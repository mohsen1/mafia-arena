## API Client

```typescript
// src/lib/api.ts
const API_URL = import.meta.env.API_URL || 'https://mafia-arena.workers.dev';

async function fetchAPI<T>(endpoint: string): Promise<T> {
  const response = await fetch(`${API_URL}${endpoint}`);
  if (!response.ok) {
    throw new Error(`API error: ${response.status}`);
  }
  return response.json();
}

export async function getLeaderboard(team?: string) {
  const query = team ? `?team=${team}` : '';
  return fetchAPI<{ rankings: LeaderboardEntry[] }>(`/api/leaderboard${query}`);
}

export async function getGames(limit = 20, offset = 0) {
  return fetchAPI<{ games: Game[]; total: number }>(
    `/api/games?limit=${limit}&offset=${offset}`
  );
}

export async function getGame(id: string) {
  return fetchAPI<GameWithParticipants>(`/api/games/${id}`);
}

export async function getTranscript(gameId: string) {
  const R2_URL = import.meta.env.R2_PUBLIC_URL;
  const response = await fetch(`${R2_URL}/games/${gameId}/transcript.json`);
  return response.json();
}
```

## Types

```typescript
// src/lib/types.ts
export interface LeaderboardEntry {
  model_id: string;
  display_name: string;
  provider: string;
  team: 'mafia' | 'town';
  games_played: number;
  games_won: number;
  win_rate: number;
  total_tokens: number;
}

export interface Game {
  id: string;
  winner: 'mafia' | 'town';
  rounds: number;
  duration_ms: number;
  total_tokens: number;
  created_at: number;
}

export interface GameWithParticipants extends Game {
  participants: Participant[];
}

export interface Participant {
  model_id: string;
  model_name: string;
  team: 'mafia' | 'town';
  player_count: number;
  won: boolean;
}
```

## Page Routes

```
/                     → Leaderboard (default: mafia)
/?team=town           → Leaderboard (town rankings)
/games                → Game list
/games/[id]           → Game detail
/games/[id]/replay    → Full game replay with transcripts
/about                → How it works
```

## Error Handling

```astro
---
// src/pages/games/[id].astro
import Layout from '../../components/Layout.astro';
import { getGame } from '../../lib/api';

const { id } = Astro.params;
let game;
let error;

try {
  game = await getGame(id);
} catch (e) {
  error = e instanceof Error ? e.message : 'Failed to load game';
}
---

<Layout title={game ? `Game ${id}` : 'Error'}>
  {error ? (
    <div class="error">
      <h1>Error</h1>
      <p>{error}</p>
      <a href="/games">← Back to games</a>
    </div>
  ) : (
    <main>
      <!-- Game content -->
    </main>
  )}
</Layout>
```


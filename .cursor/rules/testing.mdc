## Integration Tests

```typescript
// src/engine/__tests__/integration.test.ts

import { describe, it, expect, beforeEach } from 'vitest';
import { Game } from '../Game';
import { MockAIProvider } from './mocks/MockAIProvider';
import type { GameConfig } from '../types';

describe('Game Integration', () => {
  let mockAI: MockAIProvider;
  
  const config: GameConfig = {
    playerCount: 5,
    mafiaCount: 1,
    teams: [
      { modelId: 'test-model', team: 'mafia', count: 1 },
      { modelId: 'test-model', team: 'town', count: 4 },
    ],
    maxRounds: 5,
    discussionEnabled: true,
  };

  beforeEach(() => {
    mockAI = new MockAIProvider();
  });

  it('should complete a game where town wins', async () => {
    // Queue responses for town victory scenario
    // Night 1: Mafia kills town
    mockAI.queueResponse({ action: { type: 'kill_vote', target: 'player_3' } });
    // Day 1: Discussion (4 alive players)
    for (let i = 0; i < 4; i++) {
      mockAI.queueResponse({ action: { type: 'discussion', message: `Player ${i} discussing` } });
    }
    // Day 1: Vote - town eliminates mafia
    for (let i = 0; i < 4; i++) {
      mockAI.queueResponse({ action: { type: 'elimination_vote', target: 'player_1' } }); // mafia
    }

    const game = new Game(config, mockAI);
    const result = await game.run();

    expect(result.winner).toBe('town');
    expect(result.rounds).toBe(1);
    expect(result.events.length).toBeGreaterThan(0);
  });

  it('should track all events in order', async () => {
    // Setup minimal game
    mockAI.queueResponse({ action: { type: 'kill_vote', target: 'player_2' } });
    // Queue enough responses for at least one round...

    const game = new Game(config, mockAI);
    const result = await game.run();

    const eventTypes = result.events.map(e => e.type);
    
    // Verify event ordering
    expect(eventTypes[0]).toBe('phase_start');
    expect(result.events[0].phase).toBe('night');
  });

  it('should respect maxRounds limit', async () => {
    const limitedConfig = { ...config, maxRounds: 2 };
    
    // Queue enough responses to go beyond max rounds
    for (let i = 0; i < 50; i++) {
      mockAI.queueResponse({ action: { type: 'kill_vote', target: 'player_2' } });
      mockAI.queueResponse({ action: { type: 'discussion', message: 'test' } });
      mockAI.queueResponse({ action: { type: 'elimination_vote', target: null } });
    }

    const game = new Game(limitedConfig, mockAI);
    const result = await game.run();

    expect(result.rounds).toBeLessThanOrEqual(2);
  });

  it('should calculate correct token usage', async () => {
    mockAI.queueResponse({
      action: { type: 'kill_vote', target: 'player_2' },
      tokensUsed: { input: 100, output: 50 },
    });
    // More responses with known token counts...

    const game = new Game(config, mockAI);
    const result = await game.run();

    expect(result.tokenUsage.input).toBeGreaterThan(0);
    expect(result.tokenUsage.output).toBeGreaterThan(0);
  });
});
```

## Testing Async Code

```typescript
// Testing retries
describe('RetryingProvider', () => {
  it('should retry on failure', async () => {
    const mockProvider = {
      complete: vi.fn()
        .mockRejectedValueOnce(new Error('Timeout'))
        .mockRejectedValueOnce(new Error('Timeout'))
        .mockResolvedValueOnce({ content: 'success', tokensUsed: { input: 10, output: 5 } }),
    };

    const retrying = new RetryingProvider(mockProvider as any, {
      maxRetries: 3,
      backoffMs: [10, 20, 40], // Fast for tests
    });

    const result = await retrying.complete({ systemPrompt: '', userPrompt: '' });

    expect(mockProvider.complete).toHaveBeenCalledTimes(3);
    expect(result.content).toBe('success');
  });

  it('should throw after max retries', async () => {
    const mockProvider = {
      complete: vi.fn().mockRejectedValue(new Error('Always fails')),
    };

    const retrying = new RetryingProvider(mockProvider as any, {
      maxRetries: 2,
      backoffMs: [10, 20],
    });

    await expect(retrying.complete({ systemPrompt: '', userPrompt: '' }))
      .rejects.toThrow('RETRY_EXHAUSTED');

    expect(mockProvider.complete).toHaveBeenCalledTimes(3); // Initial + 2 retries
  });
});
```


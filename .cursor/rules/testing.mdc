## Mock AI Provider

```typescript
// src/engine/__tests__/mocks/MockAIProvider.ts

import type { AIProvider, AIContext, AIResponse, ActionPrompt } from '../../types';

export class MockAIProvider implements AIProvider {
  private responseQueue: AIResponse[] = [];
  private callHistory: Array<{ context: AIContext; prompt: ActionPrompt }> = [];

  /**
   * Queue a response to be returned on the next getAction call
   */
  queueResponse(response: Partial<AIResponse>): this {
    this.responseQueue.push({
      action: { type: 'kill_vote', target: 'player_1' },
      tokensUsed: { input: 100, output: 20 },
      latencyMs: 500,
      ...response,
    });
    return this;
  }

  /**
   * Queue multiple responses at once
   */
  queueResponses(responses: Array<Partial<AIResponse>>): this {
    responses.forEach(r => this.queueResponse(r));
    return this;
  }

  /**
   * Get all calls made to this provider
   */
  getCalls(): Array<{ context: AIContext; prompt: ActionPrompt }> {
    return [...this.callHistory];
  }

  /**
   * Get the last call made
   */
  getLastCall(): { context: AIContext; prompt: ActionPrompt } | undefined {
    return this.callHistory.at(-1);
  }

  /**
   * Reset state
   */
  reset(): void {
    this.responseQueue = [];
    this.callHistory = [];
  }

  async getAction(context: AIContext, prompt: ActionPrompt): Promise<AIResponse> {
    this.callHistory.push({ context, prompt });

    const response = this.responseQueue.shift();
    if (!response) {
      throw new Error(
        `MockAIProvider: No response queued. Call queueResponse() before running the game. ` +
        `Calls so far: ${this.callHistory.length}`
      );
    }

    return response;
  }
}

/**
 * Create a mock provider with pre-configured responses for a full game
 */
export function createGameMockProvider(scenario: 'mafia_wins' | 'town_wins'): MockAIProvider {
  const mock = new MockAIProvider();

  if (scenario === 'mafia_wins') {
    // Night 1: Mafia kills a town member
    mock.queueResponse({
      action: { type: 'kill_vote', target: 'player_3' },
    });
    // Day 1: Discussion
    mock.queueResponses([
      { action: { type: 'discussion', message: 'Player 3 was killed. Very suspicious.' } },
      { action: { type: 'discussion', message: 'I think player 2 might be mafia.' } },
    ]);
    // Day 1: Vote - Town votes out another town member
    mock.queueResponses([
      { action: { type: 'elimination_vote', target: 'player_4' } },
      { action: { type: 'elimination_vote', target: 'player_4' } },
    ]);
    // Continue until mafia wins...
  }

  return mock;
}
```

## Unit Test Examples

### Testing GameState

```typescript
// src/engine/GameState.test.ts

import { describe, it, expect } from 'vitest';
import { GameState } from './GameState';
import type { GameConfig } from './types';

describe('GameState', () => {
  const defaultConfig: GameConfig = {
    playerCount: 5,
    mafiaCount: 1,
    teams: [
      { modelId: 'gpt-4o', team: 'mafia', count: 1 },
      { modelId: 'claude-3-5-sonnet', team: 'town', count: 4 },
    ],
    maxRounds: 10,
    discussionEnabled: true,
  };

  describe('create', () => {
    it('should create state with correct number of players', () => {
      const state = GameState.create(defaultConfig);
      expect(state.players).toHaveLength(5);
    });

    it('should assign correct team distribution', () => {
      const state = GameState.create(defaultConfig);
      const mafia = state.players.filter(p => p.team === 'mafia');
      const town = state.players.filter(p => p.team === 'town');
      
      expect(mafia).toHaveLength(1);
      expect(town).toHaveLength(4);
    });

    it('should start at night phase, round 1', () => {
      const state = GameState.create(defaultConfig);
      expect(state.phase).toBe('night');
      expect(state.round).toBe(1);
    });

    it('should initialize all players as alive', () => {
      const state = GameState.create(defaultConfig);
      expect(state.players.every(p => p.isAlive)).toBe(true);
    });
  });

  describe('withPlayerKilled', () => {
    it('should mark player as not alive', () => {
      const state = GameState.create(defaultConfig);
      const targetId = state.players[0].id;
      
      const newState = state.withPlayerKilled(targetId);
      
      const target = newState.players.find(p => p.id === targetId);
      expect(target?.isAlive).toBe(false);
    });

    it('should return a new state instance', () => {
      const state = GameState.create(defaultConfig);
      const newState = state.withPlayerKilled(state.players[0].id);
      
      expect(newState).not.toBe(state);
      // Original state unchanged
      expect(state.players[0].isAlive).toBe(true);
    });
  });

  describe('computed properties', () => {
    it('alivePlayers should exclude dead players', () => {
      let state = GameState.create(defaultConfig);
      state = state.withPlayerKilled(state.players[0].id);
      
      expect(state.alivePlayers).toHaveLength(4);
    });

    it('aliveMafia should return only alive mafia', () => {
      let state = GameState.create(defaultConfig);
      const mafia = state.players.find(p => p.team === 'mafia')!;
      
      expect(state.aliveMafia).toHaveLength(1);
      
      state = state.withPlayerKilled(mafia.id);
      expect(state.aliveMafia).toHaveLength(0);
    });
  });
});
```

### Testing Vote Resolution

```typescript
// src/engine/utils/votes.test.ts

import { describe, it, expect } from 'vitest';
import { resolveVotes } from './votes';

describe('resolveVotes', () => {
  const candidates = [
    { id: 'player_1', name: 'Alice' },
    { id: 'player_2', name: 'Bob' },
    { id: 'player_3', name: 'Charlie' },
  ];

  it('should return candidate with most votes', () => {
    const votes = new Map([
      ['voter_1', 'player_2'],
      ['voter_2', 'player_2'],
      ['voter_3', 'player_1'],
    ]);

    const result = resolveVotes(votes, candidates);
    expect(result?.id).toBe('player_2');
  });

  it('should return null on tie', () => {
    const votes = new Map([
      ['voter_1', 'player_1'],
      ['voter_2', 'player_2'],
    ]);

    const result = resolveVotes(votes, candidates);
    expect(result).toBeNull();
  });

  it('should return null when no votes', () => {
    const votes = new Map<string, string>();
    const result = resolveVotes(votes, candidates);
    expect(result).toBeNull();
  });

  it('should handle single vote', () => {
    const votes = new Map([['voter_1', 'player_3']]);
    const result = resolveVotes(votes, candidates);
    expect(result?.id).toBe('player_3');
  });
});

export function createTestPlayer(overrides: Partial<Player> = {}): Player {
  return {
    id: `player_${Math.random().toString(36).slice(2)}`,
    name: 'Test Player',
    modelId: 'test-model',
    team: 'town',
    isAlive: true,
    ...overrides,
  };
}

export function createTestPlayers(count: number, team: 'mafia' | 'town'): Player[] {
  return Array.from({ length: count }, (_, i) =>
    createTestPlayer({ id: `player_${team}_${i}`, team })
  );
}

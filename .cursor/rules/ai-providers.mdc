## Retrying Provider Wrapper

```typescript
// src/worker/ai/RetryingProvider.ts

export class RetryingProvider implements AIProvider {
  readonly name: string;
  readonly modelId: string;

  private provider: AIProvider;
  private maxRetries: number;
  private backoffMs: number[];

  constructor(
    provider: AIProvider,
    options: { maxRetries?: number; backoffMs?: number[] } = {}
  ) {
    this.provider = provider;
    this.name = provider.name;
    this.modelId = provider.modelId;
    this.maxRetries = options.maxRetries ?? 3;
    this.backoffMs = options.backoffMs ?? [1000, 2000, 4000];
  }

  async complete(request: CompletionRequest): Promise<CompletionResponse> {
    let lastError: Error | null = null;

    for (let attempt = 0; attempt <= this.maxRetries; attempt++) {
      try {
        return await this.provider.complete(request);
      } catch (error) {
        lastError = error as Error;
        
        // Don't retry on certain errors
        if (this.isNonRetryableError(error)) {
          throw error;
        }

        if (attempt < this.maxRetries) {
          const delay = this.backoffMs[attempt] ?? this.backoffMs.at(-1) ?? 4000;
          await this.sleep(delay);
        }
      }
    }

    throw new AIError(
      'RETRY_EXHAUSTED',
      `Failed after ${this.maxRetries} retries: ${lastError?.message}`,
      lastError ?? undefined
    );
  }

  private isNonRetryableError(error: unknown): boolean {
    if (error instanceof AIError) {
      // Don't retry auth errors or invalid requests
      return ['AUTH_ERROR', 'INVALID_REQUEST'].includes(error.code);
    }
    return false;
  }

  private sleep(ms: number): Promise<void> {
    return new Promise(resolve => setTimeout(resolve, ms));
  }
}
```


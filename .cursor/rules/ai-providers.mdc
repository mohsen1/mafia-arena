## Response Parsing

```typescript
// src/worker/ai/parsing.ts

import { z } from 'zod';

// Define schemas for expected responses
const KillVoteSchema = z.object({
  action: z.literal('kill'),
  target: z.string(),
  reasoning: z.string().optional(),
});

const DiscussionSchema = z.object({
  message: z.string(),
});

const EliminationVoteSchema = z.object({
  vote: z.string().nullable(),
  reasoning: z.string().optional(),
});

export function parseKillVote(response: string): { target: string; reasoning?: string } {
  const json = extractJSON(response);
  const parsed = KillVoteSchema.parse(json);
  return { target: parsed.target, reasoning: parsed.reasoning };
}

export function parseDiscussion(response: string): { message: string } {
  const json = extractJSON(response);
  const parsed = DiscussionSchema.parse(json);
  return { message: parsed.message };
}

export function parseEliminationVote(response: string): { vote: string | null; reasoning?: string } {
  const json = extractJSON(response);
  const parsed = EliminationVoteSchema.parse(json);
  return { vote: parsed.vote, reasoning: parsed.reasoning };
}

function extractJSON(content: string): unknown {
  // Try to find JSON in markdown code blocks
  const codeBlockMatch = content.match(/```(?:json)?\s*([\s\S]*?)```/);
  if (codeBlockMatch) {
    return JSON.parse(codeBlockMatch[1].trim());
  }

  // Try to find JSON object
  const jsonMatch = content.match(/\{[\s\S]*\}/);
  if (jsonMatch) {
    return JSON.parse(jsonMatch[0]);
  }

  // Try parsing the whole thing
  return JSON.parse(content.trim());
}
```


## Cost Tracking

```typescript
// src/worker/ai/costs.ts

const MODEL_PRICING: Record<string, { input: number; output: number }> = {
  // OpenAI (per 1K tokens)
  'gpt-4o': { input: 0.005, output: 0.015 },
  'gpt-4o-mini': { input: 0.00015, output: 0.0006 },
  
  // Anthropic (per 1K tokens)
  'claude-3-5-sonnet-20241022': { input: 0.003, output: 0.015 },
  'claude-3-5-haiku-20241022': { input: 0.001, output: 0.005 },
  
  // Google (per 1K tokens)
  'gemini-1.5-pro': { input: 0.00125, output: 0.005 },
  'gemini-1.5-flash': { input: 0.000075, output: 0.0003 },
  'gemini-2.0-flash-exp': { input: 0.0, output: 0.0 }, // Free during preview
};

export function calculateCost(
  modelId: string,
  tokens: { input: number; output: number }
): number {
  const pricing = MODEL_PRICING[modelId] ?? { input: 0.01, output: 0.03 };
  return (tokens.input / 1000) * pricing.input + (tokens.output / 1000) * pricing.output;
}

export function getTotalCost(
  calls: Array<{ modelId: string; tokensUsed: { input: number; output: number } }>
): number {
  return calls.reduce((total, call) => total + calculateCost(call.modelId, call.tokensUsed), 0);
}

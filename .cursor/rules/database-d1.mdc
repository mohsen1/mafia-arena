## Type Definitions

```typescript
// src/worker/db/types.ts

export type Team = 'mafia' | 'town';
export type GameStatus = 'running' | 'completed' | 'failed';
export type Provider = 'openai' | 'anthropic' | 'google';

export interface Model {
  id: string;
  provider: Provider;
  display_name: string;
  config: string | null;
  created_at: number;
}

export interface Game {
  id: string;
  batch_id: string | null;
  config_hash: string;
  player_count: number;
  mafia_count: number;
  winner: Team;
  rounds: number;
  duration_ms: number;
  total_tokens: number;
  status: GameStatus;
  error_message: string | null;
  created_at: number;
}

export interface Participant {
  id: string;
  game_id: string;
  model_id: string;
  team: Team;
  player_count: number;
  won: number; // 0 or 1 in SQLite
  tokens_used: number;
}

export interface ParticipantWithModel extends Participant {
  display_name: string;
  provider: Provider;
}

export interface GameWithParticipants extends Game {
  participants: ParticipantWithModel[];
}

export interface LeaderboardEntry {
  model_id: string;
  team: Team;
  games_played: number;
  games_won: number;
  win_rate: number;
  total_tokens: number;
  updated_at: number;
  display_name: string;
  provider: Provider;
}

// Create/Update params
export interface CreateGameParams {
  id: string;
  batchId?: string;
  configHash: string;
  playerCount: number;
  mafiaCount: number;
  winner: Team;
  rounds: number;
  durationMs: number;
  totalTokens: number;
}

export interface CreateParticipantParams {
  modelId: string;
  team: Team;
  playerCount: number;
  won: boolean;
  tokensUsed: number;
}

export interface LeaderboardUpdate {
  modelId: string;
  team: Team;
  won: boolean;
  tokensUsed: number;
}

// Pagination
export interface PaginationOptions {
  limit?: number;
  offset?: number;
}

export interface PaginatedResult<T> {
  items: T[];
  total: number;
  hasMore: boolean;
}
```

## D1 Best Practices

1. **Always use transactions for related writes**
2. **Use batch operations for multiple inserts**
3. **Create indexes for frequently queried columns**
4. **Use INTEGER for timestamps (unixepoch)**
5. **Keep JSON columns small and query-unfriendly data**
6. **Use CHECK constraints for enum-like columns**
7. **Always handle NULL values explicitly**

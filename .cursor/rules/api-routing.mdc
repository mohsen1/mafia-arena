# API & Routing Rules

You are building REST API endpoints for Mafia Arena using Cloudflare Workers.

## API Design Principles

1. **RESTful conventions** - Use proper HTTP methods and status codes
2. **JSON responses** - Always return JSON with consistent structure
3. **Error handling** - Return structured errors with codes
4. **Validation** - Validate input before processing
5. **Rate limiting** - Protect expensive endpoints

## Router Pattern

```typescript
// src/worker/api/router.ts

type Handler = (request: Request, env: Env, ctx: ExecutionContext) => Promise<Response>;

interface Route {
  method: string;
  pattern: RegExp;
  handler: Handler;
}

export class Router {
  private routes: Route[] = [];

  get(path: string, handler: Handler): this {
    this.routes.push({ method: 'GET', pattern: this.pathToRegex(path), handler });
    return this;
  }

  post(path: string, handler: Handler): this {
    this.routes.push({ method: 'POST', pattern: this.pathToRegex(path), handler });
    return this;
  }

  private pathToRegex(path: string): RegExp {
    // Convert /games/:id to /games/(?<id>[^/]+)
    const pattern = path
      .replace(/:[a-zA-Z]+/g, (match) => `(?<${match.slice(1)}>[^/]+)`)
      .replace(/\//g, '\\/');
    return new RegExp(`^${pattern}$`);
  }

  async handle(request: Request, env: Env, ctx: ExecutionContext): Promise<Response> {
    const url = new URL(request.url);
    const method = request.method;
    const pathname = url.pathname;

    for (const route of this.routes) {
      if (route.method !== method) continue;
      
      const match = pathname.match(route.pattern);
      if (match) {
        // Attach params to request
        (request as any).params = match.groups || {};
        return route.handler(request, env, ctx);
      }
    }

    return Response.json({ error: { code: 'NOT_FOUND', message: 'Endpoint not found' } }, { status: 404 });
  }
}
```

## API Endpoints

```typescript
// src/worker/api/index.ts

import { Router } from './router';
import { handleRunGames, handleGetGames, handleGetGame } from './games';
import { handleGetLeaderboard } from './leaderboard';
import { handleGetModels } from './models';
import { withErrorHandling, withValidation, withRateLimit } from './middleware';

export function createRouter(): Router {
  const router = new Router();

  // Games
  router.post('/api/games/run', withErrorHandling(withRateLimit(handleRunGames)));
  router.get('/api/games', withErrorHandling(handleGetGames));
  router.get('/api/games/:id', withErrorHandling(handleGetGame));

  // Leaderboard
  router.get('/api/leaderboard', withErrorHandling(handleGetLeaderboard));

  // Models
  router.get('/api/models', withErrorHandling(handleGetModels));

  // Health
  router.get('/api/health', async () => Response.json({ status: 'ok', timestamp: Date.now() }));

  return router;
}
```

## Request Handlers

### POST /api/games/run

```typescript
// src/worker/api/games.ts

import { z } from 'zod';
import { DatabaseService } from '../db/service';
import { APIError, Errors } from '../utils/errors';

const RunGamesSchema = z.object({
  count: z.number().int().min(1).max(100),
  config: z.object({
    playerCount: z.number().int().min(3).max(15),
    mafiaCount: z.number().int().min(1),
    teams: z.array(z.object({
      modelId: z.string(),
      team: z.enum(['mafia', 'town']),
      count: z.number().int().min(1),
    })),
    maxRounds: z.number().int().min(1).max(20).default(10),
    discussionEnabled: z.boolean().default(true),
  }),
});

export async function handleRunGames(request: Request, env: Env): Promise<Response> {
  // Parse and validate request body
  const body = await request.json();
  const parsed = RunGamesSchema.safeParse(body);
  
  if (!parsed.success) {
    throw Errors.BadRequest(`Invalid request: ${parsed.error.message}`);
  }

  const { count, config } = parsed.data;

  // Validate config consistency
  const totalPlayers = config.teams.reduce((sum, t) => sum + t.count, 0);
  if (totalPlayers !== config.playerCount) {
    throw Errors.BadRequest('Team counts must equal playerCount');
  }

  const mafiaTotal = config.teams
    .filter(t => t.team === 'mafia')
    .reduce((sum, t) => sum + t.count, 0);
  if (mafiaTotal !== config.mafiaCount) {
    throw Errors.BadRequest('Mafia team counts must equal mafiaCount');
  }

  // Generate batch and game IDs
  const batchId = `batch_${crypto.randomUUID().slice(0, 8)}`;
  const gameIds: string[] = [];
  const messages: MessageSendRequest[] = [];

  for (let i = 0; i < count; i++) {
    const gameId = `game_${crypto.randomUUID().slice(0, 12)}`;
    gameIds.push(gameId);
    messages.push({
      body: { gameId, config, batchId },
    });
  }

  // Enqueue games
  await env.GAME_QUEUE.sendBatch(messages);

  return Response.json({
    success: true,
    batchId,
    queued: count,
    gameIds,
  }, { status: 202 });
}
```

### GET /api/games

```typescript
export async function handleGetGames(request: Request, env: Env): Promise<Response> {
  const url = new URL(request.url);
  const limit = Math.min(parseInt(url.searchParams.get('limit') || '20'), 100);
  const offset = parseInt(url.searchParams.get('offset') || '0');
  const status = url.searchParams.get('status') as GameStatus | null;

  const db = new DatabaseService(env.DB);
  const result = await db.getGames({ limit, offset, status: status ?? undefined });

  return Response.json({
    games: result.items,
    total: result.total,
    hasMore: result.hasMore,
  });
}
```

### GET /api/games/:id

```typescript
export async function handleGetGame(request: Request, env: Env): Promise<Response> {
  const { id } = (request as any).params;

  const db = new DatabaseService(env.DB);
  const game = await db.getGame(id);

  if (!game) {
    throw Errors.NotFound('Game');
  }

  // Generate R2 URL for transcript
  const transcriptUrl = `${env.R2_PUBLIC_URL}/games/${id}/transcript.json`;

  return Response.json({
    ...game,
    transcriptUrl,
  });
}
```


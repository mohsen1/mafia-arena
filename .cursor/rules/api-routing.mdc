## Worker Entry Point

```typescript
// src/worker/index.ts

import { createRouter } from './api';
import { withCORS, withErrorHandling } from './api/middleware';

export { GameRunner } from './GameRunner';

const router = createRouter();

export default {
  async fetch(request: Request, env: Env, ctx: ExecutionContext): Promise<Response> {
    // Health check bypass
    if (new URL(request.url).pathname === '/') {
      return Response.json({ name: 'mafia-arena', status: 'ok' });
    }

    // Handle API routes with CORS
    return withCORS(withErrorHandling(
      (req, env, ctx) => router.handle(req, env, ctx)
    ))(request, env, ctx);
  },

  async queue(batch: MessageBatch<GameQueueMessage>, env: Env): Promise<void> {
    for (const message of batch.messages) {
      const { gameId, config, batchId } = message.body;

      try {
        const id = env.GAME_RUNNER.idFromName(gameId);
        const stub = env.GAME_RUNNER.get(id);

        await stub.fetch('http://internal/start', {
          method: 'POST',
          body: JSON.stringify({ config, batchId }),
        });

        message.ack();
      } catch (error) {
        console.error(`Queue error for game ${gameId}:`, error);
        message.retry();
      }
    }
  },
};
```

## HTTP Status Codes

| Code | Usage |
|------|-------|
| 200 | Successful GET |
| 201 | Resource created |
| 202 | Accepted (queued for processing) |
| 400 | Bad request / validation error |
| 401 | Authentication required |
| 403 | Forbidden |
| 404 | Resource not found |
| 429 | Rate limited |
| 500 | Internal server error |


 *   mafiaCount: 2,
 *   teams: [...]
 * }, aiProvider);
 */
export async function runGame(
  config: GameConfig,
  aiProvider: AIProvider
): Promise<GameResult> {
  // ...
}
```

### Comment "Why" Not "What"

```typescript
// ❌ Bad - describes what code does (obvious)
// Loop through players and filter alive ones
const alive = players.filter(p => p.isAlive);

// ✅ Good - explains why
// Mafia wins when they equal or outnumber town, not just when majority
if (mafiaCount >= townCount) {
  return 'mafia';
}
```

## Testing Quality

### Test Behavior, Not Implementation

```typescript
// ❌ Bad - tests implementation details
it('should call processVote and updateState', () => {
  const spy = vi.spyOn(game, 'processVote');
  game.vote('player_1', 'player_2');
  expect(spy).toHaveBeenCalled();
});

// ✅ Good - tests behavior
it('should eliminate player with most votes', () => {
  game.vote('player_1', 'player_3');
  game.vote('player_2', 'player_3');
  game.resolveVotes();
  expect(game.isPlayerAlive('player_3')).toBe(false);
});
```

### Descriptive Test Names

```typescript
// ❌ Bad
it('works', () => {});
it('test vote', () => {});

// ✅ Good
it('should eliminate the player with the most votes', () => {});
it('should not eliminate anyone when votes are tied', () => {});
it('should allow mafia to see their teammates', () => {});
```

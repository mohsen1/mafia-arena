# =============================================================================
# Mafia Arena - Environment Variables
# =============================================================================
# Copy this file to .dev.vars for local development
# For production, set these as Cloudflare Worker secrets via:
#   wrangler secret put SECRET_NAME
# =============================================================================

# -----------------------------------------------------------------------------
# AI Provider Keys (at least one required)
# -----------------------------------------------------------------------------

# OpenRouter API Key - Unified access to multiple AI models (recommended)
# Get one at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Direct provider keys (optional - enable specific providers)
# Anthropic API Key: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OpenAI API Key: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Google AI API Key: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here

# -----------------------------------------------------------------------------
# Authentication (required for admin features)
# -----------------------------------------------------------------------------

# Option 1: Google OAuth (recommended for production)
# Create OAuth credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Admin email - must match Google account used for OAuth
ADMIN_EMAIL=admin@example.com

# Option 2: Basic Auth (for development/simple setups)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-password-here

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------

# Encryption secret for user-provided API keys (32+ characters)
# Generate with: openssl rand -hex 32
ENCRYPTION_SECRET=your-32-plus-character-encryption-secret-here

# -----------------------------------------------------------------------------
# Cloudflare Configuration (for deployment)
# -----------------------------------------------------------------------------

# Cloudflare Account ID (from dashboard.cloudflare.com)
# CLOUDFLARE_ACCOUNT_ID=your-account-id

# Cloudflare API Token (create at: https://dash.cloudflare.com/profile/api-tokens)
# Use "Edit Cloudflare Workers" template with D1, R2, Queues permissions
# CLOUDFLARE_API_TOKEN=your-api-token

# -----------------------------------------------------------------------------
# Optional Configuration
# -----------------------------------------------------------------------------

# Environment (development | production)
ENVIRONMENT=development

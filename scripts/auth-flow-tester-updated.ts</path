#!/usr/bin/env node

/**
 * Phase 4.4: Comprehensive Authentication Flow Testing Suite
 * Tests both NextAuth and Melody authentication systems
 */

import { performance } from 'perf_hooks';
import { exec } from 'child_process';
import { promisify } from 'util';

const execAsync = promisify(exec);

// Test configuration - updated with correct port
const TEST_CONFIG = {
  baseUrl: process.env.NEXT_PUBLIC_APP_URL || 'http://localhost:3099',
  melodyUrl: process.env.MELODY_SERVER_URL || 'http://localhost:8787',
  enableMelody: process.env.AUTH_ENABLE_MELODY === 'true',
  testUsers: {
    google: {
      email: 'test.google@example.com',
      provider: 'google'
    },
    github: {
      email: 'test.github@example.com',
      provider: 'github'
    },
    credentials: {
      email: 'test.credentials@example.com',
      password: 'TestPassword123!',
      provider: 'credentials'
    }
  },
  performance: {
    oauthCallback: 200, // < 200ms
    sessionValidation: 50, // < 50ms
    loginLogout: 100, // < 100ms
    protectedRoute: 50 // < 50ms
  }
};

// Test results tracking
class TestResults {
  private passed: number = 0;
  private failed: number = 0;
  private errors: Array<{ test: string; error: string; details?: any }> = [];
  private performance: Record<string, { value: number; threshold: number; passed: boolean }> = {};
  private startTime: number = Date.now();

  pass(testName: string, duration: number, details?: any): void {
    this.passed++;
    console.log(`✅ PASS: ${testName} (${duration}ms)`);
    if (details) console.log(`   Details:`, details);
  }

  fail(testName: string, error: Error | string, details?: any): void {
    this.failed++;
    const errorMsg = error instanceof Error ? error.message : error;
    console.log(`❌ FAIL: ${testName} - ${errorMsg}`);
    if (details) console.log(`   Details:`, details);
    this.errors.push({ test: testName, error: errorMsg, details });
  }

  performanceMetric(name: string, value: number, threshold: number): void {
    this.performance[name] = { value, threshold, passed: value < threshold };
    const status = value < threshold ? '✅' : '❌';
    console.log(`${status} Performance: ${name} = ${value}ms (threshold: ${threshold}ms)`);
  }

  summary() {
    const total = this.passed + this.failed;
    const duration = Date.now() - this.startTime;
    const passRate = total > 0 ? ((this.passed / total) * 100).toFixed(1) : '0';
    
    console.log('\n' + '='.repeat(60));
    console.log('AUTHENTICATION TESTING SUMMARY');
    console.log('='.repeat(60));
    console.log(`Total Tests: ${total}`);
    console.log(`Passed: ${this.passed} (${passRate}%)`);
    console.log(`Failed: ${this.failed}`);
    console.log(`Duration: ${duration}ms`);
    
    if (Object.keys(this.performance).length > 0) {
      console.log('\nPerformance Metrics:');
      Object.entries(this.performance).forEach(([name, metrics]) => {
        const status = metrics.passed ? '✅' : '❌';
        console.log(`  ${status} ${name}: ${metrics.value}ms (limit: ${metrics.threshold}ms)`);
      });
    }
    
    if (this.errors.length > 0) {
      console.log('\nFailed Tests:');
      this.errors.forEach(({ test, error, details }) => {
        console.log(`  - ${test}: ${error}`);
        if (details && Object.keys(details).length > 0) {
          console.log(`    Details:`, details);
        }
      });
    }
    
    console.log('='.repeat(60));
    
    return {
      passed: this.passed,
      failed: this.failed,
      passRate: parseFloat(passRate),
      duration,
      performance: this.performance,
      errors: this.errors
    };
  }
}

// Authentication Flow Test Suite
export class AuthFlowTester {
  private config: typeof TEST_CONFIG;
  private results: TestResults;

  constructor(config = TEST_CONFIG) {
    this.config = config;
    this.results = new TestResults();
  }

  // Utility function to measure performance
  async measurePerformance(name: string, threshold: number, testFn: () => Promise<any>): Promise<any> {
    const start = performance.now();
    try {
      const result = await testFn();
      const duration = Math.round(performance.now() - start);
      this.results.performanceMetric(name, duration, threshold);
      return result;
    } catch (error) {
      const duration = Math.round(performance.now() - start);
      this.results.performanceMetric(name, duration, threshold);
      throw error;
    }
  }

  // HTTP request helper with timing
  async makeRequest(url: string, options: RequestInit = {}): Promise<{ response: Response; duration: number }> {
    const start = performance.now();
    try {
      const response = await fetch(url, {
        ...options,
        headers: {
          'Content-Type': 'application/json',
          'User-Agent': 'AuthTestingSuite/1.0',
          ...options.headers
        }
      });
      const duration = Math.round(performance.now() - start);
      return { response, duration };
    } catch (error) {
      const duration = Math.round(performance.now() - start);
      throw new Error(`Request failed (${duration}ms): ${error instanceof Error ? error.message : String(error)}`);
    }
  }

  // Test OAuth Flow
  async testOAuthFlow(provider: 'google' | 'github'): Promise<void> {
    const testName = `${provider} OAuth Flow`;
    const startTime = Date.now();
    
    try {
      await this.measurePerformance('oauthCallback', this.config.performance.oauthCallback, async () => {
        // Step 1: Test auth initialization
        const { response: authInit } = await this.makeRequest(`${this.config.baseUrl}/api/auth/session`);
        console.log(`  Auth init status: ${authInit.status}`);
        
        // Step 2: Get providers
        const { response: providers } = await this.makeRequest(`${this.config.baseUrl}/api/auth/providers`);
        const providerData = await providers.json();
        console.log(`  Providers enabled:`, providerData.providers);
        
        if (!providerData.providers[provider]) {
          throw new Error(`${provider} provider not enabled`);
        }
        
        // Step 3: Test OAuth redirect (without actually following)
        const oauthUrl = `${this.config.baseUrl}/api/auth/signin/${provider}`;
        const { response: oauthResponse } = await this.makeRequest(oauthUrl, {
          redirect: 'manual' as RequestRedirect
        });
        
        console.log(`  OAuth redirect status: ${oauthResponse.status}`);
        
        if (oauthResponse.status !== 302 && oauthResponse.status !== 301) {
          throw new Error(`Expected redirect status 302/301, got ${oauthResponse.status}`);
        }
        
        const redirectLocation = oauthResponse.headers.get('location');
        console.log(`  Redirect to: ${redirectLocation}`);
        
        if (!redirectLocation) {
          throw new Error('No redirect location provided');
        }
        
        // Verify redirect is to correct OAuth provider
        const expectedDomains = {
          google: 'accounts.google.com',
          github: 'github.com'
        };
        
        if (expectedDomains[provider]) {
          if (!redirectLocation.includes(expectedDomains[provider])) {
            throw new Error(`Expected redirect to ${expectedDomains[provider]}, got ${redirectLocation}`);
          }
        }
      });
      
      this.results.pass(testName, Date.now() - startTime);
    } catch (error) {
      this.results.fail(testName, error instanceof Error ? error : new Error(String(error)));
    }
  }

  // Test Credentials Authentication
  async testCredentialsAuth(): Promise<void> {
    const testName = 'Credentials Authentication';
    const startTime = Date.now();
    
    try {
      await this.measurePerformance('loginLogout', this.config.performance.loginLogout, async () => {
        // Test registration endpoint existence
        const registerUrl = `${this.config.baseUrl}/api/auth/register`;
        let registerStatus = 0;
        
        try {
          const { response } = await this.makeRequest(registerUrl, { method: 'HEAD' });
          registerStatus = response.status;
        } catch {
          // Endpoint might not exist, that's okay
          console.log('  Register endpoint not found (expected)');
        }
        
        // Test login endpoint
        const loginUrl = `${this.config.baseUrl}/api/auth/signin/credentials`;
        const { response: loginResponse } = await this.makeRequest(loginUrl, {
          method: 'POST',
          body: JSON.stringify({
            email: this.config.testUsers.credentials.email,
            password: this.config.testUsers.credentials.password
          })
        });
        
        console.log(`  Login status: ${loginResponse.status}`);
        
        // Test session validation
        const { response: sessionResponse } = await this.makeRequest(`${this.config.baseUrl}/api/auth/session`);
        const sessionData = await sessionResponse.json();
        console.log(`  Session valid: ${!!sessionData.session}`);
      });
      
      this.results.pass(testName, Date.now() - startTime);
    } catch (error) {
      this.results.fail(testName, error instanceof Error ? error : new Error(String(error)));
    }
  }

  // Test Session Management
  async testSessionManagement(): Promise<void> {
    const testName = 'Session Management';
    const startTime = Date.now();
    
    try {
      await this.measurePerformance('sessionValidation', this.config.performance.sessionValidation, async () => {
        // Test session creation
        const { response: sessionResponse } = await this.makeRequest(`${this.config.baseUrl}/api/auth/session`);
        const sessionData = await sessionResponse.json();
        console.log(`  Session response:`, sessionData);
        
        // Test session validation with various scenarios
        const scenarios = [
          { name: 'Valid session', cookies: 'valid-session-token' },
          { name: 'Invalid session', cookies: 'invalid-token' },
          { name: 'No session', cookies: '' }
        ];
        
        for (const scenario of scenarios) {
          try {
            const response = await fetch(`${this.config.baseUrl}/api/auth/session`, {
              headers: scenario.cookies ? { 'Cookie': scenario.cookies } : {}
            });
            console.log(`  ${scenario.name}: ${response.status}`);
          } catch (error) {
            console.log(`  ${scenario.name}: Error - ${error instanceof Error ? error.message : String(error)}`);
          }
        }
      });
      
      this.results.pass(testName, Date.now() - startTime);
    } catch (error) {
      this.results.fail(testName, error instanceof Error ? error : new Error(String(error)));
    }
  }

  // Test Protected Routes
  async testProtectedRoutes(): Promise<void> {
    const testName = 'Protected Routes';
    const startTime = Date.now();
    
    try {
      await this.measurePerformance('protectedRoute', this.config.performance.protectedRoute, async () => {
        const protectedRoutes = [
          '/games',
          '/profile',
          '/character-setup',
          '/statistics'
        ];
        
        for (const route of protectedRoutes) {
          try {
            const response = await fetch(`${this.config.baseUrl}${route}`, {
              redirect: 'manual' as RequestRedirect
            });
            
            console.log(`  ${route}: ${response.status}`);
            
            // Protected routes should either redirect to login or return 401/403
            if (response.status === 200) {
              console.log(`  ⚠️  ${route} is not properly protected`);
            }
          } catch (error) {
            console.log(`  ${route}: Error - ${error instanceof Error ? error.message : String(error)}`);
          }
        }
      });
      
      this.results.pass(testName, Date.now() - startTime);
    } catch (error) {
      this.results.fail(testName, error instanceof Error ? error : new Error(String(error)));
    }
  }

  // Test Cross-System Compatibility
  async testCrossSystemCompatibility(): Promise<void> {
    const testName = 'Cross-System Compatibility';
    const startTime = Date.now();
    
    try {
      // Test both systems if available
      if (this.config.enableMelody) {
        console.log('  Testing Melody system...');
        try {
          const { response: melodyHealth } = await this.makeRequest(`${this.config.melodyUrl}/health`);
          console.log(`  Melody health: ${melodyHealth.status}`);
          
          if (!melodyHealth.ok) {
            throw new Error(`Melody health check failed: ${melodyHealth.status}`);
          }
        } catch (error) {
          console.log('  Melody system not available:', error instanceof Error ? error.message : String(error));
        }
      }
      
      console.log('  Testing NextAuth compatibility...');
      const { response: nextAuthHealth } = await this.makeRequest(`${this.config.baseUrl}/api/auth`);
      console.log(`  NextAuth health: ${nextAuthHealth.status}`);
      
      // Test data consistency between systems
      console.log('  Testing user data consistency...');
      const { response: sessionResponse } = await this.makeRequest(`${this.config.baseUrl}/api/auth/session`);
      const sessionData = await sessionResponse.json();
      console.log(`  Session data available: ${!!sessionData.session}`);
      
      this.results.pass(testName, Date.now() - startTime);
    } catch (error) {
      this.results.fail(testName, error instanceof Error ? error : new Error(String(error)));
    }
  }

  // Test Error Handling
  async testErrorHandling(): Promise<void> {
    const testName = 'Error Handling';
    const startTime = Date.now();
    
    try {
      const errorScenarios = [
        {
          name: 'Invalid OAuth provider',
          url: `${this.config.baseUrl}/api/auth/signin/invalid`,
          expectedStatus: [302, 404, 400]
        },
        {
          name: 'Invalid session token',
          url: `${this.config.baseUrl}/api/auth/session`,
          headers: { 'Cookie': 'invalid-session-token' },
          expectedStatus: [200, 401] // Should return empty session or 401
        },
        {
          name: 'Malformed request',
          url: `${this.config.baseUrl}/api/auth/signin`,
          method: 'POST',
          body: 'invalid json',
          expectedStatus: [400, 422]
        }
      ];
      
      for (const scenario of errorScenarios) {
        try {
          const response = await fetch(scenario.url, {
            method: scenario.method || 'GET',
            headers: scenario.headers || {},
            body: scenario.body
          });
          
          console.log(`  ${scenario.name}: ${response.status}`);
          
          if (scenario.expectedStatus.includes(response.status)) {
            console.log(`    ✅ Expected status received`);
          } else {
            console.log(`    ⚠️  Unexpected status: ${response.status}`);
          }
        } catch (error) {
          console.log(`  ${scenario.name}: Network error - ${error instanceof Error ? error.message : String(error)}`);
        }
      }
      
      this.results.pass(testName, Date.now() - startTime);
    } catch (error) {
      this.results.fail(testName, error instanceof Error ? error : new Error(String(error)));
    }
  }

  // Test Edge Deployment
  async testEdgeDeployment(): Promise<void> {
    const testName = 'Edge Deployment';
    const startTime = Date.now();
    
    try {
      console.log('  Testing edge deployment endpoints...');
      
      // Test main app endpoints
      const edgeEndpoints = [
        `${this.config.baseUrl}/api/auth/session`,
        `${this.config.baseUrl}/api/auth/providers`,
        `${this.config.baseUrl}/api/auth/health`
      ];
      
      for (const endpoint of edgeEndpoints) {
        try {
          const { response } = await this.makeRequest(endpoint);
          console.log(`  ${endpoint}: ${response.status}`);
          
          if (!response.ok && response.status !== 302) {
            console.log(`    ⚠️  Non-OK status: ${response.status}`);
          }
        } catch (error) {
          console.log(`  ${endpoint}: Error - ${error instanceof Error ? error.message : String(error)}`);
        }
      }
      
      this.results.pass(testName, Date.now() - startTime);
    } catch (error) {
      this.results.fail(testName, error instanceof Error ? error : new Error(String(error)));
    }
  }

  // Run all tests
  async runAllTests(): Promise<any> {
    console.log('🧪 Starting Authentication Flow Testing Suite');
    console.log(`Base URL: ${this.config.baseUrl}`);
    console.log(`Melody URL: ${this.config.melodyUrl}`);
    console.log(`Melody Enabled: ${this.config.enableMelody}`);
    console.log('='.repeat(60));
    
    // OAuth Flow Tests
    console.log('\n🔐 Testing OAuth Flows...');
    await this.testOAuthFlow('google');
    await this.testOAuthFlow('github');
    
    // Credentials Authentication Test
    console.log('\n🔑 Testing Credentials Authentication...');
    await this.testCredentialsAuth();
    
    // Session Management Test
    console.log('\n📱 Testing Session Management...');
    await this.testSessionManagement();
    
    // Protected Routes Test
    console.log('\n🔒 Testing Protected Routes...');
    await this.testProtectedRoutes();
    
    // Cross-System Compatibility Test
    console.log('\n🔄 Testing Cross-System Compatibility...');
    await this.testCrossSystemCompatibility();
    
    // Error Handling Test
    console.log('\n⚠️  Testing Error Handling...');
    await this.testErrorHandling();
    
    // Edge Deployment Test
    console.log('\n🌍 Testing Edge Deployment...');
    await this.testEdgeDeployment();
    
    // Generate summary
    return this.results.summary();
  }
}

// Main execution
async function main(): Promise<void> {
  try {
    const tester = new AuthFlowTester();
    const results = await tester.runAllTests();
    
    // Exit with appropriate code
    process.exit(results.failed > 0 ? 1 : 0);
  } catch (error) {
    console.error('Testing suite failed:', error);
    process.exit(1);
  }
}

// Run if called directly
if (require.main === module) {
  main().catch(console.error);
}
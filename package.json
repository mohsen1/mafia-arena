{
  "name": "mafia-arena",
  "version": "0.1.0",
  "description": "AI benchmark platform - LLMs playing Mafia against each other",
  "type": "module",
  "scripts": {
    "predev": "pkill -f vite 2>/dev/null || true; pkill -f wrangler 2>/dev/null || true",
    "dev": "concurrently -n worker,frontend -c blue,magenta \"pnpm dev:worker\" \"pnpm dev:frontend\"",
    "dev:worker": "wrangler dev",
    "dev:frontend": "pnpm --dir frontend dev",
    "build": "tsc",
    "build:frontend": "pnpm --dir frontend build",
    "deploy": "pnpm deploy:worker && pnpm deploy:frontend",
    "deploy:worker": "wrangler deploy",
    "deploy:frontend": "pnpm --dir frontend run deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.workers.config.ts",
    "test:ui": "playwright test",
    "test:ui:headed": "playwright test --headed",
    "test:ui:debug": "playwright test --debug",
    "test:ui:games": "playwright test e2e/ui/game-lifecycle.test.ts",
    "test:all": "pnpm test && pnpm test:e2e && pnpm test:ui",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "ai",
    "benchmark",
    "mafia",
    "llm",
    "cloudflare"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.0",
    "@cloudflare/workers-types": "^4.20241205.0",
    "@eslint/js": "^9.39.2",
    "@libsql/client": "^0.15.15",
    "@playwright/test": "^1.57.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.10.2",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.16.0",
    "msw": "^2.12.4",
    "prettier": "^3.4.2",
    "puppeteer": "^24.34.0",
    "sharp": "^0.34.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.51.0",
    "vitest": "^2.1.8",
    "wrangler": "^3.99.0"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.1",
    "hono": "^4.11.1",
    "js-tiktoken": "^1.0.21",
    "jsonrepair": "^3.13.1",
    "zod": "^3.24.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

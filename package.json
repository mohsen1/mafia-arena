{
  "name": "werewolf-ai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.7",
  "scripts": {
    "dev": "PORT=3099 DEBUG=mafia:* next dev --turbopack",
    "build": "next build",
    "build:ci": "./scripts/ci-build.sh",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "test": "vitest run",
    "test:e2e": "pnpm run db:seed && playwright test",
    "test:e2e:ui": "pnpm run db:seed && playwright test --ui",
    "test:e2e:headed": "pnpm run db:seed && playwright test --headed",
    "translate": "tsx scripts/generate-translations.ts",
    "db:setup": "bash scripts/setup-db.sh",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "yes | drizzle-kit push --force",
    "db:studio": "drizzle-kit studio",
    "db:drop": "drizzle-kit drop",
    "db:seed": "tsx scripts/seed-dev-user.ts",
    "check-db": "tsx scripts/check-db.ts",
    "dev:db": "pnpm run db:setup && pnpm run db:push && pnpm run db:seed && pnpm run dev",
    "dev:seed": "pnpm run db:seed && pnpm run dev",
    "prepare": "husky install",
    "knip": "knip --no-exit-code"
  },

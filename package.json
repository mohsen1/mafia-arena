    "drizzle-kit": "^0.31.1",
    "drizzle-orm": "^0.43.1",
    "elevenlabs": "^1.56.0",
    "framer-motion": "^12.23.0",
    "groq-sdk": "^0.19.0",
    "i18next": "^24.2.3",
    "i18next-browser-languagedetector": "^8.0.5",
    "i18next-fs-backend": "^2.6.0",
    "i18next-resources-to-backend": "^1.2.1",
    "isomorphic-dompurify": "^2.25.0",
    "lucide-react": "^0.487.0",
    "negotiator": "^1.0.0",
    "next": "15.2.4",
    "next-auth": "^4.24.11",
    "next-i18next": "^15.4.2",
    "next-themes": "^0.4.6",
    "openai": "^4.93.0",
    "postgres": "^3.4.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.4.1",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "resend": "^4.5.2",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.2.0",
    "tw-animate-css": "^1.2.5",
    "uuid": "^11.1.0",
    "zod": "^3.25.74"
  },
  "devDependencies": {
    "@agentdeskai/browser-tools-mcp": "1.2.0",
    "@modelcontextprotocol/sdk": "^1.13.2",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/postcss": "^4.1.3",
    "@types/async-retry": "^1.4.9",
    "@types/debug": "^4.1.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.17.30",
    "@types/pg": "^8.15.2",
    "@types/prompt": "^1.1.9",
    "@types/prompts": "^2.4.9",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "chalk": "^5.4.1",
    "cli-table3": "^0.6.5",
    "debug": "^4.4.0",
    "dotenv": "^16.5.0",
    "eslint": "^9",
    "eslint-config-next": "15.2.5",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "husky": "^9.0.11",
    "js-yaml": "^4.1.0",
    "jsdom": "^26.1.0",
    "knip": "^5.60.1",
    "ora": "^8.2.0",
    "playwright": "^1.53.2",
    "prettier": "^3.2.5",
    "prompts": "^2.4.2",
    "tailwindcss": "^4.1.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.1.2"
  }
}

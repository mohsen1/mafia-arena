# Cursor Automation Configuration

# Required: Your Gemini API Key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: Test mode for faster testing (10-second intervals instead of 3 minutes)
# TEST_MODE=true

# Optional: Manual trigger for immediate analysis on next screenshot
# MANUAL_TRIGGER=true

# Optional: Similarity threshold for image comparison (0.0 to 1.0)
# Higher values = more sensitive to changes
# Lower values = less sensitive to changes
# Default: 0.95
# SIMILARITY_THRESHOLD=0.95

# Optional: Cursor app name if different from "Cursor"
# CURSOR_APP_NAME=Cursor 
# Copy this to .dev.vars and fill in your API keys

# Required (default aggregator)
OPENROUTER_API_KEY=your_openrouter_key_here

# Primary direct API providers
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
GOOGLE_API_KEY=your_google_key_here

# Additional direct API providers
CEREBRAS_API_KEY=your_cerebras_key_here
MINIMAX_API_KEY=your_minimax_key_here
FIREWORKS_API_KEY=your_fireworks_key_here

# New providers (Roadmap 1.a)
XAI_API_KEY=your_xai_key_here
DEEPSEEK_API_KEY=your_deepseek_key_here
TOGETHER_API_KEY=your_together_key_here
MISTRAL_API_KEY=your_mistral_key_here
COHERE_API_KEY=your_cohere_key_here
AI21_API_KEY=your_ai21_key_here

# Free/low-cost providers (Roadmap 1.d)
GROQ_API_KEY=your_groq_key_here
SAMBANOVA_API_KEY=your_sambanova_key_here
HYPERBOLIC_API_KEY=your_hyperbolic_key_here

# Admin authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_password_here

# Google OAuth (new authentication - Roadmap 2)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
ADMIN_EMAIL=admin@example.com
SESSION_SECRET=your_session_secret_here

---
import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Mafia Arena - LLM Benchmarking Platform" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | Mafia Arena</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
	</head>
	<body class="min-h-screen bg-background font-sans antialiased">
		<div class="relative flex min-h-screen flex-col">
			<header class="sticky top-0 z-50 w-full border-b bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60">
				<div class="container mx-auto flex h-16 items-center px-4 md:px-8">
					<div class="mr-4 flex">
						<a href="/" class="mr-6 flex items-center space-x-2">
							<span class="text-xl font-bold tracking-tight">🎭 MAFIA ARENA</span>
						</a>
						<nav class="flex items-center space-x-6 text-sm font-medium">
							<a href="/" class="transition-colors hover:text-foreground/80 text-foreground">Leaderboard</a>
							<a href="/games" class="transition-colors hover:text-foreground/80 text-foreground/60">Games</a>
							<a href="/about" class="transition-colors hover:text-foreground/80 text-foreground/60">About</a>
						</nav>
					</div>
					<div class="flex flex-1 items-center justify-end space-x-4">
						<a 
							href="https://github.com/mohsenazimi/werewolf-ai" 
							target="_blank" 
							rel="noreferrer"
							class="text-sm font-medium text-muted-foreground transition-colors hover:text-foreground"
						>
							GitHub
						</a>
					</div>
				</div>
			</header>

			<main class="flex-1">
				<div class="container mx-auto py-8 px-4 md:px-8">
					<slot />
				</div>
			</main>

			<footer class="border-t py-6 md:px-8 md:py-0">
				<div class="container mx-auto flex flex-col items-center justify-between gap-4 md:h-24 md:flex-row px-4 md:px-8">
					<p class="text-center text-sm leading-loose text-muted-foreground md:text-left">
						Built for LLM benchmarking. Pure TypeScript engine.
					</p>
				</div>
			</footer>
		</div>
	</body>
</html>

<style is:global>
	:root {
		--font-sans: 'Inter', system-ui, -apple-system, sans-serif;
		--font-mono: 'JetBrains Mono', monospace;
	}

	html {
		font-family: var(--font-sans);
	}

	pre, code {
		font-family: var(--font-mono);
	}
</style>

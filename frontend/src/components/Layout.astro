---
import '../styles/global.css';
import ThemeToggle from './ThemeToggle.astro';
import { Shield, LogOut, User } from 'lucide-astro';
import { getApiUrl } from '../lib/utils';

interface Props {
	title: string;
}

const { title } = Astro.props;
const currentPath = Astro.url.pathname;
const apiUrl = getApiUrl();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Mafia Arena - AI models playing Mafia against each other" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | Mafia Arena</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
		<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
		<script is:inline>
			const theme = localStorage.getItem('theme') || 
				(window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
			if (theme === 'dark') document.documentElement.classList.add('dark');
		</script>
		<script is:inline>
			if (localStorage.getItem('adminUnlocked') === 'true') {
				document.addEventListener('DOMContentLoaded', () => {
					const adminLink = document.getElementById('admin-nav-link');
					if (adminLink) {
						adminLink.classList.remove('hidden');
						adminLink.classList.add('flex');
					}
				});
			}
		</script>
		<script is:inline>
			// Auth state management
			(function() {
				// Use localhost:8787 for local dev, production URL otherwise
				const API_URL = window.location.hostname === 'localhost' 
					? 'http://localhost:8787'
					: 'https://api.mafia-arena.com';
				
				async function checkAuth() {
					const loadingEl = document.getElementById('auth-loading');
					const signinEl = document.getElementById('auth-signin');
					const userEl = document.getElementById('auth-user');
					
					try {
						const res = await fetch(`${API_URL}/api/auth/me`, { credentials: 'include' });
						
						if (res.ok) {
							const data = await res.json();
							if (data.authenticated && data.user) {
								// Show user menu
								loadingEl?.classList.add('hidden');
								signinEl?.classList.add('hidden');
								userEl?.classList.remove('hidden');
								userEl?.classList.add('flex');
								
								// Populate user info
								const avatar = document.getElementById('user-avatar');
								const name = document.getElementById('user-name');
								const email = document.getElementById('user-email');
								
								if (avatar) {
									if (data.user.picture) {
										avatar.src = data.user.picture;
										avatar.alt = data.user.name;
									} else {
										avatar.style.display = 'none';
									}
								}
								if (name) name.textContent = data.user.name?.split(' ')[0] || 'User';
								if (email) email.textContent = data.user.email;
								
								// Show admin link if admin
								if (data.user.isAdmin) {
									localStorage.setItem('adminUnlocked', 'true');
									const adminLink = document.getElementById('admin-nav-link');
									if (adminLink) {
										adminLink.classList.remove('hidden');
										adminLink.classList.add('flex');
									}
								}
								
								return;
							}
						}
					} catch (e) {
						console.log('Auth check failed:', e);
					}
					
					// Not authenticated - show sign in
					loadingEl?.classList.add('hidden');
					signinEl?.classList.remove('hidden');
					signinEl?.classList.add('inline-flex');
				}
				
				// User menu toggle
				document.addEventListener('DOMContentLoaded', () => {
					// Update sign-in link for localhost
					const signinEl = document.getElementById('auth-signin');
					if (signinEl) {
						const currentPath = window.location.pathname;
						signinEl.href = `${API_URL}/api/auth/google?redirect=${encodeURIComponent(currentPath)}`;
					}
					
					checkAuth();
					
					const menuBtn = document.getElementById('user-menu-btn');
					const dropdown = document.getElementById('user-dropdown');
					const logoutBtn = document.getElementById('logout-btn');
					
					menuBtn?.addEventListener('click', (e) => {
						e.stopPropagation();
						dropdown?.classList.toggle('hidden');
					});
					
					// Close dropdown on outside click
					document.addEventListener('click', () => {
						dropdown?.classList.add('hidden');
					});
					
					// Logout
					logoutBtn?.addEventListener('click', async () => {
						try {
							await fetch(`${API_URL}/api/auth/logout`, { 
								method: 'POST', 
								credentials: 'include' 
							});
						} catch (e) {}
						
						localStorage.removeItem('adminUnlocked');
						sessionStorage.removeItem('adminCredentials');
						window.location.reload();
					});
				});
			})();
		</script>
	</head>
	<body class="min-h-screen bg-background font-sans antialiased">
		<div class="relative flex min-h-screen flex-col">
			<header class="sticky top-0 z-50 w-full border-b bg-background/80 backdrop-blur-md">
				<div class="max-w-6xl mx-auto flex h-12 items-center justify-between px-4">
					<div class="flex items-center gap-6">
						<a href="/" class="flex items-center gap-2 font-semibold text-sm">
							<span class="text-lg">🎭</span>
							<span>Mafia Arena</span>
						</a>
						<nav class="flex items-center gap-4 text-sm">
							<a 
								href="/games" 
								class:list={[
									"transition-colors hover:text-foreground",
									currentPath.startsWith("/games") ? "text-foreground font-medium" : "text-muted-foreground"
								]}
							>
								Games
							</a>
							<a 
								href="/blog" 
								class:list={[
									"transition-colors hover:text-foreground",
									currentPath.startsWith("/blog") ? "text-foreground font-medium" : "text-muted-foreground"
								]}
							>
								Blog
							</a>
							<a 
								href="/faq" 
								class:list={[
									"transition-colors hover:text-foreground",
									currentPath === "/faq" ? "text-foreground font-medium" : "text-muted-foreground"
								]}
							>
								FAQ
							</a>
							<a 
								id="admin-nav-link"
								href="/admin" 
								class:list={[
									"hidden transition-colors hover:text-foreground items-center gap-1",
									currentPath.startsWith("/admin") ? "text-foreground font-medium" : "text-muted-foreground"
								]}
							>
								<Shield class="h-3.5 w-3.5" />
								Admin
							</a>
						</nav>
					</div>
					<div class="flex items-center gap-2">
						<!-- User Auth Button -->
						<div id="auth-container" class="relative">
							<!-- Loading state -->
							<div id="auth-loading" class="w-8 h-8 flex items-center justify-center">
								<div class="w-4 h-4 border-2 border-muted-foreground/30 border-t-muted-foreground rounded-full animate-spin"></div>
							</div>
							
							<!-- Sign In button (hidden by default) -->
							<a 
								id="auth-signin"
								href={`${apiUrl}/api/auth/google?redirect=${currentPath}`}
								class="hidden items-center px-3 py-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors"
							>
								Sign in
							</a>
							
							<!-- User menu (hidden by default) -->
							<div id="auth-user" class="hidden">
								<button 
									id="user-menu-btn"
									class="flex items-center gap-2 px-2 py-1 rounded-md hover:bg-accent transition-colors"
								>
									<img 
										id="user-avatar" 
										src="" 
										alt="" 
										class="w-6 h-6 rounded-full bg-muted object-cover"
										onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
									/>
									<div id="user-avatar-fallback" class="hidden w-6 h-6 rounded-full bg-muted items-center justify-center">
										<User class="h-3.5 w-3.5 text-muted-foreground" />
									</div>
									<span id="user-name" class="text-sm font-medium max-w-[100px] truncate"></span>
								</button>
								
								<!-- Dropdown -->
								<div 
									id="user-dropdown"
									class="hidden absolute right-0 top-full mt-1 w-48 py-1 bg-background border rounded-md shadow-lg z-50"
								>
									<div class="px-3 py-2 border-b">
										<p id="user-email" class="text-xs text-muted-foreground truncate"></p>
									</div>
									<a 
										href="/admin"
										class="flex items-center gap-2 px-3 py-2 text-sm hover:bg-muted transition-colors"
									>
										<Shield class="h-4 w-4" />
										<span>Admin Panel</span>
									</a>
									<button 
										id="logout-btn"
										class="w-full flex items-center gap-2 px-3 py-2 text-sm text-red-600 dark:text-red-400 hover:bg-muted transition-colors"
									>
										<LogOut class="h-4 w-4" />
										<span>Sign Out</span>
									</button>
								</div>
							</div>
						</div>

						<ThemeToggle />
					</div>
				</div>
			</header>

			<main class="flex-1">
				<div class="max-w-6xl mx-auto py-6 px-4">
					<slot />
				</div>
			</main>
		</div>
	</body>
</html>

<style is:global>
	:root {
		--font-sans: 'Inter', system-ui, -apple-system, sans-serif;
		--font-mono: 'JetBrains Mono', monospace;
	}

	html {
		font-family: var(--font-sans);
	}

	pre, code, .font-mono {
		font-family: var(--font-mono);
	}
</style>

---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'AI models playing Mafia against each other' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | Mafia Arena</title>
  </head>
  <body>
    <header class="header">
      <div class="container">
        <nav class="nav">
          <a href="/" class="logo">
            <span class="logo-icon">🎭</span>
            <span class="logo-text">MAFIA ARENA</span>
          </a>
          <div class="nav-links">
            <a href="/" class="nav-link">Leaderboard</a>
            <a href="/games" class="nav-link">Games</a>
            <a href="/about" class="nav-link">About</a>
          </div>
        </nav>
      </div>
    </header>

    <main class="main">
      <div class="container">
        <slot />
      </div>
    </main>

    <footer class="footer">
      <div class="container">
        <p class="footer-text">
          Mafia Arena — AI Benchmark Platform
          <span class="footer-divider">•</span>
          <a href="https://github.com" target="_blank" rel="noopener">GitHub</a>
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  @import '../styles/global.css';

  .header {
    padding: var(--space-lg) 0;
    border-bottom: 1px solid var(--border);
    background: var(--bg-secondary);
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(10px);
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-weight: 700;
    font-size: 1.125rem;
    letter-spacing: 0.05em;
    transition: opacity 0.2s;
  }

  .logo:hover {
    opacity: 0.8;
    text-decoration: none;
  }

  .logo-icon {
    font-size: 1.5rem;
  }

  .nav-links {
    display: flex;
    gap: var(--space-lg);
  }

  .nav-link {
    color: var(--fg-secondary);
    font-weight: 500;
    transition: color 0.2s;
  }

  .nav-link:hover {
    color: var(--fg-primary);
    text-decoration: none;
  }

  .main {
    padding: var(--space-2xl) 0;
    min-height: calc(100vh - 200px);
  }

  .footer {
    padding: var(--space-xl) 0;
    border-top: 1px solid var(--border);
    background: var(--bg-secondary);
  }

  .footer-text {
    text-align: center;
    color: var(--fg-muted);
    font-size: 0.875rem;
  }

  .footer-divider {
    margin: 0 var(--space-sm);
  }

  .footer a {
    color: var(--fg-secondary);
    transition: color 0.2s;
  }

  .footer a:hover {
    color: var(--fg-primary);
  }
</style>


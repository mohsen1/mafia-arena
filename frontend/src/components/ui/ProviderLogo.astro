---
import { getProviderColor } from '../../lib/providers';

interface Props {
  provider: string;
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const { provider, size = 'md', class: className } = Astro.props;

const sizeMap = {
  sm: 'w-4 h-4',
  md: 'w-5 h-5',
  lg: 'w-6 h-6',
};

const color = getProviderColor(provider);
const providerLower = provider.toLowerCase();
---

{providerLower === 'openai' && (
  <svg class:list={[sizeMap[size], className]} viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M22.2819 9.8211C23.2391 8.9511 23.6084 7.5871 23.2267 6.3231C22.845 5.0591 21.7834 4.1311 20.4727 3.9031C19.162 3.6751 17.8334 4.1891 17.0267 5.2511C16.22 6.3131 16.0834 7.7531 16.6667 8.9571L14.4267 10.3131C13.6267 9.2571 12.3334 8.6671 10.9934 8.7671C9.65337 8.8671 8.45337 9.6431 7.82004 10.8271L5.20004 9.8271C5.16671 8.4511 4.50004 7.1671 3.40004 6.4271C2.30004 5.6871 0.913374 5.5871 -0.259626 6.1531C-1.43296 6.7191 -2.24629 7.8671 -2.41963 9.1831C-2.59296 10.4991 -2.10629 11.8131 -1.10629 12.6831L1.13337 14.0391C1.13337 15.5991 1.93337 17.0591 3.27337 17.8791C4.61337 18.6991 6.28004 18.7591 7.66671 18.0391L9.33337 20.6591C8.50004 21.8591 8.36671 23.4191 8.97337 24.7391C9.58004 26.0591 10.8467 26.9391 12.2667 27.0591C13.6867 27.1791 15.0467 26.5091 15.8 25.2991C16.5534 24.0891 16.5734 22.5591 15.8534 21.3291L18.0934 19.9731C19.0667 21.0291 20.5 21.5391 21.9267 21.3191C23.3534 21.0991 24.5534 20.1791 25.1267 18.8991C25.7 17.6191 25.5667 16.1391 24.7667 14.9791C23.9667 13.8191 22.6134 13.1591 21.1734 13.2591L19.5067 10.6391C20.34 9.4391 20.4734 7.8791 19.8667 6.5591C19.26 5.2391 18.0134 4.3591 16.5934 4.2391L14.9267 6.8591C13.9534 5.8031 12.52 5.2931 11.0934 5.5131C9.66671 5.7331 8.46671 6.6531 7.89337 7.9331L5.27337 6.9331C5.30671 5.5571 4.64004 4.2731 3.54004 3.5331C2.44004 2.7931 1.05337 2.6931 -0.119626 3.2591L-0.119626 3.2591Z" fill={color} />
  </svg>
)}

{providerLower === 'anthropic' && (
  <svg class:list={[sizeMap[size], className]} viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M14.5 2L20 22H17L11.5 6L6 22H3L8.5 2H14.5Z" fill={color} />
  </svg>
)}

{providerLower === 'google' && (
  <svg class:list={[sizeMap[size], className]} viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
    <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
    <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
    <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
  </svg>
)}

{!['openai', 'anthropic', 'google'].includes(providerLower) && (
  <span 
    class:list={[sizeMap[size], className, 'rounded-full inline-block']} 
    style={`background: ${color}`}
  ></span>
)}


---
import { AlertTriangle } from 'lucide-astro';

interface Props {
  title?: string;
  message: string;
  retry?: () => void;
  class?: string;
}

const { title = 'Something went wrong', message, retry, class: className } = Astro.props;
---

<div class:list={['border border-destructive/50 bg-destructive/10 rounded-lg p-6', className]}>
  <div class="flex items-start gap-3">
    <AlertTriangle class="text-destructive shrink-0 w-5 h-5 mt-0.5" />
    <div class="flex-1 space-y-2">
      <h3 class="font-semibold text-destructive">{title}</h3>
      <p class="text-sm text-muted-foreground">{message}</p>
      {retry && (
        <button 
          onclick={retry}
          class="inline-flex items-center gap-2 px-4 py-2 bg-destructive text-destructive-foreground rounded-md text-sm font-medium hover:bg-destructive/90 transition-colors mt-3"
        >
          Try Again
        </button>
      )}
      <slot />
    </div>
  </div>
</div>


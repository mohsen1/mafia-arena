---
import Badge from './ui/Badge.astro';
import Card from './ui/Card.astro';
import { Calendar, Layers, Clock } from 'lucide-astro';

interface Props {
  game: {
    id: string;
    winner: 'mafia' | 'town';
    rounds: number;
    created_at: number;
    duration_ms?: number;
    total_tokens?: number;
    participants?: Array<{
      model_id: string;
      team: 'mafia' | 'town';
    }>;
  };
}

const { game } = Astro.props;

// Handle both unix timestamp (seconds) and milliseconds
const timestamp = game.created_at > 9999999999 ? game.created_at : game.created_at * 1000;
const date = new Date(timestamp).toLocaleDateString(undefined, {
  month: 'short',
  day: 'numeric',
  hour: '2-digit',
  minute: '2-digit'
});

const participants = game.participants || [];
const mafiaPlayer = participants.find(p => p.team === 'mafia');
const townPlayers = participants.filter(p => p.team === 'town');

function formatDuration(ms: number): string {
  if (ms < 1000) return `${ms}ms`;
  const seconds = Math.floor(ms / 1000);
  if (seconds < 60) return `${seconds}s`;
  const minutes = Math.floor(seconds / 60);
  return `${minutes}m ${seconds % 60}s`;
}
---

<a href={`/games/${game.id}`} class="block group">
  <Card class="transition-all hover:ring-2 hover:ring-primary/20 group-hover:bg-accent/5 overflow-hidden">
    <div class="p-5 space-y-5">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2 text-[10px] font-mono text-muted-foreground uppercase tracking-tighter">
          <span class="bg-muted px-1.5 py-0.5 rounded">ID: {game.id.slice(-8)}</span>
        </div>
        <div class="flex items-center gap-1.5 text-[10px] text-muted-foreground font-medium uppercase tracking-widest">
          <Calendar size={10} /> {date}
        </div>
      </div>
      
      <div class="flex items-center gap-4">
        <div class={`h-12 w-1 rounded-full ${game.winner === 'mafia' ? 'bg-red-500 shadow-[0_0_8px_rgba(239,68,68,0.4)]' : 'bg-blue-500 shadow-[0_0_8px_rgba(59,130,246,0.4)]'}`}></div>
        <div class="flex-1 min-w-0">
          <div class="flex items-center gap-2 mb-1">
             <h3 class="font-bold text-lg leading-tight tracking-tight">
              {game.winner === 'mafia' ? 'Mafia' : 'Town'} Victory
            </h3>
            <Badge variant={game.winner === 'mafia' ? 'mafia' : 'town'} class="text-[9px] h-4 px-1.5">
              WINNER
            </Badge>
          </div>
          <div class="flex items-center gap-3 text-xs text-muted-foreground font-medium uppercase tracking-widest">
            <span class="flex items-center gap-1"><Layers size={10}/> {game.rounds} rounds</span>
            {game.duration_ms && (
              <span class="flex items-center gap-1"><Clock size={10}/> {formatDuration(game.duration_ms)}</span>
            )}
          </div>
        </div>
      </div>

      {participants.length > 0 ? (
        <div class="pt-4 border-t grid grid-cols-2 gap-2">
          <div class="space-y-1.5">
            <span class="text-[9px] font-bold text-muted-foreground uppercase tracking-widest block">Mafia</span>
            <div class="flex flex-wrap gap-1">
              {mafiaPlayer && (
                <span class="text-[10px] font-semibold text-red-500 bg-red-500/5 px-1.5 py-0.5 rounded border border-red-500/10 truncate max-w-full">
                  {mafiaPlayer.model_id}
                </span>
              )}
            </div>
          </div>
          <div class="space-y-1.5 border-l pl-3">
            <span class="text-[9px] font-bold text-muted-foreground uppercase tracking-widest block">Town</span>
            <div class="flex flex-wrap gap-1">
              {townPlayers.slice(0, 2).map(p => (
                <span class="text-[10px] font-semibold text-blue-500 bg-blue-500/5 px-1.5 py-0.5 rounded border border-blue-500/10 truncate max-w-full">
                  {p.model_id}
                </span>
              ))}
              {townPlayers.length > 2 && (
                <span class="text-[10px] font-bold text-muted-foreground bg-muted px-1 py-0.5 rounded border">
                  +{townPlayers.length - 2}
                </span>
              )}
            </div>
          </div>
        </div>
      ) : (
        <div class="pt-4 border-t flex items-center justify-between text-xs text-muted-foreground">
          <span>{game.total_tokens?.toLocaleString() || '--'} tokens</span>
          <span class="text-primary font-medium">View Details →</span>
        </div>
      )}
    </div>
  </Card>
</a>

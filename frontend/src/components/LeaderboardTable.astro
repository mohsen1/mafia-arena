---
import { cn } from '../lib/utils';
import { Trophy, TrendingUp, Coins } from 'lucide-astro';

interface LeaderboardEntry {
  model_id: string;
  display_name: string;
  games_played: number;
  games_won: number;
  win_rate: number;
  total_tokens: number;
}

interface Props {
  entries: LeaderboardEntry[];
  team: 'mafia' | 'town';
}

const { entries, team } = Astro.props;

function getRankDisplay(index: number) {
  if (index === 0) return { icon: '🥇', class: 'text-yellow-500' };
  if (index === 1) return { icon: '🥈', class: 'text-zinc-400' };
  if (index === 2) return { icon: '🥉', class: 'text-amber-600' };
  return { icon: `${index + 1}`, class: 'text-muted-foreground' };
}
---

<div class="border rounded-md overflow-hidden">
  <table class="w-full text-sm">
    <thead>
      <tr class="border-b bg-muted/50">
        <th class="h-9 px-3 text-left font-medium text-muted-foreground w-12">#</th>
        <th class="h-9 px-3 text-left font-medium text-muted-foreground">Model</th>
        <th class="h-9 px-3 text-right font-medium text-muted-foreground w-20">Win %</th>
        <th class="h-9 px-3 text-right font-medium text-muted-foreground w-16">W</th>
        <th class="h-9 px-3 text-right font-medium text-muted-foreground w-16">L</th>
        <th class="h-9 px-3 text-right font-medium text-muted-foreground w-24">Tokens</th>
      </tr>
    </thead>
    <tbody>
      {entries?.map((entry, index) => {
        const rank = getRankDisplay(index);
        const winRate = (entry.win_rate * 100).toFixed(1);
        const losses = entry.games_played - entry.games_won;
        return (
          <tr class="border-b last:border-0 hover:bg-muted/30 transition-colors">
            <td class={cn("h-10 px-3 tabular-nums font-medium", rank.class)}>
              {rank.icon}
            </td>
            <td class="h-10 px-3">
              <span class="font-medium">{entry.display_name || entry.model_id}</span>
            </td>
            <td class="h-10 px-3 text-right">
              <span class={cn(
                "font-mono font-semibold tabular-nums",
                team === 'mafia' ? 'text-red-500 dark:text-red-400' : 'text-blue-500 dark:text-blue-400'
              )}>
                {winRate}%
              </span>
            </td>
            <td class="h-10 px-3 text-right font-mono tabular-nums text-green-600 dark:text-green-400">
              {entry.games_won}
            </td>
            <td class="h-10 px-3 text-right font-mono tabular-nums text-muted-foreground">
              {losses}
            </td>
            <td class="h-10 px-3 text-right font-mono tabular-nums text-xs text-muted-foreground">
              {Math.round(entry.total_tokens).toLocaleString()}
            </td>
          </tr>
        );
      })}
    </tbody>
  </table>
  {(!entries || entries.length === 0) && (
    <div class="p-8 text-center text-muted-foreground">
      <p class="text-sm">No data yet</p>
    </div>
  )}
</div>

---
import Badge from './ui/Badge.astro';
import { cn } from '../lib/utils';

interface LeaderboardEntry {
  model_id: string;
  display_name: string;
  games_played: number;
  games_won: number;
  win_rate: number;
  total_tokens: number;
}

interface Props {
  entries: LeaderboardEntry[];
  team: 'mafia' | 'town';
}

const { entries, team } = Astro.props;

function getRankColor(index: number) {
  switch (index) {
    case 0: return 'text-yellow-500 font-bold';
    case 1: return 'text-slate-300 font-bold';
    case 2: return 'text-amber-600 font-bold';
    default: return 'text-muted-foreground';
  }
}
---

<div class="relative w-full overflow-auto rounded-xl border bg-card shadow-sm">
  <table class="w-full caption-bottom text-sm">
    <thead>
      <tr class="border-b bg-muted/30 transition-colors">
        <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground w-16">Rank</th>
        <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">Model</th>
        <th class="h-12 px-4 text-right align-middle font-medium text-muted-foreground">Win Rate</th>
        <th class="h-12 px-4 text-right align-middle font-medium text-muted-foreground">W / L</th>
        <th class="h-12 px-4 text-right align-middle font-medium text-muted-foreground">Total Tokens</th>
      </tr>
    </thead>
    <tbody class="[&_tr:last-child]:border-0">
      {entries?.map((entry, index) => (
        <tr class="border-b transition-colors hover:bg-muted/50 group">
          <td class={cn("p-4 align-middle", getRankColor(index))}>
            #{index + 1}
          </td>
          <td class="p-4 align-middle">
            <div class="font-bold tracking-tight">{entry.display_name || entry.model_id}</div>
            <div class="text-[10px] text-muted-foreground uppercase tracking-widest mt-0.5">{team} strategy</div>
          </td>
          <td class="p-4 align-middle text-right">
            <Badge variant={team === 'mafia' ? 'mafia' : 'town'}>
              {(entry.win_rate * 100).toFixed(1)}%
            </Badge>
          </td>
          <td class="p-4 align-middle text-right font-mono text-xs">
            <span class="text-green-500 font-bold">{entry.games_won}</span>
            <span class="text-muted-foreground/30 px-1">/</span>
            <span class="text-red-500 font-bold">{entry.games_played - entry.games_won}</span>
          </td>
          <td class="p-4 align-middle text-right text-muted-foreground font-mono text-xs">
            {Math.round(entry.total_tokens).toLocaleString()}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
  {(!entries || entries.length === 0) && (
    <div class="p-12 text-center text-muted-foreground">
      <div class="mb-2">📉</div>
      <p class="text-xs font-medium uppercase tracking-widest">No data available for this team</p>
    </div>
  )}
</div>

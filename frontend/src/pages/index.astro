---
import Layout from '../components/Layout.astro';
import LeaderboardTable from '../components/LeaderboardTable.astro';
import { getLeaderboard } from '../lib/api';
import { Ghost, Shield, ArrowRight } from 'lucide-astro';

const allRankings = await getLeaderboard();
const mafiaRankings = allRankings.filter(r => r.team === 'mafia');
const townRankings = allRankings.filter(r => r.team === 'town');
---

<Layout title="Leaderboard">
	<div class="space-y-8">
		<section class="space-y-2">
			<h1 class="text-2xl font-bold tracking-tight">AI Mafia Arena</h1>
			<p class="text-muted-foreground text-sm">
				Benchmarking LLMs on social deduction, deception, and strategic reasoning.
			</p>
		</section>

		<div class="grid gap-8 lg:grid-cols-2">
			<section class="space-y-3">
				<div class="flex items-center gap-2">
					<Ghost size={16} class="text-red-500 dark:text-red-400" />
					<h2 class="font-semibold">Mafia Performance</h2>
				</div>
				<LeaderboardTable entries={mafiaRankings} team="mafia" />
			</section>

			<section class="space-y-3">
				<div class="flex items-center gap-2">
					<Shield size={16} class="text-blue-500 dark:text-blue-400" />
					<h2 class="font-semibold">Town Performance</h2>
				</div>
				<LeaderboardTable entries={townRankings} team="town" />
			</section>
		</div>

		<section class="border rounded-md p-4 bg-muted/30">
			<div class="flex items-start justify-between gap-4">
				<div class="space-y-1">
					<h3 class="font-medium text-sm">How it works</h3>
					<p class="text-muted-foreground text-xs leading-relaxed max-w-xl">
						Models play Mafia in both teams. We measure deception (as Mafia), deduction (as Town), 
						and strategic reasoning through natural language discussion and voting.
					</p>
				</div>
				<a 
					href="/games" 
					class="inline-flex items-center gap-1 text-xs font-medium hover:underline shrink-0"
				>
					View games <ArrowRight size={12} />
				</a>
			</div>
		</section>
	</div>
</Layout>

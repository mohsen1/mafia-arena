---
import Layout from '../components/Layout.astro';
import LeaderboardTable from '../components/LeaderboardTable.astro';
import MatchupMatrix from '../components/MatchupMatrix.astro';
import { getLeaderboard, getStatsOverview } from '../lib/api';
import { Ghost, Shield, ArrowRight, Trophy, Crown } from 'lucide-astro';

const allRankings = await getLeaderboard();
const mafiaRankings = allRankings.filter(r => r.team === 'mafia');
const townRankings = allRankings.filter(r => r.team === 'town');

// Get stats for overall best calculation
let statsData;
try {
  statsData = await getStatsOverview();
} catch {
  statsData = null;
}

// Get overall top models
const topMafia = mafiaRankings[0];
const topTown = townRankings[0];

// Calculate overall best model from stats
const overallBest = statsData?.topModels?.[0];
---

<Layout title="Leaderboard">
	<div class="space-y-8">
		<section class="space-y-2">
			<h1 class="text-2xl font-bold tracking-tight">AI Mafia Arena</h1>
			<p class="text-muted-foreground text-sm">
				Benchmarking LLMs on social deduction, deception, and strategic reasoning.
			</p>
		</section>

		<!-- Champions summary with Overall Best -->
		{(overallBest || topMafia || topTown) && (
			<div class="space-y-3">
				{overallBest && (
					<div class="border rounded-lg p-4 bg-gradient-to-br from-amber-500/10 to-transparent border-amber-500/30">
						<div class="flex items-center gap-2 text-xs text-amber-600 dark:text-amber-400 mb-2">
							<Crown size={14} />
							<span class="font-medium uppercase tracking-wide">Overall Best Model</span>
						</div>
						<p class="text-xl font-bold">{overallBest.display_name}</p>
						<p class="text-sm text-muted-foreground">
							{(overallBest.win_rate * 100).toFixed(1)}% overall win rate · {overallBest.games} games
						</p>
					</div>
				)}
				<div class="grid gap-3 sm:grid-cols-2">
					{topMafia && (
						<div class="border rounded-lg p-4 bg-gradient-to-br from-red-500/5 to-transparent border-red-500/20">
							<div class="flex items-center gap-2 text-xs text-red-500 mb-2">
								<Trophy size={14} />
								<span class="font-medium uppercase tracking-wide">Best Deceiver</span>
							</div>
							<p class="text-lg font-bold">{topMafia.display_name}</p>
							<p class="text-sm text-muted-foreground">
								{(topMafia.win_rate * 100).toFixed(1)}% win rate as Mafia
							</p>
						</div>
					)}
					{topTown && (
						<div class="border rounded-lg p-4 bg-gradient-to-br from-blue-500/5 to-transparent border-blue-500/20">
							<div class="flex items-center gap-2 text-xs text-blue-500 mb-2">
								<Trophy size={14} />
								<span class="font-medium uppercase tracking-wide">Best Detective</span>
							</div>
							<p class="text-lg font-bold">{topTown.display_name}</p>
							<p class="text-sm text-muted-foreground">
								{(topTown.win_rate * 100).toFixed(1)}% win rate as Town
							</p>
						</div>
					)}
				</div>
			</div>
		)}

		<!-- Head-to-Head Matrix -->
		<section class="space-y-3">
			<div class="flex items-center justify-between">
				<h2 class="text-sm font-semibold">Head-to-Head Win Rates</h2>
				<a href="/stats/matchups" class="text-[10px] text-muted-foreground hover:text-foreground">
					View full matrix →
				</a>
			</div>
			<MatchupMatrix compact={true} />
		</section>

		<div class="grid gap-8 lg:grid-cols-2">
			<section class="space-y-3">
				<div class="flex items-center gap-2">
					<Ghost size={16} class="text-red-500 dark:text-red-400" />
					<h2 class="text-sm font-medium text-foreground/90">Mafia Performance</h2>
					<span class="text-[11px] text-muted-foreground/70 ml-auto">Deception skill</span>
				</div>
				<LeaderboardTable entries={mafiaRankings} team="mafia" />
			</section>

			<section class="space-y-3">
				<div class="flex items-center gap-2">
					<Shield size={16} class="text-blue-500 dark:text-blue-400" />
					<h2 class="text-sm font-medium text-foreground/90">Town Performance</h2>
					<span class="text-[11px] text-muted-foreground/70 ml-auto">Deduction skill</span>
				</div>
				<LeaderboardTable entries={townRankings} team="town" />
			</section>
		</div>

		<section class="border rounded-md p-4 bg-muted/30">
			<div class="flex items-start justify-between gap-4">
				<div class="space-y-1">
					<h3 class="font-medium text-sm">How it works</h3>
					<p class="text-muted-foreground text-xs leading-relaxed max-w-xl">
						Models play Mafia against each other. <strong>Mafia</strong> must deceive and eliminate Town. 
						<strong>Town</strong> must detect and vote out Mafia. Win rates show which models excel at each role.
					</p>
				</div>
				<a 
					href="/games" 
					class="inline-flex items-center gap-1 text-xs font-medium hover:underline shrink-0"
				>
					View games <ArrowRight size={12} />
				</a>
			</div>
		</section>
	</div>
</Layout>

---
import Layout from '../components/Layout.astro';
import LeaderboardTable from '../components/LeaderboardTable.astro';
import Button from '../components/ui/Button.astro';
import { getLeaderboard } from '../lib/api';
import { Trophy, Shield, Ghost, Info } from 'lucide-astro';

const allRankings = await getLeaderboard();
const mafiaRankings = allRankings.filter(r => r.team === 'mafia');
const townRankings = allRankings.filter(r => r.team === 'town');
---

<Layout title="Leaderboard">
	<div class="space-y-12">
		<section class="space-y-4">
			<div class="flex flex-col gap-2">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 text-primary text-[10px] font-bold uppercase tracking-widest w-fit border border-primary/20">
          <Trophy size={12} /> Live Benchmarks
        </div>
				<h1 class="text-5xl font-extrabold tracking-tight sm:text-6xl">The AI Mafia Arena</h1>
				<p class="text-muted-foreground text-xl max-w-2xl leading-relaxed">
					Comparing how Large Language Models handle social deduction, deception, and strategic reasoning.
				</p>
			</div>
		</section>

		<div class="grid gap-12 lg:grid-cols-2">
			<div class="space-y-6">
				<div class="flex items-center justify-between border-b pb-4">
					<div class="flex items-center gap-3">
						<div class="flex h-10 w-10 items-center justify-center rounded-xl bg-red-500/10 text-red-500 border border-red-500/20">
              <Ghost size={20} />
            </div>
						<div>
              <h2 class="text-2xl font-bold tracking-tight">Mafia Strategy</h2>
              <p class="text-xs text-muted-foreground font-medium uppercase tracking-widest">Deception & Manipulation</p>
            </div>
					</div>
				</div>
				<LeaderboardTable entries={mafiaRankings} team="mafia" />
			</div>

			<div class="space-y-6">
				<div class="flex items-center justify-between border-b pb-4">
					<div class="flex items-center gap-3">
						<div class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-500/10 text-blue-500 border border-blue-500/20">
              <Shield size={20} />
            </div>
						<div>
              <h2 class="text-2xl font-bold tracking-tight">Town Vigilance</h2>
              <p class="text-xs text-muted-foreground font-medium uppercase tracking-widest">Deduction & Coordination</p>
            </div>
					</div>
				</div>
				<LeaderboardTable entries={townRankings} team="town" />
			</div>
		</div>

		<div class="relative overflow-hidden rounded-2xl border bg-card p-8 group">
      <div class="absolute inset-0 bg-gradient-to-br from-primary/5 via-transparent to-transparent opacity-50"></div>
			<div class="relative flex flex-col md:flex-row items-center justify-between gap-8">
				<div class="space-y-3 text-center md:text-left flex-1">
          <div class="flex items-center justify-center md:justify-start gap-2 text-primary">
            <Info size={18} />
					  <h3 class="font-bold text-lg">About the Benchmarks</h3>
          </div>
					<p class="text-sm text-muted-foreground max-w-2xl leading-relaxed">
						Models are tested across multiple rounds in both Mafia and Town roles. 
            We measure their ability to maintain secret information, coordinate with teammates, and influence other players' decisions through natural language discussion.
					</p>
				</div>
				<div class="flex flex-col sm:flex-row gap-3">
          <Button href="/about" variant="outline">Learn More</Button>
          <Button href="/games" variant="default">Recent Games</Button>
        </div>
			</div>
		</div>
	</div>
</Layout>

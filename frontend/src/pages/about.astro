---
import Layout from '../components/Layout.astro';
---

<Layout title="About">
  <div class="max-w-2xl space-y-8">
    <div>
      <h1 class="text-2xl font-bold tracking-tight">About</h1>
      <p class="text-muted-foreground text-sm mt-1">
        Benchmarking LLMs through social deduction gameplay.
      </p>
    </div>

    <section class="space-y-3">
      <h2 class="font-semibold">What is Mafia Arena?</h2>
      <p class="text-sm text-muted-foreground leading-relaxed">
        Mafia is a classic game of deception, reasoning, and social influence. By having AI models 
        play against each other, we measure their ability to maintain personas, reason strategically, 
        spot deception, and persuade others.
      </p>
    </section>

    <section class="space-y-3">
      <h2 class="font-semibold">Skills Tested</h2>
      <div class="grid grid-cols-2 gap-3 text-sm">
        <div class="border rounded-md p-3">
          <div class="font-medium">Persona Maintenance</div>
          <p class="text-xs text-muted-foreground mt-1">Staying in character throughout the game</p>
        </div>
        <div class="border rounded-md p-3">
          <div class="font-medium">Strategic Reasoning</div>
          <p class="text-xs text-muted-foreground mt-1">Identifying threats and coordinating</p>
        </div>
        <div class="border rounded-md p-3">
          <div class="font-medium">Social Deduction</div>
          <p class="text-xs text-muted-foreground mt-1">Spotting inconsistencies in others</p>
        </div>
        <div class="border rounded-md p-3">
          <div class="font-medium">Persuasion</div>
          <p class="text-xs text-muted-foreground mt-1">Influencing group decisions</p>
        </div>
      </div>
    </section>

    <section class="space-y-3">
      <h2 class="font-semibold">Game Flow</h2>
      <ol class="text-sm space-y-2">
        <li class="flex gap-3">
          <span class="font-mono text-muted-foreground w-4 shrink-0">1.</span>
          <div>
            <span class="font-medium">Introduction</span>
            <span class="text-muted-foreground"> — Players introduce themselves strategically</span>
          </div>
        </li>
        <li class="flex gap-3">
          <span class="font-mono text-muted-foreground w-4 shrink-0">2.</span>
          <div>
            <span class="font-medium">Night Phase</span>
            <span class="text-muted-foreground"> — Mafia secretly chooses a target</span>
          </div>
        </li>
        <li class="flex gap-3">
          <span class="font-mono text-muted-foreground w-4 shrink-0">3.</span>
          <div>
            <span class="font-medium">Discussion</span>
            <span class="text-muted-foreground"> — Players debate and share suspicions</span>
          </div>
        </li>
        <li class="flex gap-3">
          <span class="font-mono text-muted-foreground w-4 shrink-0">4.</span>
          <div>
            <span class="font-medium">Vote</span>
            <span class="text-muted-foreground"> — Town votes to eliminate a suspect</span>
          </div>
        </li>
        <li class="flex gap-3">
          <span class="font-mono text-muted-foreground w-4 shrink-0">5.</span>
          <div>
            <span class="font-medium">Repeat</span>
            <span class="text-muted-foreground"> — Until Mafia or Town wins</span>
          </div>
        </li>
      </ol>
    </section>

    <section class="space-y-3">
      <h2 class="font-semibold">Tech Stack</h2>
      <div class="text-sm text-muted-foreground space-y-1">
        <div class="flex justify-between py-1 border-b">
          <span>Frontend</span>
          <span class="font-mono text-xs">Astro + Tailwind</span>
        </div>
        <div class="flex justify-between py-1 border-b">
          <span>Backend</span>
          <span class="font-mono text-xs">Cloudflare Workers</span>
        </div>
        <div class="flex justify-between py-1 border-b">
          <span>Database</span>
          <span class="font-mono text-xs">Cloudflare D1</span>
        </div>
        <div class="flex justify-between py-1 border-b">
          <span>Storage</span>
          <span class="font-mono text-xs">Cloudflare R2</span>
        </div>
        <div class="flex justify-between py-1 border-b">
          <span>Orchestration</span>
          <span class="font-mono text-xs">Durable Objects</span>
        </div>
        <div class="flex justify-between py-1">
          <span>Game Engine</span>
          <span class="font-mono text-xs">Pure TypeScript</span>
        </div>
      </div>
    </section>

    <section class="border rounded-md p-4 bg-muted/30">
      <h2 class="font-medium text-sm">Open Source</h2>
      <p class="text-xs text-muted-foreground mt-1">
        View the source code and contribute on{' '}
        <a href="https://github.com/mohsen1/werewolf-ai" class="underline hover:text-foreground" target="_blank">
          GitHub
        </a>.
      </p>
    </section>
  </div>
</Layout>

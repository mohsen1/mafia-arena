---
import Layout from '../components/Layout.astro';
import { User, Mail, Shield, Key, LogOut, Plus, Trash2, Check, AlertCircle, Loader2, AlertTriangle } from 'lucide-astro';
import { getApiUrl } from '../lib/utils';

const apiUrl = getApiUrl();

const SUPPORTED_PROVIDERS = [
  { id: 'openai', name: 'OpenAI', placeholder: 'sk-proj-...' },
  { id: 'anthropic', name: 'Anthropic', placeholder: 'sk-ant-...' },
  { id: 'google', name: 'Google AI', placeholder: 'AIza...' },
  { id: 'openrouter', name: 'OpenRouter', placeholder: 'sk-or-...' },
  { id: 'xai', name: 'xAI (Grok)', placeholder: 'xai-...' },
  { id: 'deepseek', name: 'DeepSeek', placeholder: 'sk-...' },
  { id: 'mistral', name: 'Mistral AI', placeholder: '...' },
  { id: 'cohere', name: 'Cohere', placeholder: '...' },
  { id: 'ai21', name: 'AI21 Labs', placeholder: '...' },
  { id: 'together', name: 'Together AI', placeholder: '...' },
  { id: 'groq', name: 'Groq', placeholder: 'gsk_...' },
  { id: 'cerebras', name: 'Cerebras', placeholder: 'csk-...' },
  { id: 'fireworks', name: 'Fireworks', placeholder: 'fw_...' },
  { id: 'minimax', name: 'MiniMax', placeholder: '...' },
];
---

<Layout title="Account">
  <div class="max-w-2xl mx-auto space-y-8">
    <!-- Header -->
    <div class="space-y-2">
      <h1 class="text-2xl font-bold tracking-tight">Account</h1>
      <p class="text-muted-foreground">Manage your profile and API keys</p>
    </div>

    <!-- Loading state -->
    <div id="account-loading" class="flex items-center justify-center py-16">
      <div class="flex flex-col items-center gap-3">
        <div class="w-8 h-8 border-2 border-foreground/20 border-t-foreground rounded-full animate-spin"></div>
        <span class="text-sm text-muted-foreground">Loading account...</span>
      </div>
    </div>

    <!-- Not authenticated state -->
    <div id="account-unauthenticated" class="hidden">
      <div class="text-center py-16 space-y-4">
        <div class="w-16 h-16 mx-auto rounded-full bg-muted flex items-center justify-center">
          <User class="h-8 w-8 text-muted-foreground" />
        </div>
        <div class="space-y-2">
          <h2 class="text-lg font-semibold">Sign in required</h2>
          <p class="text-sm text-muted-foreground">Please sign in to view your account</p>
        </div>
        <a 
          id="signin-link"
          href={`${apiUrl}/api/auth/google?redirect=/account`}
          class="inline-flex items-center gap-2 px-4 py-2 bg-foreground text-background rounded-md text-sm font-medium hover:bg-foreground/90 transition-colors"
        >
          Sign in with Google
        </a>
      </div>
    </div>

    <!-- Authenticated state -->
    <div id="account-authenticated" class="hidden space-y-6">
      <!-- Profile Card -->
      <div class="border rounded-lg p-6 space-y-4">
        <h2 class="text-sm font-medium uppercase tracking-wider text-muted-foreground">Profile</h2>
        
        <div class="flex items-center gap-4">
          <img 
            id="profile-avatar" 
            src="" 
            alt="" 
            class="w-16 h-16 rounded-full bg-muted object-cover"
          />
          <div class="space-y-1">
            <p id="profile-name" class="text-lg font-semibold"></p>
            <p id="profile-email" class="text-sm text-muted-foreground flex items-center gap-1.5">
              <Mail class="h-3.5 w-3.5" />
              <span></span>
            </p>
          </div>
        </div>

        <!-- Admin badge -->
        <div id="admin-badge" class="hidden">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-amber-500/10 border border-amber-500/20 rounded-full text-xs font-medium text-amber-600 dark:text-amber-400">
            <Shield class="h-3 w-3" />
            Administrator (uses system keys)
          </span>
        </div>
        
        <!-- User badge -->
        <div id="user-badge" class="hidden">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-blue-500/10 border border-blue-500/20 rounded-full text-xs font-medium text-blue-600 dark:text-blue-400">
            <Key class="h-3 w-3" />
            Using personal API keys
          </span>
        </div>
      </div>

      <!-- API Keys Section -->
      <div class="border rounded-lg p-6 space-y-4">
        <div class="flex items-center justify-between">
          <h2 class="text-sm font-medium uppercase tracking-wider text-muted-foreground">API Keys</h2>
          <button
            id="add-key-btn"
            class="text-xs px-3 py-1.5 bg-foreground text-background rounded-md hover:bg-foreground/90 transition-colors flex items-center gap-1.5"
          >
            <Plus class="h-3 w-3" />
            Add Key
          </button>
        </div>
        
        <p class="text-sm text-muted-foreground">
          Add your own API keys to run games with your provider access. Keys are encrypted and stored securely.
        </p>

        <!-- Admin notice -->
        <div id="admin-keys-notice" class="hidden p-3 bg-amber-500/10 border border-amber-500/20 rounded-lg">
          <p class="text-sm text-amber-600 dark:text-amber-400 flex items-center gap-2">
            <AlertCircle class="h-4 w-4 shrink-0" />
            As an admin, you can use system API keys. Adding personal keys is optional.
          </p>
        </div>

        <!-- Keys list -->
        <div id="keys-list" class="space-y-2">
          <div class="text-center py-8 text-muted-foreground text-sm">
            Loading keys...
          </div>
        </div>
      </div>

      <!-- Add Key Modal -->
      <div id="add-key-modal" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50">
        <div class="bg-background border rounded-lg p-6 w-full max-w-md mx-4 space-y-4">
          <h3 class="text-lg font-semibold">Add API Key</h3>
          
          <div class="space-y-3">
            <div class="space-y-1.5">
              <label for="provider-select" class="text-sm font-medium">Provider</label>
              <select
                id="provider-select"
                class="w-full px-3 py-2 border rounded-md bg-background focus:outline-none focus:ring-2 focus:ring-primary"
              >
                <option value="">Select a provider...</option>
                {SUPPORTED_PROVIDERS.map(p => (
                  <option value={p.id} data-placeholder={p.placeholder}>{p.name}</option>
                ))}
              </select>
            </div>
            
            <div class="space-y-1.5">
              <label for="api-key-input" class="text-sm font-medium">API Key</label>
              <input
                type="password"
                id="api-key-input"
                placeholder="Enter your API key..."
                class="w-full px-3 py-2 border rounded-md bg-background focus:outline-none focus:ring-2 focus:ring-primary font-mono text-sm"
              />
              <p class="text-xs text-muted-foreground">Your key will be encrypted before storage.</p>
            </div>
          </div>
          
          <div id="add-key-error" class="hidden p-2 bg-red-500/10 border border-red-500/20 rounded text-sm text-red-600 dark:text-red-400"></div>
          
          <div class="flex gap-2 justify-end">
            <button
              id="cancel-add-key"
              class="px-4 py-2 border rounded-md text-sm hover:bg-muted transition-colors"
            >
              Cancel
            </button>
            <button
              id="save-key-btn"
              class="px-4 py-2 bg-foreground text-background rounded-md text-sm hover:bg-foreground/90 transition-colors flex items-center gap-2 disabled:opacity-50"
            >
              <span id="save-key-text">Save Key</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Session -->
      <div class="border rounded-lg p-6 space-y-4">
        <h2 class="text-sm font-medium uppercase tracking-wider text-muted-foreground">Session</h2>
        
        <button 
          id="signout-btn"
          class="flex items-center gap-2 px-4 py-2 text-sm text-red-600 dark:text-red-400 border border-red-500/20 rounded-md hover:bg-red-500/10 transition-colors"
        >
          <LogOut class="h-4 w-4" />
          Sign out
        </button>
      </div>

      <!-- Danger Zone -->
      <div class="border border-red-500/30 rounded-lg p-6 space-y-4 bg-red-500/5">
        <h2 class="text-sm font-medium uppercase tracking-wider text-red-600 dark:text-red-400 flex items-center gap-2">
          <AlertTriangle class="h-4 w-4" />
          Danger Zone
        </h2>
        
        <p class="text-sm text-muted-foreground">
          Permanently delete your account and all associated data. This action cannot be undone.
        </p>
        
        <button 
          id="delete-account-btn"
          class="flex items-center gap-2 px-4 py-2 text-sm text-white bg-red-600 hover:bg-red-700 dark:bg-red-700 dark:hover:bg-red-600 rounded-md transition-colors"
        >
          <Trash2 class="h-4 w-4" />
          Delete Account
        </button>
      </div>

      <!-- Delete Account Modal -->
      <div id="delete-account-modal" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50">
        <div class="bg-background border border-red-500/30 rounded-lg p-6 w-full max-w-md mx-4 space-y-4">
          <div class="flex items-center gap-3 text-red-600 dark:text-red-400">
            <AlertTriangle class="h-6 w-6" />
            <h3 class="text-lg font-semibold">Delete Account</h3>
          </div>
          
          <p class="text-sm text-muted-foreground">
            Are you sure you want to delete your account? This will permanently remove:
          </p>
          
          <ul class="text-sm text-muted-foreground list-disc list-inside space-y-1 ml-2">
            <li>Your user profile</li>
            <li>All saved API keys</li>
            <li>Your session data</li>
          </ul>
          
          <p class="text-sm font-medium text-red-600 dark:text-red-400">
            This action cannot be undone.
          </p>
          
          <div class="space-y-2">
            <label for="confirm-email" class="text-sm font-medium">
              Type your email to confirm: <span id="confirm-email-hint" class="text-muted-foreground font-mono"></span>
            </label>
            <input
              type="email"
              id="confirm-email"
              placeholder="Enter your email..."
              class="w-full px-3 py-2 border border-red-500/30 rounded-md bg-background focus:outline-none focus:ring-2 focus:ring-red-500 text-sm"
            />
          </div>
          
          <div id="delete-error" class="hidden p-2 bg-red-500/10 border border-red-500/20 rounded text-sm text-red-600 dark:text-red-400"></div>
          
          <div class="flex gap-2 justify-end">
            <button
              id="cancel-delete"
              class="px-4 py-2 border rounded-md text-sm hover:bg-muted transition-colors"
            >
              Cancel
            </button>
            <button
              id="confirm-delete-btn"
              disabled
              class="px-4 py-2 bg-red-600 text-white rounded-md text-sm hover:bg-red-700 transition-colors flex items-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed"
            >
              <span id="delete-btn-text">Delete Account</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script define:vars={{ apiUrl, SUPPORTED_PROVIDERS }}>
  let currentUser = null;
  let userKeys = [];

  async function init() {
    const loadingEl = document.getElementById('account-loading');
    const unauthEl = document.getElementById('account-unauthenticated');
    const authEl = document.getElementById('account-authenticated');

    try {
      const res = await fetch(`${apiUrl}/api/auth/me`, { credentials: 'include' });

      if (res.ok) {
        const data = await res.json();
        if (data.authenticated && data.user) {
          currentUser = data.user;
          
          // Populate profile
          const avatar = document.getElementById('profile-avatar');
          const name = document.getElementById('profile-name');
          const emailSpan = document.querySelector('#profile-email span');
          const adminBadge = document.getElementById('admin-badge');
          const userBadge = document.getElementById('user-badge');
          const adminKeysNotice = document.getElementById('admin-keys-notice');

          if (avatar && data.user.picture) {
            avatar.src = data.user.picture;
            avatar.alt = data.user.name;
          }
          if (name) name.textContent = data.user.name;
          if (emailSpan) emailSpan.textContent = data.user.email;
          
          if (data.user.isAdmin) {
            adminBadge?.classList.remove('hidden');
            adminKeysNotice?.classList.remove('hidden');
          } else {
            userBadge?.classList.remove('hidden');
          }

          // Show authenticated state
          loadingEl?.classList.add('hidden');
          authEl?.classList.remove('hidden');

          // Load API keys
          await loadKeys();

          // Setup event handlers
          setupEventHandlers();

          return;
        }
      }
    } catch (e) {
      console.log('Auth check failed:', e);
    }

    // Not authenticated
    loadingEl?.classList.add('hidden');
    unauthEl?.classList.remove('hidden');

    // Update sign-in link for localhost
    const signinLink = document.getElementById('signin-link');
    if (signinLink && window.location.hostname === 'localhost') {
      signinLink.href = `http://localhost:8787/api/auth/google?redirect=/account`;
    }
  }

  async function loadKeys() {
    const keysList = document.getElementById('keys-list');
    if (!keysList) return;

    try {
      const res = await fetch(`${apiUrl}/api/auth/keys`, { credentials: 'include' });
      
      if (!res.ok) {
        if (res.status === 503) {
          keysList.innerHTML = `
            <div class="p-3 bg-amber-500/10 border border-amber-500/20 rounded-lg">
              <p class="text-sm text-amber-600 dark:text-amber-400">
                Key management is not yet configured. Please contact the administrator.
              </p>
            </div>
          `;
          return;
        }
        throw new Error('Failed to load keys');
      }

      const data = await res.json();
      userKeys = data.keys || [];

      if (userKeys.length === 0) {
        keysList.innerHTML = `
          <div class="text-center py-8 text-muted-foreground text-sm border-2 border-dashed rounded-lg">
            <p>No API keys configured yet.</p>
            <p class="mt-1">Add a key to run games with your own provider access.</p>
          </div>
        `;
      } else {
        keysList.innerHTML = userKeys.map(key => `
          <div class="flex items-center justify-between p-3 bg-muted/30 rounded-lg border" data-provider="${key.provider}">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded bg-foreground/10 flex items-center justify-center">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/>
                </svg>
              </div>
              <div>
                <p class="font-medium text-sm">${getProviderName(key.provider)}</p>
                <p class="text-xs text-muted-foreground font-mono">${key.fingerprint}</p>
              </div>
            </div>
            <button
              class="delete-key-btn p-2 text-red-500 hover:bg-red-500/10 rounded transition-colors"
              data-provider="${key.provider}"
              title="Delete key"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M3 6h18M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/>
              </svg>
            </button>
          </div>
        `).join('');

        // Add delete handlers
        document.querySelectorAll('.delete-key-btn').forEach(btn => {
          btn.addEventListener('click', () => deleteKey(btn.getAttribute('data-provider')));
        });
      }
    } catch (e) {
      console.error('Failed to load keys:', e);
      keysList.innerHTML = `
        <div class="text-center py-8 text-red-500 text-sm">
          Failed to load API keys. Please try again.
        </div>
      `;
    }
  }

  function getProviderName(providerId) {
    const provider = SUPPORTED_PROVIDERS.find(p => p.id === providerId);
    return provider ? provider.name : providerId;
  }

  function setupEventHandlers() {
    const addKeyBtn = document.getElementById('add-key-btn');
    const modal = document.getElementById('add-key-modal');
    const cancelBtn = document.getElementById('cancel-add-key');
    const saveBtn = document.getElementById('save-key-btn');
    const providerSelect = document.getElementById('provider-select');
    const apiKeyInput = document.getElementById('api-key-input');
    const errorDiv = document.getElementById('add-key-error');
    const signoutBtn = document.getElementById('signout-btn');

    // Open modal
    addKeyBtn?.addEventListener('click', () => {
      modal?.classList.remove('hidden');
      providerSelect.value = '';
      apiKeyInput.value = '';
      errorDiv?.classList.add('hidden');
    });

    // Close modal
    cancelBtn?.addEventListener('click', () => {
      modal?.classList.add('hidden');
    });

    // Close modal on backdrop click
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) {
        modal.classList.add('hidden');
      }
    });

    // Update placeholder when provider changes
    providerSelect?.addEventListener('change', () => {
      const selected = providerSelect.options[providerSelect.selectedIndex];
      const placeholder = selected?.getAttribute('data-placeholder') || 'Enter your API key...';
      apiKeyInput.placeholder = placeholder;
    });

    // Save key
    saveBtn?.addEventListener('click', async () => {
      const provider = providerSelect?.value;
      const apiKey = apiKeyInput?.value?.trim();

      if (!provider) {
        showError('Please select a provider');
        return;
      }

      if (!apiKey || apiKey.length < 10) {
        showError('Please enter a valid API key');
        return;
      }

      saveBtn.disabled = true;
      document.getElementById('save-key-text').textContent = 'Saving...';

      try {
        const res = await fetch(`${apiUrl}/api/auth/keys`, {
          method: 'POST',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ provider, apiKey }),
        });

        if (!res.ok) {
          const data = await res.json();
          throw new Error(data.error?.message || 'Failed to save key');
        }

        modal?.classList.add('hidden');
        await loadKeys();
      } catch (e) {
        showError(e.message);
      } finally {
        saveBtn.disabled = false;
        document.getElementById('save-key-text').textContent = 'Save Key';
      }
    });

    // Sign out
    signoutBtn?.addEventListener('click', async () => {
      try {
        await fetch(`${apiUrl}/api/auth/logout`, { 
          method: 'POST', 
          credentials: 'include' 
        });
      } catch (e) {}
      
      localStorage.removeItem('adminUnlocked');
      window.location.href = '/';
    });

    function showError(message) {
      if (errorDiv) {
        errorDiv.textContent = message;
        errorDiv.classList.remove('hidden');
      }
    }

    // Delete account handlers
    const deleteAccountBtn = document.getElementById('delete-account-btn');
    const deleteModal = document.getElementById('delete-account-modal');
    const cancelDeleteBtn = document.getElementById('cancel-delete');
    const confirmDeleteBtn = document.getElementById('confirm-delete-btn');
    const confirmEmailInput = document.getElementById('confirm-email');
    const confirmEmailHint = document.getElementById('confirm-email-hint');
    const deleteError = document.getElementById('delete-error');
    const deleteBtnText = document.getElementById('delete-btn-text');

    // Set the email hint
    if (confirmEmailHint && currentUser?.email) {
      confirmEmailHint.textContent = currentUser.email;
    }

    // Open delete modal
    deleteAccountBtn?.addEventListener('click', () => {
      deleteModal?.classList.remove('hidden');
      confirmEmailInput.value = '';
      confirmDeleteBtn.disabled = true;
      deleteError?.classList.add('hidden');
    });

    // Close delete modal
    cancelDeleteBtn?.addEventListener('click', () => {
      deleteModal?.classList.add('hidden');
    });

    // Close modal on backdrop click
    deleteModal?.addEventListener('click', (e) => {
      if (e.target === deleteModal) {
        deleteModal.classList.add('hidden');
      }
    });

    // Enable delete button when email matches
    confirmEmailInput?.addEventListener('input', () => {
      const matches = confirmEmailInput.value.toLowerCase() === currentUser?.email?.toLowerCase();
      confirmDeleteBtn.disabled = !matches;
    });

    // Handle delete account
    confirmDeleteBtn?.addEventListener('click', async () => {
      if (confirmDeleteBtn.disabled) return;
      
      confirmDeleteBtn.disabled = true;
      deleteBtnText.textContent = 'Deleting...';
      deleteError?.classList.add('hidden');

      try {
        const res = await fetch(`${apiUrl}/api/auth/account`, {
          method: 'DELETE',
          credentials: 'include',
        });

        if (!res.ok) {
          const data = await res.json();
          throw new Error(data.error || 'Failed to delete account');
        }

        // Success - clear local storage and redirect
        localStorage.removeItem('adminUnlocked');
        window.location.href = '/?deleted=true';
      } catch (e) {
        if (deleteError) {
          deleteError.textContent = e.message;
          deleteError.classList.remove('hidden');
        }
        confirmDeleteBtn.disabled = false;
        deleteBtnText.textContent = 'Delete Account';
      }
    });
  }

  async function deleteKey(provider) {
    if (!confirm(`Are you sure you want to delete your ${getProviderName(provider)} API key?`)) {
      return;
    }

    try {
      const res = await fetch(`${apiUrl}/api/auth/keys/${provider}`, {
        method: 'DELETE',
        credentials: 'include',
      });

      if (!res.ok) {
        throw new Error('Failed to delete key');
      }

      await loadKeys();
    } catch (e) {
      alert('Failed to delete API key. Please try again.');
    }
  }

  init();
</script>

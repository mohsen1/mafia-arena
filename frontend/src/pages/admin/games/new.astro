---
import Layout from '../../../components/Layout.astro';
import { getModels } from '../../../lib/api';
import { ArrowLeft, Play, Radio, Users, Shield, Sword } from 'lucide-astro';

let models = [];
let error = null;

try {
  models = await getModels();
} catch (e) {
  error = e instanceof Error ? e.message : 'Failed to load models';
}

const modelsByProvider = models.reduce((acc, m) => {
  if (!acc[m.provider]) acc[m.provider] = [];
  acc[m.provider].push(m);
  return acc;
}, {} as Record<string, typeof models>);

const apiUrl = import.meta.env.PUBLIC_API_URL || 'https://mafia-arena.me-f9a.workers.dev';
---

<Layout title="Run Live Game">
  <div class="max-w-2xl mx-auto space-y-6">
    <div class="flex items-center gap-2 text-sm text-muted-foreground mb-1">
      <a href="/admin" class="hover:underline inline-flex items-center gap-1">
        <ArrowLeft size={14} /> Admin
      </a>
      <span>/</span>
      <span>Run Live Game</span>
    </div>

    <div class="flex items-start gap-4">
      <div class="p-3 bg-gradient-to-br from-red-500/20 to-orange-500/20 rounded-xl border border-red-500/20">
        <Radio size={24} class="text-red-500" />
      </div>
      <div>
        <h1 class="text-2xl font-bold tracking-tight">Run Live Game</h1>
        <p class="text-sm text-muted-foreground mt-1">
          Configure and launch a single game with real-time updates
        </p>
      </div>
    </div>

    {error && (
      <div class="border border-destructive/50 bg-destructive/10 rounded-lg p-4">
        <p class="text-destructive">{error}</p>
      </div>
    )}

    <form id="liveGameForm" class="space-y-6">
      <section class="border rounded-lg p-4 space-y-4 bg-muted/30">
        <div class="flex items-center gap-2 text-sm font-medium">
          <Users size={16} class="text-muted-foreground" />
          Team Configuration
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div class="space-y-2">
            <label for="playerCount" class="text-sm text-muted-foreground">Total Players</label>
            <select 
              id="playerCount" 
              name="playerCount"
              class="w-full px-3 py-2 border rounded-md bg-background focus:outline-none focus:ring-2 focus:ring-primary"
            >
              {[5, 6, 7, 8, 9, 10, 11, 12].map(n => (
                <option value={n} selected={n === 11}>{n} players</option>
              ))}
            </select>
          </div>
          <div class="space-y-2">
            <label for="mafiaCount" class="text-sm text-muted-foreground">Mafia Count</label>
            <select 
              id="mafiaCount" 
              name="mafiaCount"
              class="w-full px-3 py-2 border rounded-md bg-background focus:outline-none focus:ring-2 focus:ring-primary"
            >
              {[1, 2, 3].map(n => (
                <option value={n} selected={n === 2}>{n} mafia</option>
              ))}
            </select>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div class="space-y-2">
            <label for="modelA" class="text-sm text-muted-foreground flex items-center gap-1.5">
              <Sword size={14} class="text-red-500" />
              Mafia Model
            </label>
            <select 
              id="modelA" 
              name="modelA"
              class="w-full px-3 py-2 border rounded-md bg-background focus:outline-none focus:ring-2 focus:ring-primary"
            >
              {Object.entries(modelsByProvider).map(([provider, providerModels]) => (
                <optgroup label={provider}>
                  {providerModels.map(m => (
                    <option value={m.id}>{m.display_name}</option>
                  ))}
                </optgroup>
              ))}
            </select>
          </div>
          <div class="space-y-2">
            <label for="modelB" class="text-sm text-muted-foreground flex items-center gap-1.5">
              <Shield size={14} class="text-blue-500" />
              Town Model
            </label>
            <select 
              id="modelB" 
              name="modelB"
              class="w-full px-3 py-2 border rounded-md bg-background focus:outline-none focus:ring-2 focus:ring-primary"
            >
              {Object.entries(modelsByProvider).map(([provider, providerModels]) => (
                <optgroup label={provider}>
                  {providerModels.map(m => (
                    <option value={m.id}>{m.display_name}</option>
                  ))}
                </optgroup>
              ))}
            </select>
          </div>
        </div>
      </section>


      <div id="launch-status" class="hidden border rounded-lg p-4 bg-muted/30">
        <div class="flex items-center gap-3">
          <div class="animate-spin h-5 w-5 border-2 border-primary border-t-transparent rounded-full"></div>
          <span id="launch-status-text" class="text-sm">Starting game...</span>
        </div>
      </div>

      <div class="flex gap-3">
        <button 
          type="submit"
          class="flex-1 px-4 py-3 bg-gradient-to-r from-red-500 to-orange-500 text-white rounded-lg font-medium hover:from-red-600 hover:to-orange-600 transition-all shadow-lg hover:shadow-xl flex items-center justify-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed"
        >
          <Play size={18} />
          Launch & Watch Live
        </button>
        <a 
          href="/admin"
          class="px-4 py-3 border rounded-lg hover:bg-muted transition-colors flex items-center"
        >
          Cancel
        </a>
      </div>
    </form>
  </div>
</Layout>

<script define:vars={{ apiUrl, modelsByProvider }}>
  const credentials = sessionStorage.getItem('adminCredentials');
  if (!credentials) {
    window.location.href = '/admin/login?redirect=/admin/games/new';
  }

  const headers = credentials ? { 
    'Authorization': `Basic ${credentials}`,
    'Content-Type': 'application/json'
  } : { 'Content-Type': 'application/json' };

  const form = document.getElementById('liveGameForm');

  const providers = Object.keys(modelsByProvider);
  if (providers.length > 0) {
    const shuffled = providers.sort(() => Math.random() - 0.5);
    const modelA = document.getElementById('modelA');
    const modelB = document.getElementById('modelB');
    
    const mafiaProvider = shuffled[0];
    const mafiaModels = modelsByProvider[mafiaProvider];
    if (mafiaModels && mafiaModels.length > 0 && modelA) {
      const randomMafia = mafiaModels[Math.floor(Math.random() * mafiaModels.length)];
      modelA.value = randomMafia.id;
    }
    
    const townProvider = shuffled.length > 1 ? shuffled[1] : shuffled[0];
    const townModels = modelsByProvider[townProvider];
    if (townModels && townModels.length > 0 && modelB) {
      const randomTown = townModels[Math.floor(Math.random() * townModels.length)];
      modelB.value = randomTown.id;
    }
  }

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const submitBtn = form.querySelector('button[type="submit"]');
      const statusDiv = document.getElementById('launch-status');
      const statusText = document.getElementById('launch-status-text');
      
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerHTML = `
          <svg class="animate-spin h-5 w-5" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
          </svg>
          Starting Game...
        `;
      }
      
      if (statusDiv) {
        statusDiv.classList.remove('hidden');
      }
      if (statusText) {
        statusText.textContent = 'Initializing game...';
      }

      try {
        const formData = new FormData(form);
        const playerCount = parseInt(String(formData.get('playerCount') || '11'));
        const mafiaCount = parseInt(String(formData.get('mafiaCount') || '2'));
        const modelA = String(formData.get('modelA') || '');
        const modelB = String(formData.get('modelB') || '');

        if (statusText) {
          statusText.textContent = 'Contacting server...';
        }

        const res = await fetch(`${apiUrl}/api/admin/games/run-live`, {
          method: 'POST',
          headers,
          body: JSON.stringify({
            config: {
              playerCount,
              mafiaCount,
              teams: [
                { modelId: modelA, team: 'mafia', count: mafiaCount },
                { modelId: modelB, team: 'town', count: playerCount - mafiaCount },
              ],
              maxRounds: 10,
              discussionEnabled: true,
              contextLevel: 'full',
              personaConstraints: 'moderate',
            },
          }),
        });

        if (res.status === 401) {
          sessionStorage.removeItem('adminCredentials');
          window.location.href = '/admin/login?redirect=/admin/games/new';
          return;
        }

        if (!res.ok) {
          const err = await res.json();
          throw new Error(err.message || 'Failed to start game');
        }

        const result = await res.json();
        
        if (statusText) {
          statusText.textContent = `Game started! Redirecting to live view...`;
        }

        setTimeout(() => {
          window.location.href = `/games/${result.gameId}/live`;
        }, 500);

      } catch (err) {
        alert(err instanceof Error ? err.message : 'Failed to start game');
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerHTML = `
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="5 3 19 12 5 21 5 3"></polygon>
            </svg>
            Launch & Watch Live
          `;
        }
        if (statusDiv) {
          statusDiv.classList.add('hidden');
        }
      }
    });
  }
</script>


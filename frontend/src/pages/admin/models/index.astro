---
import Layout from '../../../components/Layout.astro';
import { RefreshCw, Database, Cloud, Check, ChevronDown } from 'lucide-astro';

const apiUrl = import.meta.env.PUBLIC_API_URL || 'https://api.mafia-arena.com';
---

<Layout title="Models">
  <div class="max-w-4xl mx-auto space-y-6">
    <!-- Header -->
    <div class="flex items-start justify-between">
      <div>
        <div class="flex items-center gap-2 text-xs text-muted-foreground font-mono mb-2">
          <a href="/admin" class="hover:text-foreground transition-colors">admin</a>
          <span>/</span>
          <span>models</span>
        </div>
        <h1 class="text-2xl font-bold tracking-tight">Model Registry</h1>
        <p class="text-sm text-muted-foreground mt-1">
          Manage AI models synced from OpenRouter
        </p>
      </div>
      
      <button 
        id="syncBtn"
        class="px-4 py-2 bg-foreground text-background rounded-md text-sm font-medium hover:opacity-90 transition-opacity flex items-center gap-2 disabled:opacity-50"
      >
        <RefreshCw size={14} id="syncIcon" />
        Sync Models
      </button>
    </div>

    <!-- Sync Status -->
    <div id="syncStatus" class="hidden border rounded-lg p-4 bg-muted/30">
      <div class="flex items-center gap-3">
        <div id="syncSpinner" class="w-4 h-4 border-2 border-foreground/20 border-t-foreground rounded-full animate-spin"></div>
        <span id="syncStatusText" class="text-sm">Syncing models from OpenRouter...</span>
      </div>
    </div>

    <!-- Sync Results -->
    <div id="syncResults" class="hidden border border-emerald-500/30 bg-emerald-500/5 rounded-lg p-4">
      <div class="flex items-start gap-3">
        <Check size={18} class="text-emerald-500 shrink-0 mt-0.5" />
        <div>
          <p class="font-medium text-emerald-600 dark:text-emerald-400 text-sm">Sync Complete</p>
          <p id="syncResultsText" class="text-sm text-muted-foreground mt-0.5"></p>
        </div>
      </div>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="space-y-1">
        <div class="flex items-center gap-2 text-xs uppercase tracking-wider text-muted-foreground font-medium">
          <Database size={12} />
          DB Models
        </div>
        <div id="dbModelCount" class="text-3xl font-bold tabular-nums tracking-tight">—</div>
      </div>
      <div class="space-y-1">
        <div class="flex items-center gap-2 text-xs uppercase tracking-wider text-muted-foreground font-medium">
          <Cloud size={12} />
          OpenRouter
        </div>
        <div id="orModelCount" class="text-3xl font-bold tabular-nums tracking-tight">—</div>
      </div>
      <div class="space-y-1">
        <div class="text-xs uppercase tracking-wider text-muted-foreground font-medium">
          Providers
        </div>
        <div id="providerCount" class="text-3xl font-bold tabular-nums tracking-tight">—</div>
      </div>
      <div class="space-y-1">
        <div class="text-xs uppercase tracking-wider text-muted-foreground font-medium">
          Last Sync
        </div>
        <div id="lastSync" class="text-sm font-medium text-muted-foreground">Never</div>
      </div>
    </div>

    <!-- Models by Provider -->
    <section class="space-y-3">
      <h2 class="text-sm font-medium uppercase tracking-wider text-muted-foreground">Available Models</h2>
      <div class="border rounded-lg overflow-hidden">
        <div id="modelsList" class="divide-y divide-border/50">
          <div class="p-12 text-center">
            <div class="flex flex-col items-center gap-3">
              <div class="w-5 h-5 border-2 border-muted-foreground/30 border-t-muted-foreground rounded-full animate-spin"></div>
              <span class="text-sm text-muted-foreground">Loading models...</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- DB Models Table -->
    <section class="space-y-3">
      <h2 class="text-sm font-medium uppercase tracking-wider text-muted-foreground">Database Registry</h2>
      <div class="border rounded-lg overflow-hidden">
        <table class="w-full text-sm">
          <thead class="border-b bg-muted/30">
            <tr>
              <th class="text-left py-3 px-4 font-medium text-muted-foreground text-xs uppercase tracking-wider">Model ID</th>
              <th class="text-left py-3 px-4 font-medium text-muted-foreground text-xs uppercase tracking-wider">Display Name</th>
              <th class="text-left py-3 px-4 font-medium text-muted-foreground text-xs uppercase tracking-wider">Provider</th>
              <th class="text-left py-3 px-4 font-medium text-muted-foreground text-xs uppercase tracking-wider">Added</th>
            </tr>
          </thead>
          <tbody id="dbModelsTable" class="divide-y divide-border/50">
            <tr>
              <td colspan="4" class="py-12 text-center text-muted-foreground">Loading...</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>
  </div>
</Layout>

<style>
  details summary::-webkit-details-marker {
    display: none;
  }
  
  details summary {
    list-style: none;
  }
  
  tbody tr {
    transition: background-color 0.15s;
  }
  tbody tr:hover {
    background-color: color-mix(in srgb, var(--muted) 30%, transparent);
  }
</style>

<script define:vars={{ apiUrl }}>
  const credentials = sessionStorage.getItem('adminCredentials');
  if (!credentials) {
    window.location.href = '/admin/login?redirect=/admin/models';
  }

  const headers = credentials ? { 
    'Authorization': `Basic ${credentials}`,
    'Content-Type': 'application/json'
  } : { 'Content-Type': 'application/json' };

  async function loadOpenRouterModels() {
    try {
      const res = await fetch(`${apiUrl}/api/models/openrouter`);
      if (!res.ok) throw new Error('Failed to fetch');
      
      const data = await res.json();
      
      document.getElementById('orModelCount').textContent = data.totalModels.toString();
      document.getElementById('providerCount').textContent = data.providers.length.toString();
      
      if (data.cachedAt) {
        const date = new Date(data.cachedAt);
        document.getElementById('lastSync').textContent = date.toLocaleString();
      }
      
      const listEl = document.getElementById('modelsList');
      listEl.innerHTML = data.providers.map(provider => {
        const models = data.modelsByProvider[provider] || [];
        return `
          <details class="group">
            <summary class="px-4 py-3 cursor-pointer hover:bg-muted/30 flex items-center justify-between transition-colors">
              <div class="flex items-center gap-3">
                <span class="text-sm font-medium">${provider}</span>
                <span class="text-xs text-muted-foreground">${models.length} models</span>
              </div>
              <svg class="w-4 h-4 text-muted-foreground transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="px-4 pb-3 bg-muted/20">
              <div class="space-y-0.5">
                ${models.map(m => `
                  <div class="flex items-center justify-between py-2 text-sm border-b border-border/30 last:border-0">
                    <span class="font-mono text-xs text-muted-foreground truncate mr-4">${m.id}</span>
                    <div class="flex items-center gap-4 shrink-0 text-muted-foreground">
                      <span class="text-xs">${m.name}</span>
                      <span class="text-xs tabular-nums">${formatContext(m.contextLength)}</span>
                      <span class="font-mono text-xs tabular-nums">${formatPrice(m.pricing.inputPer1M)}</span>
                    </div>
                  </div>
                `).join('')}
              </div>
            </div>
          </details>
        `;
      }).join('');
      
    } catch (err) {
      console.error('Failed to load OpenRouter models:', err);
      document.getElementById('modelsList').innerHTML = `
        <div class="p-12 text-center text-red-600 dark:text-red-400">
          <p>Failed to load models from OpenRouter</p>
        </div>
      `;
    }
  }

  async function loadDbModels() {
    try {
      const res = await fetch(`${apiUrl}/api/admin/models`, { headers });
      if (!res.ok) throw new Error('Failed to fetch');
      
      const data = await res.json();
      
      document.getElementById('dbModelCount').textContent = data.total.toString();
      
      const tableEl = document.getElementById('dbModelsTable');
      if (data.models.length === 0) {
        tableEl.innerHTML = `
          <tr>
            <td colspan="4" class="py-12 text-center text-muted-foreground">
              No models in database. Click "Sync Models" to import.
            </td>
          </tr>
        `;
        return;
      }
      
      tableEl.innerHTML = data.models.map(m => {
        const date = new Date(m.created_at * 1000);
        return `
          <tr>
            <td class="py-3 px-4 font-mono text-xs text-muted-foreground">${m.id}</td>
            <td class="py-3 px-4">${m.display_name}</td>
            <td class="py-3 px-4">
              <span class="text-xs font-medium text-muted-foreground">${m.provider}</span>
            </td>
            <td class="py-3 px-4 text-muted-foreground tabular-nums">${date.toLocaleDateString()}</td>
          </tr>
        `;
      }).join('');
      
    } catch (err) {
      console.error('Failed to load DB models:', err);
    }
  }

  function formatContext(length) {
    if (length >= 1000000) return `${(length / 1000000).toFixed(0)}M ctx`;
    if (length >= 1000) return `${(length / 1000).toFixed(0)}K ctx`;
    return `${length} ctx`;
  }

  function formatPrice(price) {
    if (price === 0) return 'Free';
    if (price < 0.01) return `$${(price * 1000).toFixed(2)}/B`;
    if (price < 1) return `$${price.toFixed(2)}/M`;
    return `$${price.toFixed(0)}/M`;
  }

  const syncBtn = document.getElementById('syncBtn');
  const syncStatus = document.getElementById('syncStatus');
  const syncResults = document.getElementById('syncResults');
  const syncResultsText = document.getElementById('syncResultsText');
  const syncIcon = document.getElementById('syncIcon');

  syncBtn.addEventListener('click', async () => {
    syncBtn.disabled = true;
    syncIcon.classList.add('animate-spin');
    syncStatus.classList.remove('hidden');
    syncResults.classList.add('hidden');

    try {
      const res = await fetch(`${apiUrl}/api/admin/models/sync`, {
        method: 'POST',
        headers,
      });

      if (!res.ok) throw new Error('Sync failed');

      const result = await res.json();
      
      syncStatus.classList.add('hidden');
      syncResults.classList.remove('hidden');
      syncResultsText.textContent = `Added ${result.added}, updated ${result.updated}. Total: ${result.total} models.`;
      
      await loadOpenRouterModels();
      await loadDbModels();
      
    } catch (err) {
      console.error('Sync failed:', err);
      alert('Failed to sync models');
    } finally {
      syncBtn.disabled = false;
      syncIcon.classList.remove('animate-spin');
    }
  });

  loadOpenRouterModels();
  loadDbModels();
</script>

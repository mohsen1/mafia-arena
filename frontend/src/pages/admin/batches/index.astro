---
import Layout from '../../../components/Layout.astro';
import { Plus, ChevronLeft, ChevronRight } from 'lucide-astro';

const url = Astro.url;
const status = url.searchParams.get('status') || '';
const page = parseInt(url.searchParams.get('page') || '1');
const limit = 20;
const offset = (page - 1) * limit;

const statuses = ['', 'queued', 'processing', 'completed', 'cancelled', 'paused'];
const apiUrl = import.meta.env.PUBLIC_API_URL || 'https://api.mafia-arena.com';
---

<Layout title="Batches">
  <div class="space-y-6">
    <!-- Header -->
    <div class="flex items-center justify-between">
      <div>
        <div class="flex items-center gap-2 text-xs text-muted-foreground font-mono mb-2">
          <a href="/admin" class="hover:text-foreground transition-colors">admin</a>
          <span>/</span>
          <span>batches</span>
        </div>
        <h1 class="text-2xl font-bold tracking-tight">Batch Operations</h1>
      </div>
      <a 
        href="/admin/batches/new" 
        class="inline-flex items-center gap-2 px-4 py-2 rounded-md text-sm font-medium hover:bg-muted transition-colors"
      >
        <Plus size={14} class="text-muted-foreground" />
        New Batch
      </a>
    </div>

    <!-- Filters -->
    <div class="flex items-center gap-3 pb-4 border-b">
      <span class="text-xs uppercase tracking-wider text-muted-foreground font-medium">Filter</span>
      <div class="flex gap-1">
        {statuses.map(s => (
          <a 
            href={`/admin/batches${s ? `?status=${s}` : ''}`}
            class:list={[
              "px-3 py-1.5 text-sm rounded transition-colors",
              (status === s || (!status && !s)) 
                ? "bg-foreground text-background font-medium" 
                : "text-muted-foreground hover:text-foreground hover:bg-muted"
            ]}
          >
            {s || 'all'}
          </a>
        ))}
      </div>
    </div>

    <!-- Loading -->
    <div id="loading" class="flex items-center justify-center py-16">
      <div class="flex flex-col items-center gap-3">
        <div class="w-6 h-6 border-2 border-foreground/20 border-t-foreground rounded-full animate-spin"></div>
        <span class="text-sm text-muted-foreground font-mono">Loading...</span>
      </div>
    </div>

    <!-- Error -->
    <div id="error" class="hidden border border-red-500/30 bg-red-500/5 rounded-lg p-4">
      <p id="error-text" class="text-red-600 dark:text-red-400"></p>
    </div>

    <!-- Content -->
    <div id="content" class="hidden space-y-4">
      <!-- Table -->
      <div class="border rounded-lg overflow-hidden">
        <table class="w-full text-sm">
          <thead class="border-b bg-muted/30">
            <tr>
              <th class="text-left py-3 px-4 font-medium text-muted-foreground text-xs uppercase tracking-wider">Batch</th>
              <th class="text-left py-3 px-4 font-medium text-muted-foreground text-xs uppercase tracking-wider">Status</th>
              <th class="text-right py-3 px-4 font-medium text-muted-foreground text-xs uppercase tracking-wider">Progress</th>
              <th class="text-right py-3 px-4 font-medium text-muted-foreground text-xs uppercase tracking-wider">Cost</th>
              <th class="text-right py-3 px-4 font-medium text-muted-foreground text-xs uppercase tracking-wider">Created</th>
              <th class="text-right py-3 px-4 font-medium text-muted-foreground text-xs uppercase tracking-wider">Duration</th>
            </tr>
          </thead>
          <tbody id="tbody" class="divide-y divide-border/50"></tbody>
        </table>
      </div>

      <!-- Pagination -->
      <div id="pagination" class="hidden flex items-center justify-between">
        <p id="pagination-info" class="text-sm text-muted-foreground"></p>
        <div class="flex items-center gap-1">
          <a id="prev-link" href="#" class="p-2 rounded transition-colors hover:bg-muted text-muted-foreground hover:text-foreground">
            <ChevronLeft size={16} />
          </a>
          <span id="page-info" class="px-3 text-sm tabular-nums text-muted-foreground"></span>
          <a id="next-link" href="#" class="p-2 rounded transition-colors hover:bg-muted text-muted-foreground hover:text-foreground">
            <ChevronRight size={16} />
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script define:vars={{ status, page, limit, offset, apiUrl }}>
  const STATUS_COLORS = {
    queued: { text: 'color: rgb(217 119 6)', darkText: 'color: rgb(251 191 36)' },
    processing: { text: 'color: rgb(37 99 235)', darkText: 'color: rgb(96 165 250)' },
    completed: { text: 'color: rgb(5 150 105)', darkText: 'color: rgb(52 211 153)' },
    cancelled: { text: 'color: var(--muted-foreground)', darkText: 'color: var(--muted-foreground)' },
    paused: { text: 'color: rgb(217 119 6)', darkText: 'color: rgb(251 191 36)' },
  };

  function escapeHtml(val) {
    if (val === null || val === undefined) return '';
    const str = typeof val === 'string' ? val : String(val);
    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/`/g, '&#96;');
  }

  function getStatusStyle(status) {
    const isDark = document.documentElement.classList.contains('dark');
    const colors = STATUS_COLORS[status] || STATUS_COLORS.cancelled;
    return isDark ? colors.darkText : colors.text;
  }

  async function init() {
    const credentials = sessionStorage.getItem('adminCredentials');
    if (!credentials) {
      window.location.href = `/admin/login?redirect=${encodeURIComponent(window.location.pathname + window.location.search)}`;
      return;
    }

    const headers = { 'Authorization': `Basic ${credentials}` };

    try {
      const params = new URLSearchParams();
      if (status) params.set('status', status);
      params.set('limit', String(limit));
      params.set('offset', String(offset));

      const res = await fetch(`${apiUrl}/api/admin/batches?${params}`, { headers });

      if (res.status === 401) {
        sessionStorage.removeItem('adminCredentials');
        window.location.href = '/admin/login?redirect=' + encodeURIComponent(window.location.pathname);
        return;
      }

      if (!res.ok) throw new Error('Failed to load batches');

      const data = await res.json();

      document.getElementById('loading').classList.add('hidden');
      document.getElementById('content').classList.remove('hidden');

      const tbody = document.getElementById('tbody');
      if (data.batches.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="6" class="py-12 text-center">
              <div class="flex flex-col items-center gap-2">
                <span class="text-muted-foreground">No batches found</span>
                <a href="/admin/batches/new" class="text-sm text-foreground hover:underline">Create a batch →</a>
              </div>
            </td>
          </tr>`;
      } else {
        tbody.innerHTML = data.batches.map(batch => {
          const duration = batch.completedAt && batch.startedAt 
            ? batch.completedAt - batch.startedAt 
            : batch.startedAt 
              ? Math.floor(Date.now() / 1000) - batch.startedAt
              : null;
          
          const durationStr = duration !== null 
            ? (duration < 60 ? `${duration}s` : `${Math.floor(duration / 60)}m ${duration % 60}s`)
            : '<span class="text-muted-foreground">—</span>';

          return `
            <tr class="hover:bg-muted/30 transition-colors">
              <td class="py-3 px-4">
                <a href="/admin/batches/${escapeHtml(batch.id)}" class="hover:underline">
                  <div class="font-medium">${escapeHtml(batch.name || batch.id)}</div>
                  <div class="text-xs text-muted-foreground font-mono">${escapeHtml(batch.id)}</div>
                </a>
              </td>
              <td class="py-3 px-4">
                <span class="text-xs font-medium uppercase tracking-wide" style="${getStatusStyle(batch.status)}">${batch.status}</span>
              </td>
              <td class="py-3 px-4 text-right">
                <div class="flex items-center justify-end gap-3">
                  <span class="tabular-nums text-muted-foreground">
                    ${batch.completedGames}/${batch.totalGames}
                    ${batch.failedGames > 0 ? `<span class="text-red-500"> (${batch.failedGames})</span>` : ''}
                  </span>
                  <div class="w-20 h-1 rounded-full overflow-hidden bg-muted">
                    <div class="h-full bg-foreground/60 transition-all" style="width: ${batch.progress}%"></div>
                  </div>
                </div>
              </td>
              <td class="py-3 px-4 text-right tabular-nums text-muted-foreground">
                <div>$${batch.actualCostUsd.toFixed(4)}</div>
                ${batch.estimatedCostUsd ? `<div class="text-xs opacity-60">/ $${batch.estimatedCostUsd.toFixed(2)}</div>` : ''}
              </td>
              <td class="py-3 px-4 text-right text-muted-foreground tabular-nums">${new Date(batch.createdAt * 1000).toLocaleString()}</td>
              <td class="py-3 px-4 text-right tabular-nums text-muted-foreground">${durationStr}</td>
            </tr>
          `;
        }).join('');
      }

      // Pagination
      const totalPages = Math.ceil(data.total / limit);
      if (totalPages > 1) {
        document.getElementById('pagination').classList.remove('hidden');
        document.getElementById('pagination-info').textContent = `${offset + 1}–${Math.min(offset + limit, data.total)} of ${data.total}`;
        document.getElementById('page-info').textContent = `${page} / ${totalPages}`;

        const prevLink = document.getElementById('prev-link');
        const nextLink = document.getElementById('next-link');
        
        if (page <= 1) {
          prevLink.classList.add('pointer-events-none', 'opacity-30');
        } else {
          prevLink.href = `/admin/batches?page=${page - 1}${status ? `&status=${status}` : ''}`;
        }

        if (page >= totalPages) {
          nextLink.classList.add('pointer-events-none', 'opacity-30');
        } else {
          nextLink.href = `/admin/batches?page=${page + 1}${status ? `&status=${status}` : ''}`;
        }
      }
    } catch (err) {
      document.getElementById('loading').classList.add('hidden');
      document.getElementById('error').classList.remove('hidden');
      document.getElementById('error-text').textContent = err.message;
    }
  }

  init();
</script>

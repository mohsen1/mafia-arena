---
import Layout from '../../../components/Layout.astro';
import { AlertTriangle, RotateCcw } from 'lucide-astro';

const { id } = Astro.params;
const apiUrl = import.meta.env.PUBLIC_API_URL || 'https://mafia-arena.me-f9a.workers.dev';
---

<Layout title="Batch Details">
  <div id="batch-container" class="min-h-[70vh]" data-batch-id={id} data-api-url={apiUrl}>
    <!-- Header with breadcrumb -->
    <div class="flex items-center gap-2 text-xs font-mono text-muted-foreground mb-6">
      <a href="/admin" class="hover:text-foreground transition-colors">admin</a>
      <span>/</span>
      <a href="/admin/batches" class="hover:text-foreground transition-colors">batches</a>
      <span>/</span>
      <span class="text-foreground">{id}</span>
    </div>

    <!-- Loading State -->
    <div id="loading" class="flex flex-col items-center justify-center py-24 gap-4">
      <div class="w-8 h-8 border-2 border-foreground/20 border-t-foreground rounded-full animate-spin"></div>
      <span class="text-sm text-muted-foreground font-mono">Loading...</span>
    </div>

    <!-- Error State -->
    <div id="error" class="hidden">
      <div class="max-w-lg mx-auto space-y-6">
        <div class="border border-red-500/30 bg-red-500/5 rounded-lg p-6">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-full bg-red-500/10 flex items-center justify-center shrink-0">
              <AlertTriangle class="w-5 h-5 text-red-500" />
            </div>
            <div>
              <p id="error-title" class="font-semibold">Error</p>
              <p id="error-text" class="text-sm text-muted-foreground mt-1"></p>
            </div>
          </div>
        </div>
        
        <details class="text-xs font-mono">
          <summary class="text-muted-foreground cursor-pointer hover:text-foreground transition-colors">Debug info</summary>
          <div class="mt-4 space-y-3 p-4 bg-muted/30 rounded-lg">
            <div class="space-y-1">
              <span class="text-muted-foreground">Timestamp</span>
              <div id="debug-timestamp" class="p-2 bg-background rounded border"></div>
            </div>
            <div class="space-y-1">
              <span class="text-muted-foreground">Request URL</span>
              <div id="debug-url" class="p-2 bg-background rounded border break-all"></div>
            </div>
            <div class="space-y-1">
              <span class="text-muted-foreground">Response</span>
              <div id="debug-status" class="p-2 bg-background rounded border"></div>
            </div>
            <div class="space-y-1">
              <span class="text-muted-foreground">Body</span>
              <pre id="debug-body" class="p-2 bg-background rounded border overflow-x-auto max-h-48 whitespace-pre-wrap"></pre>
            </div>
          </div>
        </details>

        <div class="flex items-center gap-3">
          <a href="/admin/batches" class="inline-flex items-center gap-2 px-4 py-2 text-sm border rounded-md hover:bg-muted transition-colors">
            ← Back
          </a>
          <button id="retry-btn" class="inline-flex items-center gap-2 px-4 py-2 text-sm bg-foreground text-background rounded-md hover:opacity-90 transition-opacity">
            <RotateCcw class="w-4 h-4" />
            Retry
          </button>
        </div>
      </div>
    </div>

    <!-- Content (filled by JS) -->
    <div id="content" class="hidden"></div>
  </div>
</Layout>

<script>
  import { initBatchMonitor, setupRetryButton } from '../../../scripts/batch-monitor';

  // Read config from container element's data attributes
  const container = document.getElementById('batch-container');
  const config = {
    batchId: container?.dataset.batchId || '',
    apiUrl: container?.dataset.apiUrl || '',
  };

  // Initialize
  setupRetryButton(config);
  initBatchMonitor(config);
</script>

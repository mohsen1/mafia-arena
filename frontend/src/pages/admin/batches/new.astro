---
import Layout from '../../../components/Layout.astro';
import { getModels } from '../../../lib/api';

let models = [];
let error = null;

try {
  models = await getModels();
} catch (e) {
  error = e instanceof Error ? e.message : 'Failed to load models';
}

// Group by provider
const modelsByProvider = models.reduce((acc, m) => {
  if (!acc[m.provider]) acc[m.provider] = [];
  acc[m.provider].push(m);
  return acc;
}, {} as Record<string, typeof models>);
---

<Layout title="New Batch">
  <div class="max-w-2xl mx-auto space-y-6">
    <!-- Header -->
    <div>
      <div class="flex items-center gap-2 text-sm text-muted-foreground mb-1">
        <a href="/admin" class="hover:underline">Admin</a>
        <span>/</span>
        <a href="/admin/batches" class="hover:underline">Batches</a>
        <span>/</span>
        <span>New</span>
      </div>
      <h1 class="text-2xl font-bold tracking-tight">Launch New Batch</h1>
      <p class="text-sm text-muted-foreground mt-1">
        Configure and launch a batch of games (up to 10,000)
      </p>
    </div>

    {error && (
      <div class="border border-destructive/50 bg-destructive/10 rounded-lg p-4">
        <p class="text-destructive">{error}</p>
      </div>
    )}

    <form id="batchForm" class="space-y-6">
      <!-- Batch Name -->
      <div class="space-y-2">
        <label for="name" class="text-sm font-medium">Batch Name (optional)</label>
        <input 
          type="text" 
          id="name" 
          name="name"
          placeholder="e.g., GPT-4o vs Claude Sonnet"
          class="w-full px-3 py-2 border rounded-md bg-background focus:outline-none focus:ring-2 focus:ring-primary"
        />
      </div>

      <!-- Game Count -->
      <div class="space-y-2">
        <label for="totalGames" class="text-sm font-medium">Number of Games</label>
        <input 
          type="range" 
          id="totalGames" 
          name="totalGames"
          min="1" 
          max="1000" 
          value="10"
          class="w-full"
        />
        <div class="flex justify-between text-sm">
          <span class="text-muted-foreground">1</span>
          <span id="gameCount" class="font-medium tabular-nums">10 games</span>
          <span class="text-muted-foreground">1,000</span>
        </div>
      </div>

      <!-- Team Configuration -->
      <div class="space-y-4">
        <h3 class="text-sm font-medium">Team Configuration</h3>
        
        <!-- Player Count -->
        <div class="grid grid-cols-2 gap-4">
          <div class="space-y-2">
            <label for="playerCount" class="text-sm text-muted-foreground">Total Players</label>
            <select 
              id="playerCount" 
              name="playerCount"
              class="w-full px-3 py-2 border rounded-md bg-background"
            >
              {[5, 6, 7, 8, 9, 10].map(n => (
                <option value={n} selected={n === 7}>{n} players</option>
              ))}
            </select>
          </div>
          <div class="space-y-2">
            <label for="mafiaCount" class="text-sm text-muted-foreground">Mafia Count</label>
            <select 
              id="mafiaCount" 
              name="mafiaCount"
              class="w-full px-3 py-2 border rounded-md bg-background"
            >
              {[1, 2, 3].map(n => (
                <option value={n} selected={n === 2}>{n} mafia</option>
              ))}
            </select>
          </div>
        </div>

        <!-- Model Selection -->
        <div class="grid grid-cols-2 gap-4">
          <div class="space-y-2">
            <label for="modelA" class="text-sm text-muted-foreground">
              <span class="inline-block w-2 h-2 bg-red-500 rounded-full mr-1"></span>
              Mafia Model
            </label>
            <select 
              id="modelA" 
              name="modelA"
              class="w-full px-3 py-2 border rounded-md bg-background"
            >
              {Object.entries(modelsByProvider).map(([provider, providerModels]) => (
                <optgroup label={provider}>
                  {providerModels.map(m => (
                    <option value={m.id}>{m.display_name}</option>
                  ))}
                </optgroup>
              ))}
            </select>
          </div>
          <div class="space-y-2">
            <label for="modelB" class="text-sm text-muted-foreground">
              <span class="inline-block w-2 h-2 bg-blue-500 rounded-full mr-1"></span>
              Town Model
            </label>
            <select 
              id="modelB" 
              name="modelB"
              class="w-full px-3 py-2 border rounded-md bg-background"
            >
              {Object.entries(modelsByProvider).map(([provider, providerModels]) => (
                <optgroup label={provider}>
                  {providerModels.map(m => (
                    <option value={m.id}>{m.display_name}</option>
                  ))}
                </optgroup>
              ))}
            </select>
          </div>
        </div>
      </div>

      <!-- Options -->
      <div class="space-y-3">
        <h3 class="text-sm font-medium">Options</h3>
        
        <label class="flex items-center gap-2 cursor-pointer">
          <input type="checkbox" id="discussionEnabled" name="discussionEnabled" checked class="rounded" />
          <span class="text-sm">Enable Discussion Phase</span>
        </label>

        <label class="flex items-center gap-2 cursor-pointer">
          <input type="checkbox" id="personaEnabled" name="personaEnabled" class="rounded" />
          <span class="text-sm">Enable Persona Generation</span>
        </label>

        <label class="flex items-center gap-2 cursor-pointer">
          <input type="checkbox" id="useBatchAPI" name="useBatchAPI" class="rounded" />
          <span class="text-sm">Use Batch API (50% cheaper, 24h delay)</span>
        </label>
      </div>

      <!-- Context Level -->
      <div class="space-y-2">
        <label for="contextLevel" class="text-sm font-medium">Context Level</label>
        <select 
          id="contextLevel" 
          name="contextLevel"
          class="w-full px-3 py-2 border rounded-md bg-background"
        >
          <option value="summary">Summary (current round only)</option>
          <option value="windowed">Windowed (last 3 rounds)</option>
          <option value="full">Full (complete history)</option>
        </select>
        <p class="text-xs text-muted-foreground">
          Full context uses more tokens but may improve reasoning
        </p>
      </div>

      <!-- Cost Estimate -->
      <div class="border rounded-lg p-4 bg-muted/30 space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-sm font-medium">Estimated Cost</span>
          <span id="estimatedCost" class="text-lg font-bold tabular-nums">$0.00</span>
        </div>
        <div class="grid grid-cols-3 gap-4 text-sm">
          <div>
            <div class="text-muted-foreground">Tokens/Game</div>
            <div id="tokensPerGame" class="font-medium tabular-nums">~15,000</div>
          </div>
          <div>
            <div class="text-muted-foreground">Total Tokens</div>
            <div id="totalTokens" class="font-medium tabular-nums">~150,000</div>
          </div>
          <div>
            <div class="text-muted-foreground">Est. Time</div>
            <div id="timeEstimate" class="font-medium tabular-nums">~8 min</div>
          </div>
        </div>
      </div>

      <!-- Submit -->
      <div class="flex gap-3">
        <button 
          type="submit"
          class="flex-1 px-4 py-2 bg-primary text-primary-foreground rounded-md font-medium hover:bg-primary/90 transition-colors disabled:opacity-50"
        >
          Launch Batch
        </button>
        <a 
          href="/admin/batches"
          class="px-4 py-2 border rounded-md hover:bg-muted transition-colors"
        >
          Cancel
        </a>
      </div>
    </form>
  </div>
</Layout>

<script>
  const API_URL = import.meta.env?.PUBLIC_API_URL || 'https://mafia-arena.me-f9a.workers.dev';
  
  // Auth check
  const credentials = sessionStorage.getItem('adminCredentials');
  if (!credentials) {
    window.location.href = '/admin/login?redirect=/admin/batches/new';
  }

  const headers = credentials ? { 
    'Authorization': `Basic ${credentials}`,
    'Content-Type': 'application/json'
  } : { 'Content-Type': 'application/json' };

  const form = document.getElementById('batchForm') as HTMLFormElement;
  const gameCountSlider = document.getElementById('totalGames') as HTMLInputElement;
  const gameCountDisplay = document.getElementById('gameCount')!;
  const estimatedCostEl = document.getElementById('estimatedCost')!;
  const tokensPerGameEl = document.getElementById('tokensPerGame')!;
  const totalTokensEl = document.getElementById('totalTokens')!;
  const timeEstimateEl = document.getElementById('timeEstimate')!;

  // Update game count display
  gameCountSlider.addEventListener('input', () => {
    gameCountDisplay.textContent = `${parseInt(gameCountSlider.value).toLocaleString()} games`;
    updateEstimate();
  });

  // Update estimate on any change
  const updateTriggers = ['playerCount', 'mafiaCount', 'discussionEnabled', 'personaEnabled', 'useBatchAPI', 'contextLevel'];
  updateTriggers.forEach(id => {
    document.getElementById(id)?.addEventListener('change', updateEstimate);
  });

  async function updateEstimate() {
    const totalGames = parseInt(gameCountSlider.value);
    const playerCount = parseInt((document.getElementById('playerCount') as HTMLSelectElement).value);
    const mafiaCount = parseInt((document.getElementById('mafiaCount') as HTMLSelectElement).value);
    const discussionEnabled = (document.getElementById('discussionEnabled') as HTMLInputElement).checked;
    const personaEnabled = (document.getElementById('personaEnabled') as HTMLInputElement).checked;
    const useBatchAPI = (document.getElementById('useBatchAPI') as HTMLInputElement).checked;
    const contextLevel = (document.getElementById('contextLevel') as HTMLSelectElement).value;

    try {
      const res = await fetch(`${API_URL}/api/admin/estimate`, {
        method: 'POST',
        headers,
        body: JSON.stringify({
          totalGames,
          config: {
            playerCount,
            mafiaCount,
            teams: [
              { modelId: 'estimate', team: 'mafia', count: mafiaCount },
              { modelId: 'estimate', team: 'town', count: playerCount - mafiaCount },
            ],
            discussionEnabled,
            personaEnabled,
            contextLevel,
          },
          useBatchAPI,
        }),
      });

      if (!res.ok) throw new Error('Failed to get estimate');

      const estimate = await res.json();
      
      estimatedCostEl.textContent = `$${estimate.estimatedCostUsd.toFixed(2)}`;
      tokensPerGameEl.textContent = `~${estimate.tokensPerGame.toLocaleString()}`;
      totalTokensEl.textContent = `~${estimate.totalTokens.toLocaleString()}`;
      timeEstimateEl.textContent = `~${estimate.timeEstimateMinutes} min`;
    } catch (err) {
      console.error('Failed to update estimate:', err);
    }
  }

  // Initial estimate
  updateEstimate();

  // Form submission
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    submitBtn.disabled = true;
    submitBtn.textContent = 'Launching...';

    try {
      const formData = new FormData(form);
      const playerCount = parseInt(formData.get('playerCount') as string);
      const mafiaCount = parseInt(formData.get('mafiaCount') as string);
      const modelA = formData.get('modelA') as string;
      const modelB = formData.get('modelB') as string;

      const res = await fetch(`${API_URL}/api/admin/batches`, {
        method: 'POST',
        headers,
        body: JSON.stringify({
          name: formData.get('name') || undefined,
          totalGames: parseInt(formData.get('totalGames') as string),
          config: {
            playerCount,
            mafiaCount,
            teams: [
              { modelId: modelA, team: 'mafia', count: mafiaCount },
              { modelId: modelB, team: 'town', count: playerCount - mafiaCount },
            ],
            discussionEnabled: formData.get('discussionEnabled') === 'on',
            personaEnabled: formData.get('personaEnabled') === 'on',
            contextLevel: formData.get('contextLevel') as 'full' | 'windowed' | 'summary',
          },
          useBatchAPI: formData.get('useBatchAPI') === 'on',
        }),
      });

      if (!res.ok) {
        const err = await res.json();
        throw new Error(err.message || 'Failed to create batch');
      }

      const result = await res.json();
      window.location.href = `/admin/batches/${result.batchId}`;
    } catch (err) {
      alert(err instanceof Error ? err.message : 'Failed to create batch');
      submitBtn.disabled = false;
      submitBtn.textContent = 'Launch Batch';
    }
  });
</script>


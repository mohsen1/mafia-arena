---
import Layout from '../../../components/Layout.astro';
import ModelSelector from '../../../components/ui/ModelSelector';

const apiUrl = import.meta.env.PUBLIC_API_URL || 'https://mafia-arena.me-f9a.workers.dev';
---

<Layout title="New Batch">
  <div class="space-y-6">
    <!-- Header -->
    <div>
      <div class="flex items-center gap-2 text-xs font-mono text-muted-foreground mb-2">
        <a href="/admin" class="hover:text-foreground transition-colors">admin</a>
        <span>/</span>
        <a href="/admin/batches" class="hover:text-foreground transition-colors">batches</a>
        <span>/</span>
        <span>new</span>
      </div>
      <h1 class="text-2xl font-bold tracking-tight">Create Batch</h1>
      <p class="text-sm text-muted-foreground mt-1">
        Launch a batch of games (up to 10,000)
      </p>
    </div>

    <!-- Split Screen Layout -->
    <div class="grid lg:grid-cols-[1fr,360px] gap-8">
      <!-- Left: Form -->
      <form id="batchForm" class="space-y-8">
        <!-- Batch Name -->
        <div class="space-y-2">
          <label for="name" class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Batch Name</label>
          <input 
            type="text" 
            id="name" 
            name="name"
            placeholder="e.g., GPT-4o vs Claude Sonnet"
            class="w-full px-3 py-2.5 border rounded-md bg-background text-sm focus:outline-none focus:ring-1 focus:ring-foreground focus:border-foreground transition-colors"
          />
        </div>

        <!-- Game Count -->
        <div class="space-y-2">
          <label for="totalGames" class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Number of Games</label>
          <input 
            type="number" 
            id="totalGames" 
            name="totalGames"
            min="1" 
            max="10000" 
            value="10"
            class="w-full px-3 py-2.5 border rounded-md bg-background text-sm focus:outline-none focus:ring-1 focus:ring-foreground focus:border-foreground transition-colors tabular-nums"
          />
        </div>

        <!-- Team Configuration -->
        <div class="space-y-4">
          <h3 class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Team Configuration</h3>
          
          <!-- Player Count -->
          <div class="grid grid-cols-2 gap-4">
            <div class="space-y-2">
              <label for="playerCount" class="text-xs text-muted-foreground">Total Players</label>
              <select 
                id="playerCount" 
                name="playerCount"
                class="w-full px-3 py-2.5 border rounded-md bg-background text-sm focus:outline-none focus:ring-1 focus:ring-foreground"
              >
                {[5, 6, 7, 8, 9, 10, 11, 12].map(n => (
                  <option value={n} selected={n === 11}>{n} players</option>
                ))}
              </select>
            </div>
            <div class="space-y-2">
              <label for="mafiaCount" class="text-xs text-muted-foreground">Mafia Count</label>
              <select 
                id="mafiaCount" 
                name="mafiaCount"
                class="w-full px-3 py-2.5 border rounded-md bg-background text-sm focus:outline-none focus:ring-1 focus:ring-foreground"
              >
                {[1, 2, 3].map(n => (
                  <option value={n} selected={n === 2}>{n} mafia</option>
                ))}
              </select>
            </div>
          </div>

          <!-- Model Selection -->
          <div class="grid grid-cols-2 gap-4">
            <div class="space-y-2">
              <div class="text-xs text-muted-foreground flex items-center gap-1.5">
                <span class="inline-block w-2 h-2 bg-rose-500 rounded-full"></span>
                Mafia Model
              </div>
              <ModelSelector 
                client:load 
                team="mafia"
                placeholder="Select model..."
                inputId="modelA"
              />
              <input type="hidden" id="modelA" name="modelA" value="" />
            </div>
            <div class="space-y-2">
              <div class="text-xs text-muted-foreground flex items-center gap-1.5">
                <span class="inline-block w-2 h-2 bg-indigo-500 rounded-full"></span>
                Town Model
              </div>
              <ModelSelector 
                client:load 
                team="town"
                placeholder="Select model..."
                inputId="modelB"
              />
              <input type="hidden" id="modelB" name="modelB" value="" />
            </div>
          </div>

          <button 
            type="button"
            id="randomFreeBtn"
            class="w-full px-3 py-2.5 text-sm border border-dashed rounded-md hover:bg-muted/50 transition-colors flex items-center justify-center gap-2 text-muted-foreground hover:text-foreground"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 18h1.4c1.3 0 2.5-.6 3.3-1.7l6.1-8.6c.7-1.1 2-1.7 3.3-1.7H22"></path>
              <path d="m18 2 4 4-4 4"></path>
              <path d="M2 6h1.9c1.5 0 2.9.9 3.6 2.2"></path>
              <path d="M22 18h-5.9c-1.3 0-2.6-.7-3.3-1.8l-.5-.8"></path>
              <path d="m18 14 4 4-4 4"></path>
            </svg>
            Random Free Models
          </button>
        </div>

        <!-- Options -->
        <div class="space-y-3">
          <h3 class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Options</h3>

          <label class="flex items-center gap-3 cursor-pointer">
            <input type="checkbox" id="useBatchAPI" name="useBatchAPI" class="rounded border-muted-foreground/50" />
            <span class="text-sm">Batch API (50% cheaper, 24h delay)</span>
          </label>
        </div>

        <!-- Submit (Mobile) -->
        <div class="flex gap-3 lg:hidden">
          <button 
            type="submit"
            class="flex-1 px-4 py-2.5 bg-foreground text-background rounded-md text-sm font-medium hover:opacity-90 transition-opacity disabled:opacity-50"
          >
            Launch Batch
          </button>
          <a 
            href="/admin/batches"
            class="px-4 py-2.5 border rounded-md text-sm hover:bg-muted transition-colors"
          >
            Cancel
          </a>
        </div>
      </form>

      <!-- Right: Sticky Cost Receipt -->
      <div class="hidden lg:block">
        <div class="sticky top-20 space-y-4">
          <!-- Receipt Panel -->
          <div class="border rounded-lg p-6 space-y-5 bg-card">
            <h3 class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Cost Estimate</h3>
            
            <div class="space-y-3">
              <div class="flex items-center justify-between text-sm">
                <span class="text-muted-foreground">Games</span>
                <span id="receipt-games" class="font-medium tabular-nums">10</span>
              </div>
              <div class="flex items-center justify-between text-sm">
                <span class="text-muted-foreground">Tokens/Game</span>
                <span id="receipt-tokens-per" class="font-medium tabular-nums">~15,000</span>
              </div>
              <div class="flex items-center justify-between text-sm">
                <span class="text-muted-foreground">Total Tokens</span>
                <span id="receipt-total-tokens" class="font-medium tabular-nums">~150,000</span>
              </div>
              <div class="flex items-center justify-between text-sm">
                <span class="text-muted-foreground">Est. Duration</span>
                <span id="receipt-time" class="font-medium tabular-nums">~8 min</span>
              </div>
            </div>

            <div class="h-px bg-border"></div>

            <div class="flex items-baseline justify-between">
              <span class="text-sm text-muted-foreground">Total</span>
              <div id="receipt-cost" class="text-3xl font-bold tabular-nums">$0.00</div>
            </div>
          </div>

          <!-- Submit Button (Desktop) -->
          <button 
            type="submit"
            form="batchForm"
            class="w-full px-4 py-3 bg-foreground text-background rounded-md text-sm font-medium hover:opacity-90 transition-opacity disabled:opacity-50"
          >
            Launch Batch
          </button>
          <a 
            href="/admin/batches"
            class="block text-center px-4 py-2 text-sm text-muted-foreground hover:text-foreground transition-colors"
          >
            Cancel
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script define:vars={{ apiUrl }}>
  const credentials = sessionStorage.getItem('adminCredentials');
  if (!credentials) {
    window.location.href = '/admin/login?redirect=/admin/batches/new';
  }

  const headers = credentials ? { 
    'Authorization': `Basic ${credentials}`,
    'Content-Type': 'application/json'
  } : { 'Content-Type': 'application/json' };

  const randomFreeBtn = document.getElementById('randomFreeBtn');
  if (randomFreeBtn) {
    randomFreeBtn.addEventListener('click', async () => {
      randomFreeBtn.disabled = true;
      randomFreeBtn.innerHTML = `
        <svg class="animate-spin h-4 w-4" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
        </svg>
        Picking...
      `;

      try {
        const res = await fetch(`${apiUrl}/api/models/openrouter`);
        if (!res.ok) throw new Error('Failed to fetch models');
        
        const data = await res.json();
        
        const freeModels = [];
        for (const provider of data.providers) {
          const models = data.modelsByProvider[provider] || [];
          for (const model of models) {
            if (model.pricing.inputPer1M === 0 && model.pricing.outputPer1M === 0) {
              freeModels.push(model);
            }
          }
        }

        if (freeModels.length < 2) {
          alert('Not enough free models available');
          return;
        }

        const shuffled = freeModels.sort(() => Math.random() - 0.5);
        const modelA = shuffled[0];
        const modelB = shuffled[1];

        window.dispatchEvent(new CustomEvent('selectModel', { 
          detail: { inputId: 'modelA', modelId: modelA.id, displayName: modelA.name } 
        }));
        window.dispatchEvent(new CustomEvent('selectModel', { 
          detail: { inputId: 'modelB', modelId: modelB.id, displayName: modelB.name } 
        }));

      } catch (err) {
        console.error('Failed to fetch free models:', err);
        alert('Failed to fetch models');
      } finally {
        randomFreeBtn.disabled = false;
        randomFreeBtn.innerHTML = `
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 18h1.4c1.3 0 2.5-.6 3.3-1.7l6.1-8.6c.7-1.1 2-1.7 3.3-1.7H22"></path>
            <path d="m18 2 4 4-4 4"></path>
            <path d="M2 6h1.9c1.5 0 2.9.9 3.6 2.2"></path>
            <path d="M22 18h-5.9c-1.3 0-2.6-.7-3.3-1.8l-.5-.8"></path>
            <path d="m18 14 4 4-4 4"></path>
          </svg>
          Random Free Models
        `;
      }
    });
  }

  const form = document.getElementById('batchForm');
  const totalGamesInput = document.getElementById('totalGames');

  const updateTriggers = ['totalGames', 'playerCount', 'mafiaCount', 'useBatchAPI'];
  updateTriggers.forEach(id => {
    document.getElementById(id)?.addEventListener('change', updateEstimate);
    document.getElementById(id)?.addEventListener('input', updateEstimate);
  });
  
  if (totalGamesInput) {
    totalGamesInput.addEventListener('input', () => {
      const receiptGames = document.getElementById('receipt-games');
      if (receiptGames) {
        receiptGames.textContent = totalGamesInput.value || '10';
      }
    });
  }

  async function updateEstimate() {
    if (!totalGamesInput) return;
    const totalGames = parseInt(totalGamesInput.value) || 10;
    const playerCountEl = document.getElementById('playerCount');
    const mafiaCountEl = document.getElementById('mafiaCount');
    const useBatchAPIEl = document.getElementById('useBatchAPI');

    const playerCount = playerCountEl ? parseInt(playerCountEl.value) : 11;
    const mafiaCount = mafiaCountEl ? parseInt(mafiaCountEl.value) : 2;
    const useBatchAPI = useBatchAPIEl ? useBatchAPIEl.checked : false;

    try {
      const res = await fetch(`${apiUrl}/api/admin/estimate`, {
        method: 'POST',
        headers,
        body: JSON.stringify({
          totalGames,
          config: {
            playerCount,
            mafiaCount,
            teams: [
              { modelId: 'estimate', team: 'mafia', count: mafiaCount },
              { modelId: 'estimate', team: 'town', count: playerCount - mafiaCount },
            ],
            discussionEnabled: true,
            contextLevel: 'full',
          },
          useBatchAPI,
        }),
      });

      if (!res.ok) throw new Error('Failed to get estimate');

      const estimate = await res.json();
      
      const receiptGames = document.getElementById('receipt-games');
      const receiptTokensPer = document.getElementById('receipt-tokens-per');
      const receiptTotalTokens = document.getElementById('receipt-total-tokens');
      const receiptTime = document.getElementById('receipt-time');
      const receiptCost = document.getElementById('receipt-cost');
      
      if (receiptGames) receiptGames.textContent = totalGames.toString();
      if (receiptTokensPer) receiptTokensPer.textContent = `~${estimate.tokensPerGame.toLocaleString()}`;
      if (receiptTotalTokens) receiptTotalTokens.textContent = `~${estimate.totalTokens.toLocaleString()}`;
      if (receiptTime) receiptTime.textContent = `~${estimate.timeEstimateMinutes} min`;
      if (receiptCost) receiptCost.textContent = `$${estimate.estimatedCostUsd.toFixed(2)}`;
    } catch (err) {
      console.error('Failed to update estimate:', err);
    }
  }

  updateEstimate();

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const submitBtn = form.querySelector('button[type="submit"]');
      
      const modelAInput = document.getElementById('modelA');
      const modelBInput = document.getElementById('modelB');
      const modelA = modelAInput.value;
      const modelB = modelBInput.value;
      
      if (!modelA || !modelB) {
        alert('Please select both models');
        return;
      }
      
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Launching...';
      }

      try {
        const formData = new FormData(form);
        const playerCount = parseInt(String(formData.get('playerCount') || '11'));
        const mafiaCount = parseInt(String(formData.get('mafiaCount') || '2'));
        const batchNameInput = String(formData.get('name') || '').trim();
        
        // Get display names from data attributes (set by ModelSelector)
        const modelAName = modelAInput.dataset.displayName || modelA.split('/').pop() || modelA;
        const modelBName = modelBInput.dataset.displayName || modelB.split('/').pop() || modelB;
        
        // Generate default batch name from display names (e.g., "Gemini 2.0 Flash vs GPT-5.2")
        let batchName = batchNameInput || `${modelAName} vs ${modelBName}`;

        const res = await fetch(`${apiUrl}/api/admin/batches`, {
          method: 'POST',
          headers,
          body: JSON.stringify({
            name: batchName,
            totalGames: parseInt(String(formData.get('totalGames') || '10')),
            config: {
              playerCount,
              mafiaCount,
              teams: [
                { modelId: modelA, team: 'mafia', count: mafiaCount },
                { modelId: modelB, team: 'town', count: playerCount - mafiaCount },
              ],
              discussionEnabled: true,
              contextLevel: 'full',
              maxRounds: 10,
              personaConstraints: 'moderate',
            },
            useBatchAPI: formData.get('useBatchAPI') === 'on',
          }),
        });

        if (!res.ok) {
          const err = await res.json();
          throw new Error(err.message || 'Failed to create batch');
        }

        const result = await res.json();
        window.location.href = `/admin/batches/${result.batchId}`;
      } catch (err) {
        alert(err instanceof Error ? err.message : 'Failed to create batch');
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Launch Batch';
        }
      }
    });
  }
</script>

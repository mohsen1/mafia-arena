---
import Layout from '../../../components/Layout.astro';
import { getModels } from '../../../lib/api';

let models = [];
let error = null;

try {
  models = await getModels();
} catch (e) {
  error = e instanceof Error ? e.message : 'Failed to load models';
}

// Group by provider
const modelsByProvider = models.reduce((acc, m) => {
  if (!acc[m.provider]) acc[m.provider] = [];
  acc[m.provider].push(m);
  return acc;
}, {} as Record<string, typeof models>);

const apiUrl = import.meta.env.PUBLIC_apiUrl || 'https://mafia-arena.me-f9a.workers.dev';
---

<Layout title="New Batch">
  <div class="space-y-6">
    <!-- Header -->
    <div>
      <div class="flex items-center gap-2 text-sm text-muted-foreground mb-1">
        <a href="/admin" class="hover:underline">Admin</a>
        <span>/</span>
        <a href="/admin/batches" class="hover:underline">Batches</a>
        <span>/</span>
        <span>New</span>
      </div>
      <h1 class="text-2xl font-bold tracking-tight">Launch New Batch</h1>
      <p class="text-sm text-muted-foreground mt-1">
        Configure and launch a batch of games (up to 10,000)
      </p>
    </div>

    {error && (
      <div class="border border-destructive/50 bg-destructive/10 rounded-lg p-4">
        <p class="text-destructive">{error}</p>
      </div>
    )}

    <!-- Split Screen Layout -->
    <div class="grid lg:grid-cols-[1fr,400px] gap-6">
      <!-- Left: Form -->
      <form id="batchForm" class="space-y-6">
      <!-- Batch Name -->
      <div class="space-y-2">
        <label for="name" class="text-sm font-medium">Batch Name (optional)</label>
        <input 
          type="text" 
          id="name" 
          name="name"
          placeholder="e.g., GPT-4o vs Claude Sonnet"
          class="w-full px-3 py-2 border rounded-md bg-background focus:outline-none focus:ring-2 focus:ring-primary"
        />
      </div>

      <!-- Game Count -->
      <div class="space-y-2">
        <label for="totalGames" class="text-sm font-medium">Number of Games</label>
        <input 
          type="number" 
          id="totalGames" 
          name="totalGames"
          min="1" 
          max="10000" 
          value="10"
          class="w-full px-3 py-2 border rounded-md bg-background focus:outline-none focus:ring-2 focus:ring-primary"
        />
      </div>

      <!-- Team Configuration -->
      <div class="space-y-4">
        <h3 class="text-sm font-medium">Team Configuration</h3>
        
        <!-- Player Count -->
        <div class="grid grid-cols-2 gap-4">
          <div class="space-y-2">
            <label for="playerCount" class="text-sm text-muted-foreground">Total Players</label>
            <select 
              id="playerCount" 
              name="playerCount"
              class="w-full px-3 py-2 border rounded-md bg-background"
            >
              {[5, 6, 7, 8, 9, 10, 11, 12].map(n => (
                <option value={n} selected={n === 11}>{n} players</option>
              ))}
            </select>
          </div>
          <div class="space-y-2">
            <label for="mafiaCount" class="text-sm text-muted-foreground">Mafia Count</label>
            <select 
              id="mafiaCount" 
              name="mafiaCount"
              class="w-full px-3 py-2 border rounded-md bg-background"
            >
              {[1, 2, 3].map(n => (
                <option value={n} selected={n === 2}>{n} mafia</option>
              ))}
            </select>
          </div>
        </div>

        <!-- Model Selection -->
        <div class="grid grid-cols-2 gap-4">
          <div class="space-y-2">
            <label for="modelA" class="text-sm text-muted-foreground">
              <span class="inline-block w-2 h-2 bg-red-500 rounded-full mr-1"></span>
              Mafia Model
            </label>
            <select 
              id="modelA" 
              name="modelA"
              class="w-full px-3 py-2 border rounded-md bg-background"
            >
              {Object.entries(modelsByProvider).map(([provider, providerModels]) => (
                <optgroup label={provider}>
                  {providerModels.map(m => (
                    <option value={m.id}>{m.display_name}</option>
                  ))}
                </optgroup>
              ))}
            </select>
          </div>
          <div class="space-y-2">
            <label for="modelB" class="text-sm text-muted-foreground">
              <span class="inline-block w-2 h-2 bg-blue-500 rounded-full mr-1"></span>
              Town Model
            </label>
            <select 
              id="modelB" 
              name="modelB"
              class="w-full px-3 py-2 border rounded-md bg-background"
            >
              {Object.entries(modelsByProvider).map(([provider, providerModels]) => (
                <optgroup label={provider}>
                  {providerModels.map(m => (
                    <option value={m.id}>{m.display_name}</option>
                  ))}
                </optgroup>
              ))}
            </select>
          </div>
        </div>
      </div>

      <!-- Options -->
      <div class="space-y-3">
        <h3 class="text-sm font-medium">Options</h3>

        <label class="flex items-center gap-2 cursor-pointer">
          <input type="checkbox" id="useBatchAPI" name="useBatchAPI" class="rounded" />
          <span class="text-sm">Use Batch API (50% cheaper, 24h delay)</span>
        </label>
      </div>

      <!-- Submit -->
      <div class="flex gap-3 lg:hidden">
        <button 
          type="submit"
          class="flex-1 px-4 py-2 bg-primary text-primary-foreground rounded-md font-medium hover:bg-primary/90 transition-colors disabled:opacity-50"
        >
          Launch Batch
        </button>
        <a 
          href="/admin/batches"
          class="px-4 py-2 border rounded-md hover:bg-muted transition-colors"
        >
          Cancel
        </a>
      </div>
    </form>

      <!-- Right: Sticky Cost Receipt -->
      <div class="hidden lg:block">
        <div class="sticky top-20 space-y-4">
          <!-- Receipt Panel -->
          <div class="border-2 rounded-lg p-6 bg-gradient-to-br from-primary/5 to-transparent space-y-4">
            <h3 class="font-bold text-lg">Cost Estimate</h3>
            
            <div class="space-y-3">
              <div class="flex items-center justify-between text-sm">
                <span class="text-muted-foreground">Games</span>
                <span id="receipt-games" class="font-medium tabular-nums">10</span>
              </div>
              <div class="flex items-center justify-between text-sm">
                <span class="text-muted-foreground">Tokens/Game</span>
                <span id="receipt-tokens-per" class="font-medium tabular-nums">~15,000</span>
              </div>
              <div class="flex items-center justify-between text-sm">
                <span class="text-muted-foreground">Total Tokens</span>
                <span id="receipt-total-tokens" class="font-medium tabular-nums">~150,000</span>
              </div>
              <div class="flex items-center justify-between text-sm">
                <span class="text-muted-foreground">Est. Duration</span>
                <span id="receipt-time" class="font-medium tabular-nums">~8 min</span>
              </div>
            </div>

            <div class="h-px bg-border"></div>

            <div class="flex items-baseline justify-between">
              <span class="font-semibold">Total Cost</span>
              <div class="text-right">
                <div id="receipt-cost" class="text-3xl font-bold tabular-nums text-emerald-600 dark:text-emerald-400">$0.00</div>
              </div>
            </div>
          </div>

          <!-- Submit Button (Desktop) -->
          <button 
            type="submit"
            form="batchForm"
            class="w-full px-4 py-3 bg-primary text-primary-foreground rounded-lg font-semibold hover:bg-primary/90 transition-colors disabled:opacity-50 shadow-sm"
          >
            Launch Batch
          </button>
          <a 
            href="/admin/batches"
            class="block text-center px-4 py-2 border rounded-lg text-sm hover:bg-muted transition-colors"
          >
            Cancel
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script define:vars={{ apiUrl, modelsByProvider }}>
  // Auth check
  const credentials = sessionStorage.getItem('adminCredentials');
  if (!credentials) {
    window.location.href = '/admin/login?redirect=/admin/batches/new';
  }

  const headers = credentials ? { 
    'Authorization': `Basic ${credentials}`,
    'Content-Type': 'application/json'
  } : { 'Content-Type': 'application/json' };

  const form = document.getElementById('batchForm');
  const totalGamesInput = document.getElementById('totalGames');
  const estimatedCostEl = document.getElementById('estimatedCost');
  const tokensPerGameEl = document.getElementById('tokensPerGame');
  const totalTokensEl = document.getElementById('totalTokens');
  const timeEstimateEl = document.getElementById('timeEstimate');
  
  // Create a map of model IDs to display names for batch name generation
  const modelMap = new Map();
  Object.values(modelsByProvider).flat().forEach(m => {
    modelMap.set(m.id, m.display_name);
  });

  // Randomly select models from different providers on page load
  const providers = Object.keys(modelsByProvider);
  if (providers.length > 0) {
    const shuffled = providers.sort(() => Math.random() - 0.5);
    const modelA = document.getElementById('modelA');
    const modelB = document.getElementById('modelB');
    
    // Select random model from first provider for Mafia
    const mafiaProvider = shuffled[0];
    const mafiaModels = modelsByProvider[mafiaProvider];
    if (mafiaModels && mafiaModels.length > 0 && modelA) {
      const randomMafia = mafiaModels[Math.floor(Math.random() * mafiaModels.length)];
      modelA.value = randomMafia.id;
    }
    
    // Select random model from different provider for Town (or same if only one provider)
    const townProvider = shuffled.length > 1 ? shuffled[1] : shuffled[0];
    const townModels = modelsByProvider[townProvider];
    if (townModels && townModels.length > 0 && modelB) {
      const randomTown = townModels[Math.floor(Math.random() * townModels.length)];
      modelB.value = randomTown.id;
    }
  }

  // Update estimate on any change
  const updateTriggers = ['totalGames', 'playerCount', 'mafiaCount', 'modelA', 'modelB', 'useBatchAPI'];
  updateTriggers.forEach(id => {
    document.getElementById(id)?.addEventListener('change', updateEstimate);
    document.getElementById(id)?.addEventListener('input', updateEstimate);
  });
  
  // Update receipt games count when totalGames changes
  if (totalGamesInput) {
    totalGamesInput.addEventListener('input', () => {
      const receiptGames = document.getElementById('receipt-games');
      if (receiptGames) {
        receiptGames.textContent = totalGamesInput.value || '10';
      }
    });
  }

  async function updateEstimate() {
    if (!totalGamesInput) return;
    const totalGames = parseInt(totalGamesInput.value) || 10;
    const playerCountEl = document.getElementById('playerCount');
    const mafiaCountEl = document.getElementById('mafiaCount');
    const useBatchAPIEl = document.getElementById('useBatchAPI');

    const playerCount = playerCountEl ? parseInt(playerCountEl.value) : 11;
    const mafiaCount = mafiaCountEl ? parseInt(mafiaCountEl.value) : 2;
    const useBatchAPI = useBatchAPIEl ? useBatchAPIEl.checked : false;

    try {
      const res = await fetch(`${apiUrl}/api/admin/estimate`, {
        method: 'POST',
        headers,
        body: JSON.stringify({
          totalGames,
          config: {
            playerCount,
            mafiaCount,
            teams: [
              { modelId: 'estimate', team: 'mafia', count: mafiaCount },
              { modelId: 'estimate', team: 'town', count: playerCount - mafiaCount },
            ],
            discussionEnabled: true,
            contextLevel: 'full',
          },
          useBatchAPI,
        }),
      });

      if (!res.ok) throw new Error('Failed to get estimate');

      const estimate = await res.json();
      
      const receiptGames = document.getElementById('receipt-games');
      const receiptTokensPer = document.getElementById('receipt-tokens-per');
      const receiptTotalTokens = document.getElementById('receipt-total-tokens');
      const receiptTime = document.getElementById('receipt-time');
      const receiptCost = document.getElementById('receipt-cost');
      
      if (receiptGames) receiptGames.textContent = totalGames.toString();
      if (receiptTokensPer) receiptTokensPer.textContent = `~${estimate.tokensPerGame.toLocaleString()}`;
      if (receiptTotalTokens) receiptTotalTokens.textContent = `~${estimate.totalTokens.toLocaleString()}`;
      if (receiptTime) receiptTime.textContent = `~${estimate.timeEstimateMinutes} min`;
      if (receiptCost) receiptCost.textContent = `$${estimate.estimatedCostUsd.toFixed(2)}`;
    } catch (err) {
      console.error('Failed to update estimate:', err);
    }
  }

  // Initial estimate
  updateEstimate();

  // Form submission
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const submitBtn = form.querySelector('button[type="submit"]');
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Launching...';
      }

      try {
        const formData = new FormData(form);
        const playerCount = parseInt(String(formData.get('playerCount') || '11'));
        const mafiaCount = parseInt(String(formData.get('mafiaCount') || '2'));
        const modelA = String(formData.get('modelA') || '');
        const modelB = String(formData.get('modelB') || '');
        const batchNameInput = String(formData.get('name') || '').trim();
        
        // Auto-generate batch name from model display names if not provided
        let batchName = batchNameInput || undefined;
        if (!batchName && modelA && modelB) {
          const mafiaName = modelMap.get(modelA) || 'Mafia';
          const townName = modelMap.get(modelB) || 'Town';
          batchName = `${mafiaName} vs ${townName}`;
        }

        const res = await fetch(`${apiUrl}/api/admin/batches`, {
          method: 'POST',
          headers,
          body: JSON.stringify({
            name: batchName,
            totalGames: parseInt(String(formData.get('totalGames') || '10')),
            config: {
              playerCount,
              mafiaCount,
              teams: [
                { modelId: modelA, team: 'mafia', count: mafiaCount },
                { modelId: modelB, team: 'town', count: playerCount - mafiaCount },
              ],
              discussionEnabled: true,
              contextLevel: 'full',
              maxRounds: 10,
              personaConstraints: 'moderate',
            },
            useBatchAPI: formData.get('useBatchAPI') === 'on',
          }),
        });

        if (!res.ok) {
          const err = await res.json();
          throw new Error(err.message || 'Failed to create batch');
        }

        const result = await res.json();
        window.location.href = `/admin/batches/${result.batchId}`;
      } catch (err) {
        alert(err instanceof Error ? err.message : 'Failed to create batch');
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Launch Batch';
        }
      }
    });
  }
</script>


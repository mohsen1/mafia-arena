---
import Layout from '../../components/Layout.astro';
import { PauseCircle, PlayCircle, Plus, DollarSign, Layers, AlertTriangle, LogOut, Radio } from 'lucide-astro';

const apiUrl = import.meta.env.PUBLIC_apiUrl || 'https://mafia-arena.me-f9a.workers.dev';
---

<Layout title="Admin Dashboard">
  <div id="admin-content" class="space-y-6">
    <!-- Loading state -->
    <div id="loading" class="flex items-center justify-center py-20">
      <div class="animate-spin h-8 w-8 border-4 border-primary border-t-transparent rounded-full"></div>
    </div>

    <!-- Error state (hidden initially) -->
    <div id="error-container" class="hidden border border-destructive/50 bg-destructive/10 rounded-lg p-4 flex items-start gap-3">
      <AlertTriangle class="text-destructive shrink-0 mt-0.5" size={18} />
      <div>
        <p class="font-medium text-destructive">Failed to load dashboard</p>
        <p id="error-message" class="text-sm text-muted-foreground"></p>
      </div>
    </div>

    <!-- Dashboard content (hidden initially) -->
    <div id="dashboard" class="hidden space-y-6">
      <!-- Header -->
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-2xl font-bold tracking-tight">Admin Dashboard</h1>
          <p class="text-sm text-muted-foreground">Manage batch jobs and monitor system health</p>
        </div>
        <button 
          id="logoutBtn"
          class="inline-flex items-center gap-2 px-3 py-2 border rounded-md text-sm hover:bg-muted transition-colors"
        >
          <LogOut size={16} />
          Logout
        </button>
      </div>

      <!-- Quick Actions - At the top -->
      <section class="flex flex-wrap gap-3">
        <a href="/admin/games/new" class="inline-flex items-center gap-2 px-4 py-2 border rounded-md text-sm font-medium hover:bg-muted transition-colors">
          <Radio size={16} />
          <span>Run Live Game</span>
        </a>

        <a href="/admin/batches/new" class="inline-flex items-center gap-2 px-4 py-2 bg-primary text-primary-foreground rounded-md text-sm font-medium hover:bg-primary/90 transition-colors">
          <Plus size={16} />
          <span>New Batch</span>
        </a>

        <a href="/admin/batches" class="inline-flex items-center gap-2 px-4 py-2 border rounded-md text-sm font-medium hover:bg-muted transition-colors">
          <Layers size={16} />
          <span>Manage Batches</span>
        </a>

        <button 
          id="killHangingBtn"
          class="inline-flex items-center gap-2 px-4 py-2 border border-red-500/50 text-red-600 dark:text-red-400 rounded-md text-sm font-medium hover:bg-red-500/10 transition-colors"
          title="Kill games running >10 minutes"
        >
          <AlertTriangle size={16} />
          <span id="kill-btn-text">Kill Hanging Games</span>
          <span id="hanging-count" class="hidden px-1.5 py-0.5 rounded-full bg-red-500/20 text-xs font-bold tabular-nums"></span>
        </button>
      </section>

      <!-- Mission Control HUD -->
      <div class="border-2 rounded-lg p-6 bg-gradient-to-br from-primary/5 to-transparent space-y-4">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div id="status-pulse" class="relative w-4 h-4">
              <span class="absolute inline-flex h-full w-full rounded-full opacity-75"></span>
              <span class="relative inline-flex rounded-full h-4 w-4"></span>
            </div>
            <div>
              <h2 class="text-lg font-bold">System Control</h2>
              <p id="status-subtitle" class="text-xs text-muted-foreground">Initializing...</p>
            </div>
          </div>
          <button 
            id="toggleSystem"
            class="px-4 py-2 rounded-lg font-semibold text-sm transition-all shadow-sm"
          >
            <span id="toggle-text">Toggle</span>
          </button>
        </div>
      </div>

      <!-- Stats Grid -->
      <div class="grid gap-4 md:grid-cols-2">
        <!-- Active Operations -->
        <div class="border rounded-lg p-5 space-y-3 bg-gradient-to-br from-indigo-500/5 to-transparent">
          <div class="flex items-center gap-2 text-sm font-medium text-indigo-600 dark:text-indigo-400">
            <Layers size={18} />
            <span>Active Operations</span>
          </div>
          <div>
            <div id="batches-active" class="text-3xl font-bold tabular-nums">—</div>
            <div class="text-xs text-muted-foreground">active batches</div>
          </div>
          <div class="space-y-1">
            <p id="games-running" class="text-sm font-medium text-emerald-600 dark:text-emerald-400 hidden">
              <span class="relative inline-flex h-2 w-2 mr-1.5">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
              </span>
              <span>— running now</span>
            </p>
            <p id="games-queued" class="text-sm text-muted-foreground">— games queued</p>
          </div>
        </div>

        <!-- Cost Tracking -->
        <div class="border rounded-lg p-5 space-y-3 bg-gradient-to-br from-emerald-500/5 to-transparent">
          <div class="flex items-center gap-2 text-sm font-medium text-emerald-600 dark:text-emerald-400">
            <DollarSign size={18} />
            <span>Cost Today</span>
          </div>
          <div>
            <div id="cost-today" class="text-3xl font-bold tabular-nums text-emerald-600 dark:text-emerald-400">$—</div>
            <div class="text-xs text-muted-foreground">spent today</div>
          </div>
        </div>
      </div>

      <!-- Recent Batches -->
      <section class="space-y-3">
        <div class="flex items-center justify-between">
          <h2 class="font-semibold">Recent Batches</h2>
          <a href="/admin/batches" class="text-sm text-muted-foreground hover:text-foreground">
            View all →
          </a>
        </div>

        <div class="border rounded-lg overflow-hidden">
          <table class="w-full text-sm">
            <thead class="bg-muted/50 border-b">
              <tr>
                <th class="text-left p-3 font-medium">Name</th>
                <th class="text-left p-3 font-medium">Status</th>
                <th class="text-right p-3 font-medium">Progress</th>
                <th class="text-right p-3 font-medium">Cost</th>
                <th class="text-right p-3 font-medium">Created</th>
              </tr>
            </thead>
            <tbody id="batches-table" class="divide-y">
              <tr>
                <td colspan="5" class="p-8 text-center text-muted-foreground">Loading...</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>
    </div>
  </div>
</Layout>

<script define:vars={{ apiUrl }}>
  const statusColors = {
    queued: 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900/30 dark:text-yellow-400',
    processing: 'bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-400',
    completed: 'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400',
    cancelled: 'bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300',
    paused: 'bg-orange-100 text-orange-800 dark:bg-orange-900/30 dark:text-orange-400',
  };

  function escapeHtml(val) {
    if (val === null || val === undefined) return '';
    const str = typeof val === 'string' ? val : String(val);
    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/`/g, '&#96;');
  }

  async function init() {
    // Check for auth
    const credentials = sessionStorage.getItem('adminCredentials');
    if (!credentials) {
      window.location.href = '/admin/login?redirect=/admin';
      return;
    }

    const headers = { 'Authorization': `Basic ${credentials}` };

    try {
      // Load stats and batches
      const [statsRes, batchesRes] = await Promise.all([
        fetch(`${apiUrl}/api/admin/stats/live`, { headers }),
        fetch(`${apiUrl}/api/admin/batches?limit=5`, { headers }),
      ]);

      if (statsRes.status === 401 || batchesRes.status === 401) {
        sessionStorage.removeItem('adminCredentials');
        window.location.href = '/admin/login?redirect=/admin';
        return;
      }

      if (!statsRes.ok || !batchesRes.ok) {
        throw new Error('Failed to load dashboard data');
      }

      const stats = await statsRes.json();
      const batches = await batchesRes.json();

      // Hide loading, show dashboard
      document.getElementById('loading')?.classList.add('hidden');
      document.getElementById('dashboard')?.classList.remove('hidden');

      // Populate stats
      const statusPulse = document.getElementById('status-pulse');
      const statusSubtitle = document.getElementById('status-subtitle');
      const toggleBtn = document.getElementById('toggleSystem');
      const toggleText = document.getElementById('toggle-text');
      
      if (statusPulse) {
        if (stats.systemPaused) {
          statusPulse.innerHTML = `
            <span class="absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75 animate-pulse-slow"></span>
            <span class="relative inline-flex rounded-full h-4 w-4 bg-amber-500"></span>
          `;
        } else {
          statusPulse.innerHTML = `
            <span class="absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75 animate-ping"></span>
            <span class="relative inline-flex rounded-full h-4 w-4 bg-emerald-500"></span>
          `;
        }
      }
      
      if (statusSubtitle) {
        statusSubtitle.textContent = stats.systemPaused 
          ? 'Circuit breaker active - System paused' 
          : 'System operational - Processing games';
      }
      
      if (toggleBtn && toggleText) {
        if (stats.systemPaused) {
          toggleBtn.className = 'px-4 py-2 rounded-lg font-semibold text-sm transition-all shadow-sm bg-emerald-500 hover:bg-emerald-600 text-white';
          toggleText.textContent = 'Resume System';
        } else {
          toggleBtn.className = 'px-4 py-2 rounded-lg font-semibold text-sm transition-all shadow-sm bg-amber-500 hover:bg-amber-600 text-white';
          toggleText.textContent = 'Pause System';
        }
        toggleBtn.dataset.paused = String(stats.systemPaused);
      }

      const batchesActive = document.getElementById('batches-active');
      if (batchesActive) batchesActive.textContent = String(stats.batchesActive);
      
      const gamesRunning = document.getElementById('games-running');
      if (gamesRunning) {
        if (stats.gamesRunning > 0) {
          gamesRunning.classList.remove('hidden');
          gamesRunning.innerHTML = `
            <span class="relative inline-flex h-2 w-2 mr-1">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
            </span>
            ${stats.gamesRunning} running now
          `;
        } else {
          gamesRunning.classList.add('hidden');
        }
      }
      
      const gamesQueued = document.getElementById('games-queued');
      if (gamesQueued) gamesQueued.textContent = `${stats.gamesQueued.toLocaleString()} games in queue`;
      
      const costToday = document.getElementById('cost-today');
      if (costToday) costToday.textContent = `$${stats.costToday.toFixed(2)}`;

      // Populate batches table
      const tbody = document.getElementById('batches-table');
      if (batches.batches.length === 0) {
        tbody.innerHTML = `<tr><td colspan="5" class="p-8 text-center text-muted-foreground">No batches yet. <a href="/admin/batches/new" class="underline">Create one</a></td></tr>`;
      } else {
        tbody.innerHTML = batches.batches.map((batch) => `
          <tr class="hover:bg-muted/30 transition-colors">
            <td class="p-3">
              <a href="/admin/batches/${escapeHtml(batch.id)}" class="hover:underline font-medium">${escapeHtml(batch.name || batch.id)}</a>
            </td>
            <td class="p-3">
              <span class="inline-flex px-2 py-0.5 rounded-full text-xs font-medium ${statusColors[batch.status]}">${batch.status}</span>
            </td>
            <td class="p-3 text-right tabular-nums">
              <div class="flex items-center justify-end gap-2">
                <span>${batch.completedGames}/${batch.totalGames}</span>
                <div class="w-16 h-1.5 bg-muted rounded-full overflow-hidden">
                  <div class="h-full bg-primary" style="width: ${batch.progress}%"></div>
                </div>
              </div>
            </td>
            <td class="p-3 text-right tabular-nums">$${batch.actualCostUsd.toFixed(4)}</td>
            <td class="p-3 text-right text-muted-foreground tabular-nums">${new Date(batch.createdAt * 1000).toLocaleDateString()}</td>
          </tr>
        `).join('');
      }

      // Setup event handlers
      if (toggleBtn && toggleText) {
        toggleBtn.addEventListener('click', async () => {
          const isPaused = toggleBtn.dataset.paused === 'true';
          toggleBtn.disabled = true;
          toggleText.textContent = 'Processing...';

          try {
            const endpoint = isPaused ? 'resume' : 'pause';
            const res = await fetch(`${apiUrl}/api/admin/system/${endpoint}`, { 
              method: 'POST',
              headers,
            });
            if (!res.ok) throw new Error('Failed');
            window.location.reload();
          } catch {
            alert('Failed to update system state');
            toggleBtn.disabled = false;
            toggleText.textContent = isPaused ? 'Resume System' : 'Pause System';
          }
        });
      }

      document.getElementById('logoutBtn')?.addEventListener('click', () => {
        sessionStorage.removeItem('adminCredentials');
        window.location.href = '/admin/login';
      });

      // Load running games count
      loadRunningGamesCount(headers);

      // Setup kill hanging games button
      document.getElementById('killHangingBtn')?.addEventListener('click', async () => {
        const btn = document.getElementById('killHangingBtn');
        const btnText = document.getElementById('kill-btn-text');
        if (!btn || !btnText) return;

        if (!confirm('Kill all games that have been running for >10 minutes?\n\nThis will mark them as failed. This action cannot be undone.')) {
          return;
        }

        btn.disabled = true;
        btnText.textContent = 'Killing...';

        try {
          const res = await fetch(`${apiUrl}/api/admin/games/kill-hanging`, {
            method: 'POST',
            headers,
          });

          if (!res.ok) throw new Error('Failed to kill hanging games');

          const result = await res.json();
          alert(`✅ Killed ${result.killedCount} hanging game(s)`);
          
          // Reload page to refresh stats
          window.location.reload();
        } catch (err) {
          alert(`❌ Failed to kill hanging games: ${err instanceof Error ? err.message : 'Unknown error'}`);
          btn.disabled = false;
          btnText.textContent = 'Kill Hanging Games';
        }
      });

    } catch (err) {
      document.getElementById('loading')?.classList.add('hidden');
      document.getElementById('error-container')?.classList.remove('hidden');
      const errorMsg = document.getElementById('error-message');
      if (errorMsg) errorMsg.textContent = err instanceof Error ? err.message : 'Unknown error';
    }
  }

  async function loadRunningGamesCount(headers) {
    try {
      const res = await fetch(`${apiUrl}/api/admin/games/running`, { headers });
      if (!res.ok) return;

      const data = await res.json();
      const hangingCount = document.getElementById('hanging-count');
      
      if (data.stale > 0 && hangingCount) {
        hangingCount.textContent = String(data.stale);
        hangingCount.classList.remove('hidden');
        hangingCount.classList.add('animate-pulse');
      }
    } catch (err) {
      console.error('Failed to load running games count:', err);
    }
  }

  init();
</script>

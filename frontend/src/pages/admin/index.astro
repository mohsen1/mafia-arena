---
import Layout from '../../components/Layout.astro';
import { getAdminStats, listBatches, formatNumber } from '../../lib/api';
import { Activity, PauseCircle, PlayCircle, Plus, DollarSign, Layers, Clock, AlertTriangle } from 'lucide-astro';

let stats;
let batches;
let error = null;

try {
  [stats, batches] = await Promise.all([
    getAdminStats(),
    listBatches({ limit: 5 })
  ]);
} catch (e) {
  error = e instanceof Error ? e.message : 'Failed to load admin data';
}

const statusColors = {
  queued: 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900/30 dark:text-yellow-400',
  processing: 'bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-400',
  completed: 'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400',
  cancelled: 'bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300',
  paused: 'bg-orange-100 text-orange-800 dark:bg-orange-900/30 dark:text-orange-400',
};
---

<Layout title="Admin Dashboard">
  <div class="space-y-6">
    <!-- Header -->
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold tracking-tight">Admin Dashboard</h1>
        <p class="text-sm text-muted-foreground">Manage batch jobs and monitor system health</p>
      </div>
      <div class="flex gap-2">
        <a 
          href="/admin/batches/new" 
          class="inline-flex items-center gap-2 px-4 py-2 bg-primary text-primary-foreground rounded-md text-sm font-medium hover:bg-primary/90 transition-colors"
        >
          <Plus size={16} />
          New Batch
        </a>
      </div>
    </div>

    {error ? (
      <div class="border border-destructive/50 bg-destructive/10 rounded-lg p-4 flex items-start gap-3">
        <AlertTriangle class="text-destructive shrink-0 mt-0.5" size={18} />
        <div>
          <p class="font-medium text-destructive">Failed to load dashboard</p>
          <p class="text-sm text-muted-foreground">{error}</p>
        </div>
      </div>
    ) : (
      <>
        <!-- Stats Grid -->
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
          <!-- System Status -->
          <div class="border rounded-lg p-4 space-y-2">
            <div class="flex items-center gap-2 text-sm text-muted-foreground">
              {stats.systemPaused ? <PauseCircle size={16} class="text-orange-500" /> : <PlayCircle size={16} class="text-green-500" />}
              System Status
            </div>
            <div class="flex items-center justify-between">
              <span class="text-2xl font-bold">{stats.systemPaused ? 'Paused' : 'Running'}</span>
              <button 
                id="toggleSystem"
                data-paused={stats.systemPaused}
                class="text-xs px-2 py-1 rounded border hover:bg-accent transition-colors"
              >
                {stats.systemPaused ? 'Resume' : 'Pause'}
              </button>
            </div>
          </div>

          <!-- Active Batches -->
          <div class="border rounded-lg p-4 space-y-2">
            <div class="flex items-center gap-2 text-sm text-muted-foreground">
              <Layers size={16} />
              Active Batches
            </div>
            <div class="text-2xl font-bold tabular-nums">{stats.batchesActive}</div>
            <p class="text-xs text-muted-foreground">{formatNumber(stats.gamesQueued)} games in queue</p>
          </div>

          <!-- Cost Today -->
          <div class="border rounded-lg p-4 space-y-2">
            <div class="flex items-center gap-2 text-sm text-muted-foreground">
              <DollarSign size={16} />
              Cost Today
            </div>
            <div class="text-2xl font-bold tabular-nums">${stats.costToday.toFixed(2)}</div>
            <p class="text-xs text-muted-foreground">${stats.budgetRemaining.toFixed(2)} remaining</p>
          </div>

          <!-- Budget Progress -->
          <div class="border rounded-lg p-4 space-y-2">
            <div class="flex items-center gap-2 text-sm text-muted-foreground">
              <Activity size={16} />
              Budget Usage
            </div>
            <div class="space-y-1">
              <div class="h-2 bg-muted rounded-full overflow-hidden">
                <div 
                  class="h-full bg-primary transition-all duration-300"
                  style={`width: ${Math.min((stats.costToday / (stats.costToday + stats.budgetRemaining)) * 100, 100)}%`}
                ></div>
              </div>
              <p class="text-xs text-muted-foreground">
                {((stats.costToday / (stats.costToday + stats.budgetRemaining)) * 100).toFixed(1)}% used
              </p>
            </div>
          </div>
        </div>

        <!-- Recent Batches -->
        <section class="space-y-3">
          <div class="flex items-center justify-between">
            <h2 class="font-semibold">Recent Batches</h2>
            <a href="/admin/batches" class="text-sm text-muted-foreground hover:text-foreground">
              View all →
            </a>
          </div>

          <div class="border rounded-lg overflow-hidden">
            <table class="w-full text-sm">
              <thead class="bg-muted/50 border-b">
                <tr>
                  <th class="text-left p-3 font-medium">Name</th>
                  <th class="text-left p-3 font-medium">Status</th>
                  <th class="text-right p-3 font-medium">Progress</th>
                  <th class="text-right p-3 font-medium">Cost</th>
                  <th class="text-right p-3 font-medium">Created</th>
                </tr>
              </thead>
              <tbody class="divide-y">
                {batches.batches.length === 0 ? (
                  <tr>
                    <td colspan="5" class="p-8 text-center text-muted-foreground">
                      No batches yet. <a href="/admin/batches/new" class="underline">Create one</a>
                    </td>
                  </tr>
                ) : (
                  batches.batches.map(batch => (
                    <tr class="hover:bg-muted/30 transition-colors">
                      <td class="p-3">
                        <a href={`/admin/batches/${batch.id}`} class="hover:underline font-medium">
                          {batch.name || batch.id}
                        </a>
                      </td>
                      <td class="p-3">
                        <span class={`inline-flex px-2 py-0.5 rounded-full text-xs font-medium ${statusColors[batch.status]}`}>
                          {batch.status}
                        </span>
                      </td>
                      <td class="p-3 text-right tabular-nums">
                        <div class="flex items-center justify-end gap-2">
                          <span>{batch.completedGames}/{batch.totalGames}</span>
                          <div class="w-16 h-1.5 bg-muted rounded-full overflow-hidden">
                            <div 
                              class="h-full bg-primary"
                              style={`width: ${batch.progress}%`}
                            ></div>
                          </div>
                        </div>
                      </td>
                      <td class="p-3 text-right tabular-nums">
                        ${batch.actualCostUsd.toFixed(4)}
                      </td>
                      <td class="p-3 text-right text-muted-foreground tabular-nums">
                        {new Date(batch.createdAt * 1000).toLocaleDateString()}
                      </td>
                    </tr>
                  ))
                )}
              </tbody>
            </table>
          </div>
        </section>

        <!-- Quick Actions -->
        <section class="grid gap-4 md:grid-cols-3">
          <a 
            href="/admin/batches/new"
            class="border rounded-lg p-4 hover:bg-muted/30 transition-colors group"
          >
            <div class="flex items-center gap-3">
              <div class="p-2 bg-primary/10 rounded-lg">
                <Plus size={20} class="text-primary" />
              </div>
              <div>
                <h3 class="font-medium group-hover:underline">Launch Batch</h3>
                <p class="text-xs text-muted-foreground">Create a new batch of games</p>
              </div>
            </div>
          </a>

          <a 
            href="/admin/batches"
            class="border rounded-lg p-4 hover:bg-muted/30 transition-colors group"
          >
            <div class="flex items-center gap-3">
              <div class="p-2 bg-blue-500/10 rounded-lg">
                <Layers size={20} class="text-blue-500" />
              </div>
              <div>
                <h3 class="font-medium group-hover:underline">Manage Batches</h3>
                <p class="text-xs text-muted-foreground">View and manage all batches</p>
              </div>
            </div>
          </a>

          <a 
            href="/stats"
            class="border rounded-lg p-4 hover:bg-muted/30 transition-colors group"
          >
            <div class="flex items-center gap-3">
              <div class="p-2 bg-green-500/10 rounded-lg">
                <Activity size={20} class="text-green-500" />
              </div>
              <div>
                <h3 class="font-medium group-hover:underline">View Stats</h3>
                <p class="text-xs text-muted-foreground">Analyze game results</p>
              </div>
            </div>
          </a>
        </section>
      </>
    )}
  </div>
</Layout>

<script>
  const API_URL = import.meta.env.PUBLIC_API_URL || 'https://mafia-arena.me-f9a.workers.dev';

  document.getElementById('toggleSystem')?.addEventListener('click', async (e) => {
    const btn = e.target as HTMLButtonElement;
    const isPaused = btn.dataset.paused === 'true';
    
    try {
      btn.disabled = true;
      btn.textContent = 'Working...';
      
      const endpoint = isPaused ? 'resume' : 'pause';
      const res = await fetch(`${API_URL}/api/admin/system/${endpoint}`, { method: 'POST' });
      
      if (!res.ok) throw new Error('Failed to update system state');
      
      // Reload to show updated state
      window.location.reload();
    } catch (err) {
      alert(`Failed to ${isPaused ? 'resume' : 'pause'} system`);
      btn.disabled = false;
      btn.textContent = isPaused ? 'Resume' : 'Pause';
    }
  });
</script>


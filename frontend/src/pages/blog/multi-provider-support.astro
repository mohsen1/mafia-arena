---
import Layout from '../../components/Layout.astro';
import { Calendar, Clock, ArrowLeft, Wrench } from 'lucide-astro';

const post = {
  title: 'New: Support for 15+ AI Providers',
  description: "We've expanded our AI provider integrations to include OpenAI, Anthropic, Google, Mistral, and many more. Here's what this means for the benchmark.",
  date: '2024-12-24',
  readTime: '4 min',
  category: 'update',
};

function formatDate(dateStr: string): string {
  return new Date(dateStr).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<Layout title={post.title}>
  <article class="max-w-2xl">
    <a 
      href="/blog" 
      class="inline-flex items-center gap-1 text-sm text-muted-foreground hover:text-foreground transition-colors mb-6"
    >
      <ArrowLeft class="h-4 w-4" />
      Back to Blog
    </a>

    <header class="mb-8">
      <div class="flex items-center gap-2 mb-3">
        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-blue-500/10 text-blue-600 dark:text-blue-400">
          <Wrench class="h-3 w-3" />
          Update
        </span>
      </div>
      <h1 class="text-3xl font-bold tracking-tight mb-3">{post.title}</h1>
      <p class="text-muted-foreground text-lg leading-relaxed mb-4">
        {post.description}
      </p>
      <div class="flex items-center gap-4 text-sm text-muted-foreground">
        <span class="inline-flex items-center gap-1">
          <Calendar class="h-4 w-4" />
          {formatDate(post.date)}
        </span>
        <span class="inline-flex items-center gap-1">
          <Clock class="h-4 w-4" />
          {post.readTime} read
        </span>
      </div>
    </header>

    <div class="prose prose-zinc dark:prose-invert max-w-none">
      <p>
        We're excited to announce expanded AI provider support in Mafia Arena. Our benchmark now integrates with over 15 different providers, giving us access to dozens of models.
      </p>

      <h2>Supported Providers</h2>
      
      <h3>Direct API Integrations</h3>
      <ul>
        <li><strong>OpenAI</strong>: GPT-4o, GPT-4o Mini, GPT-4 Turbo, o1, o3-mini</li>
        <li><strong>Anthropic</strong>: Claude 3.5 Sonnet, Claude 3 Opus, Claude 3 Haiku</li>
        <li><strong>Google</strong>: Gemini 2.0 Flash, Gemini 1.5 Pro, Gemini 1.5 Flash</li>
        <li><strong>Mistral</strong>: Mistral Large, Mistral Medium, Mixtral</li>
        <li><strong>Minimax</strong>: MiniMax-01</li>
      </ul>

      <h3>Via OpenRouter</h3>
      <ul>
        <li><strong>Meta</strong>: Llama 3.3, Llama 3.1 405B</li>
        <li><strong>xAI</strong>: Grok 2, Grok 2 Mini</li>
        <li><strong>DeepSeek</strong>: DeepSeek V3, DeepSeek R1</li>
        <li><strong>Cohere</strong>: Command R+</li>
        <li>And many more...</li>
      </ul>

      <h2>Why Provider Diversity Matters</h2>
      <p>
        Having broad provider coverage is essential for a meaningful benchmark:
      </p>
      <ol>
        <li><strong>Comprehensive comparison</strong>: See how the latest models from every major lab perform</li>
        <li><strong>No bias</strong>: Results aren't skewed toward any single provider's models</li>
        <li><strong>Future-proof</strong>: Easy to add new models as they're released</li>
        <li><strong>Open source friendliness</strong>: Include both proprietary and open-weight models</li>
      </ol>

      <h2>Technical Implementation</h2>
      <p>
        Our provider system uses a unified adapter interface:
      </p>
      <ul>
        <li>Each provider implements a common <code>AIProvider</code> interface</li>
        <li>Automatic retry logic handles transient failures</li>
        <li>Rate limiting prevents overloading provider APIs</li>
        <li>Structured output parsing ensures consistent response formats</li>
      </ul>

      <h2>What's Next</h2>
      <p>
        We're actively working to add:
      </p>
      <ul>
        <li>Amazon Bedrock (Nova Pro, Titan)</li>
        <li>Together AI for open-source models</li>
        <li>Groq for fast inference</li>
        <li>Additional OpenRouter models as they become available</li>
      </ul>

      <hr />

      <p>
        Check the <a href="/">leaderboard</a> to see how all these models stack up against each other.
      </p>
    </div>

    <footer class="mt-12 pt-6 border-t">
      <a 
        href="/blog" 
        class="inline-flex items-center gap-1 text-sm text-muted-foreground hover:text-foreground transition-colors"
      >
        <ArrowLeft class="h-4 w-4" />
        Back to all posts
      </a>
    </footer>
  </article>
</Layout>

<style>
  .prose h2 {
    font-size: 1.25rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }
  .prose h3 {
    font-size: 1.125rem;
    font-weight: 500;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }
  .prose p {
    line-height: 1.75;
    color: var(--muted-foreground);
    margin-bottom: 1rem;
  }
  .prose ul, .prose ol {
    margin-top: 1rem;
    margin-bottom: 1rem;
    margin-left: 1.5rem;
  }
  .prose ul {
    list-style-type: disc;
  }
  .prose ol {
    list-style-type: decimal;
  }
  .prose li {
    color: var(--muted-foreground);
    margin-bottom: 0.5rem;
  }
  .prose strong {
    color: var(--foreground);
    font-weight: 600;
  }
  .prose code {
    background: var(--muted);
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    font-size: 0.875rem;
    font-family: var(--font-mono);
  }
  .prose a {
    color: var(--foreground);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .prose a:hover {
    color: var(--primary);
  }
  .prose hr {
    margin-top: 2rem;
    margin-bottom: 2rem;
    border-color: var(--border);
  }
</style>

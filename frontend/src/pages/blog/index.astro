---
import Layout from '../../components/Layout.astro';
import { Newspaper } from 'lucide-astro';
---

<Layout title="Blog & Updates">
  <div class="max-w-3xl space-y-8">
    <div>
      <div class="flex items-center gap-2 mb-1">
        <Newspaper class="h-5 w-5 text-muted-foreground" />
        <h1 class="text-2xl font-bold tracking-tight">Blog & Updates</h1>
      </div>
      <p class="text-muted-foreground text-sm">
        Development diaries, technical deep-dives, and announcements from the Mafia Arena team.
      </p>
    </div>

    <section class="border rounded-lg p-8 bg-muted/30 text-center">
      <h2 class="text-xl font-semibold mb-2">Coming Soon</h2>
      <p class="text-muted-foreground">
        We're working on some exciting content. Check back later!
      </p>
    </section>
  </div>
</Layout>

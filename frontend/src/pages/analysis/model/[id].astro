---
import Layout from '../../../components/Layout.astro';
import { getModelPatterns } from '../../../lib/api';
import { ArrowLeft, BarChart3, Trophy, Users, Sparkles } from 'lucide-astro';

const { id } = Astro.params;

let data = null;
let error = null;

try {
  data = await getModelPatterns(id!);
} catch (e) {
  error = e instanceof Error ? e.message : 'Failed to load model analysis';
}

const hasData = data && (data.mafia.length > 0 || data.town.length > 0);
---

<Layout title={data ? `${data.model.display_name} Persona Analysis` : 'Model Analysis'}>
  <div class="space-y-6 max-w-3xl">
    <div class="flex items-center gap-2 text-sm text-muted-foreground">
      <a href="/analysis" class="hover:text-foreground inline-flex items-center gap-1">
        <ArrowLeft size={14} /> Analysis
      </a>
      <span>/</span>
      <span>{data?.model.display_name || id}</span>
    </div>

    {error || !data ? (
      <div class="border rounded-md p-8 text-center text-muted-foreground">
        <p class="text-sm mb-4">Model not found or no persona data available</p>
        <a href="/analysis" class="text-sm font-medium hover:underline">← Back to analysis</a>
      </div>
    ) : (
      <div class="space-y-6">
        <div>
          <h1 class="text-2xl font-bold tracking-tight">{data.model.display_name}</h1>
          <p class="text-muted-foreground text-sm">{data.model.provider} • Persona Fingerprint</p>
        </div>

        <!-- Summary Stats -->
        <div class="grid grid-cols-3 gap-3">
          <div class="border rounded-md p-3">
            <div class="text-[10px] text-muted-foreground uppercase tracking-wider mb-1">Total Games</div>
            <div class="font-bold font-mono tabular-nums">{data.summary.totalGames}</div>
          </div>
          <div class="border rounded-md p-3">
            <div class="text-[10px] text-muted-foreground uppercase tracking-wider mb-1">Win Rate</div>
            <div class="font-bold font-mono tabular-nums">
              {(parseFloat(data.summary.overallWinRate) * 100).toFixed(1)}%
            </div>
          </div>
          <div class="border rounded-md p-3">
            <div class="text-[10px] text-muted-foreground uppercase tracking-wider mb-1">Avg Consistency</div>
            <div class="font-bold font-mono tabular-nums">
              {data.summary.avgConsistency 
                ? `${(parseFloat(data.summary.avgConsistency) * 100).toFixed(0)}%`
                : 'N/A'
              }
            </div>
          </div>
        </div>

        {!hasData ? (
          <div class="border rounded-md p-12 text-center">
            <Sparkles size={48} class="mx-auto text-muted-foreground/30 mb-4" />
            <h3 class="font-semibold mb-2">No Persona Data</h3>
            <p class="text-sm text-muted-foreground">
              This model hasn't played any games with persona generation enabled yet.
            </p>
          </div>
        ) : (
          <>
            <!-- Dominant Personas -->
            {(data.summary.dominantMafiaPersonality || data.summary.dominantTownPersonality) && (
              <section class="grid grid-cols-2 gap-3">
                <div class="border rounded-md p-4 bg-red-500/5">
                  <div class="flex items-center gap-2 mb-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-red-500"></span>
                    <span class="text-xs text-muted-foreground uppercase tracking-wider">Dominant as Mafia</span>
                  </div>
                  {data.summary.dominantMafiaPersonality ? (
                    <div>
                      <div class="font-semibold text-red-600 dark:text-red-400">
                        {data.summary.dominantMafiaPersonality.personality_type}
                      </div>
                      <div class="text-xs text-muted-foreground mt-1">
                        {data.summary.dominantMafiaPersonality.usage_count} uses •
                        {(parseFloat(data.summary.dominantMafiaPersonality.win_rate) * 100).toFixed(0)}% win rate
                      </div>
                    </div>
                  ) : (
                    <div class="text-sm text-muted-foreground">No data</div>
                  )}
                </div>
                <div class="border rounded-md p-4 bg-blue-500/5">
                  <div class="flex items-center gap-2 mb-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-blue-500"></span>
                    <span class="text-xs text-muted-foreground uppercase tracking-wider">Dominant as Town</span>
                  </div>
                  {data.summary.dominantTownPersonality ? (
                    <div>
                      <div class="font-semibold text-blue-600 dark:text-blue-400">
                        {data.summary.dominantTownPersonality.personality_type}
                      </div>
                      <div class="text-xs text-muted-foreground mt-1">
                        {data.summary.dominantTownPersonality.usage_count} uses •
                        {(parseFloat(data.summary.dominantTownPersonality.win_rate) * 100).toFixed(0)}% win rate
                      </div>
                    </div>
                  ) : (
                    <div class="text-sm text-muted-foreground">No data</div>
                  )}
                </div>
              </section>
            )}

            <!-- Detailed Patterns -->
            <div class="grid md:grid-cols-2 gap-4">
              <!-- Mafia Patterns -->
              <section class="border rounded-md overflow-hidden">
                <div class="px-4 py-2 bg-red-500/10 border-b">
                  <span class="font-semibold text-red-600 dark:text-red-400 flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-red-500"></span>
                    Mafia Patterns
                  </span>
                </div>
                <table class="w-full text-sm">
                  <thead>
                    <tr class="border-b bg-muted/50">
                      <th class="h-8 px-3 text-left font-medium text-muted-foreground text-xs">Personality</th>
                      <th class="h-8 px-3 text-right font-medium text-muted-foreground text-xs">Uses</th>
                      <th class="h-8 px-3 text-right font-medium text-muted-foreground text-xs">Win %</th>
                    </tr>
                  </thead>
                  <tbody>
                    {data.mafia.map((pattern: any) => (
                      <tr class="border-b last:border-0">
                        <td class="h-9 px-3 font-medium">{pattern.personality_type}</td>
                        <td class="h-9 px-3 text-right font-mono text-muted-foreground text-xs">
                          {pattern.usage_count}
                        </td>
                        <td class="h-9 px-3 text-right font-mono font-semibold text-xs">
                          {(parseFloat(pattern.win_rate) * 100).toFixed(0)}%
                        </td>
                      </tr>
                    ))}
                    {data.mafia.length === 0 && (
                      <tr>
                        <td colspan="3" class="h-12 text-center text-muted-foreground text-xs">
                          No mafia games yet
                        </td>
                      </tr>
                    )}
                  </tbody>
                </table>
              </section>

              <!-- Town Patterns -->
              <section class="border rounded-md overflow-hidden">
                <div class="px-4 py-2 bg-blue-500/10 border-b">
                  <span class="font-semibold text-blue-600 dark:text-blue-400 flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-blue-500"></span>
                    Town Patterns
                  </span>
                </div>
                <table class="w-full text-sm">
                  <thead>
                    <tr class="border-b bg-muted/50">
                      <th class="h-8 px-3 text-left font-medium text-muted-foreground text-xs">Personality</th>
                      <th class="h-8 px-3 text-right font-medium text-muted-foreground text-xs">Uses</th>
                      <th class="h-8 px-3 text-right font-medium text-muted-foreground text-xs">Win %</th>
                    </tr>
                  </thead>
                  <tbody>
                    {data.town.map((pattern: any) => (
                      <tr class="border-b last:border-0">
                        <td class="h-9 px-3 font-medium">{pattern.personality_type}</td>
                        <td class="h-9 px-3 text-right font-mono text-muted-foreground text-xs">
                          {pattern.usage_count}
                        </td>
                        <td class="h-9 px-3 text-right font-mono font-semibold text-xs">
                          {(parseFloat(pattern.win_rate) * 100).toFixed(0)}%
                        </td>
                      </tr>
                    ))}
                    {data.town.length === 0 && (
                      <tr>
                        <td colspan="3" class="h-12 text-center text-muted-foreground text-xs">
                          No town games yet
                        </td>
                      </tr>
                    )}
                  </tbody>
                </table>
              </section>
            </div>

            <!-- Insights -->
            <section class="border rounded-md p-4 bg-muted/30">
              <h3 class="font-semibold text-sm mb-2">Model Fingerprint Insights</h3>
              <p class="text-sm text-muted-foreground">
                This model's persona choices reveal its approach to social deduction.
                {data.summary.dominantMafiaPersonality?.personality_type !== data.summary.dominantTownPersonality?.personality_type 
                  ? ` Notably, it tends toward "${data.summary.dominantMafiaPersonality?.personality_type}" when playing Mafia but "${data.summary.dominantTownPersonality?.personality_type}" when playing Town - a potential strategic adaptation.`
                  : data.summary.dominantMafiaPersonality?.personality_type
                    ? ` It consistently gravitates toward "${data.summary.dominantMafiaPersonality?.personality_type}" personas regardless of team.`
                    : ''
                }
              </p>
            </section>
          </>
        )}
      </div>
    )}
  </div>
</Layout>


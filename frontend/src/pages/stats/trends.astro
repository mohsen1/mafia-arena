---
import Layout from '../../components/Layout.astro';
import StatsNav from '../../components/StatsNav.astro';
import { getTrends, formatNumber, formatRelativeTime } from '../../lib/api';
import { Activity, Ghost, Shield, Clock, ArrowRight } from 'lucide-astro';

const days = parseInt(Astro.url.searchParams.get('days') || '30');
const data = await getTrends(days);

const chartLabels = data.daily.map(d => d.date);
const mafiaData = data.daily.map(d => d.mafia_wins);
const townData = data.daily.map(d => d.town_wins);

const totalGames = data.daily.reduce((sum, d) => sum + d.games, 0);
const totalMafiaWins = data.daily.reduce((sum, d) => sum + d.mafia_wins, 0);
const totalTownWins = data.daily.reduce((sum, d) => sum + d.town_wins, 0);
const totalTokens = data.daily.reduce((sum, d) => sum + d.tokens, 0);
const avgPerDay = data.daily.length > 0 ? (totalGames / data.daily.length).toFixed(1) : '0';
---

<Layout title="Activity Trends">
  <div class="space-y-4">
    <div>
      <h1 class="text-lg font-semibold">Activity Trends</h1>
      <p class="text-muted-foreground text-xs">Game activity over time</p>
    </div>

    <StatsNav currentPath={Astro.url.pathname} />

    <!-- Time Range -->
    <div class="flex items-center gap-1">
      {[7, 30, 90].map(d => (
        <a
          href={`/stats/trends?days=${d}`}
          class:list={[
            "px-2.5 py-1 text-xs rounded border transition-colors",
            days === d ? "bg-foreground text-background border-foreground" : "hover:bg-muted"
          ]}
        >{d}d</a>
      ))}
      <span class="ml-auto text-[10px] text-muted-foreground">{avgPerDay} games/day avg</span>
    </div>

    <!-- Summary Row -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
      <div class="bg-card border rounded-md p-3">
        <div class="flex items-center gap-2 text-muted-foreground mb-1">
          <Activity class="h-3.5 w-3.5" />
          <span class="text-[10px] uppercase tracking-wide font-medium">Games</span>
        </div>
        <p class="text-xl font-bold tabular-nums">{totalGames}</p>
        <p class="text-[10px] text-muted-foreground">last {days} days</p>
      </div>

      <div class="bg-card border rounded-md p-3 border-red-500/30">
        <div class="flex items-center gap-2 text-red-500 mb-1">
          <Ghost class="h-3.5 w-3.5" />
          <span class="text-[10px] uppercase tracking-wide font-medium">Mafia</span>
        </div>
        <p class="text-xl font-bold tabular-nums">{totalMafiaWins}</p>
        <p class="text-[10px] text-muted-foreground">{totalGames > 0 ? ((totalMafiaWins/totalGames)*100).toFixed(0) : 0}% win rate</p>
      </div>

      <div class="bg-card border rounded-md p-3 border-blue-500/30">
        <div class="flex items-center gap-2 text-blue-500 mb-1">
          <Shield class="h-3.5 w-3.5" />
          <span class="text-[10px] uppercase tracking-wide font-medium">Town</span>
        </div>
        <p class="text-xl font-bold tabular-nums">{totalTownWins}</p>
        <p class="text-[10px] text-muted-foreground">{totalGames > 0 ? ((totalTownWins/totalGames)*100).toFixed(0) : 0}% win rate</p>
      </div>

      <div class="bg-card border rounded-md p-3">
        <div class="flex items-center gap-2 text-muted-foreground mb-1">
          <Clock class="h-3.5 w-3.5" />
          <span class="text-[10px] uppercase tracking-wide font-medium">Tokens</span>
        </div>
        <p class="text-xl font-bold tabular-nums">{formatNumber(totalTokens)}</p>
      </div>
    </div>

    <!-- Chart -->
    <div class="bg-card border rounded-md overflow-hidden">
      <div class="px-3 py-2 border-b bg-muted/30 flex items-center justify-between">
        <h2 class="text-sm font-semibold">Daily Activity</h2>
        <div class="flex items-center gap-3 text-[10px]">
          <span class="flex items-center gap-1"><span class="w-2 h-2 rounded bg-red-500"></span>Mafia</span>
          <span class="flex items-center gap-1"><span class="w-2 h-2 rounded bg-blue-500"></span>Town</span>
        </div>
      </div>
      
      {data.daily.length === 0 ? (
        <div class="p-8 text-center text-sm text-muted-foreground">No activity data</div>
      ) : (
        <div class="p-3 h-[200px]">
          <canvas id="trendsChart"></canvas>
        </div>
      )}
    </div>

    <div class="grid gap-4 lg:grid-cols-2">
      <!-- Daily Table -->
      {data.daily.length > 0 && (
        <div class="bg-card border rounded-md overflow-hidden">
          <div class="px-3 py-2 border-b bg-muted/30">
            <h2 class="text-sm font-semibold">Daily Breakdown</h2>
          </div>
          <div class="max-h-[280px] overflow-y-auto">
            <table class="w-full text-xs">
              <thead class="sticky top-0 bg-card">
                <tr class="text-muted-foreground border-b">
                  <th class="text-left p-2 font-medium">Date</th>
                  <th class="text-right p-2 font-medium">Games</th>
                  <th class="text-right p-2 font-medium text-red-500">M</th>
                  <th class="text-right p-2 font-medium text-blue-500">T</th>
                  <th class="text-right p-2 font-medium">Tokens</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-border/50">
                {data.daily.slice().reverse().map(day => (
                  <tr class="hover:bg-muted/30">
                    <td class="p-2 font-medium tabular-nums">{day.date}</td>
                    <td class="text-right p-2 tabular-nums">{day.games}</td>
                    <td class="text-right p-2 tabular-nums text-red-500">{day.mafia_wins}</td>
                    <td class="text-right p-2 tabular-nums text-blue-500">{day.town_wins}</td>
                    <td class="text-right p-2 tabular-nums text-muted-foreground">{formatNumber(day.tokens)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )}

      <!-- Recent Games -->
      <div class="bg-card border rounded-md overflow-hidden">
        <div class="px-3 py-2 border-b bg-muted/30 flex items-center justify-between">
          <h2 class="text-sm font-semibold">Recent Games</h2>
          <a href="/games" class="text-[10px] text-muted-foreground hover:text-foreground flex items-center gap-0.5">
            View all <ArrowRight class="h-3 w-3" />
          </a>
        </div>
        
        {data.recent.length === 0 ? (
          <p class="text-xs text-muted-foreground p-4 text-center">No recent games</p>
        ) : (
          <div class="divide-y divide-border/50 max-h-[280px] overflow-y-auto">
            {data.recent.map(game => (
              <a href={`/games/${game.id}`} class="flex items-center justify-between px-3 py-2 hover:bg-muted/30 transition-colors">
                <div class="flex items-center gap-2 min-w-0">
                  {game.winner === 'mafia' ? (
                    <Ghost class="h-3.5 w-3.5 text-red-500 shrink-0" />
                  ) : (
                    <Shield class="h-3.5 w-3.5 text-blue-500 shrink-0" />
                  )}
                  <div class="min-w-0">
                    <p class="text-xs">
                      <span class={game.winner === 'mafia' ? 'text-red-500 font-medium' : 'text-blue-500 font-medium'}>
                        {game.winner === 'mafia' ? 'Mafia' : 'Town'}
                      </span>
                      <span class="text-muted-foreground"> · {game.rounds}r</span>
                    </p>
                    <p class="text-[10px] text-muted-foreground truncate max-w-[180px]">{game.models}</p>
                  </div>
                </div>
                <div class="text-right text-[10px] text-muted-foreground shrink-0 ml-2">
                  <p>{formatRelativeTime(game.created_at > 9999999999 ? game.created_at : game.created_at * 1000)}</p>
                </div>
              </a>
            ))}
          </div>
        )}
      </div>
    </div>
  </div>
</Layout>

<script define:vars={{ chartLabels, mafiaData, townData }}>
  import('chart.js').then(({ Chart, registerables }) => {
    Chart.register(...registerables);
    
    const ctx = document.getElementById('trendsChart');
    if (!ctx) return;

    const isDark = document.documentElement.classList.contains('dark');
    const gridColor = isDark ? 'rgba(255,255,255,0.06)' : 'rgba(0,0,0,0.06)';
    const textColor = isDark ? 'rgba(255,255,255,0.5)' : 'rgba(0,0,0,0.5)';

    new Chart(ctx, {
      type: 'bar',
      data: {
        labels: chartLabels,
        datasets: [
          {
            label: 'Mafia',
            data: mafiaData,
            backgroundColor: 'rgba(239, 68, 68, 0.85)',
            borderRadius: 2,
            stack: 'wins',
          },
          {
            label: 'Town',
            data: townData,
            backgroundColor: 'rgba(59, 130, 246, 0.85)',
            borderRadius: 2,
            stack: 'wins',
          },
        ],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        interaction: { mode: 'index', intersect: false },
        plugins: {
          legend: { display: false },
          tooltip: {
            backgroundColor: isDark ? '#1f2937' : '#fff',
            titleColor: isDark ? '#fff' : '#000',
            bodyColor: isDark ? '#9ca3af' : '#6b7280',
            borderColor: isDark ? '#374151' : '#e5e7eb',
            borderWidth: 1,
            padding: 8,
            displayColors: true,
            boxWidth: 8,
            boxHeight: 8,
          },
        },
        scales: {
          x: {
            grid: { display: false },
            ticks: { color: textColor, font: { size: 9 }, maxRotation: 45, minRotation: 45 },
          },
          y: {
            grid: { color: gridColor },
            ticks: { color: textColor, font: { size: 9 } },
            beginAtZero: true,
          },
        },
      },
    });
  });
</script>

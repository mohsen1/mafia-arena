---
import Layout from '../../components/Layout.astro';
import StatsNav from '../../components/StatsNav.astro';
import { getStatsOverview, formatNumber, formatDuration } from '../../lib/api';
import { calculateCostFromTotal, formatCost } from '../../lib/costs';
import { Ghost, Shield, Gamepad2, Coins, Clock, Trophy, TrendingUp } from 'lucide-astro';

const stats = await getStatsOverview();

const mafiaWinRate = stats.totals.games > 0 
  ? ((stats.totals.mafiaWins / stats.totals.games) * 100).toFixed(1)
  : '0';
const townWinRate = stats.totals.games > 0 
  ? ((stats.totals.townWins / stats.totals.games) * 100).toFixed(1)
  : '0';

const estimatedCost = stats.totals.tokens > 0 
  ? calculateCostFromTotal('gpt-4o', stats.totals.tokens) 
  : 0;

const providerColors: Record<string, string> = {
  openai: 'text-emerald-600 dark:text-emerald-400',
  anthropic: 'text-orange-600 dark:text-orange-400',
  google: 'text-blue-600 dark:text-blue-400',
};
---

<Layout title="Stats Overview">
  <div class="space-y-4">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-lg font-semibold">Statistics</h1>
        <p class="text-muted-foreground text-xs">Aggregate performance metrics</p>
      </div>
    </div>

    <StatsNav currentPath={Astro.url.pathname} />

    <!-- Compact Metrics Row -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2">
      <div class="bg-card border rounded-md p-3">
        <div class="flex items-center gap-2 text-muted-foreground mb-1">
          <Gamepad2 class="h-3.5 w-3.5" />
          <span class="text-[10px] uppercase tracking-wide font-medium">Games</span>
        </div>
        <p class="text-xl font-bold tabular-nums">{formatNumber(stats.totals.games)}</p>
      </div>

      <div class="bg-card border rounded-md p-3">
        <div class="flex items-center gap-2 text-muted-foreground mb-1">
          <Coins class="h-3.5 w-3.5" />
          <span class="text-[10px] uppercase tracking-wide font-medium">Tokens</span>
        </div>
        <p class="text-xl font-bold tabular-nums">{formatNumber(stats.totals.tokens)}</p>
        <p class="text-[10px] text-muted-foreground">~{formatCost(estimatedCost)}</p>
      </div>

      <div class="bg-card border rounded-md p-3">
        <div class="flex items-center gap-2 text-muted-foreground mb-1">
          <Clock class="h-3.5 w-3.5" />
          <span class="text-[10px] uppercase tracking-wide font-medium">Avg Time</span>
        </div>
        <p class="text-xl font-bold tabular-nums">{formatDuration(stats.totals.avgDurationMs)}</p>
        <p class="text-[10px] text-muted-foreground">{stats.totals.avgRounds.toFixed(1)} rounds</p>
      </div>

      <div class="bg-card border rounded-md p-3">
        <div class="flex items-center gap-2 text-muted-foreground mb-1">
          <TrendingUp class="h-3.5 w-3.5" />
          <span class="text-[10px] uppercase tracking-wide font-medium">Avg Rounds</span>
        </div>
        <p class="text-xl font-bold tabular-nums">{stats.totals.avgRounds.toFixed(1)}</p>
      </div>

      <div class="bg-card border rounded-md p-3 border-red-500/30">
        <div class="flex items-center gap-2 text-red-500 mb-1">
          <Ghost class="h-3.5 w-3.5" />
          <span class="text-[10px] uppercase tracking-wide font-medium">Mafia</span>
        </div>
        <p class="text-xl font-bold tabular-nums">{mafiaWinRate}%</p>
        <p class="text-[10px] text-muted-foreground">{stats.totals.mafiaWins} wins</p>
      </div>

      <div class="bg-card border rounded-md p-3 border-blue-500/30">
        <div class="flex items-center gap-2 text-blue-500 mb-1">
          <Shield class="h-3.5 w-3.5" />
          <span class="text-[10px] uppercase tracking-wide font-medium">Town</span>
        </div>
        <p class="text-xl font-bold tabular-nums">{townWinRate}%</p>
        <p class="text-[10px] text-muted-foreground">{stats.totals.townWins} wins</p>
      </div>
    </div>

    <!-- Win Distribution Bar -->
    <div class="bg-card border rounded-md p-3">
      <div class="flex items-center justify-between text-xs mb-2">
        <span class="text-red-500 font-medium">Mafia {mafiaWinRate}%</span>
        <span class="text-muted-foreground">Win Distribution</span>
        <span class="text-blue-500 font-medium">Town {townWinRate}%</span>
      </div>
      <div class="h-2 bg-muted rounded-full overflow-hidden flex">
        <div class="bg-red-500 transition-all" style={`width: ${mafiaWinRate}%`} />
        <div class="bg-blue-500 transition-all" style={`width: ${townWinRate}%`} />
      </div>
    </div>

    <div class="grid gap-4 lg:grid-cols-2">
      <!-- Top Models Table -->
      <div class="bg-card border rounded-md">
        <div class="flex items-center gap-2 p-3 border-b">
          <Trophy class="h-3.5 w-3.5 text-amber-500" />
          <h2 class="text-sm font-semibold">Top Models</h2>
          <span class="text-[10px] text-muted-foreground ml-auto">min 3 games</span>
        </div>
        
        {stats.topModels.length === 0 ? (
          <p class="text-xs text-muted-foreground p-4 text-center">Not enough data</p>
        ) : (
          <div class="divide-y">
            {stats.topModels.map((model, i) => (
              <div class="flex items-center gap-3 px-3 py-2 hover:bg-muted/50">
                <span class="w-5 h-5 rounded bg-muted text-[10px] font-bold flex items-center justify-center">
                  {i + 1}
                </span>
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-medium truncate">{model.display_name}</p>
                  <p class="text-[10px] text-muted-foreground">{model.provider}</p>
                </div>
                <div class="text-right">
                  <p class="text-sm font-bold tabular-nums">{(model.win_rate * 100).toFixed(1)}%</p>
                  <p class="text-[10px] text-muted-foreground tabular-nums">{model.wins}/{model.games}</p>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>

      <!-- Provider Stats -->
      <div class="bg-card border rounded-md">
        <div class="p-3 border-b">
          <h2 class="text-sm font-semibold">By Provider</h2>
        </div>
        
        {stats.byProvider.length === 0 ? (
          <p class="text-xs text-muted-foreground p-4 text-center">No data</p>
        ) : (
          <div class="divide-y">
            {stats.byProvider.map((p) => {
              const winRate = p.games > 0 ? ((p.wins / p.games) * 100).toFixed(1) : '0';
              return (
                <div class="flex items-center justify-between px-3 py-2 hover:bg-muted/50">
                  <span class={`text-sm font-semibold capitalize ${providerColors[p.provider] || ''}`}>
                    {p.provider}
                  </span>
                  <div class="flex items-center gap-4 text-xs">
                    <span class="tabular-nums text-muted-foreground">{p.games} games</span>
                    <span class="tabular-nums font-bold w-14 text-right">{winRate}%</span>
                  </div>
                </div>
              );
            })}
          </div>
        )}
      </div>
    </div>
  </div>
</Layout>

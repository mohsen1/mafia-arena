---
import Layout from '../../components/Layout.astro';
import StatsNav from '../../components/StatsNav.astro';
import { getMatchups } from '../../lib/api';

const team = Astro.url.searchParams.get('team') as 'mafia' | 'town' | null;
const data = await getMatchups(team || undefined);

// Deduplicate models by display_name (merge variants)
const modelMap = new Map<string, { id: string; display_name: string; provider: string; ids: string[] }>();
for (const m of data.models) {
  const existing = modelMap.get(m.display_name);
  if (existing) {
    existing.ids.push(m.id);
  } else {
    modelMap.set(m.display_name, { ...m, ids: [m.id] });
  }
}
const uniqueModels = Array.from(modelMap.values());

// Build matchup matrix with deduplication
const matrix: Record<string, Record<string, { games: number; wins: number; rate: number }>> = {};

for (const rowModel of uniqueModels) {
  matrix[rowModel.display_name] = {};
  for (const colModel of uniqueModels) {
    let totalGames = 0;
    let totalWins = 0;
    
    // Aggregate all matchups between model variants
    for (const rowId of rowModel.ids) {
      for (const colId of colModel.ids) {
        const matchup = data.matchups.find(m => m.model_a === rowId && m.model_b === colId);
        if (matchup) {
          totalGames += matchup.games;
          totalWins += matchup.model_a_wins;
        }
      }
    }
    
    if (totalGames > 0) {
      matrix[rowModel.display_name][colModel.display_name] = {
        games: totalGames,
        wins: totalWins,
        rate: totalWins / totalGames,
      };
    }
  }
}

// Build self-play map with deduplication
const selfPlayMap: Record<string, { games: number; mafiaWins: number; townWins: number; mafiaRate: number; townRate: number }> = {};
for (const model of uniqueModels) {
  let totalGames = 0;
  let totalMafiaWins = 0;
  let totalTownWins = 0;
  
  for (const id of model.ids) {
    const sp = data.selfPlay?.find(s => s.model_id === id);
    if (sp) {
      totalGames += sp.games;
      totalMafiaWins += sp.mafia_wins;
      totalTownWins += sp.town_wins;
    }
  }
  
  if (totalGames > 0) {
    selfPlayMap[model.display_name] = {
      games: totalGames,
      mafiaWins: totalMafiaWins,
      townWins: totalTownWins,
      mafiaRate: totalMafiaWins / totalGames,
      townRate: totalTownWins / totalGames,
    };
  }
}

// Sort models by total games played (descending)
uniqueModels.sort((a, b) => {
  const aGames = Object.values(matrix[a.display_name] || {}).reduce((sum, cell) => sum + cell.games, 0);
  const bGames = Object.values(matrix[b.display_name] || {}).reduce((sum, cell) => sum + cell.games, 0);
  return bGames - aGames;
});

// Calculate max games for intensity scaling
let maxGames = 1;
for (const rowModel of uniqueModels) {
  for (const colModel of uniqueModels) {
    const cell = matrix[rowModel.display_name]?.[colModel.display_name];
    if (cell && cell.games > maxGames) maxGames = cell.games;
  }
}

function getShortName(name: string): string {
  // Handle common patterns
  return name
    .replace('Claude 3.5 ', 'C3.5 ')
    .replace('Claude 3 ', 'C3 ')
    .replace('Claude ', 'C ')
    .replace('GPT-4o', 'GPT-4o')
    .replace('GPT-4', 'GPT-4')
    .replace('GPT-3.5', 'GPT-3.5')
    .replace('Gemini 2.5 ', 'G2.5 ')
    .replace('Gemini 2.0 ', 'G2.0 ')
    .replace('Gemini 1.5 ', 'G1.5 ')
    .replace('Gemini 3 ', 'G3 ')
    .replace(' Pro', 'P')
    .replace(' Flash', 'F')
    .replace(' Thinking', 'T');
}

function getProviderColor(provider: string): string {
  switch (provider.toLowerCase()) {
    case 'anthropic': return 'text-amber-600 dark:text-amber-400';
    case 'openai': return 'text-emerald-600 dark:text-emerald-400';
    case 'google': return 'text-sky-600 dark:text-sky-400';
    default: return 'text-muted-foreground';
  }
}

function getProviderIcon(provider: string): string {
  switch (provider.toLowerCase()) {
    case 'anthropic': return '◉';
    case 'openai': return '◆';
    case 'google': return '▲';
    default: return '•';
  }
}
---

<Layout title="Model Matchups">
  <div class="space-y-6">
    <!-- Header -->
    <div class="flex items-start justify-between">
      <div>
        <h1 class="text-xl font-bold tracking-tight">Head-to-Head Matrix</h1>
        <p class="text-muted-foreground text-sm mt-1">Win rates when models face each other · Row vs Column</p>
      </div>
      <div class="flex items-center gap-3 text-xs">
        <div class="flex items-center gap-1.5">
          <span class="text-amber-600 dark:text-amber-400 font-medium">◉</span>
          <span class="text-muted-foreground">Anthropic</span>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="text-emerald-600 dark:text-emerald-400 font-medium">◆</span>
          <span class="text-muted-foreground">OpenAI</span>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="text-sky-600 dark:text-sky-400 font-medium">▲</span>
          <span class="text-muted-foreground">Google</span>
        </div>
      </div>
    </div>

    <StatsNav currentPath={Astro.url.pathname} />

    <!-- Team Filter Pills -->
    <div class="flex items-center gap-2">
      <span class="text-xs text-muted-foreground font-medium uppercase tracking-wide">Filter:</span>
      <div class="flex rounded-lg border overflow-hidden">
        <a
          href="/stats/matchups"
          class:list={[
            "px-4 py-2 text-sm font-medium transition-all",
            !team 
              ? "bg-foreground text-background" 
              : "hover:bg-muted text-muted-foreground hover:text-foreground"
          ]}
        >All Games</a>
        <a
          href="/stats/matchups?team=mafia"
          class:list={[
            "px-4 py-2 text-sm font-medium border-l transition-all",
            team === 'mafia' 
              ? "bg-red-500/90 text-white" 
              : "hover:bg-red-500/10 text-muted-foreground hover:text-red-500"
          ]}
        >As Mafia</a>
        <a
          href="/stats/matchups?team=town"
          class:list={[
            "px-4 py-2 text-sm font-medium border-l transition-all",
            team === 'town' 
              ? "bg-blue-500/90 text-white" 
              : "hover:bg-blue-500/10 text-muted-foreground hover:text-blue-500"
          ]}
        >As Town</a>
      </div>
    </div>

    {uniqueModels.length === 0 ? (
      <div class="rounded-xl border-2 border-dashed p-12 text-center">
        <div class="text-4xl mb-3">🎭</div>
        <p class="text-muted-foreground">No matchup data available yet</p>
        <p class="text-xs text-muted-foreground mt-1">Run some games to see head-to-head statistics</p>
      </div>
    ) : (
      <div class="space-y-4">
        <!-- Legend -->
        <div class="flex items-center justify-between text-xs">
          <div class="flex items-center gap-4">
            <span class="text-muted-foreground">Row model's win rate against column model</span>
            {!team && (
              <span class="text-muted-foreground border-l pl-4">
                Diagonal = self-play <span class="text-purple-500">(M=Mafia wins, T=Town wins)</span>
              </span>
            )}
          </div>
          <div class="flex items-center gap-1">
            <div class="flex items-center rounded-md overflow-hidden border">
              <div class="w-8 h-6 bg-gradient-to-r from-red-600 to-red-500"></div>
              <div class="w-8 h-6 bg-gradient-to-r from-red-500 to-orange-400"></div>
              <div class="w-8 h-6 bg-gradient-to-r from-orange-400 to-yellow-400"></div>
              <div class="w-8 h-6 bg-gradient-to-r from-yellow-400 to-lime-400"></div>
              <div class="w-8 h-6 bg-gradient-to-r from-lime-400 to-emerald-500"></div>
              <div class="w-8 h-6 bg-gradient-to-r from-emerald-500 to-emerald-600"></div>
            </div>
            <span class="text-muted-foreground ml-2">0%</span>
            <span class="text-muted-foreground">→</span>
            <span class="text-muted-foreground">100%</span>
          </div>
        </div>

        <!-- Heatmap -->
        <div class="rounded-xl border bg-card overflow-hidden shadow-sm">
          <div class="overflow-x-auto">
            <table class="w-full border-collapse" id="matchup-matrix">
              <thead>
                <tr>
                  <th class="sticky left-0 z-20 bg-card p-0">
                    <div class="w-40 h-12 flex items-end justify-end px-3 pb-2 border-b border-r bg-gradient-to-br from-muted/50 to-transparent">
                      <span class="text-[10px] text-muted-foreground uppercase tracking-wider font-medium">vs →</span>
                    </div>
                  </th>
                  {uniqueModels.map(m => (
                    <th class="p-0 border-b min-w-[72px]">
                      <div class="h-12 flex flex-col items-center justify-end pb-2 px-1">
                        <span class:list={["text-[10px] font-medium", getProviderColor(m.provider)]}>
                          {getProviderIcon(m.provider)}
                        </span>
                        <span 
                          class="text-xs font-semibold truncate max-w-[68px] cursor-help"
                          title={m.display_name}
                        >
                          {getShortName(m.display_name)}
                        </span>
                      </div>
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {uniqueModels.map((rowModel, rowIdx) => (
                  <tr class="group">
                    <td class="sticky left-0 z-10 bg-card p-0 border-r">
                      <div class="w-40 h-[52px] flex items-center gap-2 px-3 group-hover:bg-muted/50 transition-colors">
                        <span class:list={["text-sm font-medium", getProviderColor(rowModel.provider)]}>
                          {getProviderIcon(rowModel.provider)}
                        </span>
                        <span 
                          class="text-sm font-medium truncate cursor-help flex-1"
                          title={rowModel.display_name}
                        >
                          {getShortName(rowModel.display_name)}
                        </span>
                      </div>
                    </td>
                    {uniqueModels.map((colModel, colIdx) => {
                      const cell = matrix[rowModel.display_name]?.[colModel.display_name];
                      const isSelf = rowModel.display_name === colModel.display_name;
                      const selfPlay = isSelf && !team ? selfPlayMap[rowModel.display_name] : null;
                      
                      // Calculate color based on win rate
                      const getHeatColor = (rate: number, games: number): string => {
                        if (games === 0) return 'bg-transparent';
                        
                        // Opacity based on sample size
                        const opacity = Math.min(0.95, 0.3 + (games / maxGames) * 0.65);
                        
                        if (rate < 0.25) return `rgba(220, 38, 38, ${opacity})`; // red-600
                        if (rate < 0.35) return `rgba(239, 68, 68, ${opacity})`; // red-500
                        if (rate < 0.45) return `rgba(251, 146, 60, ${opacity})`; // orange-400
                        if (rate < 0.55) return `rgba(250, 204, 21, ${opacity})`; // yellow-400
                        if (rate < 0.65) return `rgba(163, 230, 53, ${opacity})`; // lime-400
                        if (rate < 0.75) return `rgba(34, 197, 94, ${opacity})`; // green-500
                        return `rgba(5, 150, 105, ${opacity})`; // emerald-600
                      };
                      
                      const getTextColor = (rate: number): string => {
                        if (rate < 0.35 || rate > 0.65) return 'text-white';
                        return 'text-zinc-900';
                      };
                      
                      return (
                        <td class="p-0.5">
                          {isSelf ? (
                            selfPlay ? (
                              <div 
                                class="heatmap-cell w-full h-[48px] rounded-md flex flex-col items-center justify-center cursor-help transition-all hover:scale-105 hover:z-10 hover:shadow-lg relative"
                                style={`background: linear-gradient(135deg, rgba(139, 92, 246, 0.7) 0%, rgba(168, 85, 247, 0.7) 100%);`}
                                data-tooltip={`Self-play: ${rowModel.display_name}\n\nMafia wins: ${selfPlay.mafiaWins}/${selfPlay.games} (${(selfPlay.mafiaRate * 100).toFixed(0)}%)\nTown wins: ${selfPlay.townWins}/${selfPlay.games} (${(selfPlay.townRate * 100).toFixed(0)}%)`}
                              >
                                <span class="font-bold text-white text-sm">
                                  {selfPlay.mafiaRate > selfPlay.townRate ? 'M' : selfPlay.townRate > selfPlay.mafiaRate ? 'T' : '='}{(Math.max(selfPlay.mafiaRate, selfPlay.townRate) * 100).toFixed(0)}%
                                </span>
                                <span class="text-[10px] text-white/70 font-medium">{selfPlay.games}g</span>
                              </div>
                            ) : (
                              <div class="w-full h-[48px] rounded-md bg-zinc-100 dark:bg-zinc-800/50 flex items-center justify-center">
                                <span class="text-zinc-400 dark:text-zinc-600">—</span>
                              </div>
                            )
                          ) : cell ? (
                            <div 
                              class="heatmap-cell w-full h-[48px] rounded-md flex flex-col items-center justify-center cursor-help transition-all hover:scale-105 hover:z-10 hover:shadow-lg relative"
                              style={`background: ${getHeatColor(cell.rate, cell.games)};`}
                              data-tooltip={`${rowModel.display_name}\nvs ${colModel.display_name}\n\nWins: ${cell.wins}/${cell.games}\nWin Rate: ${(cell.rate * 100).toFixed(1)}%`}
                            >
                              <span class={`font-bold text-sm ${getTextColor(cell.rate)}`}>
                                {(cell.rate * 100).toFixed(0)}%
                              </span>
                              <span class={`text-[10px] font-medium ${cell.rate < 0.35 || cell.rate > 0.65 ? 'text-white/70' : 'text-zinc-900/60'}`}>
                                {cell.games}g
                              </span>
                            </div>
                          ) : (
                            <div class="w-full h-[48px] rounded-md bg-zinc-50 dark:bg-zinc-900/30 flex items-center justify-center">
                              <span class="text-zinc-300 dark:text-zinc-700 text-xs">—</span>
                            </div>
                          )}
                        </td>
                      );
                    })}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Summary Stats -->
        <div class="grid grid-cols-3 gap-4">
          <div class="rounded-lg border bg-card p-4">
            <div class="text-xs text-muted-foreground uppercase tracking-wide font-medium">Models</div>
            <div class="text-2xl font-bold mt-1">{uniqueModels.length}</div>
            <div class="text-xs text-muted-foreground mt-1">in matchup data</div>
          </div>
          <div class="rounded-lg border bg-card p-4">
            <div class="text-xs text-muted-foreground uppercase tracking-wide font-medium">Total Matchups</div>
            <div class="text-2xl font-bold mt-1">
              {Object.values(matrix).reduce((sum, row) => 
                sum + Object.values(row).filter(c => c.games > 0).length, 0
              )}
            </div>
            <div class="text-xs text-muted-foreground mt-1">unique pairs</div>
          </div>
          <div class="rounded-lg border bg-card p-4">
            <div class="text-xs text-muted-foreground uppercase tracking-wide font-medium">Games Analyzed</div>
            <div class="text-2xl font-bold mt-1">
              {Math.round(Object.values(matrix).reduce((sum, row) => 
                sum + Object.values(row).reduce((s, c) => s + c.games, 0), 0
              ) / 2)}
            </div>
            <div class="text-xs text-muted-foreground mt-1">head-to-head</div>
          </div>
        </div>
      </div>
    )}
  </div>
</Layout>

<style>
  /* Tooltip styles */
  .heatmap-cell {
    position: relative;
  }
  
  .heatmap-cell::after {
    content: attr(data-tooltip);
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
    background: var(--popover);
    color: var(--popover-foreground);
    border: 1px solid var(--border);
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 12px;
    line-height: 1.5;
    white-space: pre-line;
    text-align: left;
    min-width: 180px;
    max-width: 250px;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.15s, visibility 0.15s;
    z-index: 50;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.15), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
    pointer-events: none;
  }
  
  .heatmap-cell::before {
    content: '';
    position: absolute;
    bottom: calc(100% + 4px);
    left: 50%;
    transform: translateX(-50%);
    border: 6px solid transparent;
    border-top-color: var(--border);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.15s, visibility 0.15s;
    z-index: 51;
  }
  
  .heatmap-cell:hover::after,
  .heatmap-cell:hover::before {
    opacity: 1;
    visibility: visible;
  }
  
  /* Dark mode tooltip arrow fix */
  .dark .heatmap-cell::before {
    border-top-color: var(--border);
  }
  
  /* Smooth table scrolling */
  #matchup-matrix {
    border-spacing: 2px;
  }
  
  /* Header gradient effect */
  thead th {
    background: linear-gradient(180deg, var(--muted) 0%, transparent 100%);
  }
  
  /* Row hover effect */
  tbody tr:hover td:first-child {
    background: var(--muted);
  }
</style>

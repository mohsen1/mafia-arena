---
import Layout from '../../components/Layout.astro';
import GameCard from '../../components/GameCard.astro';
import { getGames } from '../../lib/api';

const { games } = await getGames();
---

<Layout title="Recent Games">
  <div class="space-y-8">
    <div class="flex items-end justify-between gap-4">
      <div class="space-y-2">
        <h1 class="text-4xl font-bold tracking-tight">Recent Games</h1>
        <p class="text-muted-foreground text-lg">
          Explore full transcripts and replays of recent battles.
        </p>
      </div>
    </div>

    {games.length === 0 ? (
      <div class="flex flex-col items-center justify-center min-h-[400px] border border-dashed rounded-xl p-8 text-center space-y-4">
        <div class="bg-muted rounded-full p-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground"><path d="m8 3 4 8 5-5 5 15H2L8 3z"/></svg>
        </div>
        <div class="space-y-1">
          <h2 class="text-xl font-semibold">No games found</h2>
          <p class="text-muted-foreground max-w-sm mx-auto">
            It looks like no games have been played yet. Trigger a game from the CLI to see it here!
          </p>
        </div>
      </div>
    ) : (
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {games.map(game => (
          <GameCard game={game} />
        ))}
      </div>
    )}
  </div>
</Layout>

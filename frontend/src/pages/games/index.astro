---
import Layout from '../../components/Layout.astro';
import { getGames } from '../../lib/api';
import { getProviderColorFromModel } from '../../lib/providers';
import { ChevronLeft, ChevronRight, Trophy } from 'lucide-astro';

const LIMIT = 20;
const page = parseInt(Astro.url.searchParams.get('page') || '1', 10);
const offset = (page - 1) * LIMIT;

const { games, total, hasMore } = await getGames(LIMIT, offset);
const totalPages = Math.ceil(total / LIMIT);

const hasPrev = page > 1;
const hasNext = hasMore;

function formatDate(timestamp: number) {
  const ts = timestamp > 9999999999 ? timestamp : timestamp * 1000;
  return new Date(ts).toLocaleString(undefined, {
    month: 'short',
    day: 'numeric',
    hour: '2-digit',
    minute: '2-digit'
  });
}

function getMatchup(game: any) {
  const participants = game.participants || [];
  const mafia = participants.find((p: any) => p.team === 'mafia');
  const town = participants.find((p: any) => p.team === 'town');
  const mafiaModel = mafia?.model_name || mafia?.model_id || '?';
  const townModel = town?.model_name || town?.model_id || '?';
  const mafiaWon = game.winner === 'mafia';
  return {
    mafia: mafiaModel,
    town: townModel,
    mafiaColor: getProviderColorFromModel(mafiaModel),
    townColor: getProviderColorFromModel(townModel),
    winner: mafiaWon ? mafiaModel : townModel,
    winnerTeam: game.winner,
  };
}
---

<Layout title="Games">
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold tracking-tight">Games</h1>
        <p class="text-muted-foreground text-sm">{total} games played</p>
      </div>
    </div>

    {games.length === 0 ? (
      <div class="border rounded-md p-8 text-center text-muted-foreground">
        <p class="text-sm">No games yet</p>
      </div>
    ) : (
      <div class="space-y-4">
        <div class="border rounded-md overflow-hidden">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b bg-muted/50">
                <th class="h-9 px-3 text-left font-medium text-muted-foreground">Matchup</th>
                <th class="h-9 px-3 text-left font-medium text-muted-foreground">Winner</th>
                <th class="h-9 px-3 text-right font-medium text-muted-foreground">Rounds</th>
                <th class="h-9 px-3 text-right font-medium text-muted-foreground">Date</th>
              </tr>
            </thead>
            <tbody>
              {games.map(game => {
                const matchup = getMatchup(game);
                const mafiaWon = game.winner === 'mafia';
                return (
                  <tr class="border-b last:border-0 hover:bg-muted/50 transition-colors group">
                    <td class="h-12 p-0">
                      <a href={`/games/${game.id}`} class="flex items-center gap-2 text-sm px-3 h-full">
                        <span class={`font-semibold px-2 py-1 rounded inline-flex items-center gap-1.5 transition-all ${mafiaWon ? 'bg-rose-500/15 text-rose-700 dark:text-rose-400 ring-1 ring-rose-500/30' : 'text-muted-foreground opacity-60'}`}>
                          <span class="w-2.5 h-2.5 rounded-full flex-shrink-0" style={`background: ${matchup.mafiaColor}`}></span>
                          {matchup.mafia}
                        </span>
                        <span class="text-muted-foreground font-bold">vs</span>
                        <span class={`font-semibold px-2 py-1 rounded inline-flex items-center gap-1.5 transition-all ${!mafiaWon ? 'bg-indigo-500/15 text-indigo-700 dark:text-indigo-400 ring-1 ring-indigo-500/30' : 'text-muted-foreground opacity-60'}`}>
                          <span class="w-2.5 h-2.5 rounded-full flex-shrink-0" style={`background: ${matchup.townColor}`}></span>
                          {matchup.town}
                        </span>
                      </a>
                    </td>
                    <td class="h-12 p-0">
                      <a href={`/games/${game.id}`} class="flex items-center gap-2 px-3 h-full">
                        <Trophy size={16} class={mafiaWon ? 'text-rose-600 dark:text-rose-400' : 'text-indigo-600 dark:text-indigo-400'} />
                        <div>
                          <span class={`text-sm font-bold ${mafiaWon ? 'text-rose-700 dark:text-rose-400' : 'text-indigo-700 dark:text-indigo-400'}`}>
                            {matchup.winner}
                          </span>
                          <span class={`ml-2 text-[10px] px-1.5 py-0.5 rounded font-semibold uppercase tracking-wide ${mafiaWon ? 'bg-rose-500/20 text-rose-700 dark:text-rose-400' : 'bg-indigo-500/20 text-indigo-700 dark:text-indigo-400'}`}>
                            {mafiaWon ? 'Mafia' : 'Town'}
                          </span>
                        </div>
                      </a>
                    </td>
                    <td class="h-12 p-0 text-right font-mono tabular-nums text-muted-foreground">
                      <a href={`/games/${game.id}`} class="flex items-center justify-end px-3 h-full">{game.rounds}</a>
                    </td>
                    <td class="h-12 p-0 text-right text-muted-foreground text-xs">
                      <a href={`/games/${game.id}`} class="flex items-center justify-end px-3 h-full">{formatDate(game.created_at)}</a>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>

        {totalPages > 1 && (
          <div class="flex items-center justify-between text-sm">
            <span class="text-muted-foreground">
              Page {page} of {totalPages}
            </span>
            <div class="flex items-center gap-2">
              {hasPrev ? (
                <a 
                  href={`/games?page=${page - 1}`}
                  class="inline-flex items-center gap-1 px-2 h-8 border rounded hover:bg-muted transition-colors"
                >
                  <ChevronLeft size={14} /> Prev
                </a>
              ) : (
                <span class="inline-flex items-center gap-1 px-2 h-8 border rounded text-muted-foreground opacity-50 cursor-not-allowed">
                  <ChevronLeft size={14} /> Prev
                </span>
              )}
              {hasNext ? (
                <a 
                  href={`/games?page=${page + 1}`}
                  class="inline-flex items-center gap-1 px-2 h-8 border rounded hover:bg-muted transition-colors"
                >
                  Next <ChevronRight size={14} />
                </a>
              ) : (
                <span class="inline-flex items-center gap-1 px-2 h-8 border rounded text-muted-foreground opacity-50 cursor-not-allowed">
                  Next <ChevronRight size={14} />
                </span>
              )}
            </div>
          </div>
        )}
      </div>
    )}
  </div>
</Layout>

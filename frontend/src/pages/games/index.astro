---
import Layout from '../../components/Layout.astro';
import { getGames, getLiveGames, getMatchups, formatDuration, type GameFilters } from '../../lib/api';
import { getDisplayCost, formatCost } from '../../lib/costs';
import { ChevronLeft, ChevronRight, ChevronDown, Radio, X } from 'lucide-astro';

const LIMIT = 25;
const page = parseInt(Astro.url.searchParams.get('page') || '1', 10);
const offset = (page - 1) * LIMIT;

// Extract filters from URL
const modelFilter = Astro.url.searchParams.get('model') || undefined;
const winnerFilter = Astro.url.searchParams.get('winner') as 'mafia' | 'town' | undefined;
const themeFilter = Astro.url.searchParams.get('theme') as 'noir' | 'victorian' | 'modern' | 'fantasy' | undefined;

const filters: GameFilters = {};
if (modelFilter) filters.model = modelFilter;
if (winnerFilter && (winnerFilter === 'mafia' || winnerFilter === 'town')) filters.winner = winnerFilter;
if (themeFilter && ['noir', 'victorian', 'modern', 'fantasy'].includes(themeFilter)) filters.theme = themeFilter;

const hasFilters = Object.keys(filters).length > 0;

// Fetch data in parallel - use matchups API to get models that have actually played games
let liveGamesResult, completedGamesResult, matchupsData;
try {
  [liveGamesResult, completedGamesResult, matchupsData] = await Promise.all([
    getLiveGames(),
    getGames(LIMIT, offset, 'completed', filters),
    getMatchups(),
  ]);
} catch (error) {
  // If API is unavailable, use empty defaults
  liveGamesResult = { games: [], total: 0 };
  completedGamesResult = { games: [], total: 0, hasMore: false };
  matchupsData = { models: [], matchups: [] };
}

const liveGames = liveGamesResult.games;
const games = completedGamesResult.games;
const total = completedGamesResult.total;
const hasMore = completedGamesResult.hasMore;
const totalPages = Math.ceil(total / LIMIT);

// Models that have participated in games (from matchups data)
const activeModels = matchupsData.models.filter(m => !m.id.startsWith('test/'));

const hasPrev = page > 1;
const hasNext = hasMore;

// Build pagination URL with filters preserved
function buildUrl(newPage: number): string {
  const params = new URLSearchParams();
  params.set('page', String(newPage));
  if (modelFilter) params.set('model', modelFilter);
  if (winnerFilter) params.set('winner', winnerFilter);
  if (themeFilter) params.set('theme', themeFilter);
  return `/games?${params}`;
}

// Get the display name for the selected model
const selectedModelName = modelFilter 
  ? activeModels.find(m => m.id === modelFilter)?.display_name || modelFilter 
  : null;

function formatRelativeTime(timestamp: number | string | null | undefined): string {
  if (timestamp == null) {
    return '—';
  }
  
  let ts: number;
  if (typeof timestamp === 'string') {
    ts = new Date(timestamp).getTime();
  } else if (Number.isFinite(timestamp)) {
    ts = timestamp > 9999999999 ? timestamp : timestamp * 1000;
  } else {
    return '—';
  }
  
  if (isNaN(ts)) return '—';
  
  const now = Date.now();
  const diffMs = now - ts;
  const diffSec = Math.floor(diffMs / 1000);
  const diffMin = Math.floor(diffSec / 60);
  const diffHour = Math.floor(diffMin / 60);
  const diffDay = Math.floor(diffHour / 24);
  
  const rtf = new Intl.RelativeTimeFormat('en', { numeric: 'auto' });
  
  if (diffDay > 0) return rtf.format(-diffDay, 'day');
  if (diffHour > 0) return rtf.format(-diffHour, 'hour');
  if (diffMin > 0) return rtf.format(-diffMin, 'minute');
  return rtf.format(-diffSec, 'second');
}

function getShortModelName(modelId: string): string {
  let name = modelId.split('/').pop() || modelId;
  if (name.includes(': ')) {
    name = name.split(': ').slice(1).join(': ');
  }
  return name.replace(/-\d{4}-\d{2}-\d{2}$/, '').replace(/@.*$/, '');
}

function formatDisplayModelName(name: string): string {
  return name.split('-').map(part => {
    if (part.match(/^\d/)) return part;
    if (part === 'gpt' || part === 'o1' || part === 'o3') return part.toUpperCase();
    return part.charAt(0).toUpperCase() + part.slice(1);
  }).join(' ');
}

function getMatchup(game: any) {
  const participants = game.participants || [];
  const mafia = participants.find((p: any) => p.team === 'mafia');
  const town = participants.find((p: any) => p.team === 'town');
  const mafiaModel = mafia?.model_name || mafia?.model_id || '?';
  const townModel = town?.model_name || town?.model_id || '?';
  const mafiaWon = game.winner === 'mafia';
  const shortMafia = getShortModelName(mafiaModel);
  const shortTown = getShortModelName(townModel);
  return {
    mafia: formatDisplayModelName(shortMafia),
    town: formatDisplayModelName(shortTown),
    mafiaWon,
    winnerModel: mafiaWon ? formatDisplayModelName(shortMafia) : formatDisplayModelName(shortTown),
  };
}

function getGameCost(game: any): number {
  return getDisplayCost(game.cost_usd, game.total_tokens || 0);
}

const THEMES: Record<string, string> = {
  noir: 'Noir',
  victorian: 'Victorian',
  modern: 'Modern',
  fantasy: 'Fantasy',
};

// Group models by provider for better UX in dropdown
const modelsByProvider = activeModels.reduce((acc, model) => {
  const provider = model.provider || 'other';
  if (!acc[provider]) acc[provider] = [];
  acc[provider].push(model);
  return acc;
}, {} as Record<string, typeof activeModels>);

const providerOrder = ['anthropic', 'openai', 'google', 'meta', 'other'];
const sortedProviders = Object.keys(modelsByProvider).sort((a, b) => {
  const aIndex = providerOrder.indexOf(a.toLowerCase());
  const bIndex = providerOrder.indexOf(b.toLowerCase());
  return (aIndex === -1 ? 999 : aIndex) - (bIndex === -1 ? 999 : bIndex);
});
---

<Layout title="Games">
  <div class="space-y-4">
    <!-- Header -->
    <div class="flex items-baseline justify-between">
      <h1 class="text-lg font-semibold">Games</h1>
      <span class="text-xs text-muted-foreground">
        {total} {hasFilters ? 'matching' : 'completed'}{liveGames.length > 0 && !hasFilters ? ` · ${liveGames.length} live` : ''}
      </span>
    </div>

    <!-- Filter Bar -->
    <div class="flex flex-wrap items-center gap-2">
      <!-- Model Filter -->
      <div class="relative">
        <select 
          id="model-filter"
          class="appearance-none text-xs border rounded px-2 py-1 pr-6 bg-background hover:bg-muted/50 transition-colors cursor-pointer focus:outline-none focus:ring-1 focus:ring-primary"
          onchange="updateFilters()"
        >
          <option value="">All Models</option>
          {sortedProviders.map(provider => (
            <optgroup label={provider.charAt(0).toUpperCase() + provider.slice(1)}>
              {modelsByProvider[provider].map(model => (
                <option value={model.id} selected={model.id === modelFilter}>
                  {model.display_name}
                </option>
              ))}
            </optgroup>
          ))}
        </select>
        <ChevronDown size={12} class="absolute right-1.5 top-1/2 -translate-y-1/2 pointer-events-none text-muted-foreground" />
      </div>

      <!-- Winner Filter -->
      <div class="relative">
        <select 
          id="winner-filter"
          class="appearance-none text-xs border rounded px-2 py-1 pr-6 bg-background hover:bg-muted/50 transition-colors cursor-pointer focus:outline-none focus:ring-1 focus:ring-primary"
          onchange="updateFilters()"
        >
          <option value="">All Winners</option>
          <option value="mafia" selected={winnerFilter === 'mafia'}>Mafia</option>
          <option value="town" selected={winnerFilter === 'town'}>Town</option>
        </select>
        <ChevronDown size={12} class="absolute right-1.5 top-1/2 -translate-y-1/2 pointer-events-none text-muted-foreground" />
      </div>

      <!-- Theme Filter -->
      <div class="relative">
        <select 
          id="theme-filter"
          class="appearance-none text-xs border rounded px-2 py-1 pr-6 bg-background hover:bg-muted/50 transition-colors cursor-pointer focus:outline-none focus:ring-1 focus:ring-primary"
          onchange="updateFilters()"
        >
          <option value="">All Themes</option>
          <option value="noir" selected={themeFilter === 'noir'}>Noir</option>
          <option value="victorian" selected={themeFilter === 'victorian'}>Victorian</option>
          <option value="modern" selected={themeFilter === 'modern'}>Modern</option>
          <option value="fantasy" selected={themeFilter === 'fantasy'}>Fantasy</option>
        </select>
        <ChevronDown size={12} class="absolute right-1.5 top-1/2 -translate-y-1/2 pointer-events-none text-muted-foreground" />
      </div>

      <!-- Clear Filters -->
      {hasFilters && (
        <a 
          href="/games" 
          class="inline-flex items-center gap-1 text-xs text-muted-foreground hover:text-foreground transition-colors"
        >
          <X size={12} />
          Clear
        </a>
      )}

      <!-- Active Filter Pills -->
      {hasFilters && (
        <div class="flex items-center gap-1.5 ml-auto">
          {selectedModelName && (
            <span class="inline-flex items-center gap-1 text-[10px] px-2 py-0.5 rounded-full bg-primary/10 text-primary">
              {selectedModelName}
            </span>
          )}
          {winnerFilter && (
            <span class={`inline-flex items-center gap-1 text-[10px] px-2 py-0.5 rounded-full ${
              winnerFilter === 'mafia' 
                ? 'bg-rose-500/10 text-rose-600 dark:text-rose-400' 
                : 'bg-indigo-500/10 text-indigo-600 dark:text-indigo-400'
            }`}>
              {winnerFilter === 'mafia' ? 'Mafia wins' : 'Town wins'}
            </span>
          )}
          {themeFilter && (
            <span class="inline-flex items-center gap-1 text-[10px] px-2 py-0.5 rounded-full bg-amber-500/10 text-amber-600 dark:text-amber-400">
              {THEMES[themeFilter]}
            </span>
          )}
        </div>
      )}
    </div>

    <!-- Live Games (only show when no filters) -->
    {!hasFilters && liveGames.length > 0 && (
      <div class="space-y-1.5">
        <div class="flex items-center gap-1.5 text-[10px] text-muted-foreground uppercase tracking-wide">
          <span class="relative flex h-1.5 w-1.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-rose-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-rose-500"></span>
          </span>
          Live
        </div>
        {liveGames.map(game => {
          const m = getMatchup(game);
          return (
            <a 
              href={`/games/${game.id}/live`} 
              class="flex items-center justify-between border rounded px-3 py-2 hover:bg-muted/30 transition-colors text-xs group"
            >
              <div class="flex items-center gap-2">
                <span class="font-medium">{m.mafia}</span>
                <span class="text-muted-foreground/40 text-[10px] font-bold">vs</span>
                <span class="font-medium">{m.town}</span>
                {game.rounds > 0 && <span class="text-muted-foreground/50 text-[10px]">R{game.rounds}</span>}
              </div>
              <span class="flex items-center gap-1 text-muted-foreground group-hover:text-foreground transition-colors">
                <Radio size={10} />
                Watch
              </span>
            </a>
          );
        })}
      </div>
    )}

    <!-- Games List -->
    {games.length === 0 ? (
      <div class="border rounded py-8 text-center text-sm text-muted-foreground">
        {hasFilters ? 'No games match the selected filters' : 'No games yet'}
      </div>
    ) : (
      <div class="border rounded overflow-hidden text-xs">
        <table class="w-full">
          <thead>
            <tr class="bg-muted/30 border-b text-[10px] text-muted-foreground uppercase tracking-wide">
              <th class="text-left font-normal px-3 py-1.5 w-[40%]">Matchup <span class="normal-case font-light opacity-70">(Mafia vs Town)</span></th>
              <th class="text-left font-normal px-3 py-1.5 w-[20%]">Winner</th>
              <th class="text-center font-normal px-2 py-1.5 w-14">Rounds</th>
              <th class="text-right font-normal px-2 py-1.5 w-16">Time</th>
              <th class="text-right font-normal px-2 py-1.5 w-14">Cost</th>
              <th class="text-center font-normal px-2 py-1.5 w-20">Theme</th>
              <th class="text-right font-normal px-3 py-1.5">Date</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border/50">
            {games.map(game => {
              const m = getMatchup(game);
              const theme = (game.persona_theme && THEMES[game.persona_theme]) || 'Noir';
              const cost = getGameCost(game);
              return (
                <tr class="hover:bg-muted/20 transition-colors cursor-pointer group" onclick={`window.location='/games/${game.id}'`}>
                  <td class="px-3 py-1.5 max-w-0">
                    <a href={`/games/${game.id}`} class="flex items-center gap-1.5 truncate text-muted-foreground">
                      <span class="truncate">{m.mafia}</span>
                      <span class="text-muted-foreground/30 text-[10px] shrink-0">vs</span>
                      <span class="truncate">{m.town}</span>
                    </a>
                  </td>
                  <td class="px-3 py-1.5">
                    <div class="flex items-center gap-1.5">
                      <span class="truncate">{m.winnerModel}</span>
                      <span class={`shrink-0 text-[9px] px-1 rounded ${
                        m.mafiaWon ? 'bg-rose-500/10 text-rose-600 dark:text-rose-400' : 'bg-indigo-500/10 text-indigo-600 dark:text-indigo-400'
                      }`}>
                        {m.mafiaWon ? 'M' : 'T'}
                      </span>
                    </div>
                  </td>
                  <td class="px-2 py-1.5 text-center font-mono text-muted-foreground">{game.rounds}</td>
                  <td class="px-2 py-1.5 text-right font-mono text-muted-foreground whitespace-nowrap">{formatDuration(game.duration_ms || 0)}</td>
                  <td class="px-2 py-1.5 text-right font-mono text-muted-foreground">{formatCost(cost)}</td>
                  <td class="px-2 py-1.5 text-center text-muted-foreground">{theme}</td>
                  <td class="px-3 py-1.5 text-right text-muted-foreground whitespace-nowrap">{formatRelativeTime(game.created_at)}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    )}

    <!-- Pagination -->
    {totalPages > 1 && (
      <div class="flex items-center justify-between text-xs">
        <span class="text-muted-foreground">
          {page}/{totalPages}
        </span>
        <div class="flex items-center gap-1">
          {hasPrev ? (
            <a 
              href={buildUrl(page - 1)}
              class="inline-flex items-center gap-0.5 px-2 py-1 border rounded hover:bg-muted transition-colors"
            >
              <ChevronLeft size={12} /> Prev
            </a>
          ) : (
            <span class="inline-flex items-center gap-0.5 px-2 py-1 border rounded text-muted-foreground/50 cursor-not-allowed">
              <ChevronLeft size={12} /> Prev
            </span>
          )}
          {hasNext ? (
            <a 
              href={buildUrl(page + 1)}
              class="inline-flex items-center gap-0.5 px-2 py-1 border rounded hover:bg-muted transition-colors"
            >
              Next <ChevronRight size={12} />
            </a>
          ) : (
            <span class="inline-flex items-center gap-0.5 px-2 py-1 border rounded text-muted-foreground/50 cursor-not-allowed">
              Next <ChevronRight size={12} />
            </span>
          )}
        </div>
      </div>
    )}
  </div>
</Layout>

<script>
  function updateFilters() {
    const modelSelect = document.getElementById('model-filter') as HTMLSelectElement;
    const winnerSelect = document.getElementById('winner-filter') as HTMLSelectElement;
    const themeSelect = document.getElementById('theme-filter') as HTMLSelectElement;
    
    const params = new URLSearchParams();
    
    if (modelSelect?.value) params.set('model', modelSelect.value);
    if (winnerSelect?.value) params.set('winner', winnerSelect.value);
    if (themeSelect?.value) params.set('theme', themeSelect.value);
    
    const queryString = params.toString();
    window.location.href = '/games' + (queryString ? `?${queryString}` : '');
  }
  
  // Expose to global scope for inline handlers
  (window as any).updateFilters = updateFilters;
</script>

---
import Layout from '../../components/Layout.astro';
import { getGames } from '../../lib/api';
import { ChevronLeft, ChevronRight } from 'lucide-astro';

const LIMIT = 20;
const page = parseInt(Astro.url.searchParams.get('page') || '1', 10);
const offset = (page - 1) * LIMIT;

const { games, total, hasMore } = await getGames(LIMIT, offset);
const totalPages = Math.ceil(total / LIMIT);

const hasPrev = page > 1;
const hasNext = hasMore;

function formatDate(timestamp: number) {
  // Handle both unix timestamp (seconds) and milliseconds
  const ts = timestamp > 9999999999 ? timestamp : timestamp * 1000;
  return new Date(ts).toLocaleString(undefined, {
    month: 'short',
    day: 'numeric',
    hour: '2-digit',
    minute: '2-digit'
  });
}

function getMatchup(game: any) {
  const participants = game.participants || [];
  const mafia = participants.find((p: any) => p.team === 'mafia');
  const town = participants.find((p: any) => p.team === 'town');
  return {
    mafia: mafia?.model_name || mafia?.model_id || '?',
    town: town?.model_name || town?.model_id || '?',
  };
}
---

<Layout title="Games">
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold tracking-tight">Games</h1>
        <p class="text-muted-foreground text-sm">{total} games played</p>
      </div>
    </div>

    {games.length === 0 ? (
      <div class="border rounded-md p-8 text-center text-muted-foreground">
        <p class="text-sm">No games yet</p>
      </div>
    ) : (
      <div class="space-y-4">
        <div class="border rounded-md overflow-hidden">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b bg-muted/50">
                <th class="h-9 px-3 text-left font-medium text-muted-foreground">Matchup</th>
                <th class="h-9 px-3 text-left font-medium text-muted-foreground">Result</th>
                <th class="h-9 px-3 text-right font-medium text-muted-foreground">Rounds</th>
                <th class="h-9 px-3 text-right font-medium text-muted-foreground">Date</th>
              </tr>
            </thead>
            <tbody>
              {games.map(game => {
                const matchup = getMatchup(game);
                const mafiaWon = game.winner === 'mafia';
                return (
                  <tr 
                    class="border-b last:border-0 hover:bg-muted/50 transition-colors cursor-pointer"
                    onclick={`window.location.href='/games/${game.id}'`}
                  >
                    <td class="h-12 px-3">
                      <div class="flex items-center gap-2 text-xs">
                        <span class={`font-medium px-1.5 py-0.5 rounded ${mafiaWon ? 'bg-red-500/15 text-red-600 dark:text-red-400 ring-1 ring-red-500/20' : 'text-muted-foreground'}`}>
                          {matchup.mafia}
                        </span>
                        <span class="text-muted-foreground">vs</span>
                        <span class={`font-medium px-1.5 py-0.5 rounded ${!mafiaWon ? 'bg-blue-500/15 text-blue-600 dark:text-blue-400 ring-1 ring-blue-500/20' : 'text-muted-foreground'}`}>
                          {matchup.town}
                        </span>
                      </div>
                    </td>
                    <td class="h-12 px-3">
                      <span class={`inline-flex items-center gap-1.5 text-xs font-semibold ${
                        mafiaWon 
                          ? 'text-red-600 dark:text-red-400' 
                          : 'text-blue-600 dark:text-blue-400'
                      }`}>
                        <span class={`w-2 h-2 rounded-full ${mafiaWon ? 'bg-red-500' : 'bg-blue-500'}`}></span>
                        {mafiaWon ? 'Mafia wins' : 'Town wins'}
                      </span>
                    </td>
                    <td class="h-12 px-3 text-right font-mono tabular-nums text-muted-foreground">
                      {game.rounds}
                    </td>
                    <td class="h-12 px-3 text-right text-muted-foreground text-xs">
                      {formatDate(game.created_at)}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>

        {totalPages > 1 && (
          <div class="flex items-center justify-between text-sm">
            <span class="text-muted-foreground">
              Page {page} of {totalPages}
            </span>
            <div class="flex items-center gap-2">
              {hasPrev ? (
                <a 
                  href={`/games?page=${page - 1}`}
                  class="inline-flex items-center gap-1 px-2 h-8 border rounded hover:bg-muted transition-colors"
                >
                  <ChevronLeft size={14} /> Prev
                </a>
              ) : (
                <span class="inline-flex items-center gap-1 px-2 h-8 border rounded text-muted-foreground opacity-50 cursor-not-allowed">
                  <ChevronLeft size={14} /> Prev
                </span>
              )}
              {hasNext ? (
                <a 
                  href={`/games?page=${page + 1}`}
                  class="inline-flex items-center gap-1 px-2 h-8 border rounded hover:bg-muted transition-colors"
                >
                  Next <ChevronRight size={14} />
                </a>
              ) : (
                <span class="inline-flex items-center gap-1 px-2 h-8 border rounded text-muted-foreground opacity-50 cursor-not-allowed">
                  Next <ChevronRight size={14} />
                </span>
              )}
            </div>
          </div>
        )}
      </div>
    )}
  </div>
</Layout>

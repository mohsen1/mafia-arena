---
import Layout from '../../components/Layout.astro';
import { getGames, getLiveGames, formatDuration } from '../../lib/api';
import { getProviderColorFromModel } from '../../lib/providers';
import { calculateCostFromTotal, formatCost } from '../../lib/costs';
import { ChevronLeft, ChevronRight, Trophy, Radio, Hash } from 'lucide-astro';

const LIMIT = 25;
const page = parseInt(Astro.url.searchParams.get('page') || '1', 10);
const offset = (page - 1) * LIMIT;

const [liveGamesResult, completedGamesResult] = await Promise.all([
  getLiveGames(),
  getGames(LIMIT, offset, 'completed'),
]);

const liveGames = liveGamesResult.games;
const games = completedGamesResult.games;
const total = completedGamesResult.total;
const hasMore = completedGamesResult.hasMore;
const totalPages = Math.ceil(total / LIMIT);

const hasPrev = page > 1;
const hasNext = hasMore;

function formatDate(timestamp: number) {
  const ts = timestamp > 9999999999 ? timestamp : timestamp * 1000;
  return new Date(ts).toLocaleString(undefined, {
    month: 'short',
    day: 'numeric',
    hour: '2-digit',
    minute: '2-digit'
  });
}

function getShortModelName(modelId: string): string {
  const name = modelId.split('/').pop() || modelId;
  return name.replace(/-\d{4}-\d{2}-\d{2}$/, '').replace(/@.*$/, '');
}

function getMatchup(game: any) {
  const participants = game.participants || [];
  const mafia = participants.find((p: any) => p.team === 'mafia');
  const town = participants.find((p: any) => p.team === 'town');
  const mafiaModel = mafia?.model_name || mafia?.model_id || '?';
  const townModel = town?.model_name || town?.model_id || '?';
  const mafiaWon = game.winner === 'mafia';
  return {
    mafia: getShortModelName(mafiaModel),
    town: getShortModelName(townModel),
    mafiaColor: getProviderColorFromModel(mafiaModel),
    townColor: getProviderColorFromModel(townModel),
    mafiaWon,
    winnerModel: mafiaWon ? getShortModelName(mafiaModel) : getShortModelName(townModel),
    winnerModelFull: mafiaWon ? mafiaModel : townModel,
  };
}

function estimateCost(game: any): number {
  const participants = game.participants || [];
  const models = participants.map((p: any) => p.model_id || p.model_name);
  const primaryModel = models[0] || 'unknown';
  return calculateCostFromTotal(primaryModel, game.total_tokens || 0);
}

const THEMES: Record<string, string> = {
  noir: 'Noir',
  victorian: 'Victorian',
  modern: 'Modern',
  fantasy: 'Fantasy',
};
---

<Layout title="Games">
  <div class="space-y-4">
    <!-- Header -->
    <div class="flex items-baseline justify-between">
      <h1 class="text-lg font-semibold">Games</h1>
      <span class="text-xs text-muted-foreground">
        {total} completed{liveGames.length > 0 ? ` · ${liveGames.length} live` : ''}
      </span>
    </div>

    <!-- Live Games -->
    {liveGames.length > 0 && (
      <div class="space-y-1.5">
        <div class="flex items-center gap-1.5 text-[10px] text-muted-foreground uppercase tracking-wide">
          <span class="relative flex h-1.5 w-1.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-rose-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-rose-500"></span>
          </span>
          Live
        </div>
        {liveGames.map(game => {
          const m = getMatchup(game);
          return (
            <a 
              href={`/games/${game.id}/live`} 
              class="flex items-center justify-between border rounded px-3 py-1.5 hover:bg-muted/20 transition-colors text-xs"
            >
              <span class="text-muted-foreground">
                {m.mafia} <span class="opacity-50">vs</span> {m.town}
                {game.rounds > 0 && <span class="opacity-50"> · R{game.rounds}</span>}
              </span>
              <span class="flex items-center gap-1 text-muted-foreground hover:text-foreground">
                <Radio size={10} />
                Watch
              </span>
            </a>
          );
        })}
      </div>
    )}

    <!-- Games List -->
    {games.length === 0 ? (
      <div class="border rounded py-8 text-center text-sm text-muted-foreground">
        No games yet
      </div>
    ) : (
      <div class="border rounded overflow-hidden text-xs">
        <!-- Header -->
        <div class="flex items-center px-3 py-1.5 bg-muted/30 border-b text-[10px] text-muted-foreground uppercase tracking-wide">
          <div class="w-[280px]">Matchup</div>
          <div class="w-[160px]">Winner</div>
          <div class="w-10 text-center">Rnd</div>
          <div class="w-14 text-right">Time</div>
          <div class="w-14 text-right">Cost</div>
          <div class="w-14 text-center">Theme</div>
          <div class="flex-1 text-right">Date</div>
        </div>
        <!-- Rows -->
        <div class="divide-y divide-border/50">
          {games.map(game => {
            const m = getMatchup(game);
            const theme = THEMES[game.persona_theme] || 'Noir';
            const cost = estimateCost(game);
            return (
              <a 
                href={`/games/${game.id}`} 
                class="flex items-center px-3 py-1.5 hover:bg-muted/20 transition-colors"
              >
                <!-- Matchup -->
                <div class="w-[280px] truncate text-muted-foreground">
                  {m.mafia} <span class="opacity-50">vs</span> {m.town}
                </div>

                <!-- Winner -->
                <div class="w-[160px] flex items-center gap-1.5">
                  <span class="truncate">{m.winnerModel}</span>
                  <span class={`shrink-0 text-[9px] px-1 rounded ${
                    m.mafiaWon ? 'bg-rose-500/10 text-rose-600 dark:text-rose-400' : 'bg-indigo-500/10 text-indigo-600 dark:text-indigo-400'
                  }`}>
                    {m.mafiaWon ? 'M' : 'T'}
                  </span>
                </div>

                <!-- Rounds -->
                <div class="w-10 text-center font-mono text-muted-foreground">{game.rounds}</div>

                <!-- Duration -->
                <div class="w-14 text-right font-mono text-muted-foreground">
                  {formatDuration(game.duration_ms || 0)}
                </div>

                <!-- Cost -->
                <div class="w-14 text-right font-mono text-muted-foreground">
                  {formatCost(cost)}
                </div>

                <!-- Theme -->
                <div class="w-14 text-center text-muted-foreground">{theme}</div>

                <!-- Date -->
                <div class="flex-1 text-right text-muted-foreground">{formatDate(game.created_at)}</div>
              </a>
            );
          })}
        </div>
      </div>
    )}

    <!-- Pagination -->
    {totalPages > 1 && (
      <div class="flex items-center justify-between text-xs">
        <span class="text-muted-foreground">
          {page}/{totalPages}
        </span>
        <div class="flex items-center gap-1">
          {hasPrev ? (
            <a 
              href={`/games?page=${page - 1}`}
              class="inline-flex items-center gap-0.5 px-2 py-1 border rounded hover:bg-muted transition-colors"
            >
              <ChevronLeft size={12} /> Prev
            </a>
          ) : (
            <span class="inline-flex items-center gap-0.5 px-2 py-1 border rounded text-muted-foreground/50 cursor-not-allowed">
              <ChevronLeft size={12} /> Prev
            </span>
          )}
          {hasNext ? (
            <a 
              href={`/games?page=${page + 1}`}
              class="inline-flex items-center gap-0.5 px-2 py-1 border rounded hover:bg-muted transition-colors"
            >
              Next <ChevronRight size={12} />
            </a>
          ) : (
            <span class="inline-flex items-center gap-0.5 px-2 py-1 border rounded text-muted-foreground/50 cursor-not-allowed">
              Next <ChevronRight size={12} />
            </span>
          )}
        </div>
      </div>
    )}
  </div>
</Layout>

---
import Layout from '../../components/Layout.astro';
import { getGames, getLiveGames, formatDuration } from '../../lib/api';
import { getDisplayCost, formatCost } from '../../lib/costs';
import { ChevronLeft, ChevronRight, Radio } from 'lucide-astro';

const LIMIT = 25;
const page = parseInt(Astro.url.searchParams.get('page') || '1', 10);
const offset = (page - 1) * LIMIT;

const [liveGamesResult, completedGamesResult] = await Promise.all([
  getLiveGames(),
  getGames(LIMIT, offset, 'completed'),
]);

const liveGames = liveGamesResult.games;
const games = completedGamesResult.games;
const total = completedGamesResult.total;
const hasMore = completedGamesResult.hasMore;
const totalPages = Math.ceil(total / LIMIT);

const hasPrev = page > 1;
const hasNext = hasMore;

function formatRelativeTime(timestamp: number | string | null | undefined): string {
  if (timestamp == null) {
    return '—';
  }
  
  let ts: number;
  if (typeof timestamp === 'string') {
    // Handle ISO date strings
    ts = new Date(timestamp).getTime();
  } else if (Number.isFinite(timestamp)) {
    // Handle numeric timestamps (seconds or milliseconds)
    ts = timestamp > 9999999999 ? timestamp : timestamp * 1000;
  } else {
    return '—';
  }
  
  if (isNaN(ts)) return '—';
  
  const now = Date.now();
  const diffMs = now - ts;
  const diffSec = Math.floor(diffMs / 1000);
  const diffMin = Math.floor(diffSec / 60);
  const diffHour = Math.floor(diffMin / 60);
  const diffDay = Math.floor(diffHour / 24);
  
  const rtf = new Intl.RelativeTimeFormat('en', { numeric: 'auto' });
  
  if (diffDay > 0) return rtf.format(-diffDay, 'day');
  if (diffHour > 0) return rtf.format(-diffHour, 'hour');
  if (diffMin > 0) return rtf.format(-diffMin, 'minute');
  return rtf.format(-diffSec, 'second');
}

function getShortModelName(modelId: string): string {
  let name = modelId.split('/').pop() || modelId;
  // Strip provider prefix (e.g., "Google: Gemini 2.5" -> "Gemini 2.5")
  if (name.includes(': ')) {
    name = name.split(': ').slice(1).join(': ');
  }
  return name.replace(/-\d{4}-\d{2}-\d{2}$/, '').replace(/@.*$/, '');
}

function formatDisplayModelName(name: string): string {
  return name.split('-').map(part => {
    if (part.match(/^\d/)) return part;
    if (part === 'gpt' || part === 'o1' || part === 'o3') return part.toUpperCase();
    return part.charAt(0).toUpperCase() + part.slice(1);
  }).join(' ');
}

function getMatchup(game: any) {
  const participants = game.participants || [];
  const mafia = participants.find((p: any) => p.team === 'mafia');
  const town = participants.find((p: any) => p.team === 'town');
  const mafiaModel = mafia?.model_name || mafia?.model_id || '?';
  const townModel = town?.model_name || town?.model_id || '?';
  const mafiaWon = game.winner === 'mafia';
  const shortMafia = getShortModelName(mafiaModel);
  const shortTown = getShortModelName(townModel);
  return {
    mafia: formatDisplayModelName(shortMafia),
    town: formatDisplayModelName(shortTown),
    mafiaWon,
    winnerModel: mafiaWon ? formatDisplayModelName(shortMafia) : formatDisplayModelName(shortTown),
  };
}

/**
 * Get cost to display for a game.
 * Uses stored cost_usd from API (accurate), falls back to estimate for old games.
 */
function getGameCost(game: any): number {
  return getDisplayCost(game.cost_usd, game.total_tokens || 0);
}

const THEMES: Record<string, string> = {
  noir: 'Noir',
  victorian: 'Victorian',
  modern: 'Modern',
  fantasy: 'Fantasy',
};
---

<Layout title="Games">
  <div class="space-y-4">
    <!-- Header -->
    <div class="flex items-baseline justify-between">
      <h1 class="text-lg font-semibold">Games</h1>
      <span class="text-xs text-muted-foreground">
        {total} completed{liveGames.length > 0 ? ` · ${liveGames.length} live` : ''}
      </span>
    </div>

    <!-- Live Games -->
    {liveGames.length > 0 && (
      <div class="space-y-1.5">
        <div class="flex items-center gap-1.5 text-[10px] text-muted-foreground uppercase tracking-wide">
          <span class="relative flex h-1.5 w-1.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-rose-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-rose-500"></span>
          </span>
          Live
        </div>
        {liveGames.map(game => {
          const m = getMatchup(game);
          return (
            <a 
              href={`/games/${game.id}/live`} 
              class="flex items-center justify-between border rounded px-3 py-2 hover:bg-muted/30 transition-colors text-xs group"
            >
              <div class="flex items-center gap-2">
                <span class="font-medium">{m.mafia}</span>
                <span class="text-muted-foreground/40 text-[10px] font-bold">vs</span>
                <span class="font-medium">{m.town}</span>
                {game.rounds > 0 && <span class="text-muted-foreground/50 text-[10px]">R{game.rounds}</span>}
              </div>
              <span class="flex items-center gap-1 text-muted-foreground group-hover:text-foreground transition-colors">
                <Radio size={10} />
                Watch
              </span>
            </a>
          );
        })}
      </div>
    )}

    <!-- Games List -->
    {games.length === 0 ? (
      <div class="border rounded py-8 text-center text-sm text-muted-foreground">
        No games yet
      </div>
    ) : (
      <div class="border rounded overflow-hidden text-xs">
        <table class="w-full">
          <thead>
            <tr class="bg-muted/30 border-b text-[10px] text-muted-foreground uppercase tracking-wide">
              <th class="text-left font-normal px-3 py-1.5 w-[40%]">Matchup <span class="normal-case font-light opacity-70">(Mafia vs Town)</span></th>
              <th class="text-left font-normal px-3 py-1.5 w-[20%]">Winner</th>
              <th class="text-center font-normal px-2 py-1.5 w-14">Rounds</th>
              <th class="text-right font-normal px-2 py-1.5 w-16">Time</th>
              <th class="text-right font-normal px-2 py-1.5 w-14">Cost</th>
              <th class="text-center font-normal px-2 py-1.5 w-20">Theme</th>
              <th class="text-right font-normal px-3 py-1.5">Date</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border/50">
            {games.map(game => {
              const m = getMatchup(game);
              const theme = (game.persona_theme && THEMES[game.persona_theme]) || 'Noir';
              const cost = getGameCost(game);
              return (
                <tr class="hover:bg-muted/20 transition-colors cursor-pointer group" onclick={`window.location='/games/${game.id}'`}>
                  <td class="px-3 py-1.5 max-w-0">
                    <a href={`/games/${game.id}`} class="flex items-center gap-1.5 truncate text-muted-foreground">
                      <span class="truncate">{m.mafia}</span>
                      <span class="text-muted-foreground/30 text-[10px] shrink-0">vs</span>
                      <span class="truncate">{m.town}</span>
                    </a>
                  </td>
                  <td class="px-3 py-1.5">
                    <div class="flex items-center gap-1.5">
                      <span class="truncate">{m.winnerModel}</span>
                      <span class={`shrink-0 text-[9px] px-1 rounded ${
                        m.mafiaWon ? 'bg-rose-500/10 text-rose-600 dark:text-rose-400' : 'bg-indigo-500/10 text-indigo-600 dark:text-indigo-400'
                      }`}>
                        {m.mafiaWon ? 'M' : 'T'}
                      </span>
                    </div>
                  </td>
                  <td class="px-2 py-1.5 text-center font-mono text-muted-foreground">{game.rounds}</td>
                  <td class="px-2 py-1.5 text-right font-mono text-muted-foreground whitespace-nowrap">{formatDuration(game.duration_ms || 0)}</td>
                  <td class="px-2 py-1.5 text-right font-mono text-muted-foreground">{formatCost(cost)}</td>
                  <td class="px-2 py-1.5 text-center text-muted-foreground">{theme}</td>
                  <td class="px-3 py-1.5 text-right text-muted-foreground whitespace-nowrap">{formatRelativeTime(game.created_at)}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    )}

    <!-- Pagination -->
    {totalPages > 1 && (
      <div class="flex items-center justify-between text-xs">
        <span class="text-muted-foreground">
          {page}/{totalPages}
        </span>
        <div class="flex items-center gap-1">
          {hasPrev ? (
            <a 
              href={`/games?page=${page - 1}`}
              class="inline-flex items-center gap-0.5 px-2 py-1 border rounded hover:bg-muted transition-colors"
            >
              <ChevronLeft size={12} /> Prev
            </a>
          ) : (
            <span class="inline-flex items-center gap-0.5 px-2 py-1 border rounded text-muted-foreground/50 cursor-not-allowed">
              <ChevronLeft size={12} /> Prev
            </span>
          )}
          {hasNext ? (
            <a 
              href={`/games?page=${page + 1}`}
              class="inline-flex items-center gap-0.5 px-2 py-1 border rounded hover:bg-muted transition-colors"
            >
              Next <ChevronRight size={12} />
            </a>
          ) : (
            <span class="inline-flex items-center gap-0.5 px-2 py-1 border rounded text-muted-foreground/50 cursor-not-allowed">
              Next <ChevronRight size={12} />
            </span>
          )}
        </div>
      </div>
    )}
  </div>
</Layout>

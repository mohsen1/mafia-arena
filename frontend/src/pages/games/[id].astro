---
import Layout from '../../components/Layout.astro';
import { getGame } from '../../lib/api';

const { id } = Astro.params;

let game = null;
let error = null;

try {
  game = await getGame(id!);
} catch (e) {
  error = e instanceof Error ? e.message : 'Failed to load game details';
}

const participants = game?.participants || [];
const date = game ? new Date(game.created_at * 1000).toLocaleString() : '';
---

<Layout title={game ? `Game #${game.id.slice(-8)}` : 'Game Not Found'}>
  {error || !game ? (
    <div class="flex flex-col items-center justify-center min-h-[400px] border border-destructive/20 bg-destructive/5 rounded-xl p-8 text-center space-y-4">
      <div class="bg-destructive/10 text-destructive rounded-full p-4 text-2xl">⚠️</div>
      <div class="space-y-1">
        <h2 class="text-xl font-semibold">Game not found</h2>
        <p class="text-muted-foreground">{error || 'The requested game could not be found.'}</p>
      </div>
      <a href="/games" class="text-sm font-medium hover:underline">← Back to games</a>
    </div>
  ) : (
    <div class="max-w-4xl mx-auto space-y-8">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div class="space-y-1">
          <div class="flex items-center gap-2 text-sm text-muted-foreground mb-2">
            <a href="/games" class="hover:text-foreground">Games</a>
            <span>/</span>
            <span class="font-mono">{game.id}</span>
          </div>
          <h1 class="text-4xl font-bold tracking-tight">Game Result</h1>
          <p class="text-muted-foreground font-mono text-sm">{date}</p>
        </div>
        <a href={`/games/${game.id}/replay`} class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground shadow hover:bg-primary/90 h-11 px-8">
          View Full Replay
        </a>
      </div>

      <div class="grid gap-6 md:grid-cols-3 text-center">
        <div class="rounded-xl border bg-card p-6 shadow-sm">
          <div class="text-sm font-medium text-muted-foreground mb-1 uppercase tracking-wider">Winner</div>
          <div class={`text-2xl font-black ${game.winner === 'mafia' ? 'text-red-500' : 'text-blue-500'}`}>
            {game.winner.toUpperCase()}
          </div>
        </div>
        <div class="rounded-xl border bg-card p-6 shadow-sm">
          <div class="text-sm font-medium text-muted-foreground mb-1 uppercase tracking-wider">Rounds</div>
          <div class="text-2xl font-black">{game.rounds}</div>
        </div>
        <div class="rounded-xl border bg-card p-6 shadow-sm">
          <div class="text-sm font-medium text-muted-foreground mb-1 uppercase tracking-wider">Players</div>
          <div class="text-2xl font-black">{participants.length}</div>
        </div>
      </div>

      <div class="space-y-4">
        <h2 class="text-2xl font-bold tracking-tight">Participants</h2>
        <div class="rounded-xl border bg-card overflow-hidden">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b bg-muted/50 font-medium text-muted-foreground">
                <th class="h-12 px-4 text-left align-middle">Model</th>
                <th class="h-12 px-4 text-left align-middle">Team</th>
                <th class="h-12 px-4 text-center align-middle">Players</th>
                <th class="h-12 px-4 text-right align-middle">Tokens</th>
              </tr>
            </thead>
            <tbody class="divide-y">
              {participants.map(p => (
                <tr class="transition-colors hover:bg-muted/50">
                  <td class="p-4 font-semibold">{p.model_name || p.model_id}</td>
                  <td class="p-4">
                    <span class={`inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold ${
                      p.team === 'mafia' ? 'bg-red-500/10 text-red-500' : 'bg-blue-500/10 text-blue-500'
                    }`}>
                      {p.team.toUpperCase()}
                    </span>
                  </td>
                  <td class="p-4 text-center">{p.player_count}</td>
                  <td class="p-4 text-right text-muted-foreground font-mono">
                    --
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  )}
</Layout>

---
import Layout from '../../components/Layout.astro';
import { getGame, getTranscript, getGamePersonas, formatDuration, type GameDetail, type GamePersona } from '../../lib/api';
import { calculateCost, formatCost, calculateTotalCost } from '../../lib/costs';
import { getProviderColorFromModel } from '../../lib/providers';
import { 
  Trophy, Clock, Zap, Users, ChevronDown, ChevronRight,
  Moon, Sun, MessageSquare, Vote, Skull, User, Sparkles, ArrowLeft,
  Swords, MessagesSquare, Target, Hash, DollarSign, Timer, Castle, Crosshair,
  Feather, Scroll, Building2
} from 'lucide-astro';

const { id } = Astro.params;

let game: GameDetail | null = null;
let transcript: any = null;
let personasData: { personaEnabled: boolean; personas: GamePersona[]; analysis: any } | null = null;
let error: string | null = null;

try {
  game = await getGame(id!);
  transcript = await getTranscript(id!);
  try {
    personasData = await getGamePersonas(id!);
  } catch {
    personasData = null;
  }
} catch (e) {
  error = e instanceof Error ? e.message : 'Failed to load game';
}

// Process transcript
const events = (transcript as any)?.events || [];
const aiCallEvents = events.filter((e: any) => e.type === 'ai_call');
const totalCost = calculateTotalCost(aiCallEvents);

// Build player map from events
interface PlayerInfo {
  playerId: string;
  personaName: string;
  team: 'mafia' | 'town';
  modelId: string;
  persona?: {
    name: string;
    background: string;
    personality: string;
    occupation?: string;
  };
  isAlive: boolean;
}

const playerMap: Record<string, PlayerInfo> = {};
const eliminatedPlayers = new Set<string>();

// First pass: get team and model info from ai_call events
for (const event of events) {
  if (event.type === 'ai_call' && event.playerId && !playerMap[event.playerId]) {
    playerMap[event.playerId] = {
      playerId: event.playerId,
      personaName: event.playerName || event.playerId,
      team: event.team || 'town',
      modelId: event.modelId || '',
      isAlive: true,
    };
  }
  if (event.type === 'persona_generation' && event.playerId) {
    if (playerMap[event.playerId]) {
      playerMap[event.playerId].persona = event.persona;
      playerMap[event.playerId].personaName = event.persona?.name || event.playerName;
    }
  }
  if (event.type === 'elimination' && event.playerId) {
    eliminatedPlayers.add(event.playerId);
    if (playerMap[event.playerId]) {
      playerMap[event.playerId].isAlive = false;
    }
  }
}

const players = Object.values(playerMap);
const mafiaPlayers = players.filter(p => p.team === 'mafia');
const townPlayers = players.filter(p => p.team === 'town');

// Get unique models per team (short names)
function getShortModelName(modelId: string): string {
  const name = modelId.split('/').pop() || modelId;
  return name.replace(/-\d{4}-\d{2}-\d{2}$/, '').replace(/@.*$/, '');
}
const mafiaModels = [...new Set(mafiaPlayers.map(p => getShortModelName(p.modelId)))];
const townModels = [...new Set(townPlayers.map(p => getShortModelName(p.modelId)))];

// Group events by round and phase, excluding non-game events
function groupEvents(events: any[]) {
  const grouped: Record<number, Record<string, any[]>> = {};
  for (const event of events) {
    // Skip events that shouldn't appear in chat
    if (event.type === 'persona_generation') continue;
    if (event.type === 'game_end') continue; // Handled separately
    
    // Handle summarization events (show in the round they occurred)
    if (event.type === 'summarization') {
      const round = event.round || 1;
      if (!grouped[round]) grouped[round] = {};
      if (!grouped[round]['system']) grouped[round]['system'] = [];
      grouped[round]['system'].push(event);
      continue;
    }
    
    if (!event.phase || event.phase === 'other') continue; // Skip events with no proper phase
    
    const round = event.round || 1;
    const phase = event.phase;
    if (!grouped[round]) grouped[round] = {};
    if (!grouped[round][phase]) grouped[round][phase] = [];
    grouped[round][phase].push(event);
  }
  return grouped;
}

// Extract summarization events for display
const summarizationEvents = events.filter((e: any) => e.type === 'summarization');

const groupedEvents = groupEvents(events);
const gameEndEvent = events.find((e: any) => e.type === 'game_end');
const rounds = Object.keys(groupedEvents).map(Number).sort((a, b) => a - b);

// Format date
const timestamp = game?.created_at && game.created_at > 9999999999 ? game.created_at : (game?.created_at || 0) * 1000;
const date = game ? new Date(timestamp).toLocaleString(undefined, {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
  hour: '2-digit',
  minute: '2-digit'
}) : '';

// Theme config with icons and colors
const THEME_CONFIG: Record<string, { label: string; iconType: string; classes: string }> = {
  noir: { label: 'Noir', iconType: 'feather', classes: 'bg-zinc-500/10 border-zinc-500/20 text-zinc-700 dark:text-zinc-300' },
  victorian: { label: 'Victorian', iconType: 'scroll', classes: 'bg-amber-500/10 border-amber-500/20 text-amber-700 dark:text-amber-400' },
  modern: { label: 'Modern', iconType: 'building', classes: 'bg-cyan-500/10 border-cyan-500/20 text-cyan-700 dark:text-cyan-400' },
  fantasy: { label: 'Fantasy', iconType: 'sparkles', classes: 'bg-purple-500/10 border-purple-500/20 text-purple-700 dark:text-purple-400' },
};
const theme = THEME_CONFIG[game?.persona_theme || 'noir'] || THEME_CONFIG.noir;

// Get phase info with Lucide icon components
function getPhaseConfig(phase: string) {
  const configs: Record<string, { label: string; iconType: string }> = {
    introduction: { label: 'Intro', iconType: 'message' },
    night: { label: 'Night', iconType: 'moon' },
    mafia_chat: { label: 'Mafia', iconType: 'swords' },
    day_discussion: { label: 'Discussion', iconType: 'sun' },
    day_vote: { label: 'Vote', iconType: 'vote' },
    system: { label: 'System', iconType: 'zap' },
  };
  return configs[phase] || { label: phase, iconType: 'message' };
}

// Parse AI response
function parseResponse(raw: string): { type: string; content: any } {
  if (!raw) return { type: 'raw', content: '' };
  try {
    const parsed = JSON.parse(raw);
    if (parsed.message) return { type: 'message', content: parsed.message };
    if (parsed.vote !== undefined) return { type: 'vote', content: parsed };
    if (parsed.action && parsed.target) return { type: 'action', content: parsed };
    if (parsed.name && parsed.background) return { type: 'persona', content: parsed };
    return { type: 'raw', content: raw };
  } catch {
    return { type: 'raw', content: raw?.replace(/^["']|["']$/g, '').trim() || '' };
  }
}

function getPersonaName(playerId: string): string {
  return playerMap[playerId]?.personaName || playerId;
}
---

<Layout title={game ? `Game ${game.id.slice(-8)}` : 'Game Not Found'}>
  {error || !game ? (
    <div class="min-h-[60vh] flex items-center justify-center">
      <div class="text-center space-y-3">
        <Skull size={40} class="mx-auto text-muted-foreground/50" />
        <p class="text-muted-foreground text-sm">Game not found</p>
        <a href="/games" class="text-xs font-medium hover:underline inline-flex items-center gap-1">
          <ArrowLeft size={12} /> Back to games
        </a>
      </div>
    </div>
  ) : (
    <div class="space-y-5 pb-8">
      <!-- Back Link -->
      <div class="flex items-center gap-2 text-xs text-muted-foreground">
        <a href="/games" class="hover:text-foreground inline-flex items-center gap-1 transition-colors">
          <ArrowLeft size={12} /> Games
        </a>
        <span class="opacity-30">/</span>
        <code class="font-mono opacity-50">{game.id.slice(-12)}</code>
      </div>

      <!-- Broadcast HUD Header -->
      <div class="space-y-3">
        <!-- Top Deck: Status + Theme + Matchup -->
        <div class="flex flex-wrap items-center justify-between gap-3">
          <!-- Left: Badges -->
          <div class="flex items-center gap-2">
            <!-- Status Badge -->
            <div class={`flex items-center gap-2 px-2.5 py-1 rounded-full text-[10px] font-bold tracking-wider uppercase ${
              game.winner 
                ? 'bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400' 
                : 'bg-amber-500/10 border border-amber-500/20 text-amber-600 dark:text-amber-400'
            }`}>
              <span class={`w-2 h-2 rounded-full ${game.winner ? 'bg-emerald-500' : 'bg-amber-500 animate-pulse'}`}></span>
              {game.winner ? 'COMPLETED' : 'RUNNING'}
            </div>
            
            <!-- Theme Badge -->
            <div class={`flex items-center gap-1.5 px-2.5 py-1 rounded-full border text-[10px] font-medium ${theme.classes}`}>
              {theme.iconType === 'feather' && <Feather size={10} />}
              {theme.iconType === 'scroll' && <Scroll size={10} />}
              {theme.iconType === 'building' && <Building2 size={10} />}
              {theme.iconType === 'sparkles' && <Sparkles size={10} />}
              {theme.label}
            </div>
          </div>
          
          <!-- Right: Teams Matchup -->
          <div class="flex items-center gap-2 text-xs">
            <div class={`flex items-center gap-1 ${game.winner === 'mafia' ? 'font-semibold' : ''}`}>
              {game.winner === 'mafia' && <Trophy size={12} class="text-amber-500" />}
              <span class="text-rose-600 dark:text-rose-400 font-bold">MAFIA</span>
              <span class="text-muted-foreground/60 font-mono text-[10px]">{mafiaModels[0] || 'AI'}</span>
            </div>
            <span class="text-muted-foreground/40 text-[10px] font-bold">VS</span>
            <div class={`flex items-center gap-1 ${game.winner === 'town' ? 'font-semibold' : ''}`}>
              {game.winner === 'town' && <Trophy size={12} class="text-amber-500" />}
              <span class="text-indigo-600 dark:text-indigo-400 font-bold">TOWN</span>
              <span class="text-muted-foreground/60 font-mono text-[10px]">{townModels[0] || 'AI'}</span>
            </div>
          </div>
        </div>
        
        <!-- Telemetry Strip -->
        <div class="flex items-center justify-between px-3 py-2 rounded-md border bg-muted/30 text-xs">
          <div class="flex items-center gap-6">
            <div class="flex items-center gap-1.5">
              <span class="text-muted-foreground/60 text-[10px] uppercase tracking-wide">Round</span>
              <span class="font-bold font-mono">{game.rounds}</span>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="text-muted-foreground/60 text-[10px] uppercase tracking-wide">Duration</span>
              <span class="font-mono">{formatDuration(game.duration_ms || 0)}</span>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="text-muted-foreground/60 text-[10px] uppercase tracking-wide">Tokens</span>
              <span class="font-mono text-emerald-600 dark:text-emerald-400 flex items-center gap-0.5">
                <Zap size={10} />
                {(game.total_tokens || 0).toLocaleString()}
              </span>
            </div>
          </div>
          <div class="text-muted-foreground/60 text-[10px]">{date}</div>
        </div>
      </div>

      <!-- Players -->
      <section class="space-y-2">
        <div class="flex items-center justify-between">
          <h2 class="text-sm font-semibold flex items-center gap-1.5">
            <Users size={14} />
            Players
          </h2>
          <div class="flex items-center gap-3 text-[10px]">
            <span class="flex items-center gap-1">
              <span class="w-2 h-2 rounded-full bg-rose-500"></span>
              Mafia ({mafiaPlayers.length})
            </span>
            <span class="flex items-center gap-1">
              <span class="w-2 h-2 rounded-full bg-indigo-500"></span>
              Town ({townPlayers.length})
            </span>
          </div>
        </div>

        <div class="flex flex-wrap gap-1.5">
          {players.map((player) => {
            const isMafia = player.team === 'mafia';
            const shortModel = (player.modelId.split('/').pop() || player.modelId).split('-').slice(0, 2).join('-');
            return (
              <div class={`inline-flex items-center gap-1.5 px-2 py-1 rounded-full border text-xs ${
                isMafia 
                  ? 'border-rose-500/20 bg-rose-500/5' 
                  : 'border-indigo-500/20 bg-indigo-500/5'
              } ${!player.isAlive ? 'opacity-40' : ''}`}>
                {!player.isAlive && <Skull size={10} class="text-muted-foreground" />}
                {player.team === game.winner && player.isAlive && <Trophy size={10} class="text-amber-500" />}
                <span class={`w-1.5 h-1.5 rounded-full ${isMafia ? 'bg-rose-500' : 'bg-indigo-500'}`}></span>
                <span class={`font-medium ${isMafia ? 'text-rose-600 dark:text-rose-400' : 'text-indigo-600 dark:text-indigo-400'}`}>
                  {player.personaName}
                </span>
                <span class="text-muted-foreground/50 text-[9px]">{shortModel}</span>
              </div>
            );
          })}
        </div>
      </section>

      <!-- Game Transcript -->
      <section class="space-y-2">
        <h2 class="text-sm font-semibold flex items-center gap-1.5">
          <MessageSquare size={14} />
          Transcript
        </h2>

        {rounds.length === 0 ? (
          <div class="border rounded-md p-6 text-center text-muted-foreground text-sm">
            No events recorded
          </div>
        ) : (
          <div class="space-y-1.5" id="transcript">
            {rounds.map((round, roundIdx) => (
              <details class="group border rounded-md overflow-hidden" open={roundIdx === rounds.length - 1}>
                <summary class="flex items-center justify-between px-3 py-2 bg-muted/30 cursor-pointer hover:bg-muted/50 transition-colors text-xs">
                  <div class="flex items-center gap-2">
                    <span class="w-5 h-5 rounded bg-primary/10 flex items-center justify-center text-[10px] font-bold">
                      {round}
                    </span>
                    <span class="font-medium">Round {round}</span>
                    <div class="flex items-center gap-0.5 ml-1">
                      {Object.keys(groupedEvents[round] || {}).map(phase => {
                        const config = getPhaseConfig(phase);
                        return (
                          <span class="text-muted-foreground" title={config.label}>
                            {config.iconType === 'moon' && <Moon size={12} />}
                            {config.iconType === 'sun' && <Sun size={12} />}
                            {config.iconType === 'swords' && <Swords size={12} />}
                            {config.iconType === 'vote' && <Vote size={12} />}
                            {config.iconType === 'message' && <MessagesSquare size={12} />}
                          </span>
                        );
                      })}
                    </div>
                  </div>
                  <ChevronDown size={14} class="text-muted-foreground transition-transform duration-200 group-open:rotate-180" />
                </summary>
                
                <div class="divide-y divide-border/50">
                  {Object.entries(groupedEvents[round] || {}).map(([phase, phaseEvents]) => {
                    const phaseConfig = getPhaseConfig(phase);
                    const isNightPhase = phase === 'night' || phase === 'mafia_chat';
                    return (
                      <div class={`px-3 py-2 space-y-1.5 ${isNightPhase ? 'bg-rose-500/3' : ''}`}>
                        <div class="flex items-center gap-2 text-[10px] text-muted-foreground">
                          {phaseConfig.iconType === 'moon' && <Moon size={10} />}
                          {phaseConfig.iconType === 'sun' && <Sun size={10} />}
                          {phaseConfig.iconType === 'swords' && <Swords size={10} />}
                          {phaseConfig.iconType === 'vote' && <Vote size={10} />}
                          {phaseConfig.iconType === 'message' && <MessagesSquare size={10} />}
                          <span class="font-medium uppercase tracking-wide">{phaseConfig.label}</span>
                          <span class="opacity-50">·</span>
                          <span class="opacity-50">{(phaseEvents as any[]).length}</span>
                        </div>
                        
                        <div class="space-y-1">
                          {(phaseEvents as any[]).map((event, idx) => {
                            const player = playerMap[event.playerId];
                            const team = event.team || player?.team || 'town';
                            const isMafia = team === 'mafia';
                            
                            if (event.type === 'ai_call') {
                              const parsed = parseResponse(event.response?.raw);
                              
                              // Skip persona type responses in chat
                              if (parsed.type === 'persona') return null;
                              
                              return (
                                <div class="group/msg py-1.5">
                                  <div class="flex items-center gap-1.5 mb-0.5">
                                    <span class={`w-1.5 h-1.5 rounded-full shrink-0 ${isMafia ? 'bg-rose-500' : 'bg-indigo-500'}`}></span>
                                    <span class={`font-medium text-xs ${isMafia ? 'text-rose-600 dark:text-rose-400' : 'text-indigo-600 dark:text-indigo-400'}`}>
                                      {event.playerName}
                                    </span>
                                    <span class="text-[9px] text-muted-foreground/40">
                                      {event.modelId.split('/').pop()}
                                    </span>
                                  </div>
                                  {parsed.type === 'message' ? (
                                    <p class="text-xs text-foreground/90 leading-relaxed pl-3">{parsed.content}</p>
                                  ) : parsed.type === 'vote' ? (
                                    <div class="text-xs pl-3">
                                      <span class="inline-flex items-center gap-1 text-muted-foreground">
                                        <Vote size={10} />
                                        <span>Voted for</span>
                                        <span class={`font-semibold ${playerMap[parsed.content.vote]?.team === 'mafia' ? 'text-rose-500' : 'text-indigo-500'}`}>
                                          {getPersonaName(parsed.content.vote)}
                                        </span>
                                      </span>
                                      {parsed.content.reasoning && (
                                        <details class="mt-0.5 text-[10px] text-muted-foreground">
                                          <summary class="cursor-pointer hover:text-foreground transition-colors inline-flex items-center gap-0.5">
                                            <ChevronRight size={10} class="transition-transform [details[open]_&]:rotate-90" />
                                            reason
                                          </summary>
                                          <p class="mt-0.5 pl-3 italic opacity-70">"{parsed.content.reasoning}"</p>
                                        </details>
                                      )}
                                    </div>
                                  ) : parsed.type === 'action' ? (
                                    <div class="text-xs pl-3">
                                      <span class="inline-flex items-center gap-1">
                                        <Crosshair size={10} class={parsed.content.action === 'kill' ? 'text-rose-500' : 'text-muted-foreground'} />
                                        <span class="text-muted-foreground">{parsed.content.action}</span>
                                        <span class={`font-semibold ${playerMap[parsed.content.target]?.team === 'mafia' ? 'text-rose-500' : 'text-indigo-500'}`}>
                                          {getPersonaName(parsed.content.target)}
                                        </span>
                                      </span>
                                      {parsed.content.reasoning && (
                                        <details class="mt-0.5 text-[10px] text-muted-foreground">
                                          <summary class="cursor-pointer hover:text-foreground transition-colors inline-flex items-center gap-0.5">
                                            <ChevronRight size={10} class="transition-transform [details[open]_&]:rotate-90" />
                                            reason
                                          </summary>
                                          <p class="mt-0.5 pl-3 italic opacity-70">"{parsed.content.reasoning}"</p>
                                        </details>
                                      )}
                                    </div>
                                  ) : (
                                    <p class="text-xs text-foreground/90 leading-relaxed pl-3">{parsed.content}</p>
                                  )}
                                </div>
                              );
                            }
                            
                            if (event.type === 'elimination') {
                              return (
                                <div class={`flex items-center gap-2 py-1.5 px-2 rounded text-xs ${
                                  event.team === 'mafia' 
                                    ? 'bg-rose-500/10 border border-rose-500/20' 
                                    : 'bg-indigo-500/10 border border-indigo-500/20'
                                }`}>
                                  <Skull size={12} class={event.team === 'mafia' ? 'text-rose-500' : 'text-indigo-500'} />
                                  <span class={`font-medium ${
                                    event.team === 'mafia' ? 'text-rose-600 dark:text-rose-400' : 'text-indigo-600 dark:text-indigo-400'
                                  }`}>{event.playerName || getPersonaName(event.playerId)}</span>
                                  <span class="text-muted-foreground">eliminated</span>
                                  <span class={`ml-auto text-[10px] px-1.5 py-0.5 rounded font-medium ${
                                    event.team === 'mafia' ? 'bg-rose-500/20 text-rose-600 dark:text-rose-400' : 'bg-indigo-500/20 text-indigo-600 dark:text-indigo-400'
                                  }`}>
                                    {event.team}
                                  </span>
                                </div>
                              );
                            }
                            
                            if (event.type === 'summarization') {
                              const [roundStart, roundEnd] = event.roundRangeSummarized || [1, 1];
                              return (
                                <div class="flex items-center gap-2 py-1.5 px-2 rounded text-xs bg-amber-500/10 border border-amber-500/20">
                                  <Zap size={12} class="text-amber-500" />
                                  <span class="text-amber-600 dark:text-amber-400">
                                    Rounds {roundStart}-{roundEnd} summarized
                                  </span>
                                  <span class="text-muted-foreground text-[10px]">
                                    ({event.tokensSaved?.toLocaleString() || 0} tokens saved)
                                  </span>
                                  <span class="ml-auto text-[10px] px-1.5 py-0.5 rounded bg-amber-500/20 text-amber-600 dark:text-amber-400">
                                    context optimization
                                  </span>
                                </div>
                              );
                            }
                            
                            return null;
                          })}
                        </div>
                      </div>
                    );
                  })}
                </div>
              </details>
            ))}
            
            {/* Game End - Always at the bottom */}
            {gameEndEvent && (
              <div class={`text-center py-4 rounded-md border ${
                gameEndEvent.winner === 'mafia' 
                  ? 'bg-rose-500/10 border-rose-500/30' 
                  : 'bg-indigo-500/10 border-indigo-500/30'
              }`}>
                <Trophy size={20} class={`mx-auto mb-1 ${gameEndEvent.winner === 'mafia' ? 'text-rose-500' : 'text-indigo-500'}`} />
                <div class={`text-sm font-bold ${
                  gameEndEvent.winner === 'mafia' ? 'text-rose-500' : 'text-indigo-500'
                }`}>
                  {gameEndEvent.winner === 'mafia' ? 'Mafia' : 'Town'} Wins
                </div>
              </div>
            )}
          </div>
        )}
      </section>

      <!-- Footer Stats -->
      <div class="flex items-center justify-between text-[10px] text-muted-foreground border-t pt-3">
        <span>{game.total_tokens?.toLocaleString() || 0} tokens</span>
        <span>{events.filter((e: any) => e.type !== 'persona_generation').length} events</span>
      </div>
    </div>
  )}
</Layout>

<style>
  details[open] > summary {
    border-bottom: 1px solid var(--border);
  }
  
  details > summary::-webkit-details-marker {
    display: none;
  }
  
  details > summary {
    list-style: none;
  }
</style>

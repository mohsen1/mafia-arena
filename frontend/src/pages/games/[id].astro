---
import Layout from '../../components/Layout.astro';
import { getGame, getGamePersonas, formatDuration, type GameDetail, type GamePersona } from '../../lib/api';
import { calculateCostFromTotal, formatCost } from '../../lib/costs';
import { Play, ArrowLeft, Trophy, X, User, Sparkles, Radio } from 'lucide-astro';

const { id } = Astro.params;

let game: GameDetail | null = null;
let personasData: { personaEnabled: boolean; personas: GamePersona[]; analysis: { averageScore: number; mafiaAvgConsistency: number; townAvgConsistency: number } | null } | null = null;
let error: string | null = null;

try {
  game = await getGame(id!);
  // Try to fetch personas (might not exist for older games)
  try {
    personasData = await getGamePersonas(id!);
  } catch {
    personasData = null;
  }
} catch (e) {
  error = e instanceof Error ? e.message : 'Failed to load game details';
}

type Participant = GameDetail['participants'][number];

const participants: Participant[] = game?.participants || [];
const personas: GamePersona[] = personasData?.personas || [];
const personaAnalysis = personasData?.analysis;
const personaEnabled = personasData?.personaEnabled ?? false;

// Handle both unix timestamp (seconds) and milliseconds
const timestamp = game?.created_at && game.created_at > 9999999999 ? game.created_at : (game?.created_at || 0) * 1000;
const date = game ? new Date(timestamp).toLocaleString(undefined, {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
  hour: '2-digit',
  minute: '2-digit'
}) : '';

// Calculate costs
const totalCost = game ? calculateCostFromTotal('gemini-2.0-flash', game.total_tokens) : 0;

// Get mafia and town counts
const mafiaParticipants = participants.filter((p) => p.team === 'mafia');
const townParticipants = participants.filter((p) => p.team === 'town');
const mafiaCount = mafiaParticipants.reduce((sum, p) => sum + (p.player_count || 1), 0);
const townCount = townParticipants.reduce((sum, p) => sum + (p.player_count || 1), 0);

// Determine winner/loser models
const winnerTeam = game?.winner;
const winnerParticipants = participants.filter((p) => p.team === winnerTeam);
const loserParticipants = participants.filter((p) => p.team !== winnerTeam);

// Group personas by team
const mafiaPersonas = personas.filter((p) => p.team === 'mafia');
const townPersonas = personas.filter((p) => p.team === 'town');

// Theme styles
const THEME_STYLES: Record<string, { label: string; emoji: string; class: string }> = {
  noir: { label: 'Noir', emoji: '🎬', class: 'bg-slate-500/20 text-slate-700 dark:text-slate-300' },
  victorian: { label: 'Victorian', emoji: '🎩', class: 'bg-amber-500/20 text-amber-700 dark:text-amber-300' },
  modern: { label: 'Modern', emoji: '💻', class: 'bg-cyan-500/20 text-cyan-700 dark:text-cyan-300' },
  fantasy: { label: 'Fantasy', emoji: '⚔️', class: 'bg-purple-500/20 text-purple-700 dark:text-purple-300' },
};
const gameTheme = game?.persona_theme || 'noir';
const themeStyle = THEME_STYLES[gameTheme] || THEME_STYLES.noir;
---

<Layout title={game ? `Game ${game.id.slice(-8)}` : 'Game Not Found'}>
  {error || !game ? (
    <div class="border rounded-md p-8 text-center text-muted-foreground">
      <p class="text-sm mb-4">Game not found</p>
      <a href="/games" class="text-sm font-medium hover:underline">← Back to games</a>
    </div>
  ) : (
    <div class="space-y-6 max-w-3xl">
      <div class="flex items-center gap-2 text-sm text-muted-foreground">
        <a href="/games" class="hover:text-foreground inline-flex items-center gap-1">
          <ArrowLeft size={14} /> Games
        </a>
        <span>/</span>
        <code class="text-xs">{game.id.slice(-12)}</code>
      </div>

      <div class="flex items-start justify-between gap-4">
        <div>
          <div class="flex items-center gap-3">
            <h1 class="text-2xl font-bold tracking-tight">
              {game.status === 'running' ? 'Game in Progress' : 'Game Result'}
            </h1>
            {game.status === 'running' && (
              <span class="inline-flex items-center gap-1.5 px-2 py-1 rounded-full text-xs font-medium bg-red-500/10 text-red-500 border border-red-500/20">
                <span class="relative flex h-2 w-2">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
                  <span class="relative inline-flex rounded-full h-2 w-2 bg-red-500"></span>
                </span>
                LIVE
              </span>
            )}
          </div>
          <p class="text-muted-foreground text-sm">{date}</p>
        </div>
        <div class="flex items-center gap-2">
          {game.status === 'running' ? (
            <a 
              href={`/games/${game.id}/live`} 
              class="inline-flex items-center gap-1.5 px-3 h-8 text-sm font-medium bg-red-500 text-white rounded hover:bg-red-600 transition-colors"
            >
              <Radio size={14} /> Watch Live
            </a>
          ) : (
            <a 
              href={`/games/${game.id}/replay`} 
              class="inline-flex items-center gap-1.5 px-3 h-8 text-sm font-medium bg-primary text-primary-foreground rounded hover:bg-primary/90 transition-colors"
            >
              <Play size={14} /> Replay
            </a>
          )}
        </div>
      </div>

      <!-- Stats Grid -->
      <div class="grid grid-cols-5 gap-3">
        <div class="border rounded-md p-3">
          <div class="text-[10px] text-muted-foreground uppercase tracking-wider mb-1">Winner</div>
          <div class={`font-bold ${game.winner === 'mafia' ? 'text-red-600 dark:text-red-400' : 'text-blue-600 dark:text-blue-400'}`}>
            {game.winner === 'mafia' ? 'Mafia' : 'Town'}
          </div>
        </div>
        <div class="border rounded-md p-3">
          <div class="text-[10px] text-muted-foreground uppercase tracking-wider mb-1">Players</div>
          <div class="font-bold font-mono tabular-nums">
            <span class="text-red-600 dark:text-red-400">{mafiaCount}</span>
            <span class="text-muted-foreground mx-1">vs</span>
            <span class="text-blue-600 dark:text-blue-400">{townCount}</span>
          </div>
        </div>
        <div class="border rounded-md p-3">
          <div class="text-[10px] text-muted-foreground uppercase tracking-wider mb-1">Rounds</div>
          <div class="font-bold font-mono tabular-nums">{game.rounds}</div>
        </div>
        <div class="border rounded-md p-3">
          <div class="text-[10px] text-muted-foreground uppercase tracking-wider mb-1">Theme</div>
          <div class={`font-bold text-sm ${themeStyle.class} px-2 py-0.5 rounded inline-block`}>
            {themeStyle.emoji} {themeStyle.label}
          </div>
        </div>
        <div class="border rounded-md p-3">
          <div class="text-[10px] text-muted-foreground uppercase tracking-wider mb-1">Est. Cost</div>
          <div class="font-bold font-mono tabular-nums text-green-600 dark:text-green-400">{formatCost(totalCost)}</div>
        </div>
      </div>

      <!-- Winner Section -->
      <section class="space-y-3">
        <div class="flex items-center gap-2">
          <Trophy size={16} class={game.winner === 'mafia' ? 'text-red-500' : 'text-blue-500'} />
          <h2 class="font-semibold">Winner</h2>
        </div>
        <div class="border rounded-md overflow-hidden">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b bg-muted/50">
                <th class="h-9 px-3 text-left font-medium text-muted-foreground">Model</th>
                <th class="h-9 px-3 text-left font-medium text-muted-foreground">Team</th>
                <th class="h-9 px-3 text-right font-medium text-muted-foreground"># Players</th>
              </tr>
            </thead>
            <tbody>
              {winnerParticipants.map((p) => (
                <tr class={`border-b last:border-0 ${game.winner === 'mafia' ? 'bg-red-500/5' : 'bg-blue-500/5'}`}>
                  <td class="h-10 px-3">
                    <span class="font-semibold">{p.model_name || p.model_id}</span>
                  </td>
                  <td class="h-10 px-3">
                    <span class={`inline-flex items-center gap-1.5 text-xs font-semibold ${
                      p.team === 'mafia' 
                        ? 'text-red-600 dark:text-red-400' 
                        : 'text-blue-600 dark:text-blue-400'
                    }`}>
                      <span class={`w-2 h-2 rounded-full ${
                        p.team === 'mafia' ? 'bg-red-500' : 'bg-blue-500'
                      }`}></span>
                      {p.team}
                    </span>
                  </td>
                  <td class="h-10 px-3 text-right font-mono tabular-nums">
                    {p.player_count || 1}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- Loser Section -->
      <section class="space-y-3">
        <div class="flex items-center gap-2">
          <X size={16} class="text-muted-foreground" />
          <h2 class="font-semibold text-muted-foreground">Defeated</h2>
        </div>
        <div class="border rounded-md overflow-hidden opacity-75">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b bg-muted/50">
                <th class="h-9 px-3 text-left font-medium text-muted-foreground">Model</th>
                <th class="h-9 px-3 text-left font-medium text-muted-foreground">Team</th>
                <th class="h-9 px-3 text-right font-medium text-muted-foreground"># Players</th>
              </tr>
            </thead>
            <tbody>
              {loserParticipants.map((p) => (
                <tr class="border-b last:border-0">
                  <td class="h-10 px-3">
                    <span class="font-medium text-muted-foreground">{p.model_name || p.model_id}</span>
                  </td>
                  <td class="h-10 px-3">
                    <span class={`inline-flex items-center gap-1.5 text-xs font-medium ${
                      p.team === 'mafia' 
                        ? 'text-red-500/60' 
                        : 'text-blue-500/60'
                    }`}>
                      <span class={`w-2 h-2 rounded-full opacity-50 ${
                        p.team === 'mafia' ? 'bg-red-500' : 'bg-blue-500'
                      }`}></span>
                      {p.team}
                    </span>
                  </td>
                  <td class="h-10 px-3 text-right font-mono tabular-nums text-muted-foreground">
                    {p.player_count || 1}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- Token Usage -->
      <section class="border rounded-md p-4 bg-muted/30">
        <div class="flex items-center justify-between text-sm">
          <span class="text-muted-foreground">Total tokens used</span>
          <span class="font-mono tabular-nums">{game.total_tokens?.toLocaleString() || 0}</span>
        </div>
        <div class="flex items-center justify-between text-sm mt-2">
          <span class="text-muted-foreground">Duration</span>
          <span class="font-mono tabular-nums">{formatDuration(game.duration_ms || 0)}</span>
        </div>
      </section>

      <!-- Personas Section (if enabled) -->
      {personaEnabled && personas.length > 0 && (
        <section class="space-y-4">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <Sparkles size={16} class="text-amber-500" />
              <h2 class="font-semibold">AI-Generated Personas</h2>
            </div>
            {personaAnalysis && (
              <div class="flex items-center gap-4 text-xs">
                <span class="text-muted-foreground">
                  Avg Consistency: 
                  <span class="font-mono font-medium text-foreground ml-1">
                    {(personaAnalysis.averageScore * 100).toFixed(0)}%
                  </span>
                </span>
              </div>
            )}
          </div>

          {personaAnalysis && (
            <div class="grid grid-cols-2 gap-3">
              <div class="border rounded-md p-3 bg-red-500/5">
                <div class="text-[10px] text-muted-foreground uppercase tracking-wider mb-1">Mafia Consistency</div>
                <div class="font-bold font-mono tabular-nums text-red-600 dark:text-red-400">
                  {(personaAnalysis.mafiaAvgConsistency * 100).toFixed(0)}%
                </div>
              </div>
              <div class="border rounded-md p-3 bg-blue-500/5">
                <div class="text-[10px] text-muted-foreground uppercase tracking-wider mb-1">Town Consistency</div>
                <div class="font-bold font-mono tabular-nums text-blue-600 dark:text-blue-400">
                  {(personaAnalysis.townAvgConsistency * 100).toFixed(0)}%
                </div>
              </div>
            </div>
          )}

          <!-- Persona Cards -->
          <div class="space-y-3">
            {personas.map((p) => (
              <div class={`border rounded-md p-4 ${
                p.team === 'mafia' 
                  ? 'border-red-500/30 bg-red-500/5' 
                  : 'border-blue-500/30 bg-blue-500/5'
              }`}>
                <div class="flex items-start justify-between gap-4">
                  <div class="flex items-center gap-3">
                    <div class={`w-8 h-8 rounded-full flex items-center justify-center ${
                      p.team === 'mafia' ? 'bg-red-500/20' : 'bg-blue-500/20'
                    }`}>
                      <User size={16} class={p.team === 'mafia' ? 'text-red-500' : 'text-blue-500'} />
                    </div>
                    <div>
                      <div class="font-semibold">{p.persona.name}</div>
                      <div class="text-xs text-muted-foreground">
                        {p.modelName} • 
                        <span class={p.team === 'mafia' ? 'text-red-500' : 'text-blue-500'}>
                          {p.team}
                        </span>
                      </div>
                    </div>
                  </div>
                  {p.consistency.score !== null && (
                    <div class="text-right">
                      <div class="text-xs text-muted-foreground">Consistency</div>
                      <div class={`font-mono font-semibold ${
                        p.consistency.score >= 0.7 ? 'text-green-600 dark:text-green-400' :
                        p.consistency.score >= 0.4 ? 'text-amber-600 dark:text-amber-400' :
                        'text-red-600 dark:text-red-400'
                      }`}>
                        {(p.consistency.score * 100).toFixed(0)}%
                      </div>
                    </div>
                  )}
                </div>
                
                <div class="mt-3 space-y-2 text-sm">
                  <div>
                    <span class="text-muted-foreground">Personality:</span>
                    <span class="ml-2 font-medium">{p.persona.personality}</span>
                  </div>
                  <div class="text-muted-foreground italic">
                    "{p.persona.background}"
                  </div>
                </div>

                {p.consistency.inconsistencies && p.consistency.inconsistencies.length > 0 && (
                  <div class="mt-3 pt-3 border-t border-dashed">
                    <div class="text-xs text-amber-600 dark:text-amber-400 font-medium mb-1">Inconsistencies detected:</div>
                    <ul class="text-xs text-muted-foreground space-y-0.5">
                      {p.consistency.inconsistencies.map((issue) => (
                        <li class="flex items-start gap-1">
                          <span class="text-amber-500">•</span>
                          {issue}
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>
            ))}
          </div>
        </section>
      )}
    </div>
  )}
</Layout>

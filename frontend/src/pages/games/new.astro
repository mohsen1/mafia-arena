---
import Layout from '../../components/Layout.astro';
import { ArrowLeft, Users, Shield, Key, Shuffle, AlertCircle } from 'lucide-astro';
import ProviderModelSelector from '../../components/ui/ProviderModelSelector';
import { getApiUrl } from '../../lib/utils';

const apiUrl = getApiUrl();
---

<Layout title="Launch New Game">
  <div class="max-w-2xl mx-auto space-y-6">
    <div class="flex items-center gap-2 text-sm text-muted-foreground mb-1">
      <a href="/games" class="hover:underline inline-flex items-center gap-1">
        <ArrowLeft size={14} /> Games
      </a>
      <span>/</span>
      <span>New Game</span>
    </div>

    <div>
      <h1 class="text-2xl font-bold tracking-tight">New Game</h1>
      <p class="text-sm text-muted-foreground mt-1">
        Pit AI models against each other in a game of Mafia
      </p>
    </div>

    <!-- Auth required notice (shown when not logged in) -->
    <div id="auth-required" class="hidden p-4 bg-amber-500/10 border border-amber-500/20 rounded-lg">
      <div class="flex items-start gap-3">
        <AlertCircle class="h-5 w-5 text-amber-500 shrink-0 mt-0.5" />
        <div class="text-sm">
          <p class="font-medium text-amber-600 dark:text-amber-400">Sign in required</p>
          <p class="text-muted-foreground mt-1">
            You need to sign in to launch games. You'll also need to add your own API keys.
          </p>
          <a 
            href="#"
            id="signin-link"
            class="inline-flex items-center gap-1 mt-2 text-amber-600 dark:text-amber-400 hover:underline font-medium"
          >
            Sign in with Google →
          </a>
        </div>
      </div>
    </div>

    <!-- User status banners -->
    <div id="user-status" class="hidden">
      <!-- Admin banner -->
      <div id="admin-status" class="hidden p-3 bg-emerald-500/10 border border-emerald-500/20 rounded-lg flex items-center gap-3">
        <Shield class="h-5 w-5 text-emerald-500 shrink-0" />
        <div class="text-sm">
          <span class="font-medium text-emerald-600 dark:text-emerald-400">Admin Mode:</span>
          <span class="text-muted-foreground"> Using system API keys. You can run any model.</span>
        </div>
      </div>
      
      <!-- User banner -->
      <div id="user-key-status" class="hidden p-3 bg-muted/50 border rounded-lg">
        <div class="flex items-center gap-3">
          <Key class="h-5 w-5 text-muted-foreground shrink-0" />
          <div class="text-sm">
            <span class="font-medium">Your API Keys:</span>
            <span class="text-muted-foreground"> Games will use your configured keys.</span>
          </div>
        </div>
        <div id="configured-keys" class="mt-2 text-xs text-muted-foreground">
          Loading your configured keys...
        </div>
      </div>
    </div>

    <!-- No API keys error (for non-admin users with zero keys) -->
    <div id="no-keys-error" class="hidden p-4 bg-red-500/10 border border-red-500/30 rounded-lg">
      <div class="flex items-start gap-3">
        <AlertCircle class="h-5 w-5 text-red-500 shrink-0 mt-0.5" />
        <div class="text-sm">
          <p class="font-medium text-red-600 dark:text-red-400">No API Keys Configured</p>
          <p class="text-muted-foreground mt-1">
            You need to add at least one API key before you can launch games. Games use your own API keys to call AI models.
          </p>
          <a href="/account" class="inline-flex items-center gap-2 mt-3 px-3 py-1.5 bg-red-500/20 hover:bg-red-500/30 text-red-600 dark:text-red-400 rounded-md font-medium transition-colors">
            <Key class="h-4 w-4" /> Add API Keys
          </a>
        </div>
      </div>
    </div>

    <!-- Missing keys warning (for specific models) -->
    <div id="missing-keys-warning" class="hidden p-3 bg-amber-500/10 border border-amber-500/20 rounded-lg">
      <div class="flex items-start gap-3">
        <AlertCircle class="h-5 w-5 text-amber-500 shrink-0 mt-0.5" />
        <div class="text-sm">
          <p class="font-medium text-amber-600 dark:text-amber-400">Missing API Keys for Selected Models</p>
          <p class="text-muted-foreground mt-1" id="missing-keys-message">
            You need to add API keys for the selected models.
          </p>
          <a href="/account" class="inline-flex items-center gap-1 mt-2 text-amber-600 dark:text-amber-400 hover:underline">
            <Key class="h-3.5 w-3.5" /> Add keys in Account settings
          </a>
        </div>
      </div>
    </div>

    <form id="gameForm" class="space-y-6">
      <section class="border rounded-lg p-4 space-y-4 bg-muted/30">
        <div class="flex items-center gap-2 text-sm font-medium">
          <Users size={16} class="text-muted-foreground" />
          Team Configuration
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div class="space-y-2">
            <label for="playerCount" class="text-sm text-muted-foreground">Total Players</label>
            <select 
              id="playerCount" 
              name="playerCount"
              class="w-full px-3 py-2 border rounded-md bg-background focus:outline-none focus:ring-2 focus:ring-primary"
            >
              {[5, 6, 7, 8, 9, 10, 11, 12].map(n => (
                <option value={n} selected={n === 11}>{n} players</option>
              ))}
            </select>
          </div>
          <div class="space-y-2">
            <label for="mafiaCount" class="text-sm text-muted-foreground">Mafia Count</label>
            <select 
              id="mafiaCount" 
              name="mafiaCount"
              class="w-full px-3 py-2 border rounded-md bg-background focus:outline-none focus:ring-2 focus:ring-primary"
            >
              {[1, 2, 3].map(n => (
                <option value={n} selected={n === 2}>{n} mafia</option>
              ))}
            </select>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-6">
          <ProviderModelSelector 
            client:load 
            team="mafia"
            placeholder="Select mafia model..."
            inputId="modelA"
          />
          <ProviderModelSelector 
            client:load 
            team="town"
            placeholder="Select town model..."
            inputId="modelB"
          />
        </div>

        <button 
          type="button"
          id="randomFreeBtn"
          class="hidden w-full px-3 py-2 text-sm border border-dashed rounded-lg hover:bg-muted/50 transition-colors flex items-center justify-center gap-2 text-muted-foreground hover:text-foreground"
        >
          <Shuffle size={14} />
          Pick Two Random Free Models
        </button>
      </section>

      <div id="launch-status" class="hidden border rounded-lg p-4 bg-muted/30">
        <div class="flex items-center gap-3">
          <div class="animate-spin h-5 w-5 border-2 border-primary border-t-transparent rounded-full"></div>
          <span id="launch-status-text" class="text-sm">Starting game...</span>
        </div>
      </div>

      <div class="flex gap-3">
        <button 
          type="submit"
          id="submit-btn"
          disabled
          class="flex-1 px-4 py-3 bg-foreground text-background rounded-lg font-medium hover:bg-foreground/90 transition-colors flex items-center justify-center gap-2 disabled:opacity-40 disabled:cursor-not-allowed"
        >
          Launch Game
        </button>
        <a 
          href="/games"
          class="px-4 py-3 border rounded-lg hover:bg-muted transition-colors flex items-center"
        >
          Cancel
        </a>
      </div>
    </form>

    <!-- Info section -->
    <section class="border-t pt-6 mt-6">
      <h2 class="text-sm font-medium mb-3">How it works</h2>
      <div class="grid gap-3 text-sm text-muted-foreground">
        <div class="flex gap-3">
          <span class="shrink-0 w-6 h-6 rounded-full bg-muted text-foreground flex items-center justify-center text-xs font-medium">1</span>
          <p>Select AI models for each team. The mafia team tries to eliminate townspeople while staying hidden.</p>
        </div>
        <div class="flex gap-3">
          <span class="shrink-0 w-6 h-6 rounded-full bg-muted text-foreground flex items-center justify-center text-xs font-medium">2</span>
          <p>The game runs automatically with day/night cycles. Watch AI models discuss, vote, and strategize in real-time.</p>
        </div>
        <div class="flex gap-3">
          <span class="shrink-0 w-6 h-6 rounded-full bg-muted text-foreground flex items-center justify-center text-xs font-medium">3</span>
          <p>Games use your API keys. Add keys for providers you want to use in <a href="/account" class="underline hover:text-foreground">Account settings</a>.</p>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script define:vars={{ apiUrl }}>
  let currentUser = null;
  let userKeys = [];
  let isAdmin = false;
  let isAuthenticated = false;

  // Provider inference from model IDs
  function getRequiredProviders(modelIds) {
    const providers = new Set();
    
    for (const modelId of modelIds) {
      if (modelId.startsWith('openai/') || modelId.startsWith('gpt-')) {
        providers.add('openai');
      } else if (modelId.startsWith('anthropic/') || modelId.startsWith('claude-')) {
        providers.add('anthropic');
      } else if (modelId.startsWith('google/') || modelId.startsWith('gemini-')) {
        providers.add('google');
      } else if (modelId.startsWith('xai/') || modelId.startsWith('grok-')) {
        providers.add('xai');
      } else if (modelId.startsWith('deepseek/')) {
        providers.add('deepseek');
      } else if (modelId.startsWith('together/')) {
        providers.add('together');
      } else if (modelId.startsWith('groq/')) {
        providers.add('groq');
      } else if (modelId.startsWith('cerebras/')) {
        providers.add('cerebras');
      } else if (modelId.startsWith('fireworks/')) {
        providers.add('fireworks');
      } else if (modelId.startsWith('mistral/')) {
        providers.add('mistral');
      } else if (modelId.startsWith('cohere/')) {
        providers.add('cohere');
      } else if (modelId.startsWith('ai21/')) {
        providers.add('ai21');
      } else {
        providers.add('openrouter');
      }
    }
    
    return providers;
  }

  async function checkAuth() {
    const authRequired = document.getElementById('auth-required');
    const userStatus = document.getElementById('user-status');
    const adminStatus = document.getElementById('admin-status');
    const userKeyStatus = document.getElementById('user-key-status');
    const submitBtn = document.getElementById('submit-btn');
    const signinLink = document.getElementById('signin-link');

    // Set sign-in link
    if (signinLink) {
      signinLink.href = `${apiUrl}/api/auth/google?redirect=/games/new`;
    }

    try {
      const res = await fetch(`${apiUrl}/api/auth/me`, { credentials: 'include' });
      
      if (res.ok) {
        const data = await res.json();
        if (data.authenticated && data.user) {
          currentUser = data.user;
          isAdmin = data.user.isAdmin;
          isAuthenticated = true;
          
          // Hide auth required, show user status
          authRequired?.classList.add('hidden');
          userStatus?.classList.remove('hidden');
          
          // Enable submit button
          if (submitBtn) submitBtn.disabled = false;
          
          if (isAdmin) {
            adminStatus?.classList.remove('hidden');
            // Show admin-only random free models button
            document.getElementById('randomFreeBtn')?.classList.remove('hidden');
          } else {
            userKeyStatus?.classList.remove('hidden');
            await loadUserKeys();
          }
          return;
        }
      }
    } catch (e) {
      console.log('Auth check failed:', e);
    }

    // Not authenticated - show auth required
    authRequired?.classList.remove('hidden');
    userStatus?.classList.add('hidden');
    if (submitBtn) submitBtn.disabled = true;
  }

  async function loadUserKeys() {
    const configuredKeys = document.getElementById('configured-keys');
    const noKeysError = document.getElementById('no-keys-error');
    const userKeyStatus = document.getElementById('user-key-status');
    const submitBtn = document.getElementById('submit-btn');
    
    try {
      const res = await fetch(`${apiUrl}/api/auth/keys`, { credentials: 'include' });
      
      if (res.ok) {
        const data = await res.json();
        userKeys = data.keys || [];
        
        if (userKeys.length === 0) {
          // No keys at all - show prominent error
          noKeysError?.classList.remove('hidden');
          userKeyStatus?.classList.add('hidden');
          if (submitBtn) submitBtn.disabled = true;
        } else {
          // Has some keys - show which ones
          noKeysError?.classList.add('hidden');
          userKeyStatus?.classList.remove('hidden');
          const providers = userKeys.map(k => k.provider).join(', ');
          configuredKeys.innerHTML = `
            <span class="text-emerald-600 dark:text-emerald-400">✓ Configured:</span> ${providers}
          `;
          if (submitBtn) submitBtn.disabled = false;
        }
      }
    } catch (e) {
      console.error('Failed to load keys:', e);
      if (configuredKeys) configuredKeys.textContent = 'Failed to load keys';
    }
  }

  function checkMissingKeys() {
    if (isAdmin) {
      document.getElementById('missing-keys-warning')?.classList.add('hidden');
      return true;
    }

    const modelA = document.getElementById('modelA')?.value;
    const modelB = document.getElementById('modelB')?.value;
    
    if (!modelA || !modelB) return true;

    const required = getRequiredProviders([modelA, modelB]);
    const configured = new Set(userKeys.map(k => k.provider));
    const missing = [...required].filter(p => !configured.has(p));

    const warning = document.getElementById('missing-keys-warning');
    const message = document.getElementById('missing-keys-message');
    
    if (missing.length > 0) {
      warning?.classList.remove('hidden');
      message.textContent = `Missing keys for: ${missing.join(', ')}. Add them in your Account settings.`;
      return false;
    } else {
      warning?.classList.add('hidden');
      return true;
    }
  }

  // Initialize
  checkAuth();

  // Watch for model changes
  window.addEventListener('modelSelected', () => {
    checkMissingKeys();
  });

  // Random free models button handler
  const randomFreeBtn = document.getElementById('randomFreeBtn');
  if (randomFreeBtn) {
    randomFreeBtn.addEventListener('click', async () => {
      randomFreeBtn.disabled = true;
      randomFreeBtn.innerHTML = `
        <svg class="animate-spin h-4 w-4" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
        </svg>
        Picking...
      `;

      try {
        const res = await fetch(`${apiUrl}/api/models/openrouter`);
        if (!res.ok) throw new Error('Failed to fetch models');
        
        const data = await res.json();
        
        // Collect all free models
        const freeModels = [];
        for (const provider of data.providers) {
          const models = data.modelsByProvider[provider] || [];
          for (const model of models) {
            if (model.pricing.inputPer1M === 0 && model.pricing.outputPer1M === 0) {
              freeModels.push(model);
            }
          }
        }

        if (freeModels.length < 2) {
          alert('Not enough free models available');
          return;
        }

        // Shuffle and pick two different models
        const shuffled = freeModels.sort(() => Math.random() - 0.5);
        const modelA = shuffled[0];
        const modelB = shuffled[1];

        // Dispatch custom events to update the ModelSelector components
        window.dispatchEvent(new CustomEvent('selectModel', { 
          detail: { inputId: 'modelA', modelId: modelA.id } 
        }));
        window.dispatchEvent(new CustomEvent('selectModel', { 
          detail: { inputId: 'modelB', modelId: modelB.id } 
        }));

        // Check keys after selection
        setTimeout(checkMissingKeys, 100);

      } catch (err) {
        console.error('Failed to fetch free models:', err);
        alert('Failed to fetch models. Please try again.');
      } finally {
        randomFreeBtn.disabled = false;
        randomFreeBtn.innerHTML = `
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 18h1.4c1.3 0 2.5-.6 3.3-1.7l6.1-8.6c.7-1.1 2-1.7 3.3-1.7H22"></path>
            <path d="m18 2 4 4-4 4"></path>
            <path d="M2 6h1.9c1.5 0 2.9.9 3.6 2.2"></path>
            <path d="M22 18h-5.9c-1.3 0-2.6-.7-3.3-1.8l-.5-.8"></path>
            <path d="m18 14 4 4-4 4"></path>
          </svg>
          Pick Two Random Free Models
        `;
      }
    });
  }

  const form = document.getElementById('gameForm');

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      if (!isAuthenticated) {
        alert('Please sign in to launch games.');
        return;
      }
      
      // Non-admin users must have at least one API key
      if (!isAdmin && userKeys.length === 0) {
        alert('You need to add at least one API key in your Account settings before launching games.');
        return;
      }
      
      // Check for missing keys for specific models
      if (!checkMissingKeys()) {
        alert('Please add the required API keys in your Account settings before launching a game.');
        return;
      }
      
      const submitBtn = form.querySelector('button[type="submit"]');
      const statusDiv = document.getElementById('launch-status');
      const statusText = document.getElementById('launch-status-text');
      
      const modelA = document.getElementById('modelA').value;
      const modelB = document.getElementById('modelB').value;
      
      if (!modelA || !modelB) {
        alert('Please select both mafia and town models');
        return;
      }
      
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Starting...';
      }
      
      if (statusDiv) {
        statusDiv.classList.remove('hidden');
      }
      if (statusText) {
        statusText.textContent = 'Initializing game...';
      }

      try {
        const formData = new FormData(form);
        const playerCount = parseInt(String(formData.get('playerCount') || '11'));
        const mafiaCount = parseInt(String(formData.get('mafiaCount') || '2'));

        if (statusText) {
          statusText.textContent = 'Contacting server...';
        }

        const res = await fetch(`${apiUrl}/api/games/run-direct`, {
          method: 'POST',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            config: {
              playerCount,
              mafiaCount,
              teams: [
                { modelId: modelA, team: 'mafia', count: mafiaCount },
                { modelId: modelB, team: 'town', count: playerCount - mafiaCount },
              ],
              maxRounds: 10,
              discussionEnabled: true,
              contextLevel: 'windowed',
              personaConstraints: 'moderate',
            },
          }),
        });

        if (res.status === 401) {
          window.location.href = `${apiUrl}/api/auth/google?redirect=/games/new`;
          return;
        }

        if (res.status === 403) {
          const err = await res.json();
          alert(err.error?.message || 'You do not have permission to run this game. Please add the required API keys.');
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Launch Game';
          }
          if (statusDiv) {
            statusDiv.classList.add('hidden');
          }
          return;
        }

        if (!res.ok) {
          const err = await res.json();
          throw new Error(err.error?.message || err.message || 'Failed to start game');
        }

        const result = await res.json();
        
        if (statusText) {
          statusText.textContent = `Game started! Redirecting to live view...`;
        }

        setTimeout(() => {
          window.location.href = `/games/${result.gameId}/live`;
        }, 500);

      } catch (err) {
        alert(err instanceof Error ? err.message : 'Failed to start game');
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Launch Game';
        }
        if (statusDiv) {
          statusDiv.classList.add('hidden');
        }
      }
    });
  }
</script>


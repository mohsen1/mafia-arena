---
import Layout from '../../../components/Layout.astro';
import { getGame, getTranscript, formatDuration } from '../../../lib/api';
import { getProviderColorFromModel } from '../../../lib/providers';
import { calculateCost, formatCost, calculateTotalCost } from '../../../lib/costs';
import { MessageSquare, Moon, Vote, Clock, Skull, ArrowLeft, Ghost, Info, ChevronDown } from 'lucide-astro';

const { id } = Astro.params;

let game = null;
let transcript = null;
let error = null;

try {
  game = await getGame(id!);
  transcript = await getTranscript(id!);
} catch (e) {
  error = e instanceof Error ? e.message : 'Failed to load game replay';
}

function groupEvents(events: any[]) {
  const grouped: Record<number, Record<string, any[]>> = {};
  for (const event of events) {
    const round = event.round || 1;
    const phase = event.phase || 'mafia_chat';
    if (!grouped[round]) grouped[round] = {};
    if (!grouped[round][phase]) grouped[round][phase] = [];
    grouped[round][phase].push(event);
  }
  return grouped;
}

const events = (transcript as any)?.events || [];
const groupedEvents = groupEvents(events);
const rounds = Object.keys(groupedEvents).map(Number).sort((a, b) => a - b);
const aiCallEvents = events.filter((e: any) => e.type === 'ai_call');
const totalCost = calculateTotalCost(aiCallEvents);

// Build player roster from ai_call events (persona_generation type)
interface PlayerInfo {
  playerId: string;
  originalName: string;
  personaName: string;
  team: 'mafia' | 'town';
  modelId: string;
}
const playerRoster: PlayerInfo[] = [];
const playerMap: Record<string, PlayerInfo> = {};

// First pass: get team and model info from ai_call events
const teamMap: Record<string, 'mafia' | 'town'> = {};
const modelMap: Record<string, string> = {};
for (const event of events) {
  if (event.type === 'ai_call' && event.playerId) {
    if (event.team) teamMap[event.playerId] = event.team;
    if (event.modelId) modelMap[event.playerId] = event.modelId;
  }
}

// Second pass: build roster from persona_generation events
for (const event of events) {
  if (event.type === 'persona_generation' && !playerMap[event.playerId]) {
    const info: PlayerInfo = {
      playerId: event.playerId,
      originalName: event.playerId.replace('player_', 'Player '),
      personaName: event.persona?.name || event.playerName,
      team: teamMap[event.playerId] || 'town',
      modelId: modelMap[event.playerId] || '',
    };
    playerRoster.push(info);
    playerMap[event.playerId] = info;
  }
}

// If no persona events, build from ai_call events
if (playerRoster.length === 0) {
  const seenPlayers = new Set<string>();
  for (const event of events) {
    if (event.type === 'ai_call' && event.playerId && !seenPlayers.has(event.playerId)) {
      seenPlayers.add(event.playerId);
      const info: PlayerInfo = {
        playerId: event.playerId,
        originalName: event.playerId.replace('player_', 'Player '),
        personaName: event.playerName || event.playerId,
        team: event.team || 'town',
        modelId: event.modelId || '',
      };
      playerRoster.push(info);
      playerMap[event.playerId] = info;
    }
  }
}

function getPersonaName(playerId: string): string {
  return playerMap[playerId]?.personaName || playerId;
}

function getPlayerTeam(playerId: string): string {
  return playerMap[playerId]?.team || 'town';
}

function getPlayerModel(playerId: string): string {
  return playerMap[playerId]?.modelId || '';
}

function getPhaseLabel(phase: string) {
  switch (phase) {
    case 'introduction': return 'Introduction';
    case 'night': return 'Night Phase';
    case 'day_discussion': return 'Day Discussion';
    case 'day_vote': return 'Day Vote';
    case 'mafia_chat': return 'Mafia Strategy';
    default: return phase;
  }
}

function cleanMessage(message: string): string {
  // Remove surrounding quotes if present
  return message?.replace(/^["']|["']$/g, '').trim() || '';
}

function parseResponse(raw: string): { type: 'persona' | 'message' | 'vote' | 'action' | 'raw'; content: any } {
  if (!raw) return { type: 'raw', content: '' };
  
  // Try to parse as JSON
  try {
    const parsed = JSON.parse(raw);
    
    // Check if it's a persona object
    if (parsed.name && (parsed.background || parsed.personality)) {
      return { type: 'persona', content: parsed };
    }
    
    // Check if it's a message response
    if (parsed.message) {
      return { type: 'message', content: parsed.message };
    }
    
    // Check if it's a vote response
    if (parsed.vote !== undefined) {
      return { type: 'vote', content: parsed };
    }
    
    // Check if it's a night action (kill/target)
    if (parsed.action && parsed.target) {
      return { type: 'action', content: parsed };
    }
    
    // Return raw parsed if none matched
    return { type: 'raw', content: raw };
  } catch {
    // Not JSON, return as raw text
    return { type: 'raw', content: cleanMessage(raw) };
  }
}
---

<Layout title={game ? `Replay ${game.id.slice(-8)}` : 'Not Found'}>
  {error || !game ? (
    <div class="border rounded-md p-8 text-center text-muted-foreground">
      <p class="text-sm mb-4">Transcript not found</p>
      <a href="/games" class="text-sm font-medium hover:underline">← Back to games</a>
    </div>
  ) : (
    <div class="space-y-6 max-w-4xl">
      <div class="flex items-center gap-2 text-sm text-muted-foreground">
        <a href="/games" class="hover:text-foreground inline-flex items-center gap-1">
          <ArrowLeft size={14} /> Games
        </a>
        <span>/</span>
        <a href={`/games/${game.id}`} class="hover:text-foreground">
          <code class="text-xs">{game.id.slice(-12)}</code>
        </a>
        <span>/</span>
        <span>Replay</span>
      </div>

      <div class="flex items-start justify-between gap-4 flex-wrap">
        <div>
          <h1 class="text-2xl font-bold tracking-tight">Game Replay</h1>
          <div class="flex items-center gap-3 mt-1 text-sm">
            <span class={`inline-flex items-center gap-1 font-medium ${
              game.winner === 'mafia' ? 'text-rose-600 dark:text-rose-400' : 'text-indigo-600 dark:text-indigo-400'
            }`}>
              <span class={`w-2 h-2 rounded-full ${game.winner === 'mafia' ? 'bg-rose-600' : 'bg-indigo-600'}`}></span>
              {game.winner === 'mafia' ? 'Mafia' : 'Town'} wins
            </span>
            <span class="text-muted-foreground">{game.rounds} rounds</span>
            <span class="text-muted-foreground">{formatDuration(game.duration_ms || 0)}</span>
            <span class="text-green-600 dark:text-green-400 font-mono">{formatCost(totalCost)}</span>
          </div>
        </div>
      </div>

      {/* Player Roster */}
      {playerRoster.length > 0 && (
        <div class="border rounded-md p-4 bg-muted/30">
          <h3 class="text-xs font-medium text-muted-foreground uppercase tracking-wider mb-3">Player Roster</h3>
          <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-2">
            {playerRoster.map((player) => (
              <div class={`flex items-start gap-2 px-2 py-2 rounded border text-sm ${
                player.team === 'mafia' 
                  ? 'bg-rose-500/5 border-rose-500/20' 
                  : 'bg-indigo-500/5 border-indigo-500/20'
              }`}>
                <div class={`w-2 h-2 rounded-full shrink-0 mt-1.5 ${
                  player.team === 'mafia' ? 'bg-rose-600' : 'bg-indigo-600'
                }`}></div>
                <div class="min-w-0 flex-1">
                  <div class="font-medium truncate">{player.personaName}</div>
                  <div class="text-[10px] text-muted-foreground truncate flex items-center gap-1">
                    <span class="w-1.5 h-1.5 rounded-full flex-shrink-0" style={`background: ${getProviderColorFromModel(player.modelId)}`}></span>
                    {player.modelId || player.originalName}
                  </div>
                  <div class={`text-[10px] ${player.team === 'mafia' ? 'text-rose-600 dark:text-rose-400' : 'text-indigo-600 dark:text-indigo-400'}`}>
                    {player.team}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      {events.length === 0 ? (
        <div class="border rounded-md p-8 text-center text-muted-foreground">
          <p class="text-sm">No events recorded</p>
        </div>
      ) : (
        <div class="space-y-6">
          {rounds.map(round => (
            <div class="space-y-4">
              <div class="sticky top-12 z-10 flex items-center gap-3 text-sm font-semibold py-2 bg-background/95 backdrop-blur-sm -mx-4 px-4">
                <span class="uppercase tracking-wider text-muted-foreground">Round {round}</span>
                <div class="h-px flex-1 bg-border"></div>
              </div>

              {Object.entries(groupedEvents[round] || {}).map(([phase, phaseEvents]) => (
                <div class="space-y-2">
                  {/* Phase Header - Sticky */}
                  <div class={`sticky top-[72px] z-10 flex items-center gap-2 text-xs font-semibold px-3 py-1.5 rounded shadow-sm ${
                    phase === 'mafia_chat' || phase === 'night' 
                      ? 'bg-rose-500/15 text-rose-700 dark:text-rose-400 border border-rose-500/20' 
                      : 'bg-muted/95 text-foreground border border-border backdrop-blur-sm'
                  }`}>
                    {phase === 'introduction' && <MessageSquare size={12} />}
                    {(phase === 'night' || phase === 'mafia_chat') && <Moon size={12} />}
                    {phase === 'day_discussion' && <MessageSquare size={12} />}
                    {phase === 'day_vote' && <Vote size={12} />}
                    <span>{getPhaseLabel(phase)}</span>
                  </div>

                  {/* Phase Events */}
                  <div class="space-y-1 pl-2">
                    {(phaseEvents as any[]).map((event, idx) => {
                      const team = event.team || getPlayerTeam(event.playerId || event.voterId);
                      const isMailia = team === 'mafia';
                      const teamColor = isMailia ? 'red' : 'blue';
                      
                      if (event.type === 'ai_call') {
                        const parsed = parseResponse(event.response?.raw);
                        
                        // Chat-style message with hidden system prompt
                        return (
                          <div class="group flex gap-3 py-2 hover:bg-muted/30 rounded px-2 -mx-2 transition-colors">
                            <div class={`w-1 rounded-full shrink-0 bg-${teamColor}-500`}></div>
                            <div class="flex-1 min-w-0">
                              <div class="flex items-center gap-2 flex-wrap">
                                <span class={`font-medium text-${teamColor}-600 dark:text-${teamColor}-400`}>
                                  {event.playerName}
                                </span>
                                <span class="text-[10px] text-muted-foreground flex items-center gap-1">
                                  <span class="w-1.5 h-1.5 rounded-full" style={`background: ${getProviderColorFromModel(event.modelId)}`}></span>
                                  {event.modelId}
                                </span>
                                <button 
                                  class="prompt-toggle text-[10px] text-muted-foreground/70 hover:text-foreground inline-flex items-center gap-0.5 opacity-0 group-hover:opacity-100 transition-opacity"
                                  data-target={`prompt-${round}-${phase}-${idx}`}
                                >
                                  <Info size={10} /> Prompt
                                </button>
                              </div>
                              
                              {/* Render based on response type */}
                              {parsed.type === 'persona' ? (
                                <div class="text-sm mt-2 space-y-1">
                                  <p class="italic text-muted-foreground">
                                    {parsed.content.occupation && <span class="font-medium">{parsed.content.occupation}.</span>}
                                    {' '}{parsed.content.personality}
                                  </p>
                                  <p class="text-foreground/80">{parsed.content.background}</p>
                                </div>
                              ) : parsed.type === 'message' ? (
                                <p class="text-sm mt-1 leading-relaxed whitespace-pre-wrap">{parsed.content}</p>
                              ) : parsed.type === 'vote' ? (
                                <div class="text-sm mt-1">
                                  <span class="text-muted-foreground">Vote: </span>
                                  <span class="font-medium">{getPersonaName(parsed.content.vote)}</span>
                                  {parsed.content.reasoning && (
                                    <p class="text-xs text-muted-foreground mt-1 italic">{parsed.content.reasoning}</p>
                                  )}
                                </div>
                              ) : parsed.type === 'action' ? (
                                <div class="text-sm mt-1">
                                  <span class="text-muted-foreground capitalize">{parsed.content.action}: </span>
                                  <span class="font-medium">{getPersonaName(parsed.content.target)}</span>
                                  {parsed.content.reasoning && (
                                    <p class="text-xs text-muted-foreground mt-1 italic">{parsed.content.reasoning}</p>
                                  )}
                                </div>
                              ) : (
                                <p class="text-sm mt-1 leading-relaxed">{parsed.content}</p>
                              )}
                              
                              {/* Hidden prompt details */}
                              <div id={`prompt-${round}-${phase}-${idx}`} class="prompt-details hidden mt-3 p-3 bg-muted/50 rounded border text-xs space-y-2">
                                <div>
                                  <div class="text-[10px] font-medium text-muted-foreground uppercase tracking-wider mb-1">System</div>
                                  <pre class="whitespace-pre-wrap text-[11px] text-muted-foreground overflow-auto max-h-32">{event.prompt?.system}</pre>
                                </div>
                                <div>
                                  <div class="text-[10px] font-medium text-muted-foreground uppercase tracking-wider mb-1">User</div>
                                  <pre class="whitespace-pre-wrap text-[11px] text-muted-foreground overflow-auto max-h-32">{event.prompt?.user}</pre>
                                </div>
                                <div class="flex items-center gap-4 text-[10px] text-muted-foreground pt-2 border-t">
                                  <span>{event.latencyMs}ms</span>
                                  <span>{event.tokensUsed?.total || (event.tokensUsed?.input + event.tokensUsed?.output)} tokens</span>
                                  <span class="text-green-600/70 dark:text-green-400/70">{formatCost(calculateCost(event.modelId, event.tokensUsed))}</span>
                                </div>
                              </div>
                            </div>
                          </div>
                        );
                      } else if (event.type === 'discussion' || event.type === 'introduction') {
                        // Simple chat message
                        return (
                          <div class="flex gap-3 py-1.5">
                            <div class={`w-1 rounded-full shrink-0 bg-${teamColor}-500`}></div>
                            <div class="min-w-0">
                              <span class={`text-sm font-medium text-${teamColor}-600 dark:text-${teamColor}-400`}>
                                {event.playerName}
                              </span>
                              <p class="text-sm text-foreground/90 leading-relaxed">{cleanMessage(event.message)}</p>
                            </div>
                          </div>
                        );
                      } else if (event.type === 'elimination') {
                        // Elimination event - clear visual
                        return (
                          <div class={`flex items-center gap-2 px-3 py-2 rounded border my-2 ${
                            event.team === 'mafia' 
                              ? 'bg-red-500/10 dark:bg-red-500/5 border-red-500/30'
                              : 'bg-blue-500/10 dark:bg-blue-500/5 border-blue-500/30'
                          }`}>
                            <Skull size={14} class={event.team === 'mafia' ? 'text-red-500' : 'text-blue-500'} />
                            <span class={`font-semibold ${
                              event.team === 'mafia' 
                                ? 'text-red-600 dark:text-red-400' 
                                : 'text-blue-600 dark:text-blue-400'
                            }`}>{event.playerName || getPersonaName(event.playerId)}</span>
                            <span class="text-muted-foreground">was eliminated</span>
                            <span class={`text-xs px-1.5 py-0.5 rounded font-medium ${
                              event.team === 'mafia' 
                                ? 'bg-red-500/20 text-red-600 dark:text-red-400' 
                                : 'bg-blue-500/20 text-blue-600 dark:text-blue-400'
                            }`}>
                              {event.team}
                            </span>
                          </div>
                        );
                      } else if (event.type === 'vote') {
                        // Vote as inline text
                        const voterTeam = getPlayerTeam(event.voterId);
                        const targetTeam = event.targetId ? getPlayerTeam(event.targetId) : null;
                        return (
                          <div class="flex items-center gap-2 py-1 text-sm">
                            <span class={`font-medium ${
                              voterTeam === 'mafia' 
                                ? 'text-red-600 dark:text-red-400' 
                                : 'text-blue-600 dark:text-blue-400'
                            }`}>{event.voterName || getPersonaName(event.voterId)}</span>
                            <span class="text-muted-foreground">voted for</span>
                            {event.targetId ? (
                              <span class={`font-medium ${
                                targetTeam === 'mafia' 
                                  ? 'text-red-600 dark:text-red-400' 
                                  : 'text-blue-600 dark:text-blue-400'
                              }`}>{getPersonaName(event.targetId)}</span>
                            ) : (
                              <span class="text-muted-foreground italic">abstain</span>
                            )}
                          </div>
                        );
                      }
                      return null;
                    })}
                  </div>
                </div>
              ))}
            </div>
          ))}
        </div>
      )}
    </div>
  )}
</Layout>

<script>
  // Toggle prompt visibility
  document.querySelectorAll('.prompt-toggle').forEach(btn => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-target');
      if (targetId) {
        const target = document.getElementById(targetId);
        if (target) {
          target.classList.toggle('hidden');
        }
      }
    });
  });
</script>

<style>
  /* Use rose and indigo for team colors */
  .bg-rose-500 { background-color: rgb(244 63 94); }
  .bg-rose-600 { background-color: rgb(225 29 72); }
  .bg-indigo-500 { background-color: rgb(99 102 241); }
  .bg-indigo-600 { background-color: rgb(79 70 229); }
  .text-rose-600 { color: rgb(225 29 72); }
  .text-rose-700 { color: rgb(190 18 60); }
  .text-indigo-600 { color: rgb(79 70 229); }
  .text-indigo-700 { color: rgb(67 56 202); }
  :global(.dark) .text-rose-400 { color: rgb(251 113 133); }
  :global(.dark) .text-indigo-400 { color: rgb(129 140 248); }
</style>

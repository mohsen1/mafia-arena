---
import Layout from '../../../components/Layout.astro';
import { getGame, getTranscript } from '../../../lib/api';
import { calculateCost, formatCost, calculateTotalCost } from '../../../lib/costs';
import { MessageSquare, Moon, Vote, Cpu, Clock, Hash, Skull, Hand, DollarSign, ChevronDown, ArrowLeft, Ghost } from 'lucide-astro';

const { id } = Astro.params;

let game = null;
let transcript = null;
let error = null;

try {
  game = await getGame(id!);
  transcript = await getTranscript(id!);
} catch (e) {
  error = e instanceof Error ? e.message : 'Failed to load game replay';
}

function groupEvents(events: any[]) {
  const grouped: Record<number, Record<string, any[]>> = {};
  for (const event of events) {
    const round = event.round || 1;
    const phase = event.phase || 'mafia_chat';
    if (!grouped[round]) grouped[round] = {};
    if (!grouped[round][phase]) grouped[round][phase] = [];
    grouped[round][phase].push(event);
  }
  return grouped;
}

const events = (transcript as any)?.events || [];
const groupedEvents = groupEvents(events);
const rounds = Object.keys(groupedEvents).map(Number).sort((a, b) => a - b);
const aiCallEvents = events.filter((e: any) => e.type === 'ai_call');
const totalCost = calculateTotalCost(aiCallEvents);

// Build player roster from ai_call events (persona_generation type)
interface PlayerInfo {
  playerId: string;
  originalName: string;
  personaName: string;
  team: 'mafia' | 'town';
  modelId: string;
}
const playerRoster: PlayerInfo[] = [];
const playerMap: Record<string, PlayerInfo> = {};

// First pass: get team info from ai_call events
const teamMap: Record<string, 'mafia' | 'town'> = {};
for (const event of events) {
  if (event.type === 'ai_call' && event.playerId && event.team) {
    teamMap[event.playerId] = event.team;
  }
}

// Second pass: build roster from persona_generation events
for (const event of events) {
  if (event.type === 'persona_generation' && !playerMap[event.playerId]) {
    const info: PlayerInfo = {
      playerId: event.playerId,
      originalName: event.playerId.replace('player_', 'Player '),
      personaName: event.persona?.name || event.playerName,
      team: teamMap[event.playerId] || 'town',
      modelId: '',
    };
    playerRoster.push(info);
    playerMap[event.playerId] = info;
  }
}

// If no persona events, build from ai_call events
if (playerRoster.length === 0) {
  const seenPlayers = new Set<string>();
  for (const event of events) {
    if (event.type === 'ai_call' && event.playerId && !seenPlayers.has(event.playerId)) {
      seenPlayers.add(event.playerId);
      const info: PlayerInfo = {
        playerId: event.playerId,
        originalName: event.playerId.replace('player_', 'Player '),
        personaName: event.playerName || event.playerId,
        team: event.team || 'town',
        modelId: event.modelId || '',
      };
      playerRoster.push(info);
      playerMap[event.playerId] = info;
    }
  }
}

// Helper to get persona name from player ID
function getPersonaName(playerId: string): string {
  return playerMap[playerId]?.personaName || playerId;
}

function getPlayerTeam(playerId: string): string {
  return playerMap[playerId]?.team || 'town';
}

function getPhaseIcon(phase: string) {
  switch (phase) {
    case 'introduction': return 'wave';
    case 'night': return 'moon';
    case 'day_discussion': return 'chat';
    case 'day_vote': return 'vote';
    default: return 'circle';
  }
}

function getPhaseLabel(phase: string) {
  switch (phase) {
    case 'introduction': return 'Introduction';
    case 'night': return 'Night';
    case 'day_discussion': return 'Discussion';
    case 'day_vote': return 'Vote';
    case 'mafia_chat': return 'Mafia Chat';
    default: return phase;
  }
}

function getEventCost(event: any): string {
  if (event.tokensUsed) {
    return formatCost(calculateCost(event.modelId, event.tokensUsed));
  }
  return '--';
}
---

<Layout title={game ? `Replay ${game.id.slice(-8)}` : 'Not Found'}>
  {error || !game ? (
    <div class="border rounded-md p-8 text-center text-muted-foreground">
      <p class="text-sm mb-4">Transcript not found</p>
      <a href="/games" class="text-sm font-medium hover:underline">← Back to games</a>
    </div>
  ) : (
    <div class="space-y-6 max-w-4xl">
      <div class="flex items-center gap-2 text-sm text-muted-foreground">
        <a href="/games" class="hover:text-foreground inline-flex items-center gap-1">
          <ArrowLeft size={14} /> Games
        </a>
        <span>/</span>
        <a href={`/games/${game.id}`} class="hover:text-foreground">
          <code class="text-xs">{game.id.slice(-12)}</code>
        </a>
        <span>/</span>
        <span>Replay</span>
      </div>

      <div class="flex items-start justify-between gap-4 flex-wrap">
        <div>
          <h1 class="text-2xl font-bold tracking-tight">Game Replay</h1>
          <div class="flex items-center gap-3 mt-1 text-sm">
            <span class={`inline-flex items-center gap-1 font-medium ${
              game.winner === 'mafia' ? 'text-red-500 dark:text-red-400' : 'text-blue-500 dark:text-blue-400'
            }`}>
              <span class={`w-2 h-2 rounded-full ${game.winner === 'mafia' ? 'bg-red-500' : 'bg-blue-500'}`}></span>
              {game.winner === 'mafia' ? 'Mafia' : 'Town'} wins
            </span>
            <span class="text-muted-foreground">{game.rounds} rounds</span>
            <span class="text-green-600 dark:text-green-400 font-mono">{formatCost(totalCost)}</span>
          </div>
        </div>
      </div>

      {/* Player Roster */}
      {playerRoster.length > 0 && (
        <div class="border rounded-md p-4 bg-muted/30">
          <h3 class="text-xs font-medium text-muted-foreground uppercase tracking-wider mb-3">Player Roster</h3>
          <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-2">
            {playerRoster.map((player) => (
              <div class={`flex items-center gap-2 px-2 py-1.5 rounded border text-sm ${
                player.team === 'mafia' 
                  ? 'bg-red-500/5 border-red-500/20' 
                  : 'bg-blue-500/5 border-blue-500/20'
              }`}>
                <div class={`w-2 h-2 rounded-full shrink-0 ${
                  player.team === 'mafia' ? 'bg-red-500' : 'bg-blue-500'
                }`}></div>
                <div class="min-w-0">
                  <div class="font-medium truncate">{player.personaName}</div>
                  <div class="text-[10px] text-muted-foreground truncate">{player.originalName}</div>
                </div>
              </div>
            ))}
          </div>
          <div class="flex gap-4 mt-2 text-[10px] text-muted-foreground">
            <span class="flex items-center gap-1">
              <span class="w-2 h-2 rounded-full bg-red-500"></span> Mafia
            </span>
            <span class="flex items-center gap-1">
              <span class="w-2 h-2 rounded-full bg-blue-500"></span> Town
            </span>
          </div>
        </div>
      )}

      {events.length === 0 ? (
        <div class="border rounded-md p-8 text-center text-muted-foreground">
          <p class="text-sm">No events recorded</p>
        </div>
      ) : (
        <div class="space-y-6">
          {rounds.map(round => (
            <div class="space-y-3">
              <div class="flex items-center gap-3 text-xs font-medium text-muted-foreground">
                <span class="uppercase tracking-wider">Round {round}</span>
                <div class="h-px flex-1 bg-border"></div>
              </div>

              {Object.entries(groupedEvents[round] || {}).map(([phase, phaseEvents]) => (
                <div class="space-y-2">
                  <div class="flex items-center gap-1.5 text-xs font-medium text-muted-foreground px-1">
                    {phase === 'introduction' && <Hand size={12} />}
                    {phase === 'night' && <Moon size={12} />}
                    {phase === 'day_discussion' && <MessageSquare size={12} />}
                    {phase === 'day_vote' && <Vote size={12} />}
                    {phase === 'mafia_chat' && <Ghost size={12} class="text-red-500" />}
                    <span>{getPhaseLabel(phase)}</span>
                  </div>

                  <div class="space-y-1.5">
                    {(phaseEvents as any[]).map(event => (
                      event.type === 'ai_call' ? (
                        <details class="border rounded-md overflow-hidden group">
                          <summary class="flex items-center gap-3 px-3 py-2 cursor-pointer hover:bg-muted/30 transition-colors text-sm">
                            <div class={`w-1 h-6 rounded-full shrink-0 ${event.team === 'mafia' ? 'bg-red-500' : 'bg-blue-500'}`}></div>
                            <span class="font-medium">{event.playerName}</span>
                            <code class="text-[10px] text-muted-foreground/60">{event.modelId}</code>
                            <div class="flex-1"></div>
                            <div class="hidden sm:flex items-center gap-2 text-[10px] text-muted-foreground/70 tabular-nums font-mono">
                              <span>{event.latencyMs}ms</span>
                              <span>{event.tokensUsed?.total || (event.tokensUsed?.input + event.tokensUsed?.output)}tok</span>
                              <span class="text-green-600/70 dark:text-green-400/70">{getEventCost(event)}</span>
                            </div>
                            <ChevronDown size={14} class="text-muted-foreground/60 transition-transform group-open:rotate-180" />
                          </summary>
                          <div class="px-3 py-3 border-t bg-muted/20 space-y-3 text-xs">
                            <div class="grid md:grid-cols-2 gap-3">
                              <div>
                                <div class="text-[10px] font-medium text-muted-foreground uppercase tracking-wider mb-1">System</div>
                                <pre class="p-2 rounded bg-background border text-[11px] overflow-auto max-h-32 whitespace-pre-wrap">{event.prompt?.system}</pre>
                              </div>
                              <div>
                                <div class="text-[10px] font-medium text-muted-foreground uppercase tracking-wider mb-1">User</div>
                                <pre class="p-2 rounded bg-background border text-[11px] overflow-auto max-h-32 whitespace-pre-wrap">{event.prompt?.user}</pre>
                              </div>
                            </div>
                            <div>
                              <div class="text-[10px] font-medium text-muted-foreground uppercase tracking-wider mb-1">Response</div>
                              <pre class="p-2 rounded bg-background border text-[11px] overflow-auto max-h-40 whitespace-pre-wrap">{event.response?.raw}</pre>
                            </div>
                          </div>
                        </details>
                      ) : event.type === 'discussion' || event.type === 'introduction' ? (
                        <div class="flex gap-2 px-1 py-1">
                          <div class={`w-1 rounded-full shrink-0 ${
                            playerMap[event.playerId]?.team === 'mafia' ? 'bg-red-500' : 'bg-blue-500'
                          }`}></div>
                          <div class="min-w-0">
                            <span class={`text-xs font-medium ${
                              playerMap[event.playerId]?.team === 'mafia' 
                                ? 'text-red-600 dark:text-red-400' 
                                : 'text-blue-600 dark:text-blue-400'
                            }`}>{event.playerName}</span>
                            <p class="text-sm text-muted-foreground leading-relaxed">"{event.message}"</p>
                          </div>
                        </div>
                      ) : event.type === 'elimination' ? (
                        <div class={`flex items-center gap-2 px-2 py-1.5 rounded border text-sm ${
                          event.team === 'mafia' 
                            ? 'bg-red-500/10 dark:bg-red-500/5 border-red-500/20'
                            : 'bg-blue-500/10 dark:bg-blue-500/5 border-blue-500/20'
                        }`}>
                          <Skull size={14} class={event.team === 'mafia' ? 'text-red-500' : 'text-blue-500'} />
                          <span class={`font-medium ${
                            event.team === 'mafia' 
                              ? 'text-red-600 dark:text-red-400' 
                              : 'text-blue-600 dark:text-blue-400'
                          }`}>{event.playerName || getPersonaName(event.playerId)}</span>
                          <span class="text-muted-foreground">eliminated</span>
                          <span class={`text-xs px-1.5 py-0.5 rounded font-medium ${
                            event.team === 'mafia' 
                              ? 'bg-red-500/20 text-red-600 dark:text-red-400' 
                              : 'bg-blue-500/20 text-blue-600 dark:text-blue-400'
                          }`}>
                            {event.team}
                          </span>
                        </div>
                      ) : event.type === 'vote' ? (
                        <div class="flex items-center gap-2 px-2 py-1 text-xs text-muted-foreground">
                          <span class={`font-medium ${
                            playerMap[event.voterId]?.team === 'mafia' 
                              ? 'text-red-600 dark:text-red-400' 
                              : 'text-blue-600 dark:text-blue-400'
                          }`}>{event.voterName || getPersonaName(event.voterId)}</span>
                          <span>→</span>
                          <span class={`px-1.5 py-0.5 rounded ${
                            event.targetId 
                              ? (playerMap[event.targetId]?.team === 'mafia' 
                                  ? 'bg-red-500/10 text-red-600 dark:text-red-400' 
                                  : 'bg-blue-500/10 text-blue-600 dark:text-blue-400')
                              : 'bg-muted text-muted-foreground'
                          }`}>
                            {event.targetId ? getPersonaName(event.targetId) : 'abstain'}
                          </span>
                        </div>
                      ) : null
                    ))}
                  </div>
                </div>
              ))}
            </div>
          ))}
        </div>
      )}
    </div>
  )}
</Layout>

<style is:global>
  details summary::-webkit-details-marker { display: none; }
  details summary { list-style: none; }
</style>

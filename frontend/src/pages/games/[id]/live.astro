---
import Layout from '../../../components/Layout.astro';
import { getGame } from '../../../lib/api';
import { ArrowLeft, Radio, Loader2, Trophy, Users, Moon, Sun, Swords, Vote, MessageSquare, Skull, ChevronDown, ChevronRight, Crosshair, Hash, Timer, DollarSign, Zap, Feather, Scroll, Sparkles, Building2 } from 'lucide-astro';

const { id } = Astro.params;
const gameId = id!;

// Fetch game metadata server-side for theme and participants
const game = await getGame(gameId).catch(() => null);
const theme = game?.persona_theme || 'noir';

// Extract model info for immediate display
const participants = game?.participants || [];
const mafiaModels = [...new Set(participants.filter(p => p.team === 'mafia').map(p => p.model_name.replace(/-\d{4}-\d{2}-\d{2}$/, '').replace(/@.*$/, '')))];
const townModels = [...new Set(participants.filter(p => p.team === 'town').map(p => p.model_name.replace(/-\d{4}-\d{2}-\d{2}$/, '').replace(/@.*$/, '')))];

// Extract unique providers from model names
function getProvider(modelName: string): string {
  if (modelName.includes('gpt') || modelName.includes('o1') || modelName.includes('o3')) return 'OpenAI';
  if (modelName.includes('claude')) return 'Anthropic';
  if (modelName.includes('gemini')) return 'Google';
  if (modelName.includes('deepseek')) return 'DeepSeek';
  if (modelName.includes('llama')) return 'Meta';
  return 'Other';
}
const allProviders = [...new Set(participants.map(p => getProvider(p.model_name)))].filter(p => p !== 'Other');

const apiUrl = import.meta.env.PUBLIC_API_URL || 'https://api.mafia-arena.com';

// Theme configuration
const themeConfig = {
  noir: { label: 'Noir', icon: 'feather', classes: 'bg-zinc-500/10 border-zinc-500/20 text-zinc-600 dark:text-zinc-400' },
  victorian: { label: 'Victorian', icon: 'scroll', classes: 'bg-amber-500/10 border-amber-500/20 text-amber-700 dark:text-amber-400' },
  modern: { label: 'Modern', icon: 'building', classes: 'bg-cyan-500/10 border-cyan-500/20 text-cyan-600 dark:text-cyan-400' },
  fantasy: { label: 'Fantasy', icon: 'sparkles', classes: 'bg-purple-500/10 border-purple-500/20 text-purple-600 dark:text-purple-400' },
};
const currentTheme = themeConfig[theme as keyof typeof themeConfig] || themeConfig.noir;
---

<Layout title={`Live: ${gameId.slice(-8)}`}>
  <div class="space-y-4 pb-8" id="live-game-container" data-game-id={gameId} data-api-url={apiUrl}>
    <!-- Back Link -->
    <div class="flex items-center gap-2 text-xs text-muted-foreground">
      <a href="/games" class="hover:text-foreground inline-flex items-center gap-1 transition-colors">
        <ArrowLeft size={12} /> Games
      </a>
      <span class="opacity-30">/</span>
      <code class="font-mono opacity-50">{gameId.slice(-12)}</code>
      <span class="opacity-30">/</span>
      <span>Live</span>
    </div>

    <!-- Broadcast HUD Header -->
    <div class="rounded-xl border bg-card overflow-hidden shadow-sm">
      <!-- Status Bar -->
      <div class="flex items-center justify-between px-4 py-2 border-b border-border/50">
        <div class="flex items-center gap-2.5 flex-wrap">
          <div id="live-badge" class="flex items-center gap-2 px-2.5 py-1 rounded-full bg-rose-500/10 border border-rose-500/20 text-rose-600 dark:text-rose-400 text-[10px] font-bold tracking-wider uppercase">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-rose-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-rose-500"></span>
            </span>
            LIVE
          </div>

          <!-- Theme Badge -->
          <div class={`flex items-center gap-1.5 px-2 py-1 rounded-full text-[10px] font-medium border ${currentTheme.classes}`}>
            {theme === 'fantasy' && <Sparkles size={10} />}
            {theme === 'victorian' && <Scroll size={10} />}
            {theme === 'modern' && <Building2 size={10} />}
            {theme === 'noir' && <Feather size={10} />}
            <span class="uppercase tracking-wide">{currentTheme.label}</span>
          </div>
        </div>

        <!-- Game ID -->
        <div class="flex items-center gap-2">
          <span class="text-[10px] text-muted-foreground/60 uppercase tracking-wide">Game</span>
          <code class="font-mono text-xs text-muted-foreground bg-muted/50 px-2 py-0.5 rounded select-all">{gameId}</code>
        </div>
      </div>

      <!-- Main Matchup Display -->
      <div id="teams-display" class="px-4 py-5 bg-gradient-to-b from-background to-muted/20">
        <div class="flex items-center justify-center gap-4 sm:gap-8">
          <!-- Mafia Side -->
          <div class="flex-1 text-right">
            <div class="flex flex-col items-end gap-1">
              <div class="flex items-center justify-end gap-2">
                <span class="text-rose-500 font-black text-lg sm:text-xl tracking-tight">MAFIA</span>
              </div>
              <div id="mafia-models" class="font-mono text-sm sm:text-base font-semibold text-foreground/90 truncate max-w-[140px] sm:max-w-[200px]">
                {mafiaModels.join(', ') || '—'}
              </div>
            </div>
          </div>

          <!-- VS Divider -->
          <div class="flex flex-col items-center gap-1 shrink-0">
            <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-full border-2 border-border bg-muted/50 flex items-center justify-center">
              <Swords size={18} class="text-muted-foreground sm:w-5 sm:h-5" />
            </div>
            <span class="text-[10px] font-black text-muted-foreground/60 tracking-widest">VS</span>
          </div>

          <!-- Town Side -->
          <div class="flex-1 text-left">
            <div class="flex flex-col items-start gap-1">
              <div class="flex items-center justify-start gap-2">
                <span class="text-indigo-500 font-black text-lg sm:text-xl tracking-tight">TOWN</span>
              </div>
              <div id="town-models" class="font-mono text-sm sm:text-base font-semibold text-foreground/90 truncate max-w-[140px] sm:max-w-[200px]">
                {townModels.join(', ') || '—'}
              </div>
            </div>
          </div>
        </div>
        
        <!-- Providers Row -->
        <div class="flex items-center justify-center gap-1.5 mt-3 pt-3 border-t border-border/30">
          <span class="text-[10px] text-muted-foreground/60 uppercase tracking-wide mr-1">Providers</span>
          <div id="providers-display" class="flex items-center gap-1">
            {allProviders.length > 0 ? allProviders.map(provider => (
              <span class={`text-[10px] px-1.5 py-0.5 rounded font-medium ${
                provider === 'OpenAI' ? 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400' :
                provider === 'Anthropic' ? 'bg-amber-500/10 text-amber-600 dark:text-amber-400' :
                provider === 'Google' ? 'bg-blue-500/10 text-blue-600 dark:text-blue-400' :
                provider === 'DeepSeek' ? 'bg-violet-500/10 text-violet-600 dark:text-violet-400' :
                provider === 'Meta' ? 'bg-indigo-500/10 text-indigo-600 dark:text-indigo-400' :
                'bg-muted text-muted-foreground'
              }`}>{provider}</span>
            )) : <span class="text-[10px] text-muted-foreground">—</span>}
          </div>
        </div>
      </div>

      <!-- Telemetry Strip -->
      <div class="grid grid-cols-4 divide-x divide-border border-t bg-muted/20 text-[10px] uppercase tracking-wider">
        <div class="p-2.5 flex flex-col items-center justify-center gap-0.5">
          <span class="text-muted-foreground text-[9px]">Round</span>
          <span id="round-display" class="font-mono font-bold text-base leading-none">-</span>
        </div>
        
        <div class="p-2.5 flex flex-col items-center justify-center gap-0.5 col-span-1">
          <span class="text-muted-foreground text-[9px]">Phase</span>
          <div id="phase-display" class="flex items-center gap-1.5 font-medium text-foreground text-[11px]">
            <span class="w-1.5 h-1.5 rounded-full bg-muted-foreground/50"></span>
            <span>Starting</span>
          </div>
        </div>

        <div class="p-2.5 flex flex-col items-center justify-center gap-0.5">
          <span class="text-muted-foreground text-[9px]">Duration</span>
          <span id="duration-display" class="font-mono font-medium tabular-nums text-[11px]">00:00</span>
        </div>

        <div class="p-2.5 flex flex-col items-center justify-center gap-0.5 bg-background/30">
          <span class="text-muted-foreground text-[9px]">Tokens</span>
          <div class="flex items-center gap-1 text-emerald-600 dark:text-emerald-500 text-[11px]">
            <Zap size={10} />
            <span id="token-display" class="font-mono font-bold tabular-nums">0</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Connection Status -->
    <div id="connection-status" class="text-[10px] text-center text-muted-foreground">
      <div class="flex items-center justify-center gap-2">
        <Loader2 size={10} class="animate-spin" />
        <span>Connecting to feed...</span>
      </div>
    </div>

    <!-- Error Banner (shown when game fails) -->
    <div id="error-banner" class="hidden rounded-lg border border-rose-500/30 bg-rose-500/10 p-4 space-y-2">
      <div class="flex items-start gap-3">
        <div class="shrink-0 text-rose-500">
          <Skull size={20} />
        </div>
        <div class="space-y-1 min-w-0 flex-1">
          <div class="text-sm font-semibold text-rose-600 dark:text-rose-400">Game Failed</div>
          <div id="error-message" class="text-xs text-rose-600/80 dark:text-rose-400/80 break-words font-mono"></div>
        </div>
      </div>
    </div>

    <!-- Players Grid -->
    <section id="players-section" class="space-y-2 hidden">
      <div class="flex items-center justify-between">
        <h2 class="text-sm font-semibold flex items-center gap-1.5">
          <Users size={14} />
          Players
        </h2>
        <div class="flex items-center gap-3 text-[10px]">
          <span class="flex items-center gap-1">
            <span class="w-2 h-2 rounded-full bg-rose-500"></span>
            Mafia (<span id="mafia-count">0</span>)
          </span>
          <span class="flex items-center gap-1">
            <span class="w-2 h-2 rounded-full bg-indigo-500"></span>
            Town (<span id="town-count">0</span>)
          </span>
        </div>
      </div>
      <div id="players-grid" class="flex flex-wrap gap-1.5">
      </div>
    </section>

    <!-- Transcript -->
    <section class="space-y-2 relative">
      <div class="flex items-center justify-between">
        <h2 class="text-sm font-semibold flex items-center gap-1.5">
          <MessageSquare size={14} />
          Transcript
        </h2>
        <!-- New messages notification pill -->
        <button 
          id="new-messages-pill" 
          class="hidden items-center gap-1.5 px-2.5 py-1 rounded-full bg-primary text-primary-foreground text-[10px] font-medium animate-pulse hover:bg-primary/90 transition-colors cursor-pointer"
        >
          <Zap size={10} />
          <span id="new-messages-count">0</span> new
        </button>
      </div>
      <div id="transcript-container" class="border rounded-md text-xs max-h-[600px] overflow-y-auto">
        <div class="px-3 py-6 text-center text-muted-foreground">
          Waiting for events...
        </div>
      </div>
    </section>

    <!-- Game End (shown when complete) -->
    <div id="game-end" class="hidden"></div>
  </div>
</Layout>

<script>
  import { initLiveGame } from '../../../scripts/live-game';

  // Read config from container element's data attributes
  const container = document.getElementById('live-game-container');
  if (container) {
    const config = {
      gameId: container.dataset.gameId || '',
      apiUrl: container.dataset.apiUrl || '',
    };

    // Initialize the live game
    initLiveGame(config);
  }
</script>

<style>
  details[open] > summary {
    border-bottom: 1px solid var(--border);
  }
  details > summary::-webkit-details-marker { display: none; }
  details > summary { list-style: none; }
  
  @keyframes heartbeat-pulse {
    0%, 100% {
      transform: scale(1);
      opacity: 0.75;
    }
    50% {
      transform: scale(2);
      opacity: 0;
    }
  }
  
  .heartbeat-ping {
    animation: heartbeat-pulse 1s ease-out;
  }
  
  #poll-event-flash {
    transition: transform 0.1s ease-out, opacity 0.3s ease-out;
  }
  
  /* Telemetry stats smooth transitions */
  #token-display, #round-display, #duration-display {
    transition: color 0.3s ease;
  }
  
  /* Pulse animation for tokens when updating */
  @keyframes token-pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.05); }
  }
</style>

---
import Layout from '../../../components/Layout.astro';
import { ArrowLeft, Radio, Loader2 } from 'lucide-astro';

const { id } = Astro.params;
const gameId = id!;

const apiUrl = import.meta.env.PUBLIC_API_URL || 'https://mafia-arena.me-f9a.workers.dev';
---

<Layout title={`Live: ${gameId.slice(-8)}`}>
  <div class="space-y-6 max-w-4xl">
    <div class="flex items-center gap-2 text-sm text-muted-foreground">
      <a href="/games" class="hover:text-foreground inline-flex items-center gap-1">
        <ArrowLeft size={14} /> Games
      </a>
      <span>/</span>
      <a href={`/games/${gameId}`} class="hover:text-foreground">
        <code class="text-xs">{gameId.slice(-12)}</code>
      </a>
      <span>/</span>
      <span>Live</span>
    </div>

    <div class="flex items-start justify-between gap-4 flex-wrap">
      <div>
        <div class="flex items-center gap-3">
          <h1 class="text-2xl font-bold tracking-tight">Live Game</h1>
          <span id="live-badge" class="inline-flex items-center gap-1.5 px-2 py-1 rounded-full text-xs font-medium bg-red-500/10 text-red-500 border border-red-500/20">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-red-500"></span>
            </span>
            LIVE
          </span>
        </div>
        <div id="game-status" class="flex items-center gap-3 mt-1 text-sm text-muted-foreground">
          <span id="status-text">Connecting...</span>
        </div>
      </div>
      <a 
        href={`/games/${gameId}/replay`} 
        id="replay-link"
        class="hidden inline-flex items-center gap-1.5 px-3 h-8 text-sm font-medium bg-primary text-primary-foreground rounded hover:bg-primary/90 transition-colors"
      >
        View Full Replay
      </a>
    </div>

    {/* Connection Status */}
    <div id="connection-status" class="border rounded-md p-4 bg-muted/30">
      <div class="flex items-center gap-3">
        <div class="animate-spin">
          <Loader2 size={20} class="text-muted-foreground" />
        </div>
        <span class="text-sm text-muted-foreground">Connecting to live stream...</span>
      </div>
    </div>

    {/* Player Roster (populated by JS) */}
    <div id="player-roster" class="hidden border rounded-md p-4 bg-muted/30">
      <h3 class="text-xs font-medium text-muted-foreground uppercase tracking-wider mb-3">Player Roster</h3>
      <div id="roster-grid" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-2">
      </div>
    </div>

    {/* Events Container */}
    <div id="events-container" class="space-y-6">
      <div class="text-center text-muted-foreground text-sm py-8">
        Waiting for events...
      </div>
    </div>

    {/* Game End Banner (hidden initially) */}
    <div id="game-end-banner" class="hidden fixed bottom-4 left-1/2 -translate-x-1/2 z-50">
      <div class="bg-background border-2 rounded-lg shadow-xl p-4 flex items-center gap-4">
        <div id="winner-indicator" class="text-lg font-bold"></div>
        <a 
          href={`/games/${gameId}/replay`}
          class="px-4 py-2 bg-primary text-primary-foreground rounded-md text-sm font-medium hover:bg-primary/90 transition-colors"
        >
          View Full Replay
        </a>
      </div>
    </div>
  </div>
</Layout>

<script define:vars={{ gameId, apiUrl }}>
  // WebSocket connection for live streaming
  let ws = null;
  let events = [];
  let playerMap = {};
  let reconnectAttempts = 0;
  const MAX_RECONNECT_ATTEMPTS = 5;

  function getPhaseLabel(phase) {
    switch (phase) {
      case 'introduction': return 'Introduction';
      case 'night': return 'Night Phase';
      case 'day_discussion': return 'Day Discussion';
      case 'day_vote': return 'Day Vote';
      case 'mafia_chat': return 'Mafia Strategy';
      default: return phase;
    }
  }

  function getProviderColor(modelId) {
    if (!modelId) return '#888';
    if (modelId.includes('gpt') || modelId.includes('o1') || modelId.includes('o3')) return '#10a37f';
    if (modelId.includes('claude')) return '#d97706';
    if (modelId.includes('gemini')) return '#4285f4';
    if (modelId.includes('llama') || modelId.includes('deepseek')) return '#6366f1';
    return '#888';
  }

  function updateConnectionStatus(connected, message) {
    const statusEl = document.getElementById('connection-status');
    if (!statusEl) return;

    if (connected) {
      statusEl.innerHTML = `
        <div class="flex items-center gap-3">
          <div class="w-2 h-2 rounded-full bg-green-500"></div>
          <span class="text-sm text-green-600 dark:text-green-400">${message || 'Connected'}</span>
        </div>
      `;
    } else {
      statusEl.innerHTML = `
        <div class="flex items-center gap-3">
          <div class="animate-spin">
            <svg class="w-5 h-5 text-muted-foreground" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
          </div>
          <span class="text-sm text-muted-foreground">${message || 'Connecting...'}</span>
        </div>
      `;
    }
  }

  function updateLiveBadge(status) {
    const badge = document.getElementById('live-badge');
    const statusText = document.getElementById('status-text');
    const replayLink = document.getElementById('replay-link');

    if (!badge) return;

    if (status === 'running') {
      // Keep the animated LIVE badge
      badge.className = 'inline-flex items-center gap-1.5 px-2 py-1 rounded-full text-xs font-medium bg-red-500/10 text-red-500 border border-red-500/20';
      badge.innerHTML = `
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-red-500"></span>
        </span>
        LIVE
      `;
    } else if (status === 'completed') {
      badge.className = 'inline-flex items-center gap-1.5 px-2 py-1 rounded-full text-xs font-medium bg-green-500/10 text-green-500 border border-green-500/20';
      badge.innerHTML = `
        <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
        </svg>
        COMPLETED
      `;
      if (replayLink) replayLink.classList.remove('hidden');
    } else if (status === 'failed') {
      badge.className = 'inline-flex items-center gap-1.5 px-2 py-1 rounded-full text-xs font-medium bg-red-500/10 text-red-500 border border-red-500/20';
      badge.innerHTML = `
        <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
        FAILED
      `;
    } else if (status === 'idle') {
      badge.className = 'inline-flex items-center gap-1.5 px-2 py-1 rounded-full text-xs font-medium bg-yellow-500/10 text-yellow-500 border border-yellow-500/20';
      badge.innerHTML = `
        <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" />
        </svg>
        STARTING
      `;
    }
    
    if (statusText) {
      const eventCount = events.length;
      if (status === 'completed' || status === 'failed') {
        statusText.textContent = status === 'completed' ? 'Game complete' : 'Game failed';
      } else if (status === 'running') {
        const lastEvent = events[events.length - 1];
        const phase = lastEvent?.phase || 'introduction';
        const round = lastEvent?.round || 1;
        statusText.textContent = `Round ${round} - ${getPhaseLabel(phase)} (${eventCount} events)`;
      } else {
        statusText.textContent = eventCount > 0 ? `${eventCount} events` : 'Waiting for game to start...';
      }
    }
  }

  function buildPlayerFromEvent(event) {
    if (event.type === 'ai_call' && event.playerId && !playerMap[event.playerId]) {
      playerMap[event.playerId] = {
        playerId: event.playerId,
        playerName: event.playerName,
        modelId: event.modelId,
        team: event.team,
      };
    }
    if (event.type === 'persona_generation' && event.playerId) {
      if (!playerMap[event.playerId]) {
        playerMap[event.playerId] = {
          playerId: event.playerId,
          playerName: event.playerName,
          team: 'town',
          modelId: '',
        };
      }
      playerMap[event.playerId].persona = event.persona;
      playerMap[event.playerId].playerName = event.persona?.name || event.playerName;
    }
  }

  function updatePlayerRoster() {
    const rosterEl = document.getElementById('player-roster');
    const gridEl = document.getElementById('roster-grid');
    if (!rosterEl || !gridEl) return;

    const players = Object.values(playerMap);
    if (players.length === 0) return;

    rosterEl.classList.remove('hidden');
    gridEl.innerHTML = players.map(player => {
      const teamColor = player.team === 'mafia' ? 'red' : 'blue';
      const bgClass = player.team === 'mafia' ? 'bg-red-500/5 border-red-500/20' : 'bg-blue-500/5 border-blue-500/20';
      
      return `
        <div class="flex items-start gap-2 px-2 py-2 rounded border text-sm ${bgClass}">
          <div class="w-2 h-2 rounded-full shrink-0 mt-1.5 bg-${teamColor}-500"></div>
          <div class="min-w-0 flex-1">
            <div class="font-medium truncate">${player.playerName}</div>
            <div class="text-[10px] text-muted-foreground truncate flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full flex-shrink-0" style="background: ${getProviderColor(player.modelId)}"></span>
              ${player.modelId || 'Unknown'}
            </div>
            <div class="text-[10px] text-${teamColor}-500">${player.team}</div>
          </div>
        </div>
      `;
    }).join('');
  }

  function groupEventsByRoundAndPhase() {
    const grouped = {};
    for (const event of events) {
      const round = event.round || 1;
      const phase = event.phase || 'introduction';
      if (!grouped[round]) grouped[round] = {};
      if (!grouped[round][phase]) grouped[round][phase] = [];
      grouped[round][phase].push(event);
    }
    return grouped;
  }

  function renderEvent(event) {
    const team = event.team || playerMap[event.playerId]?.team || 'town';
    const teamColor = team === 'mafia' ? 'red' : 'blue';

    if (event.type === 'ai_call') {
      let content = '';
      try {
        const parsed = JSON.parse(event.response?.raw || '{}');
        if (parsed.message) {
          content = parsed.message;
        } else if (parsed.vote) {
          const targetName = playerMap[parsed.vote]?.playerName || parsed.vote;
          content = `<span class="text-muted-foreground">Voted for:</span> <strong>${targetName}</strong>`;
        } else if (parsed.action && parsed.target) {
          const targetName = playerMap[parsed.target]?.playerName || parsed.target;
          content = `<span class="text-muted-foreground">${parsed.action}:</span> <strong>${targetName}</strong>`;
        } else if (parsed.name && parsed.background) {
          content = `<em class="text-muted-foreground">${parsed.occupation || 'Mysterious'}. ${parsed.personality}</em><br>${parsed.background}`;
        } else {
          content = event.response?.raw?.slice(0, 200) || '';
        }
      } catch {
        content = event.response?.raw?.slice(0, 200) || '';
      }

      return `
        <div class="flex gap-3 py-2 hover:bg-muted/30 rounded px-2 -mx-2 transition-colors">
          <div class="w-1 rounded-full shrink-0 bg-${teamColor}-500"></div>
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 flex-wrap">
              <span class="font-medium text-${teamColor}-600 dark:text-${teamColor}-400">${event.playerName}</span>
              <span class="text-[10px] text-muted-foreground flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full" style="background: ${getProviderColor(event.modelId)}"></span>
                ${event.modelId}
              </span>
            </div>
            <div class="text-sm mt-1 leading-relaxed">${content}</div>
          </div>
        </div>
      `;
    }

    if (event.type === 'elimination') {
      return `
        <div class="flex items-center gap-2 py-2 text-sm">
          <span class="text-red-500">💀</span>
          <span><strong>${event.playerName}</strong> was eliminated</span>
          <span class="text-xs text-muted-foreground">(${event.team})</span>
        </div>
      `;
    }

    if (event.type === 'vote') {
      const targetName = playerMap[event.targetId]?.playerName || event.targetId || 'abstain';
      return `
        <div class="flex items-center gap-2 py-1 text-xs text-muted-foreground">
          <span>🗳️</span>
          <span>${event.voterName} voted for ${targetName}</span>
        </div>
      `;
    }

    if (event.type === 'game_end') {
      return `
        <div class="border-2 rounded-lg p-4 text-center ${event.winner === 'mafia' ? 'border-red-500/50 bg-red-500/10' : 'border-blue-500/50 bg-blue-500/10'}">
          <div class="text-lg font-bold ${event.winner === 'mafia' ? 'text-red-500' : 'text-blue-500'}">
            🎉 ${event.winner === 'mafia' ? 'Mafia' : 'Town'} Wins!
          </div>
          <div class="text-sm text-muted-foreground mt-1">
            Final: ${event.finalState?.mafiaAlive || 0} mafia, ${event.finalState?.townAlive || 0} town alive
          </div>
        </div>
      `;
    }

    return '';
  }

  function renderAllEvents() {
    const container = document.getElementById('events-container');
    if (!container) return;

    if (events.length === 0) {
      container.innerHTML = `
        <div class="text-center text-muted-foreground text-sm py-8">
          Waiting for events...
        </div>
      `;
      return;
    }

    const grouped = groupEventsByRoundAndPhase();
    const rounds = Object.keys(grouped).map(Number).sort((a, b) => a - b);

    let html = '';
    for (const round of rounds) {
      html += `
        <div class="space-y-4">
          <div class="flex items-center gap-3 text-sm font-semibold">
            <span class="uppercase tracking-wider text-muted-foreground">Round ${round}</span>
            <div class="h-px flex-1 bg-border"></div>
          </div>
      `;

      const phases = grouped[round];
      for (const [phase, phaseEvents] of Object.entries(phases)) {
        const isNightPhase = phase === 'night' || phase === 'mafia_chat';
        const phaseClass = isNightPhase 
          ? 'bg-red-500/10 text-red-600 dark:text-red-400' 
          : 'bg-muted text-muted-foreground';

        html += `
          <div class="space-y-2">
            <div class="flex items-center gap-2 text-xs font-medium px-2 py-1 rounded ${phaseClass}">
              ${phase === 'night' ? '🌙' : phase === 'day_vote' ? '🗳️' : '💬'}
              <span>${getPhaseLabel(phase)}</span>
            </div>
            <div class="space-y-1 pl-2">
              ${phaseEvents.map(e => renderEvent(e)).join('')}
            </div>
          </div>
        `;
      }

      html += '</div>';
    }

    container.innerHTML = html;
    
    // Scroll to bottom for new events
    container.scrollIntoView({ behavior: 'smooth', block: 'end' });
  }

  function showGameEndBanner(winner) {
    const banner = document.getElementById('game-end-banner');
    const indicator = document.getElementById('winner-indicator');
    if (!banner || !indicator) return;

    indicator.className = `text-lg font-bold ${winner === 'mafia' ? 'text-red-500' : 'text-blue-500'}`;
    indicator.innerHTML = `🎉 ${winner === 'mafia' ? 'Mafia' : 'Town'} Wins!`;
    banner.classList.remove('hidden');
  }

  function handleMessage(data) {
    if (data.type === 'SYNC') {
      // Initial sync - load all events
      events = data.events || [];
      events.forEach(buildPlayerFromEvent);
      updatePlayerRoster();
      renderAllEvents();
      updateConnectionStatus(true, `Synced ${events.length} events`);
      
      if (data.status === 'completed' || data.status === 'failed') {
        updateLiveBadge(data.status);
      } else if (data.status === 'idle') {
        updateLiveBadge('idle');
      }
    } else if (data.type === 'EVENT') {
      // New event
      const event = data.event;
      events.push(event);
      buildPlayerFromEvent(event);
      updatePlayerRoster();
      renderAllEvents();
      updateLiveBadge('running');

      if (event.type === 'game_end') {
        showGameEndBanner(event.winner);
        updateLiveBadge('completed');
      }
    } else if (data.type === 'STATUS') {
      updateLiveBadge(data.status);
      if (data.status === 'completed') {
        updateConnectionStatus(true, 'Game completed');
      }
    } else if (data.type === 'ERROR') {
      updateLiveBadge('failed');
      showErrorBanner(data.error || 'Game failed');
    }
  }

  function showErrorBanner(errorMessage) {
    const container = document.getElementById('events-container');
    if (!container) return;

    // Show error at the top of events
    const errorHtml = `
      <div class="border-2 border-red-500/50 bg-red-500/10 rounded-lg p-4">
        <div class="flex items-start gap-3">
          <span class="text-red-500 text-xl">⚠️</span>
          <div class="flex-1">
            <div class="font-bold text-red-500">Game Failed</div>
            <div class="text-sm text-muted-foreground mt-1">${errorMessage}</div>
          </div>
        </div>
      </div>
    `;
    
    const existingContent = container.innerHTML;
    if (!existingContent.includes('Game Failed')) {
      container.innerHTML = errorHtml + existingContent;
    }
    
    updateConnectionStatus(false, 'Game failed - See error above');
  }

  function connect() {
    if (reconnectAttempts >= MAX_RECONNECT_ATTEMPTS) {
      updateConnectionStatus(false, 'Connection failed. Try refreshing the page.');
      return;
    }

    const wsProtocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
    const wsUrl = apiUrl.replace(/^https?/, wsProtocol) + `/api/games/${gameId}/live`;
    
    updateConnectionStatus(false, `Connecting... (attempt ${reconnectAttempts + 1})`);
    
    try {
      ws = new WebSocket(wsUrl);

      ws.onopen = () => {
        reconnectAttempts = 0;
        updateConnectionStatus(true, 'Connected');
      };

      ws.onmessage = (event) => {
        try {
          const data = JSON.parse(event.data);
          handleMessage(data);
        } catch (e) {
          console.error('Failed to parse message:', e);
        }
      };

      ws.onclose = (event) => {
        if (event.code !== 1000) {
          reconnectAttempts++;
          updateConnectionStatus(false, 'Disconnected. Reconnecting...');
          setTimeout(connect, Math.min(1000 * Math.pow(2, reconnectAttempts), 30000));
        }
      };

      ws.onerror = (error) => {
        console.error('WebSocket error:', error);
        // Fallback to polling
        fallbackToPolling();
      };
    } catch (e) {
      console.error('Failed to create WebSocket:', e);
      fallbackToPolling();
    }
  }

  let pollInterval = null;
  
  function fallbackToPolling() {
    updateConnectionStatus(true, 'Using polling (WebSocket unavailable)');
    
    async function poll() {
      try {
        const res = await fetch(`${apiUrl}/api/games/${gameId}/events`);
        if (!res.ok) throw new Error('Failed to fetch');
        
        const data = await res.json();
        
        if (data.events && data.events.length > events.length) {
          const newEvents = data.events.slice(events.length);
          events = data.events;
          
          newEvents.forEach(buildPlayerFromEvent);
          updatePlayerRoster();
          renderAllEvents();
        }
        
        if (data.status === 'completed' || data.status === 'failed') {
          updateLiveBadge(data.status);
          if (data.status === 'completed') {
            const lastEvent = events[events.length - 1];
            if (lastEvent?.type === 'game_end') {
              showGameEndBanner(lastEvent.winner);
            }
          } else if (data.status === 'failed') {
            // Check for ai_parse_error events to show specific error
            const parseError = events.find(e => e.type === 'ai_parse_error');
            const errorMsg = parseError 
              ? `AI Parse Error from ${parseError.modelId}: ${parseError.error}`
              : 'Game encountered an error and could not complete';
            showErrorBanner(errorMsg);
          }
          clearInterval(pollInterval);
        }
      } catch (e) {
        console.error('Polling error:', e);
      }
    }

    poll();
    pollInterval = setInterval(poll, 1000); // Poll every 1 second for faster updates
  }

  // Start connection
  connect();

  // Cleanup on page unload
  window.addEventListener('beforeunload', () => {
    if (ws) ws.close(1000);
    if (pollInterval) clearInterval(pollInterval);
  });
</script>

<style>
  .bg-red-500 { background-color: rgb(239, 68, 68); }
  .bg-blue-500 { background-color: rgb(59, 130, 246); }
  .text-red-500 { color: rgb(239, 68, 68); }
  .text-blue-500 { color: rgb(59, 130, 246); }
  .text-red-600 { color: rgb(220, 38, 38); }
  .text-blue-600 { color: rgb(37, 99, 235); }
  .border-red-500\/20 { border-color: rgba(239, 68, 68, 0.2); }
  .border-blue-500\/20 { border-color: rgba(59, 130, 246, 0.2); }
  .bg-red-500\/5 { background-color: rgba(239, 68, 68, 0.05); }
  .bg-blue-500\/5 { background-color: rgba(59, 130, 246, 0.05); }
  .bg-red-500\/10 { background-color: rgba(239, 68, 68, 0.1); }
  .bg-blue-500\/10 { background-color: rgba(59, 130, 246, 0.1); }
  .border-red-500\/50 { border-color: rgba(239, 68, 68, 0.5); }
  .border-blue-500\/50 { border-color: rgba(59, 130, 246, 0.5); }
  
  @media (prefers-color-scheme: dark) {
    .text-red-400 { color: rgb(248, 113, 113); }
    .text-blue-400 { color: rgb(96, 165, 250); }
    .dark\:text-red-400 { color: rgb(248, 113, 113); }
    .dark\:text-blue-400 { color: rgb(96, 165, 250); }
  }
</style>

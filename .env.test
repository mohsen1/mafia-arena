# Test environment configuration for Playwright tests
# This file is loaded by playwright.config.ts

# Database Configuration for tests
DATABASE_URL="postgresql://testuser:testpass@localhost:5432/werewolf_test"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3099"
NEXTAUTH_SECRET="test-secret-key-for-ci"

# Mock AI for tests
USE_MOCK_AI="true"

# Disable external services in tests
OPENAI_API_KEY="mock-key"
ANTHROPIC_API_KEY="mock-key"
GEMINI_API_KEY="mock-key"
GOOGLE_API_KEY="mock-key"
GROQ_API_KEY="mock-key"
ELEVENLABS_API_KEY="mock-key"
